# Ignore local Claude Code state (settings.local.json, run/, worktrees/) but
# keep the shared dev-loop slash commands, their cross-platform driver script,
# the team-wide settings.json, and the CLAUDE.md topic files it imports.
.claude/*
!.claude/commands/
!.claude/docs/
!.claude/scripts/
!.claude/settings.json
