<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.eclipse.dirigible</groupId>
        <artifactId>dirigible-components-parent</artifactId>
        <version>14.82.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <name>Components - UI - Processes - Perspective</name>
    <artifactId>dirigible-components-ui-perspective-processes</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bpmn-visualization</artifactId>
            <version>${bpmn-visualization.version}</version>
            <!-- The UI loads one file, dist/bpmn-visualization.min.js, which already bundles these
                 (#7786). Nothing under components/ references webjars/mxgraph, webjars/es-toolkit,
                 typed-mxgraph, webjars/strnum or fast-xml-parser - the mxGraph the modelers use is
                 the copy vendored in resources-mxgraph - so the five webjars were 4 MB of nested
                 jars nobody can reach. -->
            <exclusions>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>mxgraph</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>typed-mxgraph__typed-mxgraph</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>es-toolkit</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>fast-xml-parser</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>strnum</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <properties>
        <license.header.location>../../../licensing-header.txt</license.header.location>
        <parent.pom.folder>../../../</parent.pom.folder>
    </properties>

</project>