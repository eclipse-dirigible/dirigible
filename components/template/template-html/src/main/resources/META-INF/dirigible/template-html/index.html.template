<!DOCTYPE html>
<!--
  A standalone Harmonia (Alpine.js) page. It is served straight from the project
  (/services/web/[[projectName]]/[[fileName]].html) and needs nothing but the platform's own webjars -
  no build step, no shell.

  The data comes from a plain fetch() against a public OData service; point loadRows() at one of
  your own client Java controllers (/services/java/<project>/...) to render your data instead.
-->
<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>[[fileNameBase]]</title>
    <link href="/webjars/codbex__harmonia/dist/harmonia.css" rel="stylesheet" />
    <style>
      /* Harmonia themes `body`; theme `html` too so the area below short content is not left with
         the browser default. The light/dark choice itself is applied by harmonia.min.js from the
         shared `codbex.harmonia.colorMode` key, so this page follows the platform theme. */
      html { background-color: var(--background); color: var(--foreground); }
      body { min-height: 100vh; }
      [x-cloak] { display: none !important; }
    </style>
  </head>

  <body class="vbox size-full" x-data="page" x-cloak>

    <div x-h-toolbar>
      <span x-h-toolbar-title class="shrink-0">Explore</span>
      <div x-h-select class="w-56">
        <input x-h-select-input x-model="selected" placeholder="Choose a collection" />
        <div x-h-select-content>
          <template x-for="collection in collections" :key="collection.name">
            <div x-h-select-option="collection.label" :data-value="String(collection.name)"></div>
          </template>
        </div>
      </div>
      <div class="flex-1"></div>
      <button x-h-button data-variant="transparent" data-size="icon-sm" aria-label="Reload" @click="load()">
        <i role="img" x-h-lucide data-lucide="refresh-cw"></i>
      </button>
    </div>

    <div class="vbox gap-4 p-4" style="flex: 1 1 auto;">

      <div x-show="error" x-h-alert data-variant="negative" role="alert">
        <div x-h-alert-description x-text="error"></div>
      </div>

      <div x-show="loading" x-h-text.muted>Loading...</div>

      <div x-show="!loading && !error" x-h-table-container.scroll>
        <table x-h-table data-borders="rows">
          <thead x-h-table-header>
            <tr x-h-table-row>
              <template x-for="column in columns()" :key="column">
                <th x-h-table-head scope="col" x-text="column"></th>
              </template>
            </tr>
          </thead>
          <tbody x-h-table-body>
            <template x-for="(row, index) in rows" :key="index">
              <tr x-h-table-row data-hoverable="true">
                <template x-for="column in columns()" :key="column">
                  <td x-h-table-cell x-text="row[column]"></td>
                </template>
              </tr>
            </template>
            <tr x-show="rows.length === 0">
              <td x-h-table-cell :colspan="columns().length" class="text-center">No data</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>

    <script>
      // Registered on `alpine:init` because Alpine is loaded deferred and starts itself - this page
      // must never call Alpine.start().
      document.addEventListener('alpine:init', () => {
        Alpine.data('page', () => ({
          serviceUrl: 'https://services.odata.org/V4/Northwind/Northwind.svc',
          collections: [
            { name: 'Customers', label: 'Customers', columns: ['CompanyName', 'City', 'Address'] },
            { name: 'Employees', label: 'Employees', columns: ['FirstName', 'LastName', 'Title', 'Country'] },
            { name: 'Products', label: 'Products', columns: ['ProductName', 'UnitPrice', 'QuantityPerUnit'] },
          ],
          selected: 'Customers',
          rows: [],
          loading: false,
          error: '',

          init() {
            this.$watch('selected', () => this.load());
            this.load();
          },

          columns() {
            return this.collections.find((collection) => collection.name === this.selected)?.columns ?? [];
          },

          async load() {
            this.loading = true;
            this.error = '';
            try {
              const response = await fetch(`${this.serviceUrl}/${this.selected}`, { headers: { Accept: 'application/json' } });
              if (!response.ok) {
                throw new Error(`${response.status} ${response.statusText}`);
              }
              const payload = await response.json();
              this.rows = payload.value ?? [];
            } catch (error) {
              this.rows = [];
              this.error = `Unable to load ${this.selected}: ${error.message}`;
            } finally {
              this.loading = false;
            }
          },
        }));
      });
    </script>

    <script defer src="/webjars/alpinejs/dist/cdn.min.js"></script>
    <script src="/webjars/codbex__harmonia/dist/harmonia.min.js"></script>
    <script src="/webjars/lucide/dist/umd/lucide.min.js"></script>
    <!-- opt-in Harmonia Lucide plugin: registers x-h-lucide (renders Lucide icons + keeps them in sync); needs window.lucide (above). -->
    <script src="/webjars/codbex__harmonia/dist/harmonia-lucide.min.js"></script>
  </body>

</html>
