#set($dollar = '$')
{
    "feeds": [],
    "scripts": [],
    "code": "${dollar}scope.model.param1 = \"\";\n${dollar}scope.model.param2 = 0;\n\n${dollar}scope.onTriggerClicked = function(){\n    ${dollar}http.post(\"/services/java/${projectName}/${javaPackageName}/ProcessService/processes\", JSON.stringify(${dollar}scope.model)).then(function (response) {\n        alert(\"A new process instance has been triggered.\\nResponse: \" + JSON.stringify(response.data));\n    }, function (error) {\n        alert(`Unable to trigger a new process: '${dollar}{(error && error.data && error.data.message) || error}'`);\n    });\n}\n",
    "form": [
        {
            "controlId": "header",
            "groupId": "fb-display",
            "label": "Trigger new process instance",
            "headerSize": 2,
            "level": 1,
            "padding": "sm",
            "side": "bottom"
        },
        {
            "controlId": "input-textfield",
            "groupId": "fb-controls",
            "id": "param1Id",
            "label": "Parameter 1",
            "horizontal": false,
            "isCompact": false,
            "readonly": false,
            "placeholder": "string value here",
            "type": "text",
            "model": "param1",
            "required": false,
            "minLength": 0,
            "maxLength": -1,
            "errorMessage": "Incorrect input"
        },
        {
            "controlId": "input-number",
            "groupId": "fb-controls",
            "id": "param2Id",
            "label": "Parameter 2",
            "horizontal": false,
            "isCompact": false,
            "readonly": false,
            "model": "param2",
            "required": false,
            "minNum": 0,
            "maxNum": 100000,
            "step": 1
        },
        {
            "controlId": "container-hbox",
            "groupId": "fb-containers",
            "children": [
                {
                    "controlId": "button",
                    "groupId": "fb-controls",
                    "label": "Trigger",
                    "type": "emphasized",
                    "isSubmit": true,
                    "isCompact": false,
                    "callback": "onTriggerClicked()"
                }
            ],
            "justify": "end"
        }
    ]
}