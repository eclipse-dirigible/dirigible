@Repository
@Component("${javaGenFolderName}_${name}Repository")
public class ${name}Repository extends JavaRepository<${name}Entity> {

#if($history == "true")
    /** The base table whose shadow ${tablePrefix}${dataName}_HISTORY table carries the change trail. */
    private static final String HISTORY_TABLE = "${tablePrefix}${dataName}";

    /**
     * The properties whose changes are recorded. The primary key never changes and the audit columns
     * say what the history row already says (who and when), so both are left out - everything else,
     * calculated fields and foreign keys included, is part of what the row was at a point in time.
     */
#set($historyFirst = true)
    private static final java.util.List<String> HISTORY_PROPERTIES = java.util.List.of(#foreach($property in $properties)#if(!$property.dataPrimaryKey && (!$property.auditType || $property.auditType == "NONE"))#if($historyFirst)#set($historyFirst = false)#else, #end"${property.name}"#end#end);

#end
    public ${name}Repository() {
        super(${name}Entity.class);
    }

    @Override
    public ${name}Entity save(${name}Entity entity) {
#if($lifecycleInitialStatus)
        enforceLifecycleStart(entity.${lifecycleStatusProperty});
#end
#rollupGuardCheck()
#aggregateGuardCheck()
#if($hasLabel)
        computeName(entity);
#end
#if($haveCalculatedPropertyOnCreate)
#foreach ($property in $properties)
#if($property.isCalculatedProperty && $property.calculatedActionOnCreate)
#actionAssign($property $property.calculatedActionOnCreate)
#elseif($property.isCalculatedProperty && $property.calculatedPropertyExpressionCreate)
#calcAssign($property $property.calculatedPropertyExpressionCreate)
#end
#end
#end
## A uuid field (intent type: uuid) is platform-generated: assign a random UUID on create when empty.
## A number: {} field with stampOn:issue also carries generatedUuid, so its create-time placeholder is
## a UUID (the real number is stamped at the issue step); stampOn:create fields are handled just below.
#foreach ($property in $properties)
#if($property.generatedUuid)
        if (entity.${property.name} == null || entity.${property.name}.isBlank()) {
            entity.${property.name} = java.util.UUID.randomUUID().toString();
        }
#end
#end
## First-class numbering, stampOn:create: allocate the real document number on insert (when empty)
## from the tenant's series. The number's SHAPE is not here - prefix and width live in the series
## configuration (the module's .numbers artefact, then per-tenant settings), so a deployment can change
## it without touching this model. `per` selects WHICH sequence: each value of that relation (typically
## Company - a separate legal entity owes its own range) has its own counter.
#foreach ($property in $properties)
#if($property.numberStampOnCreate)
        if (entity.${property.name} == null || entity.${property.name}.isBlank()) {
#if($property.numberPer && $property.numberPer != "")
            entity.${property.name} = org.eclipse.dirigible.sdk.numbering.DocumentNumbers.next("${property.numberSeries}", entity.${property.numberPer} == null ? null : String.valueOf(entity.${property.numberPer}));
#else
            entity.${property.name} = org.eclipse.dirigible.sdk.numbering.DocumentNumbers.next("${property.numberSeries}");
#end
        }
#end
#end
#if($documentMaster)
        recalculate(entity);
#end
#if($documentChecks && $documentChecks.size() > 0)
        enforceChecks(entity);
#end
        // The create event is handed to the write itself, which records it in the tenant's event outbox
        // INSIDE the insert's transaction: row and event commit together, so a broker outage can
        // neither swallow an event whose row exists nor fail a call whose row was written. Listeners
        // (intent process triggers, the reactions under gen/events) see it the moment it is durable.
        ${name}Entity saved = super.save(entity, "${projectName}-${perspectiveName}-${name}");
#if($history == "true")
        // Change history: the initial state as a null -> value delta per property, attributed to the
        // user whose request created the row.
        History.recordCreate(HISTORY_TABLE, saved.${pkPropertyName}, History.USER, saved, HISTORY_PROPERTIES);
#end
#if($documentItem)
        // Keep the document consistent: synchronously recompute the master's totals (no async roll-up).
        new ${documentItem.parentEntity}Repository().recalculate(saved.${documentItem.fkProperty});
#end
        return saved;
    }

    @Override
    public ${name}Entity update(${name}Entity entity) {
#if($lifecycleEdges)
        enforceLifecycle(entity);
#end
#rollupGuardCheck()
#aggregateGuardCheck()
#if($preservedOnUpdate.size() > 0)
        // System-owned fields survive a partial payload: a caller's update carries only the fields
        // its form edits, and a value it leaves null must not erase what the write path computed -
        // the roll-up/aggregate targets (an invoice's Paid, a timesheet's total hours) and the
        // platform-managed identifiers (document number, uuid). The #6226/#6306 lost-update family,
        // user-update edition: read the stored row once and take the system-owned values from THERE,
        // never from the payload. System writers stay on the targeted primitives (updateProperty /
        // updateProperties / updateDerived), so this preservation cannot fight a workflow write.
        ${name}Entity existingRow = entity.${pkPropertyName} == null ? null : findById(entity.${pkPropertyName});
        if (existingRow != null) {
#foreach($property in $preservedOnUpdate)
            entity.${property.name} = existingRow.${property.name};
#end
        }
#end
#if($groupingKeys && $groupingKeys.size() > 0)
        // Rekey: this entity's rows are GROUPED by something maintained asynchronously (an aggregate's
        // keys, a roll-up's parent FK), so a change to one of those columns MOVES the row between groups.
        // The group it moves into is recomputed off the "-updated" event like any other change; the group
        // it LEAVES has no event of its own, so capture the previous row here and publish it on the
        // dedicated "-rekeyed" topic after the write (below). Only the aggregate / roll-up handlers listen
        // there, so no other reaction sees a second event.
        ${name}Entity groupingPrevious = findById(entity.${groupingSourcePk});
        boolean groupingMoved = groupingPrevious != null && (false#foreach($k in $groupingKeys)
                || !java.util.Objects.equals(groupingPrevious.${k.key}, entity.${k.key})#end);
#end
#if($hasLabel)
        computeName(entity);
#end
#if($documentMaster)
        recalculate(entity);
#end
#if($haveCalculatedPropertyOnUpdate)
## The update-time recomputes run AFTER recalculate() and the preservation block above, so an
## expression like Balance = Total - Paid reads the freshly resummed Total and the preserved Paid -
## computing it from the incoming payload read nulls as zeros and persisted Balance 0 on a header
## edit (the 2026-08-12 prod invoice corruption).
#foreach ($property in $properties)
#if($property.isCalculatedProperty && $property.calculatedActionOnUpdate)
#actionAssign($property $property.calculatedActionOnUpdate)
#elseif($property.isCalculatedProperty && $property.calculatedPropertyExpressionUpdate)
#calcAssign($property $property.calculatedPropertyExpressionUpdate)
#end
#end
#end
#if($documentChecks && $documentChecks.size() > 0)
        enforceChecks(entity);
#end
#if($documentItem)
        // The document this line belongs to BEFORE the write: a full-row update may re-point the
        // line's FK to another document, and the one it leaves has no write of its own to resum it -
        // the same moved-line hole the targeted path already closes. Read through the BASE find, like
        // the history before-image below.
        ${name}Entity documentBeforeRow = entity.${pkPropertyName} == null ? null : super.findById(entity.${pkPropertyName});
        Object documentBefore = documentBeforeRow == null ? null : documentBeforeRow.${documentItem.fkProperty};
#end
#if($history == "true")
        // Change history: the before-image is read through the BASE find (super), never this class's
        // overridden one - on a multilingual entity the overridden read overlays the caller's language,
        // and a translated value diffed against the stored one would report an edit nobody made.
        ${name}Entity historyBefore = entity.${pkPropertyName} == null ? null : super.findById(entity.${pkPropertyName});
#end
#if($groupingKeys && $groupingKeys.size() > 0)
        java.util.List<DomainEvent> rekeyEvents = new java.util.ArrayList<>();
        if (groupingMoved) {
            // The "-rekeyed" notice carries the PREVIOUS row: the aggregate / roll-up handler recomputes
            // that row's old group from the store, which no longer contains this row, so the total it
            // left behind drops instead of staying stale. It rides the SAME transaction as the update,
            // so the group the row left cannot be stranded by a broker that was down for the second of
            // two separate publishes.
            rekeyEvents.add(new DomainEvent("${projectName}-${perspectiveName}-${name}-rekeyed", Json.stringify(groupingPrevious)));
        }
        ${name}Entity updated = super.update(entity, "${projectName}-${perspectiveName}-${name}-updated", rekeyEvents);
#else
        // The update event is recorded in the event outbox inside this write's own transaction - see
        // save() - so the intent reactions under gen/events see exactly the changes that committed.
        ${name}Entity updated = super.update(entity, "${projectName}-${perspectiveName}-${name}-updated");
#end
#if($history == "true")
        History.recordUpdate(HISTORY_TABLE, updated.${pkPropertyName}, History.USER, historyBefore, updated, HISTORY_PROPERTIES);
#end
#if($documentItem)
        // Keep the document consistent: synchronously recompute the master's totals (no async roll-up).
        new ${documentItem.parentEntity}Repository().recalculate(updated.${documentItem.fkProperty});
        if (documentBefore != null && !documentBefore.equals(updated.${documentItem.fkProperty})) {
            // The line MOVED: resum the document it left, which nothing else is going to touch.
            new ${documentItem.parentEntity}Repository().recalculate(documentBefore);
        }
#end
        return updated;
    }

    /**
     * Persists changes WITHOUT publishing the "-updated" event. Intended for system-managed
     * back-references — e.g. an intent process trigger writing ProcessId back onto the entity that
     * started it. Going through {@link #update} would re-publish "${name}-updated" and spuriously
     * re-fire onUpdate reactions (notifications, roll-ups, integrations) for a change the user never made.
     */
    public ${name}Entity updateWithoutEvent(${name}Entity entity) {
#if($lifecycleEdges)
        // A system write is still a status write: the state machine is the ONE place the legal moves
        // are declared, so a workflow setter or glue action gets the same answer a user form gets.
        enforceLifecycle(entity);
#end
#if($hasLabel)
        // Workflow writes change label inputs too (e.g. the stamped document number) - keep the
        // stored display name current on the system path as well.
        computeName(entity);
#end
#if($documentChecks && $documentChecks.size() > 0)
        // The workflow transition (e.g. the setter flipping the status to POSTED) comes through here -
        // the gate check makes an unbalanced document fail the transition, not silently post.
        enforceChecks(entity);
#end
#if($documentItem)
        // The document this line belongs to BEFORE the write - a system write can re-point the FK
        // exactly as a user edit does, and the vacated document has no write of its own to resum it.
        ${name}Entity documentBeforeRow = entity.${pkPropertyName} == null ? null : super.findById(entity.${pkPropertyName});
        Object documentBefore = documentBeforeRow == null ? null : documentBeforeRow.${documentItem.fkProperty};
#end
#if($history == "true")
        ${name}Entity historyBefore = entity.${pkPropertyName} == null ? null : super.findById(entity.${pkPropertyName});
        ${name}Entity updated = super.update(entity);
        // A system write (no user event), recorded as such so the trail separates what the application
        // did from what a person did.
        History.recordUpdate(HISTORY_TABLE, updated.${pkPropertyName}, History.SYSTEM, historyBefore, updated, HISTORY_PROPERTIES);
#else
        ${name}Entity updated = super.update(entity);
#end
#if($documentItem)
        // A system write is still a line change: the event is suppressed here, the arithmetic is not.
        // Keep the document consistent exactly as update() does (no async roll-up).
        new ${documentItem.parentEntity}Repository().recalculate(updated.${documentItem.fkProperty});
        if (documentBefore != null && !documentBefore.equals(updated.${documentItem.fkProperty})) {
            // The line MOVED: resum the document it left, which nothing else is going to touch.
            new ${documentItem.parentEntity}Repository().recalculate(documentBefore);
        }
#end
        return updated;
    }
#if(($documentChecks && $documentChecks.size() > 0) || $hasLabel || $lifecycleEdges || $history == "true" || $documentItem || ($groupingKeys && $groupingKeys.size() > 0))

    /**
     * Targeted single-column write with this entity's semantics preserved: routed through
     * {@link #updateProperties}, which is where they are applied. The base implementation writes the
     * column directly, so a plain pass-through would skip them.
     */
    @Override
    public int updateProperty(Object id, String property, Object value) {
        java.util.Map<String, Object> single = new java.util.LinkedHashMap<>();
        single.put(property, value);
        return updateProperties(id, single);
    }

    /**
     * Targeted multi-column write with this entity's semantics preserved: the incoming values are
     * applied to a FRESH copy of the row first, so the declarative gate checks (and the stored label
     * Name) see the row as it will be after the write - then only the named columns (plus a changed
     * Name) are persisted in one statement. The workflow setters/writers come through here; a plain
     * pass-through to the base targeted write would silently skip the posting gate - and, on a document
     * line, leave the master summing to something other than its lines.
     *
     * <p>
     * Both forms are overridden and the plain one delegates to the event-carrying one, so a targeted
     * write keeps these semantics whether or not it publishes. {@code recalculate} is the deliberate
     * exception: it reaches the base write through {@code super}, having already computed the row.
#if($groupingKeys && $groupingKeys.size() > 0)
     *
     * <p>
     * Still event-free for the reactions: the only event it can publish is {@code "-rekeyed"}, and only
     * when the write MOVED the row between groups - a topic nothing but the generated aggregate /
     * roll-up handlers subscribes to. Both notices are recorded in the outbox with the write itself,
     * so the mutation and the recompute signals commit together - a broker outage delays the
     * recompute instead of losing it.
#end
     */
    @Override
    public int updateProperties(Object id, java.util.Map<String, Object> values) {
        return updateProperties(id, values, null);
    }

    @Override
    public int updateProperties(Object id, java.util.Map<String, Object> values, String eventTopic) {
        if (values == null || values.isEmpty()) {
            return 0;
        }
#if($groupingKeys && $groupingKeys.size() > 0)
        // Rekey on the TARGETED path: a workflow setter, a resolver and a task-form writer move a
        // grouping column exactly as a user edit does, but they publish no "-updated" - so without this
        // neither side of the move would ever be recomputed (#6819). The row as it stands before the
        // write is snapshotted as JSON here, so applying the incoming values below cannot mutate it.
        String groupingPrevious = null;
        boolean groupingMoved = false;
#end
#if(($documentChecks && $documentChecks.size() > 0) || $hasLabel || $lifecycleEdges || $documentItem || ($groupingKeys && $groupingKeys.size() > 0))
        ${name}Entity entity = findOne(id).orElse(null);
#if($documentItem)
        // The document this line belongs to as it stands BEFORE the write - a targeted write may also
        // MOVE the line to another document, and the one it leaves behind has no write of its own to
        // resum it.
        Object documentBefore = entity == null ? null : entity.${documentItem.fkProperty};
#end
#end
#if(($documentChecks && $documentChecks.size() > 0) || $hasLabel || $lifecycleEdges || ($groupingKeys && $groupingKeys.size() > 0))
        if (entity != null) {
#if($documentChecks && $documentChecks.size() > 0)
            // What this write is ABOUT, read before the label recompute below may add a column of its
            // own: the gate applies to what a person or a workflow authored, not to the platform's own
            // bookkeeping.
            boolean authoredWrite = touchesAuthoredColumn(values);
#end
#if($lifecycleEdges)
            // The status as it stands BEFORE the targeted write - a transition button, a workflow
            // setter and a glue action all arrive here, and all of them are moves in the state machine.
            Object lifecyclePrevious = entity.${lifecycleStatusProperty};
#end
#if($groupingKeys && $groupingKeys.size() > 0)
            groupingPrevious = Json.stringify(entity);
#foreach($k in $groupingKeys)
            Object groupingPrevious${k.key} = entity.${k.key};
#end
#end
            values = new java.util.LinkedHashMap<>(values);
            for (java.util.Map.Entry<String, Object> value : values.entrySet()) {
                try {
                    ${name}Entity.class.getField(value.getKey())
                                       .set(entity, value.getValue());
                } catch (ReflectiveOperationException e) {
                    throw new IllegalArgumentException("Unknown property [" + value.getKey() + "]", e);
                }
            }
#if($groupingKeys && $groupingKeys.size() > 0)
            groupingMoved = false#foreach($k in $groupingKeys)
                    || !java.util.Objects.equals(groupingPrevious${k.key}, entity.${k.key})#end;
#end
#if($hasLabel)
            // A targeted write may change a label input (a workflow status hop, a stamped number) -
            // recompute the display name from the post-write row and carry it in the same statement.
            String nameBefore = entity.Name;
            computeName(entity);
            if (entity.Name == null ? nameBefore != null : !entity.Name.equals(nameBefore)) {
                values.put("Name", entity.Name);
            }
#end
#if($lifecycleEdges)
            enforceLifecycleMove(lifecyclePrevious, entity.${lifecycleStatusProperty});
#end
#if($documentChecks && $documentChecks.size() > 0)
            // The workflow transition (the setter flipping the status to POSTED) comes through here -
            // the gate check makes an unbalanced document fail the transition, not silently post. It
            // does NOT apply to a write that touches only platform-owned columns: the process id a
            // trigger stamps back says which process handles this document, which no document check has
            // an opinion about, and refusing it left a started instance with nothing pointing at it
            // (#6815) - strictly worse than an unbalanced document that records its process.
            if (authoredWrite) {
                enforceChecks(entity);
            }
#end
        }
#end
#if($groupingKeys && $groupingKeys.size() > 0)
        // BOTH sides of the move, on the one topic only the aggregate / roll-up handlers listen to -
        // so no other reaction sees a second event, which is why this path can signal them without
        // re-publishing "-updated". The previous row names the group the row LEFT (recomputed without
        // it, its total drops instead of staying stale); the written row names the one it moved INTO,
        // which on the targeted path gets no event of its own at all. Handed to the base write so both
        // notices commit with the mutation itself - a broker outage delays the recompute instead of
        // losing it - and recorded only when the row actually existed to be written.
        java.util.List<DomainEvent> rekeyEvents = groupingMoved
                ? java.util.List.of(new DomainEvent("${projectName}-${perspectiveName}-${name}-rekeyed", groupingPrevious),
                        new DomainEvent("${projectName}-${perspectiveName}-${name}-rekeyed", Json.stringify(entity)))
                : java.util.List.of();
#end
#if($history == "true")
        // Change history for the targeted write: it is how the system writes (a roll-up total, a
        // workflow write-back, a stamped number), so the trail attributes it to SYSTEM - a person
        // reading the record must be able to tell those apart from an edit somebody made.
        ${name}Entity historyBefore = super.findById(id);
#if($groupingKeys && $groupingKeys.size() > 0)
        int updatedCount = super.updateProperties(id, values, eventTopic, rekeyEvents);
#else
        int updatedCount = super.updateProperties(id, values, eventTopic);
#end
        if (updatedCount > 0) {
            History.recordUpdate(HISTORY_TABLE, id, History.SYSTEM, historyBefore, super.findById(id), HISTORY_PROPERTIES);
        }
#else
#if($groupingKeys && $groupingKeys.size() > 0)
        int updatedCount = super.updateProperties(id, values, eventTopic, rekeyEvents);
#else
        int updatedCount = super.updateProperties(id, values, eventTopic);
#end
#end
#if($documentItem)
        if (updatedCount > 0 && (values.containsKey("${documentItem.fkProperty}")#foreach($f in $documentItem.fields) || values.containsKey("${f.field}")#end)) {
            // A line written by a TARGETED primitive - a workflow setField, a glue updateProperty /
            // updateProperties / updateDerived - moves the document's totals exactly as a full save or
            // update does, so it resums the master here too. Without this the header displayed, printed
            // and posted a total that did not equal the sum of its lines. Guarded on the columns
            // actually written, so a targeted write that touches nothing aggregated (a status hop, a
            // process write-back) costs no extra query. The master's recalculate persists through its
            // own targeted write, so this cannot turn into a full-row write of the header.
            Object documentAfter = values.containsKey("${documentItem.fkProperty}")
                    ? values.get("${documentItem.fkProperty}")
                    : documentBefore;
            if (documentAfter != null) {
                new ${documentItem.parentEntity}Repository().recalculate(documentAfter);
            }
            if (documentBefore != null && !documentBefore.equals(documentAfter)) {
                // The line MOVED: resum the document it left, which nothing else is going to touch.
                new ${documentItem.parentEntity}Repository().recalculate(documentBefore);
            }
        }
#end
        return updatedCount;
    }
#end

    /**
     * Targeted write of DERIVED columns - roll-up totals and keyed aggregates maintained by the generated
     * handlers under {@code gen/events} - that keeps the {@code "-updated"} event contract.
     *
     * <p>
     * Only the named columns are persisted, so a concurrent user write to any other column of the row
     * cannot be reverted: a handler that read the row, recomputed one total and then merged the WHOLE row
     * back silently reverted whatever the user changed in that window (the lost-update family of #6226 /
     * #6306). The {@code "-updated"} event still fires so downstream reactions - notably a transitive
     * roll-up whose own parent sits above this row - keep cascading exactly as they did when the handler
     * persisted the full row. Routed through {@link #updateProperties} so an entity that declares
     * {@code checks:} still runs its gate, a labelled entity still refreshes its stored display Name,
     * and a document line still resums the master it belongs to.
     */
    public int updateDerived(Object id, java.util.Map<String, Object> values) {
        if (values == null || values.isEmpty()) {
            return 0;
        }
        // The event travels with the write: the resulting row is read back on the write's own
        // connection, before its commit, and recorded in the event outbox alongside it.
        return updateProperties(id, values, "${projectName}-${perspectiveName}-${name}-updated");
    }
#if($lifecycleEdges)

    /**
     * The declarative state machine (intent {@code lifecycle:}): the WHOLE set of legal status edges,
     * as {@code 1&gt;2} source-to-target id pairs.
     *
     * <p>
     * It is enforced HERE, in the repository, because this is the one place every status write passes
     * through whoever performs it - a user form, a workflow setter, a transition button, a glue action,
     * a custom controller. Guarding only the {@code transitions:} buttons would leave every other
     * writer free to jump a record from any status to any other, which is precisely the hole the
     * declaration closes.
     */
    private static final java.util.Set<String> LIFECYCLE_EDGES =
            new java.util.HashSet<>(java.util.Arrays.asList("${lifecycleEdges}".split(",")));

    /** Seeded status names, so a rejection names statuses instead of quoting positional ids. */
    private static final java.util.Map<String, String> LIFECYCLE_STATUS_NAMES = lifecycleStatusNames();

    private static java.util.Map<String, String> lifecycleStatusNames() {
        java.util.Map<String, String> names = new java.util.HashMap<>();
#if($lifecycleStatusNames)
        for (String seeded : "${lifecycleStatusNames}".split(",")) {
            int separator = seeded.indexOf('=');
            if (separator > 0) {
                names.put(seeded.substring(0, separator), seeded.substring(separator + 1));
            }
        }
#end
        return names;
    }

    /** A status as a person reads it: its seeded name when it has one, else the bare id. */
    private static String lifecycleLabel(Object status) {
        String id = String.valueOf(status);
        String name = LIFECYCLE_STATUS_NAMES.get(id);
        return name == null ? id : name;
    }

    /**
     * Validate the status move this write would make against the state machine, reading the stored row
     * for the status the record is standing in.
     */
    private void enforceLifecycle(${name}Entity entity) {
        if (entity.${pkPropertyName} == null) {
            return; // no stored row yet - a create, which enforceLifecycleStart covers
        }
        ${name}Entity stored = findById(entity.${pkPropertyName});
        if (stored != null) {
            enforceLifecycleMove(stored.${lifecycleStatusProperty}, entity.${lifecycleStatusProperty});
        }
    }

    /**
     * Reject a status move the lifecycle does not declare. A write that leaves the status where it was
     * is not a move; clearing the status is, and there is no edge to nowhere.
     */
    private void enforceLifecycleMove(Object previous, Object next) {
        if (previous == null || (next != null && String.valueOf(previous)
                                                       .equals(String.valueOf(next)))) {
            return;
        }
        if (next == null) {
            throw new ValidationException("This ${name} is " + lifecycleLabel(previous) + " and cannot be left without a status");
        }
        if (!LIFECYCLE_EDGES.contains(String.valueOf(previous) + ">" + String.valueOf(next))) {
            throw new ValidationException("This ${name} cannot move from " + lifecycleLabel(previous) + " to "
                    + lifecycleLabel(next) + " - that is not a step its lifecycle allows");
        }
    }
#if($lifecycleInitialStatus)

    /**
     * A lifecycle with a declared start ({@code init:}) also fixes where a record may ENTER it: created
     * anywhere else, a record would skip the graph entirely rather than travel it. The system's own
     * create-time filing (an aggregate guard's {@code outcome: reject}) runs after this check, so it
     * still files the record where the model says it belongs.
     */
    private void enforceLifecycleStart(Object status) {
        if (status != null && !"${lifecycleInitialStatus}".equals(String.valueOf(status))) {
            throw new ValidationException("A new ${name} starts at " + lifecycleLabel("${lifecycleInitialStatus}") + ", not at "
                    + lifecycleLabel(status));
        }
    }
#end
#end
#if($documentChecks && $documentChecks.size() > 0)

    /**
     * Platform-owned columns: the system writes them on the record's behalf and nothing a person or a
     * workflow authors ever lands in them. The process trigger's {@code ProcessId} is the one that
     * matters here - it records WHICH process handles the record, and it is written after the instance
     * has already started.
     */
    private static final java.util.List<String> SYSTEM_PROPERTIES = java.util.List.of("ProcessId");

    /**
     * Whether a targeted write is about a column somebody authored, as opposed to only the platform's own
     * bookkeeping. A write of the second kind cannot move this document into a gated status, nor break
     * what the gate checks, so the gate has nothing to say about it.
     *
     * @param values the properties the write carries
     * @return true when at least one of them is authored
     */
    private static boolean touchesAuthoredColumn(java.util.Map<String, Object> values) {
        for (String property : values.keySet()) {
            if (!SYSTEM_PROPERTIES.contains(property)) {
                return true;
            }
        }
        return false;
    }

    /**
     * Declarative document checks (intent {@code checks:}): each runs when the document is persisted
     * carrying its gate status. Throws {@code ValidationException} with the authored message - mapped to
     * HTTP 400 on a REST write, and failing the transaction (and thereby a workflow task completion
     * attempting an invalid transition) on the BPMN path.
     */
    private void enforceChecks(${name}Entity entity) {
#foreach($check in $documentChecks)
        if (entity.${check.statusProperty} != null && entity.${check.statusProperty} == ${check.status}) {
#if($check.kind == "itemsSumEqual")
            java.math.BigDecimal sum${check.overA} = java.math.BigDecimal.ZERO;
            java.math.BigDecimal sum${check.overB} = java.math.BigDecimal.ZERO;
            for (${check.itemsEntity}Entity checkItem : new ${check.itemsEntity}Repository().findAll(
                    Criteria.create().eq("${check.itemsFk}", entity.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end))) {
                if (checkItem.${check.overA} != null) {
                    sum${check.overA} = sum${check.overA}.add(checkItem.${check.overA});
                }
                if (checkItem.${check.overB} != null) {
                    sum${check.overB} = sum${check.overB}.add(checkItem.${check.overB});
                }
            }
            if (sum${check.overA}.compareTo(sum${check.overB}) != 0) {
                throw new ValidationException("${check.message}");
            }
#else
            if (new ${check.itemsEntity}Repository().findAll(
                    Criteria.create().eq("${check.itemsFk}", entity.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end)).size() < ${check.count}) {
                throw new ValidationException("${check.message}");
            }
#end
        }
#end
    }
#end

    @Override
    public void delete(${name}Entity entity) {
#if($history == "true")
        // The caller's argument may be a partial snapshot; the trail must carry what was actually
        // stored, so read the row (untranslated) before it is gone.
        ${name}Entity historyDeleted = entity.${pkPropertyName} == null ? null : super.findById(entity.${pkPropertyName});
#end
        // The delete event is recorded in the event outbox inside this write's own transaction - see
        // save() - so the intent reactions under gen/events cannot miss a row that is really gone.
        super.delete(entity, "${projectName}-${perspectiveName}-${name}-deleted");
#if($history == "true")
        History.recordDelete(HISTORY_TABLE, entity.${pkPropertyName}, History.USER, historyDeleted, HISTORY_PROPERTIES);
#end
#if($documentItem)
        // Keep the document consistent: synchronously recompute the master's totals (no async roll-up).
        new ${documentItem.parentEntity}Repository().recalculate(entity.${documentItem.fkProperty});
#end
    }

    @Override
    public void deleteById(Object id) {
#if($documentItem)
        ${name}Entity entity = findById(id);
#end
#if($history == "true")
        ${name}Entity historyDeleted = super.findById(id);
#end
        // The payload is the row as the deleting transaction read it, recorded in the event outbox
        // beside the delete itself - see save().
        super.deleteById(id, "${projectName}-${perspectiveName}-${name}-deleted");
#if($history == "true")
        History.recordDelete(HISTORY_TABLE, id, History.USER, historyDeleted, HISTORY_PROPERTIES);
#end
#if($documentItem)
        if (entity != null) {
            // Keep the document consistent: synchronously recompute the master's totals (no async roll-up).
            new ${documentItem.parentEntity}Repository().recalculate(entity.${documentItem.fkProperty});
        }
#end
    }
#if($multilingual == "true")

    // ${name} is multilingual: every read overlays the translated property values from the
    // ${tablePrefix}${dataName}_LANG table for the caller's language (the Accept-Language request
    // header - the Harmonia shell sends the Settings language there). Outside a request scope, or
    // with no translations for the language, the base values pass through unchanged.

    @Override
    public ${name}Entity findById(Object id) {
        return Translator.translateEntity(super.findById(id), id, User.getLanguage(), "${tablePrefix}${dataName}");
    }

    @Override
    public java.util.Optional<${name}Entity> findOne(Object id) {
        // The generated controller reads single records through findOne - translate that path too.
        return super.findOne(id)
                    .map(entity -> Translator.translateEntity(entity, id, User.getLanguage(), "${tablePrefix}${dataName}"));
    }

    @Override
    public List<${name}Entity> findAll() {
        return Translator.translateList(super.findAll(), User.getLanguage(), "${tablePrefix}${dataName}");
    }

    @Override
    public List<${name}Entity> findAll(int limit, int offset) {
        return Translator.translateList(super.findAll(limit, offset), User.getLanguage(), "${tablePrefix}${dataName}");
    }

    @Override
    public List<${name}Entity> findAll(Criteria criteria) {
        return Translator.translateList(super.findAll(criteria), User.getLanguage(), "${tablePrefix}${dataName}");
    }

    @Override
    public List<${name}Entity> query(String hql, Map<String, Object> parameters) {
        return Translator.translateList(super.query(hql, parameters), User.getLanguage(), "${tablePrefix}${dataName}");
    }
#end
#if($documentMaster)

    /**
     * Document totals: each aggregate field is the sum of the line items' same-named field. Recomputed
     * synchronously (in the same request) so the document stays consistent - NOT via async roll-up
     * listeners. Called on the master's own save/update, and by ${documentMaster.childEntity}Repository
     * after every line change.
     */
    private void recalculate(${name}Entity entity) {
#foreach($f in $documentMaster.fields)
        BigDecimal sum${f.field} = BigDecimal.ZERO;
#end
        if (entity.${documentMaster.masterPk} != null) {
            for (${documentMaster.childEntity}Entity row : new ${documentMaster.childEntity}Repository().findAll(
                    Criteria.create().eq("${documentMaster.fkProperty}", entity.${documentMaster.masterPk}))) {
#foreach($f in $documentMaster.fields)
                if (row.${f.field} != null) {
                    sum${f.field} = sum${f.field}.add(row.${f.field});
                }
#end
            }
        }
#foreach($f in $documentMaster.fields)
        entity.${f.field} = sum${f.field};
#end
    }

    /**
     * Reload the master, recompute its document totals from the current line items, and persist ONLY the
     * total columns in one atomic statement.
     *
     * <p>
     * The recompute is triggered by a LINE change, so whatever the user changed on the master in the
     * meantime has to survive it: persisting the whole row here reverts any concurrent write to an
     * unrelated column (the lost-update family fixed for the trigger write-back in #6226 and for the
     * workflow setters/writers in #6306). The targeted write also keeps this path free of the document
     * gate checks, exactly as the previous {@code super.update} was: totals move while a document is
     * still being assembled line by line, and a half-built document must not fail its posting gate.
     */
    public ${name}Entity recalculate(Object id) {
        ${name}Entity entity = findById(id);
        if (entity == null) {
            return null;
        }
        recalculate(entity);
#foreach ($property in $properties)
#if($property.isCalculatedProperty && !$property.calculatedActionOnUpdate && $property.calculatedPropertyExpressionUpdate)
#if($foreach.first)
        // The header's expression-calculated fields follow the totals they derive from (e.g.
        // balance = total - paid): an items change moves the totals, so the derived expressions are
        // refreshed here and persisted in the same targeted write - otherwise they stay stale (or
        // null, printing an empty amount) until the next explicit header save. Calculated ACTIONS
        // are deliberately NOT run here: a server call-out may mint or mutate state and belongs to
        // the explicit save/update paths only.
#end
#calcAssign($property $property.calculatedPropertyExpressionUpdate)
#end
#end
        java.util.Map<String, Object> totals = new java.util.LinkedHashMap<>();
#foreach($f in $documentMaster.fields)
        totals.put("${f.field}", entity.${f.field});
#end
#foreach ($property in $properties)
#if($property.isCalculatedProperty && !$property.calculatedActionOnUpdate && $property.calculatedPropertyExpressionUpdate)
        totals.put("${property.name}", entity.${property.name});
#end
#end
#if($history == "true")
        // Recalculation deliberately goes to the BASE targeted write (it has already computed the row,
        // so it must not re-run the gate), which means the history has to be recorded here rather than
        // in the override - a document whose totals move with every line must show that in its trail.
        ${name}Entity historyBefore = super.findById(id);
#end
        super.updateProperties(id, totals);
#if($history == "true")
        History.recordUpdate(HISTORY_TABLE, id, History.SYSTEM, historyBefore, super.findById(id), HISTORY_PROPERTIES);
#end
        return entity;
    }
#end

#if($hasLabel)
    /**
     * Recompute the stored display name (intent label expression: ${labelExpression}). One-hop
     * relation tokens load the referenced record; a missing reference renders empty. Runs on every
     * write path, so the name follows its inputs (staleness is bounded by the referenced record's
     * own next write - labels compose by referencing the related entity's generated Name).
     */
    private void computeName(${name}Entity entity) {
        StringBuilder label = new StringBuilder();
#foreach($part in $labelParts)
#if($part.kind == "literal")
        label.append("${part.text}");
#elseif($part.kind == "field")
        label.append(formatLabelValue(entity.${part.property}, #if($part.format)"${part.format}"#{else}null#end));
#else
        {
            var related = entity.${part.relation} == null ? null
                    : new ${part.repositoryClass}().findOne(entity.${part.relation})
                                                   .orElse(null);
            label.append(formatLabelValue(related == null ? null : related.${part.property},
                    #if($part.format)"${part.format}"#{else}null#end));
        }
#end
#end
        String value = label.toString()
                            .trim();
        entity.Name = value.length() > 512 ? value.substring(0, 512) : value;
    }

    private static String formatLabelValue(Object value, String pattern) {
        if (value == null) {
            return "";
        }
        if (pattern != null && value instanceof TemporalAccessor temporal) {
            return DateTimeFormatter.ofPattern(pattern, Locale.ENGLISH)
                                    .format(temporal);
        }
        // A month field stores the picker's YYYY-MM string - parse it back to a temporal so a
        // |format token renders "2026 July" instead of the raw string. Fail-soft: a value that is
        // not a real month, or a pattern demanding fields a month lacks (dd), keeps the raw string.
        if (pattern != null && value instanceof String string && string.matches("\\d{4}-\\d{2}")) {
            try {
                return DateTimeFormatter.ofPattern(pattern, Locale.ENGLISH)
                                        .format(java.time.YearMonth.parse(string));
            } catch (RuntimeException e) {
                return string;
            }
        }
        return String.valueOf(value);
    }
#end
}
