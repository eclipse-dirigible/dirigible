package gen.${javaGenFolderName}.data.${javaPerspectiveName};

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Set;

import org.eclipse.dirigible.sdk.db.Database;
#if($query && $query.contains(":language"))
import org.eclipse.dirigible.sdk.security.User;
#end
import org.eclipse.dirigible.sdk.utils.Json;
import org.eclipse.dirigible.sdk.utils.LenientJavaTime;

/**
 * Generated repository for the ${name} report. Executes the report query against the configured data
 * source and returns the rows as generic maps keyed by the result-set column aliases.
 *
 * Besides the report's own declared parameters, a request may carry per-column {@code conditions}
 * ({@code [{column, operator, value}]}) applied OVER the report's output: the query is wrapped as
 * {@code SELECT * FROM (QUERY) AS "REPORT_DATA" WHERE "<alias>" <op> :reportFilter<i>}. Columns are
 * validated against the report's column aliases and typed from the report metadata, operators
 * against a fixed whitelist - so the filter surface is exactly the visible table.
 *
 * {@code :language} is the one RESERVED named parameter: a query that reads a multilingual entity's
 * translated columns joins its language table on it, and this repository binds it from the caller's
 * Accept-Language - the same overlay the entity repositories apply. It is bound whenever the query
 * uses it (so a hand-authored report can reach it too) and BEFORE the report's own parameters, so an
 * explicitly declared {@code language} parameter still wins.
 *
 * Do not modify the content as it may be re-generated again.
 */
public class ${name}Repository {

    /** The report query, joined from per-line literals - never one long single-line literal (#6936). */
    private static final String QUERY = String.join("\n"#foreach($line in $queryJavaLines),
            ${line}#end);

    /** The report's output columns (result-set alias -> SQL type) - the filterable surface. */
    private static final Map<String, String> FILTER_COLUMNS = Map.ofEntries(
#foreach($column in $columns)
            Map.entry("${column.alias}", "${column.type}")#if($foreach.hasNext),#end
#end
    );

    private static final Map<String, String> OPERATORS =
            Map.of("EQ", "=", "NE", "<>", "GT", ">", "GTE", ">=", "LT", "<", "LTE", "<=", "LIKE", "LIKE");

    /**
     * A case-insensitive substring of a column - what the report page's text filter ("contains") sends:
     * a plain LIKE is case-sensitive on PostgreSQL, so "acme" missed "Acme Corporation" (#8431).
     */
    private static final String CONTAINS = "CONTAINS";

    /** The column types {@link #sum(String, Map)} accepts - anything else has no meaningful total. */
    private static final Set<String> NUMERIC_COLUMN_TYPES =
            Set.of("TINYINT", "SMALLINT", "INT", "INTEGER", "BIGINT", "DECIMAL", "NUMERIC", "DOUBLE",
                    "DOUBLE PRECISION", "FLOAT", "REAL");

    /** The other column types a pattern (LIKE, CONTAINS) does not apply to - see {@link #textual(String)}. */
    private static final Set<String> TEMPORAL_AND_BOOLEAN_COLUMN_TYPES = Set.of("DATE", "TIME", "TIMESTAMP", "BOOLEAN");

    /** A timestamp as the named-parameter binder reads it. */
    private static final DateTimeFormatter TIMESTAMP_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS");

    @SuppressWarnings("unchecked")
    public List<Map<String, Object>> findAll(Integer limit, Integer offset, Map<String, Object> filter) {
        List<Map<String, Object>> parameters = baseParameters(filter);
        StringBuilder sql = new StringBuilder(filteredQuery(filter, parameters));
        // A negative page bound is ignored, as the entity controllers ignore it - in the SQL it failed
        // the whole report (#7828).
        if (limit != null && limit.intValue() >= 0) {
            sql.append(" LIMIT ").append(limit.intValue());
        }
        if (offset != null && offset.intValue() >= 0) {
            sql.append(" OFFSET ").append(offset.intValue());
        }
        try {
            String result = Database.queryNamed(sql.toString(), Json.stringify(parameters));
            return (List<Map<String, Object>>) Json.parse(result, List.class);
        } catch (Throwable t) {
            throw new RuntimeException("Failed to execute report ${name}", t);
        }
    }

    @SuppressWarnings("unchecked")
    public long count(Map<String, Object> filter) {
        List<Map<String, Object>> parameters = baseParameters(filter);
        String sql = "SELECT COUNT(*) AS \"REPORT_COUNT\" FROM (" + filteredQuery(filter, parameters) + ") AS \"REPORT_TOTAL\"";
        try {
            String result = Database.queryNamed(sql, Json.stringify(parameters));
            List<Map<String, Object>> rows = (List<Map<String, Object>>) Json.parse(result, List.class);
            if (rows.isEmpty()) {
                return 0L;
            }
            Object count = rows.get(0).get("REPORT_COUNT");
            if (count instanceof Number number) {
                return number.longValue();
            }
            return count == null ? 0L : Long.parseLong(count.toString());
        } catch (Throwable t) {
            throw new RuntimeException("Failed to count report ${name}", t);
        }
    }

    /**
     * The SUM of one of the report's own numeric output columns over the (optionally filtered) rows -
     * one aggregated number in one round trip. A dashboard count tile over an AGGREGATING report reads
     * its record count this way: the rows are groups, so the count is the {@code count(*)} measure
     * summed, and computing that in the browser meant fetching every group row of the report per tile
     * per dashboard load (#7161).
     *
     * The column is matched against the report's own aliases (the same allowlist the conditions use)
     * and must be numeric; anything else is an {@link IllegalArgumentException}, i.e. a client error.
     * Never {@code null}: a report yielding no rows sums to zero.
     */
    @SuppressWarnings("unchecked")
    public Number sum(String column, Map<String, Object> filter) {
        String type = column == null ? null : FILTER_COLUMNS.get(column);
        if (type == null) {
            throw new IllegalArgumentException("Unknown report column: " + column);
        }
        if (!NUMERIC_COLUMN_TYPES.contains(type.toUpperCase(Locale.ROOT))) {
            throw new IllegalArgumentException("Report column is not numeric: " + column + " [" + type + "]");
        }
        List<Map<String, Object>> parameters = baseParameters(filter);
        String sql = "SELECT SUM(\"" + column + "\") AS \"REPORT_SUM\" FROM (" + filteredQuery(filter, parameters)
                + ") AS \"REPORT_TOTAL\"";
        try {
            String result = Database.queryNamed(sql, Json.stringify(parameters));
            List<Map<String, Object>> rows = (List<Map<String, Object>>) Json.parse(result, List.class);
            if (rows.isEmpty()) {
                return 0L;
            }
            Object sum = rows.get(0)
                             .get("REPORT_SUM");
            if (sum instanceof Number number) {
                return number;
            }
            return sum == null ? 0L : new BigDecimal(sum.toString());
        } catch (Throwable t) {
            throw new RuntimeException("Failed to sum column " + column + " of report ${name}", t);
        }
    }

    public List<Map<String, Object>> exportCsv(Map<String, Object> filter) {
        return findAll(null, null, filter);
    }

    /**
     * Reads the request's declared parameters as their types without running the report, refusing an
     * unreadable one with an {@link IllegalArgumentException} - what an export over this report calls
     * before it records a run, so a refused request leaves no FAILED filing behind (#8098).
     */
    public static void checkParameters(Map<String, Object> filter) {
        baseParameters(filter);
    }

    /**
     * The report query, wrapped with the request's per-column conditions when present. Each condition
     * binds a named parameter typed from the column's report metadata.
     */
    private static String filteredQuery(Map<String, Object> filter, List<Map<String, Object>> parameters) {
        List<Map<String, Object>> conditions = conditionsOf(filter);
        if (conditions.isEmpty()) {
            return QUERY;
        }
        StringBuilder sql = new StringBuilder("SELECT * FROM (").append(QUERY).append(") AS \"REPORT_DATA\" WHERE ");
        for (int i = 0; i < conditions.size(); i++) {
            Map<String, Object> condition = conditions.get(i);
            String column = stringValue(condition.get("column"));
            String type = FILTER_COLUMNS.get(column);
            if (type == null) {
                throw new IllegalArgumentException("Unknown report filter column: " + column);
            }
            String requested = stringValue(condition.get("operator"));
            if (i > 0) {
                sql.append(" AND ");
            }
            String marker = "reportFilter" + i;
            if ((CONTAINS.equals(requested) || "LIKE".equals(requested)) && !textual(type)) {
                throw new IllegalArgumentException(
                        "Report filter operator " + requested + " does not apply to column [" + column + "] of type " + type);
            }
            if (CONTAINS.equals(requested)) {
                sql.append("LOWER(\"").append(column).append("\") LIKE :").append(marker).append(" ESCAPE '!'");
                parameters.add(parameter(marker, "VARCHAR", containsPattern(condition.get("value"))));
                continue;
            }
            String operator = OPERATORS.get(requested);
            if (operator == null) {
                throw new IllegalArgumentException("Unknown report filter operator: " + condition.get("operator"));
            }
            sql.append("\"").append(column).append("\" ").append(operator).append(" :").append(marker);
            Object value = condition.get("value");
            parameters.add(parameter(marker, parameterType(type),
                    value == null ? null : typed(type, value, "Report filter value of column [" + column + "]")));
        }
        return sql.toString();
    }

    @SuppressWarnings("unchecked")
    private static List<Map<String, Object>> conditionsOf(Map<String, Object> filter) {
        Object conditions = filter == null ? null : filter.get("conditions");
        if (conditions instanceof List<?> list) {
            List<Map<String, Object>> result = new ArrayList<>();
            for (Object item : list) {
                if (item instanceof Map<?, ?> map) {
                    result.add((Map<String, Object>) map);
                }
            }
            return result;
        }
        return List.of();
    }

    /**
     * The LIKE pattern of a CONTAINS condition: the value lower-cased, its wildcards escaped with
     * {@code !}, between two {@code %} - so a typed {@code %} or {@code _} matches itself.
     */
    private static String containsPattern(Object value) {
        String text = value == null ? "" : value.toString()
                                                .toLowerCase(Locale.ROOT);
        return "%" + text.replace("!", "!!")
                         .replace("%", "!%")
                         .replace("_", "!_")
                + "%";
    }

    /** The named-parameter type for a report column type. */
    private static String parameterType(String columnType) {
        return "CHARACTER VARYING".equalsIgnoreCase(columnType) ? "VARCHAR" : columnType;
    }

    /** Whether a pattern (LIKE, CONTAINS) applies to a column of the type - it matches characters (#8177). */
    private static boolean textual(String columnType) {
        String type = columnType.toUpperCase(Locale.ROOT);
        return !NUMERIC_COLUMN_TYPES.contains(type) && !TEMPORAL_AND_BOOLEAN_COLUMN_TYPES.contains(type);
    }

    /**
     * A request's value read as the SQL type it is bound with, so a value that is not one is refused
     * here, naming it, rather than failing the query inside the binder as a 500 (#7828, #8098, #8177):
     * a number exactly (an integer outside its type is refused, never wrapped), a date or timestamp in
     * the near-ISO shapes the generated REST layer accepts. Text, and any other type, binds as given.
     *
     * @param subject what the value is, for the refusal
     * @throws IllegalArgumentException when the value does not read as the type
     */
    private static Object typed(String type, Object value, String subject) {
        Object converted = converted(type.toUpperCase(Locale.ROOT), String.valueOf(value).trim(), value);
        if (converted == null) {
            throw new IllegalArgumentException(subject + " is not a valid " + type + ": " + value);
        }
        return converted;
    }

    /** The value converted to its type, or null when the text does not read as one. */
    private static Object converted(String type, String text, Object value) {
        try {
            return switch (type) {
                case "TINYINT" -> new BigDecimal(text).byteValueExact();
                case "SMALLINT" -> new BigDecimal(text).shortValueExact();
                case "INT", "INTEGER" -> new BigDecimal(text).intValueExact();
                case "BIGINT" -> new BigDecimal(text).longValueExact();
                case "DECIMAL", "NUMERIC", "DOUBLE", "DOUBLE PRECISION", "FLOAT", "REAL" -> new BigDecimal(text);
                case "DATE" -> {
                    LocalDate date = LenientJavaTime.parseLocalDate(text);
                    yield date == null ? null : date.toString();
                }
                case "TIMESTAMP" -> {
                    LocalDateTime timestamp = LenientJavaTime.parseLocalDateTime(text);
                    yield timestamp == null ? null : timestamp.format(TIMESTAMP_FORMAT);
                }
                default -> value;
            };
        } catch (NumberFormatException | ArithmeticException notANumberOfTheType) {
            // Not a number, or not one the type holds: refused by the caller, as an unreadable date is.
            return null;
        }
    }

    private static String stringValue(Object value) {
        return value == null ? null : value.toString();
    }

    private static List<Map<String, Object>> baseParameters(Map<String, Object> filter) {
        List<Map<String, Object>> parameters = new ArrayList<>();
#if($query && $query.contains(":language"))
        parameters.add(parameter("language", "VARCHAR", language()));
#end
#foreach($parameter in $parameters)
#if($parameter.type == "DATE" && $parameter.initial == "CURRENT_DATE")
        // initial: CURRENT_DATE - the day the report is run, resolved per request.
        parameters.add(parameter("${parameter.name}", "${parameter.type}", value(filter, "${parameter.name}", "${parameter.type}", java.time.LocalDate.now().toString())));
#else
        parameters.add(parameter("${parameter.name}", "${parameter.type}", value(filter, "${parameter.name}", "${parameter.type}", "${parameter.initialJavaLiteral}")));
#end
#end
        return parameters;
    }

#if($query && $query.contains(":language"))
    /**
     * The caller's language for the translation overlay: the primary subtag of the Accept-Language
     * request header, lower-cased (en-US -> en), which is the code the &lt;TABLE&gt;_LANG rows carry and
     * what the entity repositories translate by. Blank outside a request scope - the query's LEFT JOINs
     * then match no translation row and every overlaid column reads its base value.
     */
    private static String language() {
        String language = User.getLanguage();
        if (language == null || language.isBlank()) {
            return "";
        }
        return language.trim()
                       .split("[-_,;]")[0]
                       .toLowerCase(Locale.ROOT);
    }

#end
    private static Map<String, Object> parameter(String name, String type, Object value) {
        Map<String, Object> parameter = new LinkedHashMap<>();
        parameter.put("name", name);
        parameter.put("type", type);
        parameter.put("value", value);
        return parameter;
    }

    /** A declared parameter's value: the caller's, read as the parameter's type - else its initial. */
    private static Object value(Map<String, Object> filter, String name, String type, Object initial) {
        if (filter != null && filter.get(name) != null) {
            return typed(type, filter.get(name), "Report parameter [" + name + "]");
        }
        return initial;
    }
}
