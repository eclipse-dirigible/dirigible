package gen.${javaGenFolderName}.api.${javaPerspectiveName};

import gen.${javaGenFolderName}.data.${javaPerspectiveName}.${name}Entity;
import gen.${javaGenFolderName}.data.${javaPerspectiveName}.${name}Repository;

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
import org.eclipse.dirigible.sdk.platform.Documentation;
import org.eclipse.dirigible.sdk.http.Body;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.http.Controller;
import org.eclipse.dirigible.sdk.http.Delete;
import org.eclipse.dirigible.sdk.http.Get;
import org.eclipse.dirigible.sdk.http.PathParam;
import org.eclipse.dirigible.sdk.http.Post;
import org.eclipse.dirigible.sdk.http.Put;
import org.eclipse.dirigible.sdk.http.QueryParam;
import org.eclipse.dirigible.sdk.security.User;
import org.springframework.http.HttpStatus;
import org.springframework.web.server.ResponseStatusException;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

## Role-scoped properties (the modeler's per-property read/write role, or the intent's `visibleTo:`
## allow-list): stripped from this surface's responses and ignored on its writes for a caller outside
## the roles - owning the record is not the same as being allowed to see every column of it.
#foreach($property in $properties)
#if($property.roleRead)
#set($hasRestrictedReads = "true")
#end
#if($property.roleRead || $property.roleWrite)
#set($hasRoleScopedProperties = "true")
#end
#end
## A see-only personal surface refuses every write with 403 already, so the inherited lock would
## only add an unreachable guard and an unused repository: drop it for that variant.
#if($personalReadOnly)
#set($masterLock = false)
#end
#if($masterLock)
#if($personalParent)
#set($masterRepositoryRef = "parentRepository")
#else
#set($masterRepositoryRef = "masterRepository")
#end
#end
/**
 * The PERSONAL (my) surface of ${name}: every read is scoped to the logged-in user's identity
 * record and every write is forced onto it - the client can neither see nor touch anybody else's
 * rows, and sensitive fields are stripped from responses and ignored on writes. The power surface
 * (${name}Controller) is unaffected.
 *
 * Generated from the intent identity/personal/sensitive attributes - do not edit; it is
 * re-generated with the application.
 */
@Controller
@Component("${javaGenFolderName}_${name}MyController")
@Documentation("${projectName} - ${name} personal (my) controller")
public class ${name}MyController {

    private final ${name}Repository repository;
    private final ${personalIdentityRepositoryClass} identityRepository;
#if($personalParent)
    private final ${personalParent.repositoryClass} parentRepository;
#end
#if($masterLock && !$personalParent)
    private final ${masterLock.repositoryClass} masterRepository;
#end

    public ${name}MyController(${name}Repository repository, ${personalIdentityRepositoryClass} identityRepository#if($personalParent),
            ${personalParent.repositoryClass} parentRepository#end#if($masterLock && !$personalParent),
            ${masterLock.repositoryClass} masterRepository#end) {
        this.repository = repository;
        this.identityRepository = identityRepository;
#if($personalParent)
        this.parentRepository = parentRepository;
#end
#if($masterLock && !$personalParent)
        this.masterRepository = masterRepository;
#end
    }

#if($personalParent)
    @Get
    @Documentation("List my ${name} of one ${personalParent.entity}")
    public List<${name}Entity> getAll(@QueryParam("${personalParent.fkProperty}") String ${personalParent.fkProperty}) {
        if (${personalParent.fkProperty} == null || me() == null) {
            return List.of();
        }
        requireMyParent(${personalParent.fkProperty});
        Map<String, Object> params = new LinkedHashMap<>();
        params.put("parent", ${personalParent.fkProperty});
        List<${name}Entity> result = repository.query("from ${javaGenFolderName}_${name}Entity e where e.${personalParent.fkProperty} = :parent", params);
        result.forEach(this::scrub);
        return result;
    }
#else
    @Get
    @Documentation("List my ${name}")
    public List<${name}Entity> getAll() {
        ${personalFkJavaClass} me = me();
        if (me == null) {
            return List.of();
        }
        List<${name}Entity> result = repository.findAll(Criteria.create().eq("${personalProperty}", me));
        result.forEach(this::scrub);
        return result;
    }

    @Get("/count")
    @Documentation("Count my ${name}")
    public Map<String, Long> count() {
        ${personalFkJavaClass} me = me();
        return Map.of("count", me == null ? 0L : (long) repository.findAll(Criteria.create().eq("${personalProperty}", me)).size());
    }
#end

    @Get("/{id}")
    @Documentation("Get my ${name} by id")
    public ${name}Entity getById(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
        return scrub(requireMine(id));
    }
#if($immutableAlways || $immutableStatusProperty)

    @Get("/{id}/mutable")
    @Documentation("Whether my ${name} {id} currently accepts edits/deletes - the immutability pre-check the generated UI gates its Edit affordances on (the PUT/DELETE 409 stays authoritative)")
    public Map<String, Boolean> mutable(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
        return Map.of("mutable", isMutable(requireMine(id)));
    }
#end

#if($personalReadOnly)
    // See-only personal surface (intent personalReadOnly): the owner may read their own records but
    // never author them - the write endpoints exist only to refuse with 403 (the power controller
    // remains the sole write path). Fixes the self-grant risk on owner-owned reference records.
    @Post
    @Documentation("Not allowed - this ${name} is read-only on the personal surface")
    public ${name}Entity create(@Body ${name}Entity entity) {
        throw new ResponseStatusException(HttpStatus.FORBIDDEN, "This ${name} is read-only on your personal surface");
    }

    @Put("/{id}")
    @Documentation("Not allowed - this ${name} is read-only on the personal surface")
    public ${name}Entity update(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id, @Body ${name}Entity entity) {
        throw new ResponseStatusException(HttpStatus.FORBIDDEN, "This ${name} is read-only on your personal surface");
    }

    @Delete("/{id}")
    @Documentation("Not allowed - this ${name} is read-only on the personal surface")
    public void deleteById(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
        throw new ResponseStatusException(HttpStatus.FORBIDDEN, "This ${name} is read-only on your personal surface");
    }
#else
    @Post
    @Documentation("Create a ${name} of mine")
    public ${name}Entity create(@Body ${name}Entity entity) {
#if($personalParent)
        if (entity.${personalParent.fkProperty} == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "${personalParent.fkProperty} is required");
        }
        requireMyParent(String.valueOf(entity.${personalParent.fkProperty}));
#else
        ${personalFkJavaClass} me = me();
        if (me == null) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN, "No identity record is mapped to the current user");
        }
        // The owner is the server's decision - whatever the client sent is overwritten.
        entity.${personalProperty} = me;
#end
#if($masterLock)
        requireMasterMutable(entity.${masterLock.fkProperty});
#end
#if($periodLock)
        // Nothing new may be filed into a closed period either - that is what closing one means.
        requirePeriodOpen(entity.${periodLock.dateProperty});
#end
#foreach($sensitive in $sensitiveProperties)
        entity.${sensitive} = null;
#end
#foreach($property in $properties)
#if($property.roleWrite)
        // Role-scoped field: not writable by a caller outside its roles, here as on the power surface.
        if (!isInAnyRole("${property.roleWrite}")) {
            entity.${property.name} = null;
        }
#end
#end
        return scrub(repository.save(entity));
    }

    @Put("/{id}")
    @Documentation("Update my ${name} by id")
    public ${name}Entity update(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id, @Body ${name}Entity entity) {
        ${name}Entity existing = requireMine(id);
#if($immutableAlways || $immutableStatusProperty || $periodLock)
        requireMutable(existing);
#end
#if($masterLock)
        requireMasterMutable(existing.${masterLock.fkProperty});
#end
#if($periodLock)
        // The stored date is checked above; this refuses a move INTO a closed period.
        requirePeriodOpen(entity.${periodLock.dateProperty});
#end
        entity.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end = id;
#if($personalParent)
        // Re-parenting is not a personal-surface operation - the parent stays what it was.
        entity.${personalParent.fkProperty} = existing.${personalParent.fkProperty};
#else
        entity.${personalProperty} = existing.${personalProperty};
#end
#foreach($sensitive in $sensitiveProperties)
        // Sensitive fields are not writable here - the stored value is kept.
        entity.${sensitive} = existing.${sensitive};
#end
#foreach($property in $properties)
#if($property.roleWrite)
        // Role-scoped field: a caller outside its roles keeps the stored value.
        if (!isInAnyRole("${property.roleWrite}")) {
            entity.${property.name} = existing.${property.name};
        }
#end
#end
        return scrub(repository.update(entity));
    }

    @Delete("/{id}")
    @Documentation("Delete my ${name} by id")
    public void deleteById(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
        ${name}Entity existing = requireMine(id);
#if($immutableAlways || $immutableStatusProperty || $periodLock)
        requireMutable(existing);
#end
#if($masterLock)
        requireMasterMutable(existing.${masterLock.fkProperty});
#end
        try {
            repository.deleteById(id);
        } catch (RuntimeException e) {
            if (isConstraintViolation(e)) {
                throw new ResponseStatusException(HttpStatus.CONFLICT,
                        "This ${name} is referenced by other records and cannot be deleted");
            }
            throw e;
        }
    }
#end

    /**
     * The current user's identity record id: the ${personalIdentityProperty} of the identity entity
     * matched against the EFFECTIVE username - the acting identity when an entitled user armed
     * "act as" (delegated entry), else the real login. Null when no record maps (the personal
     * surface is then empty, never an error). Audit stamping stays on the real login.
     */
    private #if($personalParent)${personalParent.personalFkJavaClass}#else${personalFkJavaClass}#end me() {
        String username = User.getEffectiveName();
        if (username == null || username.isBlank()) {
            return null;
        }
        var matches = identityRepository.findAll(Criteria.create().eq("${personalIdentityProperty}", username));
        return matches.isEmpty() ? null : matches.get(0).Id;
    }

    /**
     * The EFFECTIVE user's own display name (the identity record's ${personalIdentityLabel}), for
     * the personal pages' "New/Edit ... for &lt;owner&gt;" title - under "act as" this is the
     * acting identity's name, which is exactly what the pages must show. Falls back to the
     * username when no identity record maps. Exposes only the display name - never the whole
     * identity record.
     */
    @Get("/me")
    @Documentation("The effective user's own display name")
    public Map<String, Object> currentIdentity() {
        Map<String, Object> result = new LinkedHashMap<>();
        String username = User.getEffectiveName();
        result.put("name", username);
        if (username != null && !username.isBlank()) {
            var matches = identityRepository.findAll(Criteria.create().eq("${personalIdentityProperty}", username));
            if (!matches.isEmpty() && matches.get(0).${personalIdentityLabel} != null) {
                result.put("name", String.valueOf(matches.get(0).${personalIdentityLabel}));
            }
        }
        return result;
    }

    /** Load the record and prove it is mine - a foreign or missing record is the same 404. */
    private ${name}Entity requireMine(Object id) {
        var me = me();
        ${name}Entity entity = me == null ? null
                : repository.findOne(id)
                            .orElse(null);
#if($personalParent)
        if (entity != null && entity.${personalParent.fkProperty} != null) {
            var parent = parentRepository.findOne(entity.${personalParent.fkProperty})
                                         .orElse(null);
            if (parent != null && me.equals(parent.${personalParent.personalProperty})) {
                return entity;
            }
        }
#else
        if (entity != null && me.equals(entity.${personalProperty})) {
            return entity;
        }
#end
        throw new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found");
    }
#if($personalParent)

    /** Prove the ${personalParent.entity} the operation targets is mine - else the same 404. */
    private void requireMyParent(String parentId) {
        var me = me();
        var parent = me == null ? null
                : parentRepository.findOne(${personalParent.fkJavaClass}.valueOf(parentId))
                                  .orElse(null);
        if (parent == null || !me.equals(parent.${personalParent.personalProperty})) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "${personalParent.entity} not found");
        }
    }
#end
#if($masterLock)

    // Inherited immutability: this ${name} is a line of a ${masterLock.entity}, and its writes
    // recompute that document's totals - so while the document is locked its lines are locked with
    // it. Declare `locksWithMaster: false` on the child to keep a collection writable past the
    // master's lock. Workflow / system writes through the repository stay unaffected.
    private void requireMasterMutable(${masterLock.fkJavaClass} masterId) {
        if (masterId == null) {
            return;
        }
        ${masterLock.entityClass} master = ${masterRepositoryRef}.findOne(masterId).orElse(null);
        if (master == null) {
            return;
        }
#if($masterLock.statusLock)
        if (!isMasterMutable(master)) {
#if($masterLock.always)
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "This ${name} belongs to an append-only ${masterLock.entity} and can no longer be changed");
#else
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "The ${masterLock.entity} of this ${name} is immutable in its current status - corrections go through the workflow");
#end
        }
#end
#if($masterLock.period)
        if (!isMasterPeriodOpen(master.${masterLock.period.dateProperty})) {
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "The ${masterLock.period.entity} covering this ${masterLock.entity} is closed - book the correction in an open period");
        }
#end
    }
#if($masterLock.statusLock)

    private static boolean isMasterMutable(${masterLock.entityClass} master) {
#if($masterLock.always)
        return false;
#else
        if (master.${masterLock.statusProperty} == null) {
            return true;
        }
        for (String immutable : "${masterLock.statusValues}".split(",")) {
            if (immutable.equals(String.valueOf(master.${masterLock.statusProperty}))) {
                return false;
            }
        }
        return true;
#end
    }
#end
#if($masterLock.period)

    // The master's own period guard, read through the line: adding, editing or removing a line
    // recomputes the document's totals, so a document dated in a closed period freezes its lines with
    // it - exactly as a locked status does.
    private boolean isMasterPeriodOpen(${masterLock.period.dateJavaClass} date) {
        if (date == null) {
            return true;
        }
        for (${masterLock.period.entityClass} period : new ${masterLock.period.repositoryClass}().findAll(
                org.eclipse.dirigible.components.data.store.java.repository.Criteria.create()
                                                                                   .le("${masterLock.period.startProperty}", date)
                                                                                   .ge("${masterLock.period.endProperty}", date))) {
            if (period.${masterLock.period.statusProperty} != null) {
                for (String closed : "${masterLock.period.closedValues}".split(",")) {
                    if (closed.equals(String.valueOf(period.${masterLock.period.statusProperty}))) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
#end
#end
#if($immutableAlways || $immutableStatusProperty || $periodLock)

    // User-write immutability. `immutable: true` freezes a record from the moment it is created,
    // `immutableWhen:` while its status says so, `immutableInPeriod:` while the period covering its
    // date is closed - and the three compose. Workflow / system writes through the repository stay
    // unaffected, as on the power surface.
    private void requireMutable(${name}Entity existing) {
#if($immutableAlways)
        throw new ResponseStatusException(HttpStatus.CONFLICT,
                "This ${name} is append-only - records can neither be edited nor deleted");
#else
#if($immutableStatusProperty)
        if (!isStatusMutable(existing)) {
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "This ${name} is immutable in its current status - corrections go through the workflow");
        }
#end
#if($periodLock)
        requirePeriodOpen(existing.${periodLock.dateProperty});
#end
#end
    }
#end
#if($immutableStatusProperty && !$immutableAlways)

    private static boolean isStatusMutable(${name}Entity existing) {
        if (existing.${immutableStatusProperty} == null) {
            return true;
        }
        for (String immutable : "${immutableStatusValues}".split(",")) {
            if (immutable.equals(String.valueOf(existing.${immutableStatusProperty}))) {
                return false;
            }
        }
        return true;
    }
#end
#if($periodLock)

    // Date-based immutability (intent `immutableInPeriod:`): once the ${periodLock.entity} covering a
    // record's ${periodLock.dateProperty} is closed, that record can no longer be created, edited or
    // deleted through this REST surface, whatever status it carries.
    private void requirePeriodOpen(${periodLock.dateJavaClass} date) {
        if (isPeriodOpen(date)) {
            return;
        }
        throw new ResponseStatusException(HttpStatus.CONFLICT,
                "The ${periodLock.entity} covering this date is closed - book the correction in an open period");
    }

    // A date covered by no period at all is open: periods are declared as they are needed, and an
    // unopened future month must not freeze the present. A record carrying no date falls in none.
    private boolean isPeriodOpen(${periodLock.dateJavaClass} date) {
        if (date == null) {
            return true;
        }
        for (${periodLock.entityClass} period : new ${periodLock.repositoryClass}().findAll(
                org.eclipse.dirigible.components.data.store.java.repository.Criteria.create()
                                                                                   .le("${periodLock.startProperty}", date)
                                                                                   .ge("${periodLock.endProperty}", date))) {
            if (period.${periodLock.statusProperty} != null) {
                for (String closed : "${periodLock.closedValues}".split(",")) {
                    if (closed.equals(String.valueOf(period.${periodLock.statusProperty}))) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
#end

    /**
     * Strip from a response what this caller may not see: the sensitive fields (absent from the
     * personal surface for everyone) and the role-scoped ones (absent unless the caller holds one of
     * their roles - being the owner of the record does not grant them).
     */
    private ${name}Entity scrub(${name}Entity entity) {
#foreach($sensitive in $sensitiveProperties)
        entity.${sensitive} = null;
#end
#foreach($property in $properties)
#if($property.roleRead)
        if (!isInAnyRole("${property.roleRead}")) {
            entity.${property.name} = null;
        }
#end
#end
        return entity;
    }
#if($hasRestrictedReads)

    @Get("/restricted")
    @Documentation("The ${name} properties withheld from the CURRENT caller (role-scoped fields) - what the generated pages leave out instead of rendering a permanently empty column; the redaction applied to every response stays authoritative")
    public Map<String, List<String>> restricted() {
        List<String> restricted = new java.util.ArrayList<>();
#foreach($property in $properties)
#if($property.roleRead)
        if (!isInAnyRole("${property.roleRead}")) {
            restricted.add("${property.name}");
        }
#end
#end
        return Map.of("restricted", restricted);
    }
#end
#if($hasRoleScopedProperties)

    /**
     * Whether the caller holds ANY of a comma-separated role list. One role name is what the entity
     * modeler's per-property read/write role carries; the intent's `visibleTo: [A, B]` allow-list
     * arrives here as "A,B" and holding either of them is enough.
     */
    private static boolean isInAnyRole(String roles) {
        for (String role : roles.split(",")) {
            String name = role.trim();
            if (!name.isEmpty() && User.isInRole(name)) {
                return true;
            }
        }
        return false;
    }
#end

    /** Whether a persistence failure is (caused by) a database constraint violation. */
    private static boolean isConstraintViolation(Throwable e) {
        for (Throwable cause = e; cause != null; cause = cause.getCause() == cause ? null : cause.getCause()) {
            String type = cause.getClass().getName();
            if (type.contains("ConstraintViolation") || type.contains("DataIntegrityViolation")) {
                return true;
            }
        }
        return false;
    }
}
