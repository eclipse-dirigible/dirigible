    @Get
    @Documentation("List ${name}")
    public List<${name}Entity> getAll(@QueryParam("$limit") Integer limit,
                                      @QueryParam("$offset") Integer offset#if($layoutType == "MANAGE_DETAILS" || $layoutType == "LIST_DETAILS"),
                                      @QueryParam("${masterEntityId}") ${masterEntityIdJavaClass} ${masterEntityId}#end#if($ownerProperty),
                                      @QueryParam("mine") boolean mine#end) {
#if($needsRoles)
        checkPermissions("read");
#end
        int actualLimit = limit != null ? limit.intValue() : 20;
        int actualOffset = offset != null ? offset.intValue() : 0;
#if($ownerProperty)
        if (mine) {
            // The caller's own rows only (intent `owner: true`, #8499): the search with no condition of
            // its own, so the page, the order and the redaction are the search's.
            Map<String, Object> filter = new LinkedHashMap<>();
#if($layoutType == "MANAGE_DETAILS" || $layoutType == "LIST_DETAILS")
            if (${masterEntityId} != null) {
                filter.put("equals", Map.of("${masterEntityId}", ${masterEntityId}));
            }
            // a master's lines are listed whole unless a page is asked for, as below
            filter.put("$limit", limit == null && ${masterEntityId} != null ? -1 : actualLimit);
#else
            filter.put("$limit", actualLimit);
#end
            filter.put("$offset", actualOffset);
            return search(filter, true);
        }
#end
#if($layoutType == "MANAGE_DETAILS" || $layoutType == "LIST_DETAILS")
        List<${name}Entity> result;
        if (${masterEntityId} != null) {
            Map<String, Object> params = new LinkedHashMap<>();
            params.put("${masterEntityId}", ${masterEntityId});
            // A master's lines honour the page they are asked for (dirigible #7982): api.getAll walks
            // $limit/$offset, and a page that ignored them came back full forever on a master with 1000+
            // lines. Without $limit the master's lines are listed whole, as before.
            result = repository.query("from ${javaGenFolderName}_${name}Entity e where e.${masterEntityId} = :${masterEntityId}#if($orderByHql) order by ${orderByHql}#else order by e.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end#end", params,
                    limit != null ? limit.intValue() : -1, actualOffset);
        } else {
            result = repository.findAll(actualLimit, actualOffset#if($orderByHql), "${orderByHql}"#end);
        }
#else
        List<${name}Entity> result = repository.findAll(actualLimit, actualOffset#if($orderByHql), "${orderByHql}"#end);
#end
#if($collectionColumns)
        fillCollectionColumns(result);
#end
#if($isEntityPropertySecurityEnabled)
        result.forEach(this::redactRead);
#end
        return result;
    }

