#else
                && !(entity.${check.field}.compareTo(entity.${check.than}) ${check.op} 0)) {
#end
            throw #if($check.refusalJava)${check.refusalJava}#{else}org.eclipse.dirigible.sdk.db.CheckMessages.refusal(${check.messageArgsJava})#end;
