    private ${name}Entity updateLocked(#foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id, ${name}Entity entity) {
#end
#if($needsRoles)
        checkPermissions("write");
#end
#if($immutableStatusProperty || $immutableAlways || $periodLock)
        requireMutable(id);
#end
#if($workflowStatusProperty)
        applyWorkflowStatus(id, entity);
#end
#if($fixedAfterCreateProperties && $fixedAfterCreateProperties.size() > 0)
        applyFixedAfterCreate(id, entity);
#end
#if($fixedWhenReferencedProperties && $fixedWhenReferencedProperties.size() > 0)
        applyFixedWhenReferenced(id, repository.findOne(id).orElse(null), entity);
#end
#if($masterLock)
        // Neither an edit inside a locked ${masterLock.entity} nor a move into one.
        repository.findOne(id).ifPresent(stored -> requireMasterMutable(stored.${masterLock.fkProperty}));
        requireMasterMutable(entity.${masterLock.fkProperty});
#end
#if($periodLock)
        // The stored date is checked above; this refuses a move INTO a closed period.
        requirePeriodOpen(entity.${periodLock.dateProperty});
#end
#if($isEntityPropertySecurityEnabled)
        ${name}Entity existing = repository.findOne(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found"));
        mergeWritable(existing, entity);
        // The checks read the record as the write will store it - its calculated fields computed, not
        // taken from the payload (#7544). What is persisted is still computed by the repository.
        ${name}Entity checked = repository.calculatedForUpdate(existing);
        validate(checked);
#if($hasReferenceValidations)
        validateReferences(checked);
#end
#if($slotMessageArgs)
        // The slot picker's promise (intent `slots:`, #8097): an open day, inside the window, on the grid,
        // in a slot nobody else holds.
        repository.requireBookableSlot(checked);
#end
#if($warningChecks && $warningChecks.size() > 0)
        // The soft checks (severity: warn, #7466): asked of the person saving - a 428 listing them
        // until the request confirms their codes - and only then persisted.
        org.eclipse.dirigible.sdk.http.Warnings.requireConfirmed(repository.warnings(checked));
#end
#if($hasDuplicateKeys && !$lockedUpdate)
        try {
            return repository.update(existing);
        } catch (RuntimeException e) {
            throw repository.duplicateKeyOr(e);
        }
#else
        return repository.update(existing);
#end
#else
        entity.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end = id;
        // The checks read the record as the write will store it - its calculated fields computed, not
        // taken from the payload (#7544). What is persisted is still computed by the repository.
        ${name}Entity checked = repository.calculatedForUpdate(entity);
        validate(checked);
#if($hasReferenceValidations)
        validateReferences(checked);
#end
#if($slotMessageArgs)
        // The slot picker's promise (intent `slots:`, #8097): an open day, inside the window, on the grid,
        // in a slot nobody else holds.
        repository.requireBookableSlot(checked);
#end
#if($warningChecks && $warningChecks.size() > 0)
        // The soft checks (severity: warn, #7466): asked of the person saving - a 428 listing them
        // until the request confirms their codes - and only then persisted.
        org.eclipse.dirigible.sdk.http.Warnings.requireConfirmed(repository.warnings(checked));
#end
#if($hasDuplicateKeys && !$lockedUpdate)
        try {
            return repository.update(entity);
        } catch (RuntimeException e) {
            throw repository.duplicateKeyOr(e);
        }
#else
        return repository.update(entity);
#end
#end
    }

    @Delete("/{id}")
    @Documentation("Delete ${name} by id")
    public void deleteById(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
#if($systemWritten)
        refuseSystemWritten("deleted");
#end
#if($needsRoles)
        checkPermissions("write");
#end
        if (repository.findOne(id).isEmpty()) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found");
        }
#if($immutableStatusProperty || $immutableAlways || $periodLock)
        requireMutable(id);
#end
#if($masterLock)
        repository.findOne(id).ifPresent(stored -> requireMasterMutable(stored.${masterLock.fkProperty}));
#end
#if($processDeleteGuards)
        repository.findOne(id).ifPresent(this::requireNoRunningProcess);
#end
#if($deleteChecks && $deleteChecks.size() > 0)
        // A `checks: forbidWhen` refuses the REMOVAL of a row it guards too, not only its create and its
        // update - the delete is the third affordance the master-detail panel hides (#7372).
        repository.findOne(id).ifPresent(stored -> requireDeletable(stored));
#end
#if($hasRequiredSingleFlags)
        // The holder of a `single: { required: true }` flag goes only once another row holds it (#8700).
        repository.findOne(id).ifPresent(repository::requireSingleFlagsKept);
#end
#if($attachmentEntity)
        String storagePath = repository.findOne(id)
                                       .map(a -> a.StoragePath)
                                       .orElse(null);
#end
        try {
            repository.deleteById(id);
#if($attachmentEntity)
            if (storagePath != null) {
                org.eclipse.dirigible.sdk.cms.Attachments.delete(storagePath);
            }
#end
        } catch (RuntimeException e) {
            // A foreign-key violation means other records still reference this one - a data-integrity
            // conflict the user can act on, not a server error.
            if (isConstraintViolation(e)) {
                // Answered 409 in the reader's language (#8569), as the refusal of a counted reference is.
                throw repository.referencedByOthers();
            }
            throw e;
        }
    }

    /** Whether a persistence failure is (caused by) a database constraint violation. */
    private static boolean isConstraintViolation(Throwable e) {
        for (Throwable cause = e; cause != null; cause = cause.getCause() == cause ? null : cause.getCause()) {
            String type = cause.getClass().getName();
            if (type.contains("ConstraintViolation") || type.contains("DataIntegrityViolation")) {
                return true;
            }
        }
        return false;
    }

