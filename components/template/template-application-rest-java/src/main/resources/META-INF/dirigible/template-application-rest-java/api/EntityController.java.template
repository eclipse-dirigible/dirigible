    @Get("/{id}/download")
    @Documentation("Download the ${name} attachment file (disposition=inline opens it in the browser instead)")
    public void download(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id,
            @org.eclipse.dirigible.sdk.http.QueryParam("disposition") String disposition) {
#if($needsRoles)
        checkPermissions("read");
#end
        ${name}Entity entity = repository.findOne(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found"));
        if (entity.StoragePath == null) {
            // A row that stored no file - a FAILED export run - has nothing to serve (#8098).
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} " + id + " has no stored file");
        }
        org.eclipse.dirigible.sdk.http.Response.setContentType(entity.ContentType != null ? entity.ContentType : "application/octet-stream");
        // inline lets a stored PDF open (and print) in a browser tab; anything else stays a download
        String dispositionType = "inline".equals(disposition) ? "inline" : "attachment";
        // RFC 6266 / 5987: a header value outside ISO-8859-1 is dropped by the servlet container, so the
        // quoted filename is an ASCII fallback and filename* carries the real name, percent-encoded
        String fallbackName = entity.FileName.replaceAll("[^\\x20-\\x7E]", "_").replace("\"", "_");
        String encodedName = java.net.URLEncoder.encode(entity.FileName, java.nio.charset.StandardCharsets.UTF_8).replace("+", "%20");
        org.eclipse.dirigible.sdk.http.Response.setHeader("Content-Disposition",
                dispositionType + "; filename=\"" + fallbackName + "\"; filename*=UTF-8''" + encodedName);
        try (java.io.InputStream in = org.eclipse.dirigible.sdk.cms.Attachments.open(entity.StoragePath);
                java.io.OutputStream out = org.eclipse.dirigible.sdk.http.Response.getOutputStream()) {
            in.transferTo(out);
        } catch (java.io.IOException e) {
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to stream the attachment", e);
        }
    }
