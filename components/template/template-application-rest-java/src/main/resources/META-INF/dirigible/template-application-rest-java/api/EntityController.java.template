#end
#end
#end
## The refusals of one property's value are resolved for the reader's language (#8596): the model's
## catalog, the entity's label and its key - each as the processor derived it, else the bare names.
#set($refusalCatalog = "null")
#if($messageCatalogJava)#set($refusalCatalog = $messageCatalogJava)#end
#set($refusalEntityLabel = '"' + $name + '"')
#if($entityLabelJava)#set($refusalEntityLabel = $entityLabelJava)#end
#set($refusalEntityLabelKey = "null")
#if($labelCatalogKeyJava)#set($refusalEntityLabelKey = $labelCatalogKeyJava)#end
#foreach($property in $properties)
#set($refusalField = '"' + $property.name + '", "' + $property.name + '", null')
#if($property.refusalFieldArgsJava)#set($refusalField = $property.refusalFieldArgsJava)#end
