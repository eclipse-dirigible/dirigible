#if($share)

    // Share links (intent `share:`, #8613): a link hands the ISSUED COPY of this ${name} - the stored
    // file of its newest ${share.copyEntity} - to a reader without an account. The three endpoints
    // below are the whole authenticated surface: nothing here serves a document, and nothing mints a
    // link on its own. They are gated by the declared roles alone, and an empty list admits nobody.

    @Get("/{id}/share-links")
    @Documentation("The share links of ${name} {id}, newest first - never their tokens, which are shown once, at creation")
    public List<Map<String, Object>> shareLinks(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
        requireShareRole();
        ${name}Entity entity = repository.findOne(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found"));
        if (!${name}Repository.isShareable(entity)) {
            // The record left the state it may be shared in: its links are dead, and say so here rather
            // than on the first reader who tries one.
            org.eclipse.dirigible.sdk.share.ShareLinks.revokeAll(${name}Repository.SHARE_SUBJECT, id);
        }
        List<Map<String, Object>> links = new java.util.ArrayList<>();
        for (org.eclipse.dirigible.sdk.share.ShareLinks.Link link : org.eclipse.dirigible.sdk.share.ShareLinks.list(
                ${name}Repository.SHARE_SUBJECT, id)) {
            links.add(link.toMap());
        }
        return links;
    }

    @Post("/{id}/share-links")
    @Documentation("Create a share link to the issued copy of ${name} {id} - the answer carries the URL, which cannot be read again")
    public Map<String, Object> createShareLink(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
        requireShareRole();
        ${name}Entity entity = repository.findOne(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found"));
        if (!${name}Repository.isShareable(entity)) {
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "This ${name} cannot be shared in its current state");
        }
        if (!org.eclipse.dirigible.sdk.share.ShareLinks.enabled()) {
            throw new ResponseStatusException(HttpStatus.CONFLICT, "Sharing documents through a link is switched off");
        }
        // The newest stored copy, and only a stored one: a link never renders the live record.
        gen.${javaGenFolderName}.data.${share.javaCopyPerspective}.${share.copyEntity}Entity issued = null;
        for (gen.${javaGenFolderName}.data.${share.javaCopyPerspective}.${share.copyEntity}Entity copy : new gen.${javaGenFolderName}.data.${share.javaCopyPerspective}.${share.copyEntity}Repository().findAll(
                org.eclipse.dirigible.components.data.store.java.repository.Criteria.create().eq("${share.copyMasterFk}", id))) {
            if (copy.StoragePath != null && (issued == null || (copy.Version != null && (issued.Version == null || copy.Version > issued.Version)))) {
                issued = copy;
            }
        }
        if (issued == null) {
            throw new ResponseStatusException(HttpStatus.CONFLICT,
                    "This ${name} has no issued copy yet - a link serves the stored copy, which is minted when the document is issued");
        }
        org.eclipse.dirigible.sdk.http.Response.setStatus(201);
        return org.eclipse.dirigible.sdk.share.ShareLinks.create(${name}Repository.SHARE_SUBJECT, id, issued.StoragePath, issued.FileName,
                issued.ContentType, ${share.expiresAfterDays}).toMap();
    }

    @Delete("/{id}/share-links/{linkId}")
    @Documentation("Revoke one share link of ${name} {id} - it stops answering at once")
    public void revokeShareLink(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id, @PathParam("linkId") String linkId) {
        requireShareRole();
        if (repository.findOne(id).isEmpty()) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found");
        }
        if (!org.eclipse.dirigible.sdk.share.ShareLinks.revoke(${name}Repository.SHARE_SUBJECT, id, linkId)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "This ${name} has no such link to revoke");
        }
    }

    /** The share gate: one of the roles the intent's {@code share: roles:} lists - an empty list admits nobody. */
    private static void requireShareRole() {
        if (!isInAnyRole("${share.rolesJavaLiteral}")) {
            throw new ResponseStatusException(HttpStatus.FORBIDDEN);
        }
    }
#end
#if($history == "true")

    @Get("/{id}/history")
    @Documentation("The change history of ${name} {id} - one entry per property whose value changed, newest first")
    public List<Map<String, Object>> history(@PathParam("id") #foreach($property in $properties)#if($property.dataPrimaryKey)${property.dataTypeJavaClass}#end#end id) {
#if($needsRoles)
        checkPermissions("read");
#end
        // 404 on an unknown row rather than an empty trail, so the caller cannot read "nothing ever
        // happened" out of "no such record".
        repository.findOne(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found"));
        // Read-only by design: the shadow table has no create/update/delete verb anywhere, which is
        // what makes the trail append-only.
        List<Map<String, Object>> entries = org.eclipse.dirigible.sdk.db.History.read("${tablePrefix}${dataName}", id);
#if($hasRestrictedReads)
        // The trail records the before/after of every tracked property, so a role-scoped field would
        // hand out here exactly what the record's own response withholds. Drop those entries for a
        // caller outside the roles - the rest of the record's history stays readable.
        List<String> hidden = restrictedProperties();
        entries.removeIf(entry -> hidden.contains(String.valueOf(entry.get("Property"))));
#end
        return entries;
    }
#end

    @Post
    @Documentation("Create ${name}")
    public ${name}Entity create(@Body ${name}Entity entity) {
#if($systemWritten)
        refuseSystemWritten("created");
#end
#if($attachmentReadOnly)
        // Its rows are written by the system only - an export run, a snapshot mint - each with the file
        // it stored (#8098): a row made over REST is a record no run produced, with no file to serve.
        throw new ResponseStatusException(HttpStatus.METHOD_NOT_ALLOWED,
                "${name} records are written by the system only - they cannot be created over REST");
#else
#if($needsRoles)
        checkPermissions("write");
#end
#if($generatedKey)
        // First, before anything reads the record: the key is the database's (#8103).
        dropClientPrimaryKey(entity);
#end
#if($masterLock)
        requireMasterMutable(entity.${masterLock.fkProperty});
#end
#if($periodLock)
        // Nothing new may be filed into a closed period either - that is what closing one means.
        requirePeriodOpen(entity.${periodLock.dateProperty});
#end
#if($isEntityPropertySecurityEnabled)
        applyOnCreate(entity);
#end
#if($workflowStatusProperty)
        requireWorkflowStatusOnCreate(entity);
#end
        // The checks read the record as the write will store it - its calculated fields computed, not
        // taken from the payload (#7544). What is persisted is still computed by the repository.
        ${name}Entity checked = repository.calculatedForCreate(entity);
        validate(checked);
#if($hasReferenceValidations)
        validateReferences(checked);
#end
#if($slotMessageArgs)
        // The slot picker's promise (intent `slots:`, #8097): an open day, inside the window, on the grid,
        // in a slot nobody else holds.
        repository.requireBookableSlot(checked);
#end
#if($warningChecks && $warningChecks.size() > 0)
        // The soft checks (severity: warn, #7466): asked of the person saving - a 428 listing them
        // until the request confirms their codes - and only then persisted.
        org.eclipse.dirigible.sdk.http.Warnings.requireConfirmed(repository.warnings(checked));
#end
#if($systemOwnedOnCreate.size() > 0)
        // After every check above, so what a create refuses is unchanged; before the save, so the
        // repository never sees a caller's value for a column it does not own (#7549, #7620).
        dropSystemOwnedOnCreate(entity);
#end
#if($hasDuplicateKeys)
        ${name}Entity saved;
        try {
            saved = repository.save(entity);
        } catch (RuntimeException e) {
            throw repository.duplicateKeyOr(e);
        }
#else
        ${name}Entity saved = repository.save(entity);
#end
        return repository.findOne(saved.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end).orElse(saved);
#end
    }
#if($duplicable && !$systemWritten && !$attachmentReadOnly)
## The server-side Duplicate (intent `duplicable`, #8752): the copy the document page's duplicate() built
## from a GET and a create, made in ONE unit of work. The predicate below is the page's clone-strip list
## (document-page.js.template duplicate()) - keep the two in step.
#set($dupPkType = "")
#foreach($property in $properties)
#if($property.dataPrimaryKey)
#set($dupPkType = $property.dataTypeJavaClass)
#end
#end
#set($dupSystemNames = ["ProcessId", "ProcessIds", "CreatedAt", "CreatedBy", "UpdatedAt", "UpdatedBy", "Uuid"])
#set($dupNumbered = [])
#if($duplicateUnique && $duplicateDefaults)
#foreach($dupDefault in $duplicateDefaults)
#if("$!dupDefault.unique" == "true")
#set($ignore = $dupNumbered.add($dupDefault.name))
#end
#end
#end

    /**
     * Duplicates a ${name} into a new record and answers it (intent {@code duplicable}, #8752): the
     * source's ordinary fields - not its key, status, number, read-only, aggregate, audit or process
     * columns, nor a {@code duplicable.reset} field - with the {@code duplicable.defaults} values the
     * request body carries (the document page sends the ones it computed: {@code now} in the user's
     * calendar, a {@code {field}} template of the source), created through {@link #create} with every
     * gate and check a create has. With {@code duplicable.unique}, the templated name is numbered past
     * the names already taken - inside the same unit of work that holds the source row locked, so two
     * duplicates of one record never pick the same free name. Line items are not copied here.
     *
     * @param id the record to copy
     * @param values the copy's {@code duplicable.defaults} values; a field left out keeps the source's
     * @return the created copy
     */
    @Post("/{id}/duplicate")
    @Documentation("Duplicate ${name} by id")
    public ${name}Entity duplicate(@PathParam("id") ${dupPkType} id, @Body ${name}Entity values) {
#if($needsRoles)
        // The copy is read like a GET and written like a POST: both gates, create() asks the second.
        checkPermissions("read");
#end
#if($hasDuplicateKeys)
        try {
            return org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.call(() -> duplicateLocked(id, values));
        } catch (RuntimeException e) {
            // Outside the unit: a duplicate business key is raised by its commit.
            throw repository.duplicateKeyOr(e);
        }
#else
        return org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.call(() -> duplicateLocked(id, values));
#end
    }

    private ${name}Entity duplicateLocked(${dupPkType} id, ${name}Entity values) {
        // Duplicates of one record wait for each other here, so the name probe below sees every copy
        // committed before it.
        if (!repository.lockForUpdate(id)) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found");
        }
        ${name}Entity source = repository.findOne(id)
                .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "${name} not found"));
#if($isEntityPropertySecurityEnabled)
        // What the caller may not read is not copied - the page's copy never saw it either.
        redactRead(source);
#end
        ${name}Entity copy = new ${name}Entity();
#foreach($property in $properties)
