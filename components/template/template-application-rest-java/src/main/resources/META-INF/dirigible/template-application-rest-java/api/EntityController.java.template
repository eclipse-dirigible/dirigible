    @Get("/access")
    @Documentation("What the CURRENT caller may do with ${name}: read and write, by the same gates every endpoint applies - what the generated pages show or hide their write controls by; the 403 of each write stays authoritative")
    public Map<String, Boolean> access() {
        // Never a 403: a caller who may not read is told so, the way a reader is told it may not write.
#if($systemWritten)
        // Written by the application only (#8503): no caller may write it over REST.
        return Map.of("read", #if($needsRoles)mayRead()#{else}true#end, "write", false);
#elseif($needsRoles)
        return Map.of("read", mayRead(), "write", mayWrite());
#else
