#if($check.literalJavaExpression)
        if (entity.${check.field} != null
#if($check.numeric == "true")
                && !(new java.math.BigDecimal(entity.${check.field}.toString()).compareTo(${check.literalJavaExpression}) ${check.op} 0)) {
#else
                && !(entity.${check.field}.compareTo(${check.literalJavaExpression}) ${check.op} 0)) {
