    /**
     * ${name} is written by the application only (intent {@code systemWritten: true}, #8503) - a
     * create-from's link row, a settlement, a reaction - each through the repository. A REST write is
     * refused for every caller, ADMINISTRATOR included: a hand-made row is bookkeeping no flow recorded.
     */
    private static void refuseSystemWritten(String verb) {
        throw new ResponseStatusException(HttpStatus.METHOD_NOT_ALLOWED,
                "${name} records are written by the system only - they cannot be " + verb + " over REST");
    }
