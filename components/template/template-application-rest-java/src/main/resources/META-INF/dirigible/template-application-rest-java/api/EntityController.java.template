## The two records a junction row links must point at the same third thing (intent `checks: agree`,
## #7409) - the same customer, the same currency, the same company. Each side is one hop away, so both
## records are loaded by their foreign key first; an unset side is skipped unless the check says to
## refuse it, because requiredness is the relation's own declaration.
        {
#foreach($load in $check.pathLoads)
            Object ${load.local}Fk = ${load.sourceExpression};
            ${load.entityClass} ${load.local} = ${load.local}Fk == null ? null
                    : (${load.entityClass}) loadedHops.computeIfAbsent("${load.repositoryClass}:" + ${load.local}Fk,
                            hopKey -> new ${load.repositoryClass}().findById(${load.local}Fk));
#end
