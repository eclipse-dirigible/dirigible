package gen.events.${javaGenFolderName};

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.http.Controller;
import org.eclipse.dirigible.sdk.http.Get;
import org.eclipse.dirigible.sdk.http.PathParam;
import org.eclipse.dirigible.sdk.http.Response;
#if($hasCrossModel)
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
#end
#if($expandsReferences)
import org.eclipse.dirigible.sdk.print.PrintRecords;
#end
import org.eclipse.dirigible.sdk.security.User;
import org.eclipse.dirigible.sdk.utils.Json;

/**
 * Print data feeder for ${entity}: loads the document record and its related graph through the
 * generated repositories and returns the nested { document, items } payload the ${entity}.print
 * template binds - so a template path like {{document.<Relation>.<Field>}} resolves.
 *
 * Generated from the intent printFeeders glue - do not edit; it is re-generated with the application.
 * Every fetch is explicit below, and so is every field of a record this project owns (this class IS
 * the audit of what a print receives). A record owned by ANOTHER model is copied field-by-field at
 * runtime instead - see copyRecordFields - and its own to-one relations are followed one hop from
 * what its entity declares (PrintRecords). Entity access goes ONLY through the generated repositories,
 * so validations, events and the multilingual translation overlay (print in the caller's language)
 * all apply, and the browser calls it as the logged-in user so authorization and tenant are the
 * caller's own.
 * Served at /services/java/<project>/gen/events/${javaGenFolderName}/${className}PrintFeeder/{id},
 * to a caller holding the ${entity}'s read gate (issue #7921) - the roles its generated controller
 * admits on a read.
 */
@Controller
@Component("${javaGenFolderName}_${className}PrintFeeder")
public class ${className}PrintFeeder {
#if($hasCrossModel)

    /** Application logger - nested under the platform's `app.` root, so levels and appenders are the ones the rest of the app uses. */
    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}PrintFeeder");
#end

    /** What {@link #feed} answers for a ${entity} that does not exist. */
    private static final String NOT_FOUND = "{}";

    @Get("/{id}")
    public String serve(@PathParam("id") Integer id) {
        // The role gate (issue #7921): a print reads the ${entity}, so its caller must hold the read gate
        // its generated controller demands. Asked before anything is read, so a refused caller cannot
        // probe which ids exist either. Reading the document reads what it prints: the related records
        // are not gated one by one.
        if (!isInAnyRole("${readRolesJavaLiteral}")) {
            Response.setStatus(403);
            return "{\"error\": \"forbidden\"}";
        }
        String payload = feed(id);
        if (NOT_FOUND.equals(payload)) {
            Response.setStatus(404);
        }
        return payload;
    }

    /**
     * The { document, items } payload of one ${entity}. Not gated: the in-process callers (a snapshot, an
     * attached print) run behind their own gate or where nobody is signed in at all.
     */
    public String feed(Integer id) {
        gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity root =
                new gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository().findById(id);
        if (root == null) {
            return NOT_FOUND;
        }
        Map<String, Object> document = new LinkedHashMap<>();
#if($expandsReferences)
        // The records reached through another model's own relations, by repository and key: each is
        // loaded once for this payload, however many header relations and item rows lead to it.
        Map<String, Map<String, Object>> loadedReferences = new java.util.HashMap<>();
#end
#foreach($s in $rootScalars)
#if($s.date)
        document.put("${s.name}", root.${s.name} == null ? null : root.${s.name}.toString());
#else
        document.put("${s.name}", root.${s.name});
#end
#end
#foreach($n in $nodes)

        // ${n.entity} (via ${n.fkProperty})
        gen.${n.genFolder}.data.${n.javaPerspective}.${n.entity}Entity ${n.entityVar} = null;
        Map<String, Object> ${n.mapVar} = new LinkedHashMap<>();
        if (${n.parentEntityVar} != null && ${n.parentEntityVar}.${n.fkProperty} != null) {
            ${n.entityVar} = new gen.${n.genFolder}.data.${n.javaPerspective}.${n.entity}Repository().findById(${n.parentEntityVar}.${n.fkProperty});
        }
        if (${n.entityVar} != null) {
#if($n.crossModel)
            // ${n.model} owns this record, so its fields are copied as they are TODAY rather than named
            // here: a name baked in would be a snapshot of another model's schema (dirigible #6422).
            copyRecordFields(${n.entityVar}, ${n.mapVar});
#if($n.labelField != "")
            ${n.mapVar}.put("__label", ${n.mapVar}.get("${n.labelField}"));
#end
#if($n.expandReferences)
            // One hop further ({{document.${n.keyInParent}.<Relation>.<Field>}}, dirigible #7752): the
            // relations are the ones ${n.model}'s entity declares, read at runtime - none is named here.
            PrintRecords.expandReferences(${n.entityVar}, ${n.mapVar}, loadedReferences);
#end
#else
#if($n.labelField != "")
            ${n.mapVar}.put("__label", ${n.entityVar}.${n.labelField});
#end
#foreach($s in $n.scalars)
#if($s.date)
            ${n.mapVar}.put("${s.name}", ${n.entityVar}.${s.name} == null ? null : ${n.entityVar}.${s.name}.toString());
#else
            ${n.mapVar}.put("${s.name}", ${n.entityVar}.${s.name});
#end
#end
#end
        }
        ${n.parentMapVar}.put("${n.keyInParent}", ${n.mapVar});
#end

        List<Object> items = new ArrayList<>();
#foreach($n in $itemNodes)
        // ${n.entity} lookups (via the items' ${n.fkProperty}): one load per DISTINCT key, not per row.
        Map<Object, gen.${n.genFolder}.data.${n.javaPerspective}.${n.entity}Entity> ${n.entityVar}Cache = new LinkedHashMap<>();
#end
        for (gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity item : new gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Repository().findAll(Criteria.create().eq("${itemsFkProperty}", id))) {
            Map<String, Object> im = new LinkedHashMap<>();
#foreach($s in $itemScalars)
#if($s.date)
            im.put("${s.name}", item.${s.name} == null ? null : item.${s.name}.toString());
#else
            im.put("${s.name}", item.${s.name});
#end
#end
#foreach($n in $itemNodes)

            // ${n.entity} (via ${n.fkProperty}) - so an items column renders {{${n.keyInParent}}} (the
            // label) or descends into {{${n.keyInParent}.<Field>}}, exactly as the header relations do.
            gen.${n.genFolder}.data.${n.javaPerspective}.${n.entity}Entity ${n.entityVar} = null;
            if (item.${n.fkProperty} != null) {
                ${n.entityVar} = ${n.entityVar}Cache.get(item.${n.fkProperty});
                if (${n.entityVar} == null) {
                    ${n.entityVar} = new gen.${n.genFolder}.data.${n.javaPerspective}.${n.entity}Repository().findById(item.${n.fkProperty});
                    if (${n.entityVar} != null) {
                        ${n.entityVar}Cache.put(item.${n.fkProperty}, ${n.entityVar});
                    }
                }
            }
            Map<String, Object> ${n.mapVar} = new LinkedHashMap<>();
            if (${n.entityVar} != null) {
#if($n.crossModel)
                // ${n.model} owns this record, so its fields are copied as they are TODAY rather than
                // named here (dirigible #6422).
                copyRecordFields(${n.entityVar}, ${n.mapVar});
#if($n.labelField != "")
                ${n.mapVar}.put("__label", ${n.mapVar}.get("${n.labelField}"));
#end
#if($n.expandReferences)
                // One hop further ({{${n.keyInParent}.<Relation>.<Field>}}, dirigible #7752), from what
                // ${n.model}'s entity declares; a record many rows lead to is loaded once.
                PrintRecords.expandReferences(${n.entityVar}, ${n.mapVar}, loadedReferences);
#end
#else
#if($n.labelField != "")
                ${n.mapVar}.put("__label", ${n.entityVar}.${n.labelField});
#end
#foreach($s in $n.scalars)
#if($s.date)
                ${n.mapVar}.put("${s.name}", ${n.entityVar}.${s.name} == null ? null : ${n.entityVar}.${s.name}.toString());
#else
                ${n.mapVar}.put("${s.name}", ${n.entityVar}.${s.name});
#end
#end
#end
            }
            im.put("${n.keyInParent}", ${n.mapVar});
#end
            items.add(im);
        }

        Map<String, Object> payload = new LinkedHashMap<>();
        payload.put("document", document);
        payload.put("items", items);
        return Json.stringify(payload);
    }

    /** Whether the caller holds ANY role of a comma-separated gate; an empty gate admits nobody. */
    private static boolean isInAnyRole(String roles) {
        for (String role : roles.split(",")) {
            String name = role.trim();
            if (!name.isEmpty() && User.isInRole(name)) {
                return true;
            }
        }
        return false;
    }
#if($hasCrossModel)

    /**
     * Copy every field of a record owned by ANOTHER model onto the print payload, reading the record as
     * it is at runtime instead of naming the fields here.
     *
     * The owner model is generated on its own cycle. A field list written into this class would be a
     * snapshot of the owner's schema taken when THIS project was last generated, so the day the owner
     * retires a field this class stops compiling - and client Java compiles in one all-or-nothing
     * batch, so it would take every module's beans down with it, in a project that never changed
     * (dirigible #6422). Reading the record instead means a retired field simply stops appearing and a
     * new one appears, with no regeneration of this project.
     *
     * Dates become their ISO string, exactly as for a relation this project owns; everything else stays
     * raw so the print binder's own number/money formatting still applies.
     */
    private static void copyRecordFields(Object record, Map<String, Object> target) {
        for (java.lang.reflect.Field field : record.getClass()
                                                   .getFields()) {
            if (java.lang.reflect.Modifier.isStatic(field.getModifiers())) {
                continue;
            }
            try {
                Object value = field.get(record);
                boolean temporal = value instanceof java.time.temporal.Temporal || value instanceof java.util.Date;
                target.put(field.getName(), temporal ? value.toString() : value);
            } catch (ReflectiveOperationException | RuntimeException ex) {
                LOG.warn("Could not read [{}] of [{}] for the print payload - it is omitted", field.getName(), record.getClass()
                                                                                                                    .getName(),
                        ex);
            }
        }
    }
#end
}
