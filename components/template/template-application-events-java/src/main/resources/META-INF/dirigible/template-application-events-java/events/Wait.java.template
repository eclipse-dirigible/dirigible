package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.sdk.bpm.Process;
import org.eclipse.dirigible.sdk.bpm.ProcessStamps;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.messaging.ListenerKind;
import org.eclipse.dirigible.sdk.messaging.MessageHandler;
import org.eclipse.dirigible.sdk.utils.Json;

import gen.${javaGenFolderName}.data.${javaEventPerspective}.${eventEntity}Entity;
#if(${viaFkProperty} != "")
import gen.${javaGenFolderName}.data.${javaParentPerspective}.${parentEntity}Entity;
import gen.${javaGenFolderName}.data.${javaParentPerspective}.${parentEntity}Repository;
#else
import gen.${javaGenFolderName}.data.${javaEventPerspective}.${eventEntity}Repository;
#end

/**
 * Resumes the ${process} process parked on its "${messageName}" wait when a ${eventEntity}
 * lifecycle event fires.
 *
 * Generated from the intent wait step - do not edit; it is re-generated with the application.
 * The listener resolves the record carrying the parked instance#if(${viaFkProperty} != "") (through the
 * ${viaFkProperty} back-reference to the ${parentEntity})#end and correlates the message on THIS
 * process's instance - read from the record's ProcessIds stamps, not from its single ProcessId, which
 * holds whichever process started last: once a record can be the subject of several flows, correlating
 * on that one would resume a stranger's wait, or nothing at all.
 * An instance that is running but not parked on the wait YET - still running the steps after a user
 * task when the event arrives - keeps the event, and the wait continues on it the moment the process
 * reaches it (dirigible #8106): the event must not be lost to the window before the wait subscribes.
 * Fail-soft by design: no stamp, or an instance that has ended, is a no-op, never an error - the event
 * is simply not for this wait. A delivery that fails for any other reason is a different matter: the
 * instance stays parked on a wait nobody will resume, so it is logged with its cause rather than
 * swallowed (dirigible #7230).
 *
 * Self-describing MessageHandler (strong-interface style): the destination/kind come from the
 * interface, not an annotation; @Component makes it a managed bean.
 */
@Component("${javaGenFolderName}_${className}Wait")
public class ${className}Wait implements MessageHandler {

    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Wait");

    @Override
    public String destination() {
        return "${projectName}-${eventPerspective}-${eventEntity}${topicSuffix}";
    }

    @Override
    public ListenerKind kind() {
        return ListenerKind.TOPIC;
    }

    @Override
    public void onMessage(String message) {
        ${eventEntity}Entity entity = Json.parse(message, ${eventEntity}Entity.class);
        if (entity == null) {
            return;
        }
#if(${guardExpression} != "true")
        if (!(${guardExpression})) {
            return;
        }
#end
#if(${viaFkProperty} != "")
        if (entity.${viaFkProperty} == null) {
            return;
        }
        ${parentEntity}Entity carrier = new ${parentEntity}Repository().findById(entity.${viaFkProperty});
#else
        // The event entity is the trigger entity itself - re-load it so the freshest ProcessId is
        // read (the payload snapshot may predate the trigger listener's write-back).
        ${eventEntity}Entity carrier = new ${eventEntity}Repository().findById(entity.${eventKeyProperty});
#end
        if (carrier == null) {
            return;
        }
        // This process's own instance. The ProcessId fallback covers records stamped before ProcessIds
        // existed, where the single column is all there is - for them the old reading was also the only
        // possible one.
        String instance = ProcessStamps.idFor(carrier.ProcessIds, "${process}");
        if (instance == null && (carrier.ProcessIds == null || carrier.ProcessIds.isBlank())) {
            instance = carrier.ProcessId;
        }
        if (instance == null || instance.isBlank()) {
            return;
        }
        try {
            // Resumes the parked instance, or keeps the event for the wait the instance has not reached
            // yet - until it completes a user task, after which the event no longer counts.
            Process.deliverMessageEvent(instance, "${messageName}");
        } catch (IllegalArgumentException ended) {
            // The one expected miss: the instance is no longer running, which the platform reports with
            // exactly this type. A no-op by the fail-soft glue convention.
            LOG.debug("${process} instance [{}] is not running - \"${messageName}\" is not for it", instance, ended);
        } catch (RuntimeException failed) {
            // Anything else - the correlation did not happen, so an instance that should have moved on
            // stays parked on this wait until someone notices. Fail-soft, but never silent.
            LOG.warn("Could not resume ${process} instance [{}] parked on \"${messageName}\" - it is still waiting", instance, failed);
        }
    }

    @Override
    public void onError(String error) {
        LOG.error("Wait ${className}: the listener on [{}] failed - [{}]", destination(), error);
    }
}
