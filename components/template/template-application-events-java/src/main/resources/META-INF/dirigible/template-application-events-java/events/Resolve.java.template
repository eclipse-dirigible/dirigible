package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.messaging.ListenerKind;
import org.eclipse.dirigible.sdk.messaging.MessageHandler;
import org.eclipse.dirigible.sdk.utils.Json;

import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity;
import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository;
import gen.${javaGenFolderName}.data.${javaRegisterPerspective}.${registerEntity}Entity;
import gen.${javaGenFolderName}.data.${javaRegisterPerspective}.${registerEntity}Repository;

/**
 * Effective-dated register lookup ${name}: fills ${entity}.${setProperty} from the ${registerEntity}
 * row whose validity period covers ${entity}.${valueProperty}, matched on [${matchSummary}]#if($filterSummary != "")
 * and filtered to [${filterSummary}]#end.
 *
#if($pathLoads.size() > 0)
 * A match key or the period date may be a to-one PATH off the record rather than a column of it - the
 * list a line is priced by belongs to its document header, and the date in force is the header's. Each
 * hop is loaded here, once per distinct path prefix, so two paths through the same header read it once.
 *
#end
#if($hasCopies == "true")
 * On the single covering row this also copies [${copySummary}] onto the record - the scalars the row
 * NAMES (a price, a rate), as opposed to the relation it points at, which is what ${setProperty} is.
 * A copy skips a field the record already carries a value in, the same never-overwrite rule the
 * relation has, so a manual correction stands.
 *
#end
 * Generated from the intent resolves block - do not edit; it is re-generated with the application.
 *
 * All three outcomes are first-class. Exactly one covering row fills the relation; NO covering row and
 * MORE THAN ONE covering row both leave it unset - an automation that silently picks one of two
 * candidates is worse than none, so an ambiguous register is handed back to a human. Each outcome may
 * route the record by status, and the attempt is traceable: the outcome is stamped on the record and
 * logged with the keys and the date that were checked.
 *
 * A record that already carries ${setProperty} is skipped, so a manual correction is never overwritten
 * and a re-delivered event is a no-op. The writes are TARGETED (updateProperties / updateProperty) -
 * only the resolved column#if($hasCopies == "true"), the copied scalars#end, the outcome and the status are in the UPDATE
 * statements, so a concurrent user write to any other column cannot be reverted, and no "-updated"
 * event re-fires. The result and the routing status go out SEPARATELY, so a rejected status move
 * cannot discard the identification - see stamp().
 *
 * When an outcome routes the record by status, the "-transitioned" topic IS published afterwards, so
 * that an automatic resolution reaches the same constructs a manual transition does - `generates:` and
 * `postings:` bound to `event: { onTransition: ... }`. A targeted write raises no event of its own, so
 * this publish is the only thing that makes the automatic path observable at all.
 */
@Component("${javaGenFolderName}_${className}Resolve")
public class ${className}Resolve implements MessageHandler {

    /** Application logger - nested under the platform's `app.` root, like every other app logger. */
    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Resolve");

    @Override
    public String destination() {
        return "${projectName}-${perspective}-${entity}${topicSuffix}";
    }

    @Override
    public ListenerKind kind() {
        return ListenerKind.TOPIC;
    }

    @Override
    public void onMessage(String message) {
        ${entity}Entity entity = Json.parse(message, ${entity}Entity.class);
        if (entity == null || entity.${keyProperty} == null#if($guardExpression != "true") || !(${guardExpression})#end) {
            return;
        }
        if (entity.${setProperty} != null) {
            return;
        }
#if($pathLoads.size() > 0)
        // The hops of the declared paths, loaded AFTER the guards so an event this lookup ignores costs
        // no reads. Every access is null-guarded, so a missing link leaves the operand null and the
        // lookup reports notFound rather than throwing inside a listener nobody is watching.
#foreach($load in $pathLoads)
        Object ${load.local}Fk = ${load.sourceExpression};
        ${load.entityClass} ${load.local} = ${load.local}Fk == null ? null : new ${load.repositoryClass}().findById(${load.local}Fk);
#end
#end
        // The operands the register is queried by, read once each: they are tested for null and then
        // bound into the query, and a path would otherwise re-walk its hops per use.
#foreach($match in $matches)
        Object ${match.local} = ${match.recordExpression};
#end
        Object on = ${valueExpression};
        Long at = millis(on);
        java.util.List<${registerEntity}Entity> covering = new java.util.ArrayList<>();
        if (at != null#foreach($match in $matches) && ${match.local} != null#end) {
            // The match keys bind register columns to the record's; the `where:` filters are constants
            // ANDed on top, which is how a register's cancelled and superseded rows stay out of the
            // period comparison instead of covering it forever as a false ambiguous.
            for (${registerEntity}Entity row : new ${registerEntity}Repository().findAll(Criteria.create()#foreach($match in $matches).eq("${match.registerProperty}", ${match.local})#end#foreach($filter in $filters).eq("${filter.property}", ${filter.literal})#end)) {
                if (covers(row, at)) {
                    covering.add(row);
                }
            }
        }
        if (covering.size() == 1) {
            ${registerEntity}Entity covered = covering.get(0);
            Integer resolved = covered.${registerValueProperty};
            LOG.info("${name}: ${entity} [{}] resolved ${setProperty} to [{}] valid on [{}]", entity.${keyProperty}, resolved, on);
            stamp(entity, "found", resolved, #if($hasCopies == "true")copies(entity, covered)#{else}java.util.Map.of()#end#if($writesStatus == "true"), #if($foundStatus != "")${foundStatus}#{else}null#end#end);
        } else if (covering.isEmpty()) {
            LOG.info("${name}: no ${registerEntity} row covers [{}] for ${entity} [{}]#if($filterSummary != "") (filtered to [${filterSummary}])#end"
                    + " - ${setProperty} left unresolved", on, entity.${keyProperty});
            stamp(entity, "notFound", null, java.util.Map.of()#if($writesStatus == "true"), #if($notFoundStatus != "")${notFoundStatus}#{else}null#end#end);
        } else {
            LOG.warn("${name}: [{}] ${registerEntity} rows cover [{}] for ${entity} [{}] - ${setProperty} left unresolved for a human",
                    covering.size(), on, entity.${keyProperty});
            stamp(entity, "ambiguous", null, java.util.Map.of()#if($writesStatus == "true"), #if($ambiguousStatus != "")${ambiguousStatus}#{else}null#end#end);
        }
    }
#if($hasCopies == "true")

    /**
     * The scalars of the covering row to write onto the record: the values the row NAMES (a price, a
     * rate) rather than the relation it points at.
     *
     * A field the record already carries a value in is left alone - the never-overwrite rule the
     * resolved relation has, one field at a time: a line whose price a person typed keeps it even when
     * the rest of the copy applies, because a lookup correcting a human is the failure this construct
     * exists to avoid.
     */
    private static java.util.Map<String, Object> copies(${entity}Entity entity, ${registerEntity}Entity covered) {
        java.util.Map<String, Object> values = new java.util.LinkedHashMap<>();
#foreach($copy in $copies)
        if (entity.${copy.recordProperty} == null) {
            values.put("${copy.recordProperty}", covered.${copy.registerProperty});
        }
#end
        return values;
    }
#end

    @Override
    public void onError(String error) {
        LOG.error("${name}: the listener on [{}] failed - [{}]", destination(), error);
    }

    /**
     * Whether a register row's validity period covers the record's date. An absent bound is open-ended
     * (a row with no end is still valid), and the end is inclusive - a date-only end covers its whole day.
     */
    private static boolean covers(${registerEntity}Entity row, long at) {
#if($startProperty != "")
        Long from = millis(row.${startProperty});
        if (from != null && at < from) {
            return false;
        }
#end
#if($endProperty != "")
        Long to = endExclusive(row.${endProperty});
        if (to != null && at >= to) {
            return false;
        }
#end
        return true;
    }

    /**
     * Persists what this attempt decided, in two writes rather than one, and in that order deliberately.
     *
     * First the RESULT - the resolved relation, the copied scalars and the outcome trace - because that
     * is the work: the register was read, exactly one row covered the date, and this is the answer.
     * Then, separately, the ROUTING status.
     *
     * They were one updateProperties call, and the DAO runs the lifecycle and checks gates against the
     * post-write row BEFORE persisting anything, so a rejected status move discarded the relation and the
     * trace with it: the lookup did the work, got the right answer, and threw all of it away - including
     * the field whose entire purpose is recording what happened. Split, a rejected transition can no
     * longer destroy the identification, and the audit trace is the LAST thing a failure can take.
     *
     * Nothing else of the record is touched (both writes are targeted), so no "-updated" re-fires and a
     * concurrent write to any other column cannot be reverted. A plain targeted write publishes NO
     * event, so the routing write carries the "-transitioned" topic itself - the flip and its
     * announcement commit together through the outbox.
     */
    private static void stamp(${entity}Entity entity, String outcome, Integer resolved, java.util.Map<String, Object> copied#if($writesStatus == "true"), Integer status#end) {
        Object id = entity.${keyProperty};
        ${entity}Repository repository = new ${entity}Repository();
        java.util.Map<String, Object> values = new java.util.LinkedHashMap<>();
        if (resolved != null) {
            values.put("${setProperty}", resolved);
        }
        // The copied scalars ride the RESULT write, not one of their own: they are the same answer the
        // register just gave, so a partial commit would leave a line pointing at a price list with no
        // price on it - and one targeted UPDATE is one row version for a concurrent writer to lose.
        values.putAll(copied);
#if($outcomeProperty != "")
        values.put("${outcomeProperty}", outcome);
#end
        if (!values.isEmpty()) {
            repository.updateProperties(id, values);
        }
#if($writesStatus == "true")
        if (status != null) {
            try {
                // The status this lookup just routed the record to IS a transition, and the constructs
                // that react to one - `generates:` and `postings:` bound to `event: { onTransition: ... }`
                // - listen on "-transitioned". A plain targeted write publishes nothing at all, so the
                // topic rides the routing write into the outbox: the flip and its announcement commit
                // together, the payload is the row exactly as the statement left it, and a broker outage
                // delays the announcement instead of losing it. Inside the try on purpose - a status the
                // record could not take is not a transition, so a rejected move must announce nothing,
                // and a rejected write records no event either.
                repository.updateProperties(id, java.util.Map.of("${statusProperty}", status),
                        "${projectName}-${perspective}-${entity}-transitioned");
            } catch (org.eclipse.dirigible.sdk.db.ValidationException rejected) {
                // The record cannot take this status where it currently stands - an unmodeled lifecycle
                // move, or a gate the status would trip. Retrying cannot help (nothing about the record
                // changes by re-reading the register), so the failure is recorded rather than thrown: the
                // relation and the outcome above are already committed and stay that way.
                LOG.warn("${name}: ${entity} [{}] resolved [{}] but could not be routed to status [{}] - [{}]", id, outcome, status,
                        rejected.getMessage());
#if($outcomeProperty != "")
                // Amend the trace so the record itself carries the evidence - otherwise a
                // routed-but-rejected record is indistinguishable from a fully processed one.
                repository.updateProperty(id, "${outcomeProperty}", outcome + "-notRouted");
#end
            }
        }
#end
    }

    /**
     * Epoch-milli of a temporal value, so a date-only bound and an instant compare on one axis. A
     * date-only value is taken at the start of its day, UTC.
     */
    private static Long millis(Object value) {
        if (value instanceof java.time.Instant instant) {
            return instant.toEpochMilli();
        }
        if (value instanceof java.time.LocalDate date) {
            return date.atStartOfDay(java.time.ZoneOffset.UTC)
                       .toInstant()
                       .toEpochMilli();
        }
        if (value instanceof java.time.LocalDateTime dateTime) {
            return dateTime.toInstant(java.time.ZoneOffset.UTC)
                           .toEpochMilli();
        }
        if (value instanceof java.util.Date date) {
            return date.getTime();
        }
        return null;
    }

    /** The exclusive upper bound of a period end: a date-only end covers its whole day. */
    private static Long endExclusive(Object value) {
        if (value instanceof java.time.LocalDate date) {
            return millis(date.plusDays(1));
        }
        Long at = millis(value);
        return at == null ? null : at + 1;
    }
}
