package gen.events.${javaGenFolderName};

#if($hasLookups)
import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
#end
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.messaging.ListenerKind;
import org.eclipse.dirigible.sdk.messaging.MessageHandler;
import org.eclipse.dirigible.sdk.utils.Json;

import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity;
import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository;

/**
 * Inbound ${name}: ingest a ${entity} from every JSON message arriving on ${destination}.
 *
 * Generated from the intent inbound block - do not edit; it is re-generated with the application.
 * The record is saved through the entity's repository, exactly as the webhook shape saves a posted
 * body, so validations, translations and the create event all fire as they do for any other write.
 * Self-describing MessageHandler (strong-interface style): the destination and kind come from the
 * interface, not an annotation.
#if($hasAccept)
 *
 * The declared accept gate (${acceptSummary}) is checked first. A message that does not match is
 * acknowledged and IGNORED with a warning - never failed, since failing it would only have it
 * redelivered, and a sender rolling out a new version must not fill this destination's error path.
#end
#if($hasMap)
 *
 * The payload is an envelope, so it is read as one and projected onto the record by the declared
 * map - a key the map does not name is not the record's business. A business-key lookup that
 * resolves to no single row REJECTS the message rather than storing a null relation.
#end
#if($hasCollections)
 *
 * The declared collections map envelope arrays onto composition child rows. Every element is resolved
 * before anything is written, so one bad element REJECTS the whole message; then the record and its
 * children are saved in one unit of work.
#end
 */
@Component("${javaGenFolderName}_${className}Consumer")
public class ${className}Consumer implements MessageHandler {

    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Consumer");

    @Override
    public String destination() {
        return "${destinationJavaLiteral}";
    }

    @Override
    public ListenerKind kind() {
        return ListenerKind.${listenerKind};
    }

    @Override
    public void onMessage(String message) {
#if($hasEnvelope)
        java.util.Map<?, ?> envelope = Json.parse(message, java.util.Map.class);
        if (envelope == null) {
            LOG.warn("Inbound ${name}: an empty or invalid payload arrived on [{}] - nothing ingested", destination());
            return;
        }
#end
#if($hasAccept)
        if (!(${acceptExpression})) {
            LOG.warn("Inbound ${name}: a message on [{}] does not match accept [{}] - acknowledged and ignored", destination(),
                    ${acceptSummaryLiteral});
            return;
        }
#end
#if($hasMap)
        ${entity}Entity entity = new ${entity}Entity();
#foreach($field in $mapFields)
        {
            Object raw = envelope.get(${field.fromLiteral});
            if (raw != null) {
                entity.${field.property} = ${field.expression};
            }
        }
#end
#foreach($lookup in $lookups)
        Object ${lookup.local}Key = envelope.get(${lookup.fromLiteral});
        if (${lookup.local}Key == null) {
            LOG.error("Inbound ${name}: a message on [{}] carries no [{}] to resolve ${lookup.property} by - NOT ingested", destination(),
                    ${lookup.fromLiteral});
            return;
        }
        java.util.List<gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity> ${lookup.local}Matches =
                new gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Repository()
                        .findAll(Criteria.create()
                                         .eq("${lookup.byProperty}", ${lookup.byValueExpression}));
        if (${lookup.local}Matches.size() != 1) {
            LOG.error("Inbound ${name}: no unique ${lookup.targetEntity} matches ${lookup.byProperty} [{}] from [{}] - NOT ingested",
                    ${lookup.local}Key, ${lookup.fromLiteral});
            return;
        }
        entity.${lookup.property} = ${lookup.local}Matches.get(0).${lookup.targetKeyProperty};
#end
#foreach($collection in $collections)
        java.util.List<gen.${javaGenFolderName}.data.${collection.javaChildPerspective}.${collection.childEntity}Entity> ${collection.local} =
                new java.util.ArrayList<>();
        {
            Object array = envelope.get(${collection.fromLiteral});
            if (array != null && !(array instanceof java.util.List)) {
                LOG.error("Inbound ${name}: a message on [{}]: [{}] is not an array - NOT ingested", destination(),
                        ${collection.fromLiteral});
                return;
            }
            java.util.List<?> elements = array == null ? java.util.List.of() : (java.util.List<?>) array;
#if($collection.hasMax)
            if (elements.size() > ${collection.max}) {
                LOG.error("Inbound ${name}: a message on [{}]: [{}] holds [{}] elements, more than the declared max ${collection.max} - NOT ingested", destination(),
                        ${collection.fromLiteral}, elements.size());
                return;
            }
#end
#foreach($lookup in $collection.lookups)
            java.util.Map<Object, gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity> ${lookup.local}Cache =
                    new java.util.HashMap<>();
#end
            for (int index = 0; index < elements.size(); index++) {
                Object element = elements.get(index);
#if($collection.scalarElements)
                if (element == null || element instanceof java.util.Map || element instanceof java.util.List) {
                    LOG.error("Inbound ${name}: a message on [{}]: element [{}] of [{}] is not a value - NOT ingested", destination(),
                            index, ${collection.fromLiteral});
                    return;
                }
#else
                if (!(element instanceof java.util.Map<?, ?> item)) {
                    LOG.error("Inbound ${name}: a message on [{}]: element [{}] of [{}] is not an object - NOT ingested", destination(),
                            index, ${collection.fromLiteral});
                    return;
                }
#end
                gen.${javaGenFolderName}.data.${collection.javaChildPerspective}.${collection.childEntity}Entity child =
                        new gen.${javaGenFolderName}.data.${collection.javaChildPerspective}.${collection.childEntity}Entity();
#foreach($field in $collection.mapFields)
                {
#if($collection.scalarElements)
                    Object raw = element;
#else
                    Object raw = item.get(${field.fromLiteral});
#end
                    if (raw != null) {
                        child.${field.property} = ${field.expression};
                    }
                }
#end
#foreach($lookup in $collection.lookups)
#if($collection.scalarElements)
                Object ${lookup.local}Key = element;
#else
                Object ${lookup.local}Key = item.get(${lookup.fromLiteral});
                if (${lookup.local}Key == null) {
                    LOG.error("Inbound ${name}: a message on [{}]: element [{}] of [{}] carries no [{}] to resolve ${lookup.property} by - NOT ingested", destination(),
                            index, ${collection.fromLiteral}, ${lookup.fromLiteral});
                    return;
                }
#end
                gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity ${lookup.local}Match =
                        ${lookup.local}Cache.get(${lookup.local}Key);
                if (${lookup.local}Match == null) {
                    java.util.List<gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Entity> ${lookup.local}Matches =
                            new gen.${javaGenFolderName}.data.${lookup.javaTargetPerspective}.${lookup.targetEntity}Repository()
                                    .findAll(Criteria.create()
                                                     .eq("${lookup.byProperty}", ${lookup.byValueExpression}));
                    if (${lookup.local}Matches.size() != 1) {
                        LOG.error("Inbound ${name}: a message on [{}]: element [{}] of [{}]: no unique ${lookup.targetEntity} matches ${lookup.byProperty} [{}] - NOT ingested", destination(),
                                index, ${collection.fromLiteral}, ${lookup.local}Key);
                        return;
                    }
                    ${lookup.local}Match = ${lookup.local}Matches.get(0);
                    ${lookup.local}Cache.put(${lookup.local}Key, ${lookup.local}Match);
                }
                child.${lookup.property} = ${lookup.local}Match.${lookup.targetKeyProperty};
#end
                ${collection.local}.add(child);
            }
        }
#end
#else
        ${entity}Entity entity = Json.parse(message, ${entity}Entity.class);
        if (entity == null) {
            LOG.warn("Inbound ${name}: an empty or invalid payload arrived on [{}] - nothing ingested", destination());
            return;
        }
#end
#if($hasCollections)
        // The record and its child rows are one unit: the create events are dispatched after the commit,
        // so whatever the record's create event starts sees every child, and a refused child rolls the
        // record back with it.
        org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.run(() -> {
            ${entity}Entity saved = new ${entity}Repository().save(entity);
#foreach($collection in $collections)
            for (gen.${javaGenFolderName}.data.${collection.javaChildPerspective}.${collection.childEntity}Entity child : ${collection.local}) {
                child.${collection.backRef} = saved.${collection.masterKey};
                new gen.${javaGenFolderName}.data.${collection.javaChildPerspective}.${collection.childEntity}Repository().save(child);
            }
#end
        });
#else
        new ${entity}Repository().save(entity);
#end
    }

    @Override
    public void onError(String error) {
        LOG.error("Inbound ${name}: the listener on [{}] failed - [{}]", destination(), error);
    }
}
