package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.messaging.ListenerKind;
import org.eclipse.dirigible.sdk.messaging.MessageHandler;
import org.eclipse.dirigible.sdk.utils.Calc;
import org.eclipse.dirigible.sdk.utils.Json;

/**
 * Posting ${name}: when a ${sourceEntity} ${moment}, create one
 * ${targetEntity} with its ${itemsEntity} rows computed from the source's totals per the resolved
 * rule row. Generated from the intent postings block - do not edit; it is re-generated with the
 * application.
 *
 * Contract (the accounting posting semantics, generalized):
 * - binds the topic the source's own publisher raises when it ${moment} (see destination() below)
 *   and RE-LOADS the source by id - the payload is as-of the event and lacks later-step data such as
 *   a stamped document number;
 * - idempotent + resumable + amendable via the ${backRefProperty} back-reference: the derived content
 *   is compared with what the existing post carries, so a redelivery of a complete post is a no-op,
 *   a half-post (an item write failed after the target was saved) is completed, and a source that was
 *   AMENDED and reached the moment again (rejected, edited, re-issued) has its post REWRITTEN to what
 *   it says now - never a second post, never a stale one. The rewrite stops at the created document's
 *   own lifecycle: once it has left the status this handler created it in, someone has acted on it,
 *   so the divergence is logged and the document is left to a correcting entry. Concurrent
 *   de-duplication is best-effort until a UNIQUE back-reference key lands with schema constraints; a
 *   genuinely failed post is undone by a compensation action, not this handler;
 * - a missing rule row or a null referenced rule column SKIPS the posting (the document stays on the
 *   unposted worklist - final-status documents with no back-referencing ${targetEntity});
 * - all writes go through the generated repositories (numbering, status init, validations, checks),
 *   and the whole post - the stale rows a rewrite replaces, the header, every derived line - is ONE
 *   transaction, so a refused line leaves the previous post standing rather than a partial one;
 * - REVERSAL mode (intent reverses:): the handler locates the ORIGINAL document (back-reference set,
 *   storno link empty), skips fail-soft when none exists, and creates the negated copy (same sides,
 *   negative amounts - red storno) with the storno link stamped; its idempotency guard counts only
 *   documents CARRYING the storno link, while the reversed sibling's guard counts only documents
 *   WITHOUT it.
#if($followsSource)
 * - FOLLOWER (#7634): this is the create posting's twin on the source's EDIT. A source with no status
 *   lifecycle raises its posting's moment once, at the insert, so without it an edit left the post
 *   with the insert's figures. An edit re-derives the post exactly as above - rewritten while the
 *   ${targetEntity} still holds the status it was created in, logged once someone has acted on it -
 *   and a source with NO post is left alone: the first post is the create handler's, and two handlers
 *   each finding nothing posted for a create and an edit committed together would post twice.
#end
#if($mirrorsOriginal)
 * - DELETED SOURCE (#7634): the source no longer exists, so it is read off the -deleted payload (the
 *   whole row as it was deleted), and the reversal MIRRORS the original's stored lines - every
 *   amount negated - instead of re-deriving them: a source edited after its entry was posted is a
 *   logged divergence the original still carries, and negating anything else would leave the ledger
 *   off by the difference. No determination rule is read; the original already resolved it.
#end
 */
@Component("${javaGenFolderName}_${className}Posting")
public class ${className}Posting implements MessageHandler {

    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Posting");

    @Override
    public String destination() {
        return "${sourceTopicProject}-${sourcePerspective}-${sourceEntity}${topicSuffix}";
    }

    @Override
    public ListenerKind kind() {
        return ListenerKind.TOPIC;
    }

    @Override
    public void onMessage(String message) {
        gen.${sourceJavaGenFolder}.data.${sourceJavaPerspective}.${sourceEntity}Entity payload =
                Json.parse(message, gen.${sourceJavaGenFolder}.data.${sourceJavaPerspective}.${sourceEntity}Entity.class);
        if (payload == null || payload.${sourceKeyField} == null) {
            return;
        }
#if($fromPayload)
        // The source is deleted, so it cannot be re-loaded: the -deleted payload is the whole row as it
        // was deleted (the repository announces the stored row, not the caller's snapshot).
        gen.${sourceJavaGenFolder}.data.${sourceJavaPerspective}.${sourceEntity}Entity source = payload;
#else
        // Re-load: the event payload lacks later-step data (e.g. the number stamped after Issue).
        gen.${sourceJavaGenFolder}.data.${sourceJavaPerspective}.${sourceEntity}Entity source =
                new gen.${sourceJavaGenFolder}.data.${sourceJavaPerspective}.${sourceEntity}Repository().findById(payload.${sourceKeyField});
#end
        post(source);
    }

    /**
     * The post itself, for a ${sourceEntity} already in hand. The event path above reads it off the
     * topic; the period-reopen sweep (#7703) hands over the documents a closed ${targetEntity} period
     * refused, so both run the one body and cannot drift apart.
     *
     * @param source the ${sourceEntity} to post
     */
    public void post(gen.${sourceJavaGenFolder}.data.${sourceJavaPerspective}.${sourceEntity}Entity source) {
#if($guardProperty != "")
        if (source == null || source.${guardProperty} == null || source.${guardProperty} != ${guardValue}) {
            return;
        }
#else
        if (source == null) {
            return;
        }
#end
#if($hasRule && !$mirrorsOriginal)
        // Determination rule first (the item derivation depends on it): a missing rule or a null
        // referenced column SKIPS - the document stays on the unposted worklist, never half-posted.
        // The match value is the AUTHORED literal of rule.match, not a value read off the source, so it
        // is never null here and the NULL-SAFE Criteria.eq (#7134) cannot turn this lookup into a match
        // on the rule table's null group; an empty authored literal is refused at parse (#7180).
        java.util.List<gen.${javaGenFolderName}.data.${ruleJavaPerspective}.${ruleEntity}Entity> ruleRows =
                new gen.${javaGenFolderName}.data.${ruleJavaPerspective}.${ruleEntity}Repository().findAll(
                        Criteria.create().eq("${ruleMatchProperty}", ${ruleMatchValueJava}));
        if (ruleRows.isEmpty()) {
            // Said out loud (#7649): the unposted worklist is otherwise invisible - the handler only
            // fires on the event, so a silent skip leaves nothing anywhere to explain the gap.
            LOG.warn("Posting ${name}: no ${ruleEntity} matches [{}] - ${sourceEntity} [{}] stays unposted",
                    ${ruleMatchValueJava}, source.${sourceKeyField});
            return; // no determination rule -> the document stays on the unposted worklist
        }
        gen.${javaGenFolderName}.data.${ruleJavaPerspective}.${ruleEntity}Entity ruleRow = ruleRows.get(0);
## The columns every line of this posting reads - the UNGUARDED rows'. A null here stops a document
## that would genuinely have booked on the column, so it is checked once, up front. A column only a
## `when:`-guarded line reads is checked inside that line's own guard below (#7649).
#foreach($column in $usedRuleColumns)
        if (ruleRow.${column} == null) {
            LOG.warn("Posting ${name}: ${ruleEntity} matching [{}] has no ${column} - ${sourceEntity} [{}] stays unposted",
                    ${ruleMatchValueJava}, source.${sourceKeyField});
            return; // incomplete determination -> unposted worklist
        }
#end
#foreach($guard in $conditionalRuleGuards)
        if (${guard} == null) {
            LOG.warn("Posting ${name}: the ${ruleEntity} matching [{}] determines no account for ${sourceEntity} [{}]"
                    + " - it stays unposted", ${ruleMatchValueJava}, source.${sourceKeyField});
            return; // conditional rule(by: ...) selected no account (unmatched or null) -> unposted worklist
        }
#end
#end
        // Idempotent + resumable + amendable posting. The back-reference identifies an existing post;
        // comparing it with the freshly derived content is what tells the three cases apart:
        // identical -> a redelivery, nothing to do; different ->
        // either a HALF-post to complete or an AMENDED source to rewrite the post from (#7071).
        // Concurrent-redelivery de-duplication is best-effort until a UNIQUE key on the back-reference
        // lands with schema constraint emission; a genuinely failed post is reversed by a compensation
        // action, not by this handler.
        gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Repository targetRepository =
                new gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Repository();
        gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Repository itemsRepository =
                new gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Repository();
        // The FULL derived item set, built up front: the same list is written for a fresh post and
        // compared against an existing one, so an amended source (rejected, edited, re-issued) can
        // never leave a post carrying the previous issue's content.
        java.util.List<gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity> derivedItems =
                new java.util.ArrayList<>();
#if(!$mirrorsOriginal)
#foreach($row in $itemRows)
#if($row.guard != "")
        if (${row.guard}) {
## The rule columns only THIS line reads (#7649). Required where the line books, not before: a
## document whose `when:` excludes the line books nothing on the column, so a rule row that predates
## it - every tenant's, the day an optional line is added - must not stop that document from posting.
#foreach($column in $row.ruleColumns)
            if (ruleRow.${column} == null) {
                LOG.warn("Posting ${name}: ${ruleEntity} matching [{}] has no ${column}, which this ${sourceEntity} [{}] books on"
                        + " - it stays unposted", ${ruleMatchValueJava}, source.${sourceKeyField});
                return;
            }
#end
#foreach($guard in $row.ruleCaseGuards)
            if (${guard} == null) {
                LOG.warn("Posting ${name}: the ${ruleEntity} matching [{}] determines no account for the line this ${sourceEntity}"
                        + " [{}] books - it stays unposted", ${ruleMatchValueJava}, source.${sourceKeyField});
                return;
            }
#end
#end
        {
            gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity item =
                    new gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity();
#foreach($a in $row.assigns)
            item.${a.targetProp} = ${a.expr};
#end
            derivedItems.add(item);
        }
#if($row.guard != "")
        }
#end
#end
#end
        java.util.List<gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity> relatedTargets =
                targetRepository.findAll(Criteria.create().eq("${backRefProperty}", source.${sourceKeyField}));
#if($stornoProperty != "")
        // Reversal (red storno): the ORIGINAL is the reversed posting's document for the SAME
        // source - back-reference set, storno link empty. No original -> the source was never
        // posted, nothing to reverse (fail-soft skip). Rows carrying the link are THIS handler's
        // own creations (the idempotency set).
        gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity original = null;
        java.util.List<gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity> existingTargets =
                new java.util.ArrayList<>();
        for (gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity candidate : relatedTargets) {
            if (candidate.${stornoProperty} == null) {
                original = candidate;
            } else {
                existingTargets.add(candidate);
            }
        }
        if (original == null) {
            return; // nothing was posted for this source - nothing to reverse
        }
#if($mirrorsOriginal)
        // The storno of a deleted source: the original's own lines, every amount negated (same side).
        for (gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity originalItem :
                itemsRepository.findAll(Criteria.create().eq("${itemsFk}", original.${targetPk}))) {
#foreach($row in $mirrorRows)
            gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity item =
                    new gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity();
#foreach($a in $row.assigns)
            item.${a.targetProp} = ${a.expr};
#end
            derivedItems.add(item);
#end
        }
#end
#elseif($stornoFilterProperty != "")
        // A sibling reversal posting back-references the same source (with its storno link set) -
        // only rows WITHOUT the link are THIS posting's own documents.
        java.util.List<gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity> existingTargets =
                new java.util.ArrayList<>();
        for (gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity candidate : relatedTargets) {
            if (candidate.${stornoFilterProperty} == null) {
                existingTargets.add(candidate);
            }
        }
#else
        java.util.List<gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity> existingTargets =
                relatedTargets;
#end
#if($hoistsHeaderValues)
        // The header values, evaluated ONCE. The comparison below and the assignment further down must
        // see the SAME value: an expression read twice - anything reading the clock - would differ
        // between the two reads and make every redelivery look like an amendment (#7131). Evaluated
        // HERE, once a write is actually possible: every return above this point - a source the guard
        // rejects, a missing rule row, a reversal with nothing to reverse - leaves without writing, and
        // an expression with a cost or a side effect must not run for those (#7177).
#end
#foreach($a in $headerAssignments)
#if($a.hoisted)
        var ${a.local} = ${a.expr};
#end
#end
#if($periodRegisterEntity != "")
#foreach($a in $headerAssignments)
#if($a.targetProp == $periodDateProperty)
        // Asked BEFORE the write (#7703): the target's own repository refuses a booking into a closed
        // ${periodRegisterEntity} (#7590), but it does so from inside this listener - long after the
        // source committed the transition that raised it. The issuer saw a 200, the refusal reached
        // only the listener's error log, and the document stayed unposted for good, because reopening
        // the period publishes nothing this handler listens to. Asking here says which document is
        // waiting and on which period, leaves the message acked rather than redelivered against a
        // period that will stay closed for days, and ${className}PostingReopen re-runs it the moment
        // that period opens.
        if (!periodOpen(${a.value})) {
            LOG.warn("Posting ${name}: the ${periodRegisterEntity} covering [{}] is closed - ${sourceEntity} [{}] stays unposted"
                    + " until it reopens", ${a.value}, source.${sourceKeyField});
            return;
        }
#end
#end
#end
        gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity target;
        boolean refresh = !existingTargets.isEmpty();
        // The rows the post carries today: the ones a rewrite replaces, empty for a fresh post. Both
        // branches assign it exactly once so the write block below can close over it.
        java.util.List<gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity> currentItems;
        if (refresh) {
            target = existingTargets.get(0);
            currentItems = itemsRepository.findAll(Criteria.create().eq("${itemsFk}", target.${targetPk}));
            boolean unchanged = currentItems.size() == derivedItems.size();
#foreach($a in $headerAssignments)
#if($a.overwrittenOnSave)
            // ${a.targetProp} is not compared: the write fills it itself (#7177, #7234).
#elseif($a.compareOnlyWhenDerived)
            unchanged = unchanged && sameUnlessDerivedIsEmpty(target.${a.targetProp}, ${a.value});
#elseif($a.derivedDefault != "")
            unchanged = unchanged && same(target.${a.targetProp}, ${a.value}, ${a.derivedDefault});
#else
            unchanged = unchanged && same(target.${a.targetProp}, ${a.value});
#end
#end
            // Row order is not guaranteed by the query, so each derived row is matched against an
            // unclaimed stored one rather than by position.
            java.util.List<gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity> unmatched =
                    new java.util.ArrayList<>(currentItems);
            for (gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity derived : derivedItems) {
                if (!unchanged) {
                    break;
                }
                unchanged = false;
                for (java.util.Iterator<gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity> stored =
                        unmatched.iterator(); stored.hasNext();) {
                    if (sameItem(stored.next(), derived)) {
                        stored.remove();
                        unchanged = true;
                        break;
                    }
                }
            }
            if (unchanged) {
                return; // the post already says exactly what the source derives now - a redelivery
            }
#if($amendableGuard != "")
            if (!(${amendableGuard})) {
                LOG.error("Posting ${name}: ${sourceEntity} [{}] changed after ${targetEntity} [{}] left the status it was"
                        + " created in - the posted content no longer matches the document and was NOT rewritten;"
                        + " correct it with a reversing entry.", source.${sourceKeyField}, target.${targetPk});
                return;
            }
#end
        } else {
#if($followsSource)
            return; // nothing posted for this source yet - the first post is the create handler's
#else
            target = new gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity();
            target.${backRefProperty} = source.${sourceKeyField};
#if($stornoProperty != "")
            target.${stornoProperty} = original.${targetPk};
#end
            currentItems = java.util.List.of();
#end
        }
#foreach($a in $headerAssignments)
        target.${a.targetProp} = ${a.value};
#end
        // ONE transaction for the whole post: the stale rows a rewrite replaces, the header and every
        // derived line either all become durable or none of them does. Written as separate
        // transactions, a line the item repository refuses (a validation, a constraint) left the
        // journal entry with a header and a PARTIAL set of lines - and unlike the half-post case there
        // is no second event to self-heal from, so the ledger ended up worse than the stale but
        // balanced state the rewrite set out to fix (dirigible #7132). A rewrite therefore deletes the
        // rows it replaces inside the same unit: either the post says what the source derives now, or
        // it still says what it said before.
        org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.run(() -> {
            // Either a HALF-post (an item write failed after the target was saved) or an AMENDMENT
            // (the source was re-issued with different content): both converge on rewriting the post
            // to what the source derives now. Empty for a fresh post, so no branch is needed.
            for (gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity stale : currentItems) {
                itemsRepository.delete(stale);
            }
            // A rewrite writes the header WHOLE, from a row this handler read before any of this - so the
            // row is locked first, after its lines (the order a delete of the document takes them in).
            // A system write landing in between, the process id the document's own trigger stamps, then
            // waits for this commit instead of being reverted by it: update() takes those system-owned
            // columns from the stored row, and that row cannot move any more (dirigible #7716).
            if (refresh && !targetRepository.lockForUpdate(target.${targetPk})) {
                LOG.info("Posting ${name}: ${targetEntity} [{}] was deleted while ${sourceEntity} [{}] was being re-posted - nothing"
                        + " to rewrite", target.${targetPk}, source.${sourceKeyField});
                return;
            }
            gen.${javaGenFolderName}.data.${targetJavaPerspective}.${targetEntity}Entity saved =
                    refresh ? targetRepository.update(target) : targetRepository.save(target);
            for (gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity item : derivedItems) {
                item.${itemsFk} = saved.${targetPk};
                itemsRepository.save(item);
            }
        });
    }

    /**
     * Whether a stored item row still carries what the source derives for it now - compared over the
     * values as they will be STORED, so a column the row's own rule leaves unassigned is compared
     * against the default the insert would fill it with rather than against the raw null (#7131).
     */
    private static boolean sameItem(gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity stored,
            gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity derived) {
        return
#foreach($p in $itemComparedProps)
#if($p.overwrittenOnSave)
                // ${p.name} is not compared: the write fills it itself (#7177, #7234).
#elseif($p.compareOnlyWhenDerived)
                sameUnlessDerivedIsEmpty(stored.${p.name}, derived.${p.name}) &&
#elseif($p.derivedDefault != "")
                same(stored.${p.name}, derived.${p.name}, ${p.derivedDefault}) &&
#else
                same(stored.${p.name}, derived.${p.name}) &&
#end
#end
                true;
    }
#if($comparesAgainstDefaults)

    /**
     * Value equality against a DERIVED value that is not yet saved: a null one does not stay null in
     * the column - the generated repository applies the authored default before the insert (#7104,
     * #7115), so the stored row reads that default back and comparing it against the raw null would
     * read every redelivery as an amendment (#7131). One row of a journal posting assigning Debit and
     * the other Credit, both columns `default: 0`, is exactly that shape.
     */
    private static boolean same(Object stored, Object derived, Object derivedDefault) {
        return same(stored, derived == null ? derivedDefault : derived);
    }
#end
#if($comparesUnlessDerivedIsEmpty)

    /**
     * Value equality an EMPTY derived value simply does not assert, because something other than this
     * handler fills the column: a default only the DATABASE can apply (its {@code DEFAULT} is a SQL
     * expression such as {@code CURRENT_DATE}, which has no Java stand-in, so the generated repository
     * leaves it alone - #7131), or a value the write itself supplies for an empty column - a uuid, the
     * next number in a series (#7177). What the stored row holds therefore cannot be derived, and only
     * a value the source does derive can disagree with the post. Blank counts as empty: that is the
     * test the repository's own fill makes.
     */
    private static boolean sameUnlessDerivedIsEmpty(Object stored, Object derived) {
        if (derived == null || (derived instanceof CharSequence && derived.toString().isBlank())) {
            return true;
        }
        return same(stored, derived);
    }
#end

    /**
     * Null-safe value equality. Numbers compare by VALUE, so a stored amount the database handed back
     * at another scale (1200 vs 1200.00) is not read as a change.
     */
    private static boolean same(Object stored, Object derived) {
        if (stored instanceof Number && derived instanceof Number) {
            return new java.math.BigDecimal(stored.toString()).compareTo(new java.math.BigDecimal(derived.toString())) == 0;
        }
        return java.util.Objects.equals(stored, derived);
    }
#if($periodRegisterEntity != "")

    /**
     * Whether the ${periodRegisterEntity} covering a date is open - the same question the target's
     * repository asks before it writes, read off the same register through its own generated
     * repository. A null date, and a date no period covers, are open: periods are declared as they are
     * needed, exactly as on the controllers.
     *
     * @param date the date the post would be booked on
     * @return whether a write dated there would be accepted
     */
    private static boolean periodOpen(Object date) {
        if (date == null) {
            return true;
        }
        for (gen.${javaGenFolderName}.data.${periodRegisterJavaPerspective}.${periodRegisterEntity}Entity period :
                new gen.${javaGenFolderName}.data.${periodRegisterJavaPerspective}.${periodRegisterEntity}Repository().findAll(
                        Criteria.create()
                                .le("${periodStartProperty}", date)
                                .ge("${periodEndProperty}", date))) {
            if (period.${periodStatusProperty} == null) {
                continue;
            }
            for (String closed : "${periodClosedValues}".split(",")) {
                if (closed.equals(String.valueOf(period.${periodStatusProperty}))) {
                    return false;
                }
            }
        }
        return true;
    }
#end

    @Override
    public void onError(String error) {
        LOG.error("Posting ${name}: the listener on [{}] failed - [{}]", destination(), error);
    }
}
