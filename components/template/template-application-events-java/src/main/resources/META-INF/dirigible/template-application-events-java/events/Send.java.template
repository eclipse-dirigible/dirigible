package gen.events.${javaGenFolderName};
#if($notifyRecordScoped == "true")
#set($recordArgument = "source, ")
#set($recordParameter = "${entity}Entity source, ")
#else
#set($recordArgument = "")
#set($recordParameter = "")
#end

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

#if($forEach != "")
import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
#end
import org.eclipse.dirigible.sdk.core.Configurations;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.mail.Mail;
import org.flowable.engine.delegate.DelegateExecution;
import org.flowable.engine.delegate.JavaDelegate;

import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity;
import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository;
#if($forEach != "")
import gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Entity;
import gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Repository;
#end
#foreach($load in $notifyRelationLoads)
import gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Entity;
import gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Repository;
#end
#if($attachLanguageFkProperty != "")
import gen.${attachLanguageJavaGenFolder}.data.${attachLanguageJavaTargetPerspective}.${attachLanguageTargetEntity}Entity;
import gen.${attachLanguageJavaGenFolder}.data.${attachLanguageJavaTargetPerspective}.${attachLanguageTargetEntity}Repository;
#end

/**
 * Sends the mail declared on the '${step}' step of the ${process} process.
#if($forEach != "")
 * It is a FAN-OUT: it re-loads the ${entity} the process runs on and then sends ONE message per
 * ${forEach} of it - each to its own recipient, each about its own row.
#else
 * It re-loads the ${entity} the process runs on and mails the recipient the step's notify block names.
#end
 *
 * Generated from the intent sends glue - do not edit; it is re-generated with the application. Runs as
 * a BPMN service task (flowable:delegateExpression="\${JavaTask}"). Entity access goes ONLY through
 * the generated repositories, so the mail sees the same validated, translated row a user would, and
 * the sender address comes from the DIRIGIBLE_MAIL_SENDER configuration.
#if($attach == "print")
 *
 * The document rides along as a PDF attachment: the generated ${attachEntity}PrintFeeder assembles the
 * { document, items } payload the print template binds and sdk.print.Print renders it server-side -
 * the same two steps the snapshot delegate takes.
#elseif($attach == "recordPrint")
 *
 * The ${attachEntity} the rows hang off rides along as a PDF attachment - ONE document to MANY
 * recipients, so it is rendered ONCE before the loop (the generated ${attachEntity}PrintFeeder
 * assembles the { document, items } payload and sdk.print.Print renders it) and the same bytes go out
 * with every message. A render failure therefore fails the step before anything is mailed, which is
 * safe to retry: nobody has received a copy yet.
#elseif($attach == "report")
 *
 * The ${attachReport} report rides along as a PDF attachment, run per recipient with its declared
 * parameters bound from the record this message is about - so what each one receives is their own rows
 * (a statement), not a record's own document. The layout is the report's own .print template in the CMS.
#end
 *
 * A row with no recipient is a no-op (log + skip): it simply has nobody to mail, which must not stall
 * the flow.
#if($forEach != "")
 * A delivery failure is logged per row and the step still completes - deliberately. Failing the task
 * would have the engine retry the WHOLE fan-out and mail every recipient that already received their
 * message a second time; a partial send is not idempotent, so the summary in the log is the report.
#else
 * A real delivery failure DOES fail the task, so the process engine's retry applies - unlike a
 * transition's notify, a send step's whole purpose is the message.
#end
 */
public class ${className} implements JavaDelegate {

    /** Application logger - nested under the platform's `app.` root, so levels and appenders are the ones the rest of the app uses. */
    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}");

    @Override
    public void execute(DelegateExecution execution) {
        Object key = execution.getVariable("${keyProperty}");
        if (!(key instanceof Number)) {
            return;
        }
        // The process variable arrives as a plain Number (a JSON double for an integer key), so it is
        // narrowed once here - both the load and the log line must read the record's actual id.
        var id = ((Number) key).${keyAccessor}();
#if($forEach != "")
        ${entity}Entity source = new ${entity}Repository().findById(id);
        if (source == null) {
            return;
        }
        List<${forEach}Entity> rows = new ${forEach}Repository().findAll(Criteria.create()
                                                                                .eq("${forEachFkProperty}", id));
#if($attach == "recordPrint")
        // Rendered once, outside the loop: the document belongs to the record, not to the row - and
        // not at all when there is nobody to mail it to.
        Map document = rows.isEmpty() ? null : renderDocument(source);
#end
        int sent = 0;
        int skipped = 0;
        int failed = 0;
        // The loop variable is named `entity` on purpose: every expression below is pre-rendered
        // against the ROW, exactly as the non-fan-out shape renders against the record.
        for (${forEach}Entity entity : rows) {
            try {
                if (send(${recordArgument}entity#if($attach == "recordPrint"), document#end)) {
                    sent++;
                } else {
                    skipped++;
                }
            } catch (Exception ex) {
                failed++;
                LOG.error("Could not mail ${forEach} [{}]", entity.${forEachKeyProperty}, ex);
            }
        }
        LOG.info("Mailed the ${forEach}s of ${entity} [{}]: sent [{}], no recipient [{}], failed [{}]", id, sent, skipped, failed);
    }
#if($attach == "recordPrint")

    /**
     * The ${attachEntity}'s own document, rendered once for the whole fan-out.
     */
    private Map renderDocument(${entity}Entity source) {
#if($attachLanguageFkProperty != "")
        ${attachLanguageTargetEntity}Entity attachLanguageSource = source.${attachLanguageFkProperty} == null ? null
                : new ${attachLanguageTargetEntity}Repository().findById(source.${attachLanguageFkProperty});
#end
        String language = ${attachLanguageExpression};
        Map document = new HashMap();
        document.put("type", "attachment");
        document.put("contentType", "application/pdf");
        document.put("fileName", ${attachFileNameExpression});
        // Bind the render language to the thread so the feeder's multilingual overlay resolves nomenclature
        // values in the SAME language as the template - there is no request here to carry Accept-Language
        // (dirigible #6947). Cleared in the finally so the pooled worker thread never leaks it.
        byte[] data;
        org.eclipse.dirigible.sdk.security.User.setLanguage(language);
        try {
            data = org.eclipse.dirigible.sdk.print.Print.render("${attachEntity}", language,
                    new ${attachEntity}PrintFeeder().feed(source.${attachKeyProperty}));
        } finally {
            org.eclipse.dirigible.sdk.security.User.clearLanguage();
        }
        document.put("data", data);
        return document;
    }
#end

    /**
     * Send about one ${forEach}. Returns false when the row has nobody to mail.
     */
    private boolean send(${recordParameter}${forEach}Entity entity#if($attach == "recordPrint"), Map document#end) {
#else
        ${entity}Entity entity = new ${entity}Repository().findById(id);
        if (entity == null) {
            return;
        }
#end
#foreach($load in $notifyRelationLoads)
        ${load.targetEntity}Entity ${load.local} = entity.${load.fkProperty} == null ? null : new ${load.targetEntity}Repository().findById(entity.${load.fkProperty});
#end
#if($usesRecordUrl == "true")
        // {recordUrl} - the deep link to the record this message is about (the ROW in a fan-out). The
        // ROUTE is composed HERE, in the layer that knows the generated application's URL layout; the
        // intent layer contributes only the entity and its key, which is what keeps it path-agnostic.
        String recordUrl = Configurations.get("DIRIGIBLE_APP_BASE_URL", "")
                + "/services/web/${projectName}/gen/${genFolderName}/index.html#/${recordUrlEntity}/" + entity.${recordUrlKeyProperty}
                + "/edit";
#end
#if($usesInboxUrl == "true")
        // {inboxUrl} - the deep link to the recipient's process Inbox.
        String inboxUrl = Configurations.get("DIRIGIBLE_APP_BASE_URL", "")
                + "/services/web/${projectName}/gen/${genFolderName}/index.html#/inbox";
#end
        String to = ${notifyToExpression};
        if (to == null || to.isBlank()) {
#if($forEach != "")
            return false;
#else
            LOG.info("No recipient on ${entity} [{}] - nothing sent", id);
            return;
#end
        }
        Map part = new HashMap();
        part.put("type", "text");
        part.put("contentType", "text/plain");
        part.put("text", ${notifyBodyExpression});
        List<Map> parts = new ArrayList<>();
        parts.add(part);
#if($attach == "print")
#if($attachLanguageFkProperty != "")
        ${attachLanguageTargetEntity}Entity attachLanguageSource = entity.${attachLanguageFkProperty} == null ? null
                : new ${attachLanguageTargetEntity}Repository().findById(entity.${attachLanguageFkProperty});
#end
        String language = ${attachLanguageExpression};
        Map document = new HashMap();
        document.put("type", "attachment");
        document.put("contentType", "application/pdf");
        document.put("fileName", ${attachFileNameExpression});
        // Bind the render language to the thread so the feeder's multilingual overlay resolves nomenclature
        // values in the SAME language as the template - there is no request here to carry Accept-Language
        // (dirigible #6947). Cleared in the finally so the pooled worker thread never leaks it.
        byte[] data;
        org.eclipse.dirigible.sdk.security.User.setLanguage(language);
        try {
            data = org.eclipse.dirigible.sdk.print.Print.render("${attachEntity}", language,
                    new ${attachEntity}PrintFeeder().feed(entity.${attachKeyProperty}));
        } finally {
            org.eclipse.dirigible.sdk.security.User.clearLanguage();
        }
        document.put("data", data);
        parts.add(document);
#elseif($attach == "recordPrint")
        // The record's document, rendered once for every recipient of this fan-out.
        parts.add(document);
#elseif($attach == "report")
        // attach: { report, bind } - run the declared report scoped to THIS recipient and attach the
        // rendered PDF. The bindings ARE the report's parameters, which is what makes the rows this
        // recipient's own: a customer statement is a period of rows, not one record's document.
#if($attachLanguageFkProperty != "")
        ${attachLanguageTargetEntity}Entity attachLanguageSource = entity.${attachLanguageFkProperty} == null ? null
                : new ${attachLanguageTargetEntity}Repository().findById(entity.${attachLanguageFkProperty});
#end
        String language = ${attachLanguageExpression};
        Map<String, Object> reportFilter = new HashMap<>();
#foreach($binding in $attachReportBindings)
        reportFilter.put("${binding.parameter}", reportValue(${binding.expression}));
#end
        Map document = new HashMap();
        document.put("type", "attachment");
        document.put("contentType", "application/pdf");
        document.put("fileName", ${attachFileNameExpression});
        // Bind the render language to the thread so the report query's :language overlay resolves the
        // translatable dimensions in the SAME language as the template - there is no request here to carry
        // Accept-Language (dirigible #6947). Cleared in the finally so the pooled worker thread never leaks it.
        byte[] data;
        org.eclipse.dirigible.sdk.security.User.setLanguage(language);
        try {
            Map<String, Object> reportData = new HashMap<>();
            // The bound values double as the rendered header, so the PDF states which slice it is - a
            // table of rows never does.
            reportData.put("document", reportFilter);
            reportData.put("items", new gen.${attachReportGenFolder}.data.${attachReportPerspective}.${attachReport}Repository()
                    .findAll(null, null, reportFilter));
            data = org.eclipse.dirigible.sdk.print.Print.render("${attachReport}", language,
                    org.eclipse.dirigible.sdk.utils.Json.stringify(reportData));
        } finally {
            org.eclipse.dirigible.sdk.security.User.clearLanguage();
        }
        document.put("data", data);
        parts.add(document);
#end
        String from = Configurations.get("DIRIGIBLE_MAIL_SENDER", "noreply@dirigible.io");
#if($forEach != "")
        try {
            Mail.send(from, new String[] {to}, new String[0], new String[0], ${notifySubjectExpression}, parts);
        } catch (Exception ex) {
            // Rethrown for the per-row counter above; the fan-out never fails the task (see the note).
            throw new RuntimeException(ex.getMessage(), ex);
        }
        return true;
#else
        try {
            Mail.send(from, new String[] {to}, new String[0], new String[0], ${notifySubjectExpression}, parts);
        } catch (Exception ex) {
            throw new RuntimeException("Failed to send the ${step} mail of the ${process} process", ex);
        }
#end
    }

#if($attach == "report")
    /**
     * A bound report parameter as the generated report repository reads one - a String, because the
     * value is JSON-encoded for the named-parameter binder and only a JSON primitive is accepted
     * there (a date arrives as its ISO text). Null is deliberate rather than defensive: an absent
     * value is what makes the repository fall back to the parameter's declared initial, so a
     * nullable source column widens the report instead of emptying it.
     */
    private static String reportValue(Object value) {
        return value == null ? null : String.valueOf(value);
    }
#end
}
