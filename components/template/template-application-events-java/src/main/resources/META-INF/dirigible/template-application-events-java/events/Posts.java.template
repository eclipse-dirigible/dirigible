package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.messaging.ListenerKind;
import org.eclipse.dirigible.sdk.messaging.MessageHandler;
import org.eclipse.dirigible.sdk.utils.Json;

/**
 * Post ${name}: on a ${sourceEntity} event (${event}), emit ${into} rows (one per ${itemsEntity} line
 * when forEach is set), idempotently by the ${backRef} back-reference. Generated from the intent
 * posts: block - do not edit; re-generated with the application. See the driving suite's
 * PROPOSAL_EVENT_POSTING.md.
 *
 * Contract (mirrors the postings skeleton, flattened - no header document):
 * - binds the source's #if($isCreate)create (bare entity)#{else}-transitioned#end topic#if(!$isCreate), judges the transition on the
 *   payload (the row as the transition left it - dirigible #8505),#end and RE-LOADS the source by id for
 *   the values posted (the payload is as-of the event and may lack later-step data);
 * - idempotent by ${backRef}: if ${into} rows already back-reference this source, it is a no-op;
 * - all writes go through the generated ${into} repository (so its own create logic fires), and the
 *   rows one source event derives are ONE transaction, so the back-reference either finds the whole
 *   post or finds nothing at all - a tick that fails part-way leaves no ROWS behind to be mistaken
 *   for a finished post (dirigible #7179). What the unit does not cover, exactly as in Posting and
 *   Generate: a ${into} carrying number: or history: true allocates its document number before the
 *   insert and writes its trail after it, each on its own connection, so a refused tick can consume
 *   a number and record the attempt - append-only records of what was tried, not business state.
 */
@Component("${javaGenFolderName}_${className}Post")
public class ${className}Post implements MessageHandler {

    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Post");

    @Override
    public String destination() {
        return "${projectName}-${sourcePerspective}-${sourceEntity}#if(!$isCreate)-transitioned#end";
    }

    @Override
    public ListenerKind kind() {
        return ListenerKind.TOPIC;
    }

    @Override
    public void onMessage(String message) {
        gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Entity payload =
                Json.parse(message, gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Entity.class);
        if (payload == null || payload.${sourceKeyField} == null) {
            return;
        }
#if(!$isCreate)
        // Only fires on the transition into status ${statusValue} - and the EVENT says whether it was one:
        // the payload is the row as the transition left it. The source re-loaded below may already have
        // moved on (a settlement, a roll-up's status write, the next step), and judged on it the
        // transition was lost for good (dirigible #8505).
        if (payload.${statusProperty} == null || payload.${statusProperty} != ${statusValue}) {
            return;
        }
#end
        gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Entity source =
                new gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Repository().findById(payload.${sourceKeyField});
        if (source == null) {
            return;
        }
        book(source);
    }
#if($sweeps)

    /**
     * The post of a ${sourceEntity} already in hand, offered with no event - the period-reopen sweep
     * (dirigible #8772) hands over the documents a closed ${into} period refused. It runs the same body
     * as the event path above, so the two cannot drift apart; only what decides that the source is due
     * differs.
     *
     * @param source the ${sourceEntity} to post
     */
    public void post(gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Entity source) {
#if(!$isCreate)
        // Only a ${sourceEntity} standing where this post holds (dirigible #8243): status ${statusValue}, or a
        // later live status it can only have reached through it. With no event in hand, the status it
        // stands in is all there is to judge by.
        if (source == null || !java.util.List.of("${heldStatusValues}".split(","))
                                              .contains(String.valueOf(source.${statusProperty}))) {
            return;
        }
#else
        if (source == null) {
            return;
        }
#end
        book(source);
    }

    /**
     * Whether this post already stands for the ${sourceEntity} - asked by the period-reopen sweep, which
     * re-runs only what is due. The same test the idempotency guard below applies.
     *
     * @param source the ${sourceEntity} the sweep offers
     * @return whether nothing is due for it
     */
    boolean posted(gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Entity source) {
        return !new gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Repository().findAll(
                Criteria.create().eq("${backRef}", source.${sourceKeyField})).isEmpty();
    }
#end

    /**
     * Derives the rows of a ${sourceEntity} the caller has decided is due and writes them, at most once
     * per source.
     */
    private void book(gen.${javaGenFolderName}.data.${sourceJavaPerspective}.${sourceEntity}Entity source) {
        gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Repository targetRepository =
                new gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Repository();
#if($backRef != "")
        // Idempotency: a row already back-referencing this source means the post ran - no-op. Mere
        // EXISTENCE is an exact test only because the rows below are written as one transaction: a
        // failed tick commits none of them, so the back-reference is present for a whole post and
        // absent for no post - there is no partial set for this guard to read as finished (#7179).
        if (!targetRepository.findAll(Criteria.create().eq("${backRef}", source.${sourceKeyField})).isEmpty()) {
            return;
        }
#end
#if($perItem)
        gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Repository itemsRepository =
                new gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Repository();
        // Derive every row first - reads and in-memory mapping only, nothing written yet.
        java.util.List<gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity> rows = new java.util.ArrayList<>();
        for (gen.${javaGenFolderName}.data.${itemsJavaPerspective}.${itemsEntity}Entity item :
                itemsRepository.findAll(Criteria.create().eq("${itemsFk}", source.${sourceKeyField}))) {
            gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity row =
                    new gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity();
#foreach($a in $assigns)
            row.${a.field} = ${a.expr};
#end
#if($backRef != "")
            row.${backRef} = source.${sourceKeyField};
#end
            rows.add(row);
        }
#if($periodRegisterEntity != "")
        // Asked BEFORE the write (dirigible #8772): the ${into} repository refuses a row dated in a closed
        // ${periodRegisterEntity}, but from inside this listener, after the source committed - redelivered
        // against a period that stays closed for days. A row the period refuses holds back the whole
        // post, which the period-reopen sweep re-runs when that period opens.
        for (gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity row : rows) {
            if (!periodOpen(row.${periodDateProperty})) {
                LOG.warn("Post ${name}: the ${periodRegisterEntity} covering [{}] is closed - ${sourceEntity} [{}] stays unposted"
                        + " until it reopens", row.${periodDateProperty}, source.${sourceKeyField});
                return;
            }
        }
#end
        // ONE transaction for every row this source event derives. Written one save per transaction, a
        // row the repository refused (a validation, a constraint) left the earlier rows durable - and
        // since the guard above reads the back-reference as mere existence, every redelivery afterwards
        // was a no-op and the missing rows were never written: the half-post was PERMANENT
        // (dirigible #7179). All of them commit or none does, so the redelivery finds nothing and
        // writes the whole set.
        org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.run(() -> {
            for (gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity row : rows) {
                targetRepository.save(row);
            }
        });
#else
        gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity row =
                new gen.${javaGenFolderName}.data.${targetJavaPerspective}.${into}Entity();
#foreach($a in $assigns)
        row.${a.field} = ${a.expr};
#end
#if($backRef != "")
        row.${backRef} = source.${sourceKeyField};
#end
#if($periodRegisterEntity != "")
        // Asked BEFORE the write (dirigible #8772): the ${into} repository refuses a row dated in a closed
        // ${periodRegisterEntity}, but from inside this listener, after the source committed - redelivered
        // against a period that stays closed for days. The period-reopen sweep re-runs it when that
        // period opens.
        if (!periodOpen(row.${periodDateProperty})) {
            LOG.warn("Post ${name}: the ${periodRegisterEntity} covering [{}] is closed - ${sourceEntity} [{}] stays unposted"
                    + " until it reopens", row.${periodDateProperty}, source.${sourceKeyField});
            return;
        }
#end
        // One row, one repository call - a transaction on its own, so no unit of work is needed here.
        targetRepository.save(row);
#end
    }
#if($periodRegisterEntity != "")

    /**
     * Whether the ${periodRegisterEntity} covering a date is open - the same question the ${into}
     * repository asks before it writes. A null date, and a date no period covers, are open.
     *
     * @param date the date the row would be booked on
     * @return whether a write dated there would be accepted
     */
    private static boolean periodOpen(Object date) {
        if (date == null) {
            return true;
        }
#if($periodRegisterModel != "")
        // The register belongs to the ${periodRegisterModel} model (dirigible #8755): asked at runtime by
        // model and name, as the ${into} repository asks it (#8687) - open while that model is not deployed.
        java.time.LocalDate day;
        if (date instanceof java.time.LocalDate local) {
            day = local;
        } else if (date instanceof java.sql.Date sql) {
            day = sql.toLocalDate();
        } else {
            String text = String.valueOf(date);
            try {
                day = java.time.LocalDate.parse(text.length() > 10 ? text.substring(0, 10) : text);
            } catch (RuntimeException e) {
                return true; // not a date this check can read - the target's repository decides
            }
        }
        return !org.eclipse.dirigible.sdk.db.PeriodRegisters.isClosed("${periodRegisterModel}", "${periodRegisterEntity}", day);
#else
        for (gen.${javaGenFolderName}.data.${periodRegisterJavaPerspective}.${periodRegisterEntity}Entity period :
                new gen.${javaGenFolderName}.data.${periodRegisterJavaPerspective}.${periodRegisterEntity}Repository().findAll(
                        Criteria.create()
                                .le("${periodStartProperty}", date)
                                .ge("${periodEndProperty}", date))) {
            if (period.${periodStatusProperty} == null) {
                continue;
            }
            for (String closed : "${periodClosedValues}".split(",")) {
                if (closed.equals(String.valueOf(period.${periodStatusProperty}))) {
                    return false;
                }
            }
        }
        return true;
#end
    }
#end

    @Override
    public void onError(String error) {
        LOG.error("Post ${name}: the listener on [{}] failed - [{}]", destination(), error);
    }
}
