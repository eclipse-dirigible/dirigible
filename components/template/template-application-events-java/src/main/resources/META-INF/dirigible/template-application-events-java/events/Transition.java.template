package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.sdk.http.Body;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.http.Controller;
import org.eclipse.dirigible.sdk.http.Post;
import org.eclipse.dirigible.sdk.http.Response;
import org.eclipse.dirigible.sdk.utils.Json;

/**
 * Transition ${name}: the guarded on-demand status flip on a ${entity} (loaded by the id in the
 * posted body). The record must currently be in one of the allowed statuses [${fromStatuses}]#if($guardExpr != "")
 * and satisfy the guard [${guardText}]#end; otherwise 409 and the record stays untouched. On success
 * ONLY the status column is written - through the targeted updateProperty primitive, a
 * workflow-style system write (no "-updated" re-fire; a full-row update would merge the stale
 * pre-check snapshot and revert concurrent writes) - and the "-transitioned" topic is published so
 * posting glue / integrations observe the transition.
 *
 * Generated from the intent transitions block - do not edit; it is re-generated with the application.
 * Entity access goes ONLY through the generated repositories.
 * The endpoint is served under /services/java/<project>/gen/events/${javaGenFolderName}/${className}Transition/run.
 */
@Controller
@Component("${javaGenFolderName}_${className}Transition")
public class ${className}Transition {

#if($notify == "true")
    /** Application logger - nested under the platform's `app.` root, like every other app logger. */
    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Transition");

#end
    public static class Request {
        public Integer id;
    }

    @Post("/run")
    public String run(@Body Request req) {
        // Every branch returns a JSON body - the guard errors carry {"error": reason}.
        Response.setContentType("application/json");
        if (req == null || req.id == null) {
            Response.setStatus(400);
            return "{\"error\": \"missing record id\"}";
        }
        gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository repository =
                new gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository();
        gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity source = repository.findById(req.id);
        if (source == null) {
            Response.setStatus(404);
            return "{\"error\": \"${entity} not found\"}";
        }
        // The status FK read with the Calc semantics (null reads as 0 - never an allowed seed id).
        int currentStatus = org.eclipse.dirigible.sdk.utils.Calc.eval("${statusProperty}", source, 0).intValue();
        if (!(${allowedExpr})) {
            Response.setStatus(409);
            return "{\"error\": \"${name} is allowed only from status [${fromStatuses}] - current status is [" + currentStatus + "]\"}";
        }
#if($guardExpr != "")
        if (!(${guardExpr})) {
            Response.setStatus(409);
            return "{\"error\": \"${name} requires ${guardText}\"}";
        }
#end
        repository.updateProperty(req.id, "${statusProperty}", ${setStatus});
        // Reload so the "-transitioned" payload carries the committed row, not the pre-check snapshot.
        source = repository.findById(req.id);
        org.eclipse.dirigible.sdk.messaging.Producer.sendToTopic(
                "${projectName}-${perspective}-${entity}-transitioned", Json.stringify(source));
#if($notify == "true")
        sendNotification(source);
#end
        return Json.stringify(source);
    }
#if($notify == "true")

    /**
     * The transition's `notify` block: mail the counterparty about the record that just transitioned
     * (e.g. "on Void, tell the customer"), optionally with the record's own rendered document
     * attached.
     *
     * FAIL-SOFT by construction: the status flip is this endpoint's contract and it has already
     * committed, so a mail problem (no recipient on the record, SMTP unconfigured or unreachable)
     * must never turn a successful transition into an error. Everything here is logged and swallowed.
     */
#if($forEach != "")
    private static void sendNotification(gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity source) {
        // A FAN-OUT: one message per ${forEach} of the transitioned record, each to its own recipient
        // and about its own row. Every row is attempted - one missing address or one failed send never
        // stops the rest, and none of it can fail the transition.
        int sent = 0;
        for (gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Entity entity : new gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Repository().findAll(
                org.eclipse.dirigible.components.data.store.java.repository.Criteria.create()
                                                                                   .eq("${forEachFkProperty}", source.${keyProperty}))) {
            if (sendOne(entity)) {
                sent++;
            }
        }
        LOG.info("Transition ${name}: mailed [{}] ${forEach} recipient(s) for ${entity} [{}]", sent, source.${keyProperty});
    }

    /**
     * Send about one ${forEach} row. Returns whether a message actually went out.
     */
    private static boolean sendOne(gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Entity entity) {
        try {
#else
    private static void sendNotification(gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity entity) {
        try {
#end
#foreach($load in $notifyRelationLoads)
            gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Entity ${load.local} =
                    entity.${load.fkProperty} == null ? null
                            : new gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Repository().findById(entity.${load.fkProperty});
#end
            String to = ${notifyToExpression};
            if (to == null || to.isBlank()) {
#if($forEach != "")
                return false;
#else
                return;
#end
            }
            java.util.Map part = new java.util.HashMap();
            part.put("type", "text");
            part.put("contentType", "text/plain");
            part.put("text", ${notifyBodyExpression});
            java.util.List<java.util.Map> parts = new java.util.ArrayList<>();
            parts.add(part);
#if($attach == "print")
            // attach: print - the record's own print template rendered to PDF server-side, so the
            // counterparty receives the document (the voided invoice itself), not just a notice.
            java.util.Map document = new java.util.HashMap();
            document.put("type", "attachment");
            document.put("contentType", "application/pdf");
            document.put("fileName", ${attachFileNameExpression});
            document.put("data", org.eclipse.dirigible.sdk.print.Print.render("${attachEntity}", "${attachLanguage}",
                    new ${attachEntity}PrintFeeder().feed(entity.${attachKeyProperty})));
            parts.add(document);
#end
            String from = org.eclipse.dirigible.sdk.core.Configurations.get("DIRIGIBLE_MAIL_SENDER", "noreply@dirigible.io");
            org.eclipse.dirigible.sdk.mail.Mail.send(from, new String[] {to}, new String[0], new String[0], ${notifySubjectExpression},
                    parts);
#if($forEach != "")
            return true;
        } catch (Exception ex) {
            LOG.error("Transition ${name}: could not mail ${forEach} [{}]", entity.${forEachKeyProperty}, ex);
            return false;
        }
    }
#else
        } catch (Exception ex) {
            LOG.error("Transition ${name}: the record transitioned but its mail could not be sent", ex);
        }
    }
#end
#end
}
