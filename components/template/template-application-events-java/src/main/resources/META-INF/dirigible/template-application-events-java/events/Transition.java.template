#if($notifyRecordScoped == "true")
#set($recordArgument = "source, ")
#set($recordParameter = "gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity source, ")
#else
#set($recordArgument = "")
#set($recordParameter = "")
#end
## cc:/bcc: (#7938) - only a block that authors one renders the three-recipient shape, so every
## other controller stays byte-identical.
#if($notifyCcExpression || $notifyBccExpression)
#set($notifyCopies = true)
#else
#set($notifyCopies = false)
#end
## The owner's run from the personal surface (#8406) is this controller scoped to the caller's own
## records - same guards, same write - so it is rendered from this template under its own name.
#if($personalSurface == "true")
#set($personal = true)
#set($controllerClass = "${className}TransitionMy")
#set($personalControllerClass = "gen.${javaGenFolderName}.api.${javaPerspective}.${entity}MyController")
#else
#set($personal = false)
#set($controllerClass = "${className}Transition")
#end

import org.eclipse.dirigible.sdk.http.Body;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.http.Controller;
import org.eclipse.dirigible.sdk.http.Post;
import org.eclipse.dirigible.sdk.http.Response;
import org.eclipse.dirigible.sdk.security.User;
import org.eclipse.dirigible.sdk.utils.Json;

/**
 * Transition ${name}: the guarded on-demand status flip on a ${entity} (loaded by the id in the
 * posted body). The record must currently be in one of the allowed statuses [${fromStatuses}]#if($guardExpr != "")
 * and satisfy the guard [${guardText}]#end; otherwise 409 and the record stays untouched. On success
 * ONLY the status column is written - through the targeted updateProperties primitive, a
 * workflow-style system write (no "-updated" re-fire; a full-row update would merge the stale
 * pre-check snapshot and revert concurrent writes) - and the "-transitioned" notice rides that write
 * into the outbox, so the flip and its announcement commit together and posting glue / integrations
 * can never miss a transition whose row is durable.
 *
 * Generated from the intent transitions block - do not edit; it is re-generated with the application.
 * Entity access goes ONLY through the generated repositories.
#if($personal)
 * The endpoint is served under /services/java/<project>/gen/events/${javaGenFolderName}/${controllerClass}/run,
 * to the record's OWNER on the personal surface (issue #8406): the caller's identity record is resolved
 * exactly as ${entity}MyController resolves it, a record that is not theirs is the same 404 as a missing
 * one, and the record answered is the one that controller serves - without the fields the personal
 * surface withholds.
#else
 * The endpoint is served under /services/java/<project>/gen/events/${javaGenFolderName}/${controllerClass}/run,
 * to a caller holding the ${entity}'s write gate (issue #7913) - the roles its generated controller demands.
#end
 */
@Controller
@Component("${javaGenFolderName}_${controllerClass}")
public class ${controllerClass} {

#if($notify == "true")
    /** Application logger - nested under the platform's `app.` root, like every other app logger. */
    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${controllerClass}");

    /** The delivery outcomes the response reports - the vocabulary the client branches on. */
    private static final String SENT = "sent";
    private static final String SKIPPED = "skipped";
    private static final String FAILED = "failed";

#end
#if($personal)
    /** The personal surface this run belongs to - what it answers is what that surface serves. */
    private final ${personalControllerClass} personalController;

    public ${controllerClass}(${personalControllerClass} personalController) {
        this.personalController = personalController;
    }

#end
    public static class Request {
        public Integer id;
    }

    @Post("/run")
    public String run(@Body Request req) {
        // Every branch returns a JSON body - the guard errors carry {"error": reason}.
        Response.setContentType("application/json");
#if($personal)
        // The personal gate (issue #8406): the caller runs the transition on their OWN ${entity}, so
        // the identity record they map to is resolved first. Asked before anything is read, so a caller
        // with no identity cannot probe which ids exist either.
        Object me = me();
        if (me == null) {
            Response.setStatus(403);
            return "{\"error\": \"no identity record is mapped to the current user\"}";
        }
#else
        // The role gate (issue #7913): the flip writes the ${entity}, so its caller must hold the same write
        // gate its generated controller demands. Asked before anything is read, so a refused caller cannot
        // probe which ids exist either.
        if (!isInAnyRole("${writeRolesJavaLiteral}")) {
            Response.setStatus(403);
            return "{\"error\": \"forbidden\"}";
        }
#end
        if (req == null || req.id == null) {
            Response.setStatus(400);
            return "{\"error\": \"missing record id\"}";
        }
        gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository repository =
                new gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Repository();
        gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity source = repository.findById(req.id);
#if($personal)
        // A colleague's record is the same 404 as a missing one - before any guard, so the answer never
        // says which status someone else's record is in.
        if (source == null || !me.equals(source.${personalFkProperty})) {
#else
        if (source == null) {
#end
            Response.setStatus(404);
            return "{\"error\": \"${entity} not found\"}";
        }
        // The status FK read with the Calc semantics (null reads as 0 - never an allowed seed id).
        int currentStatus = org.eclipse.dirigible.sdk.utils.Calc.eval("${statusProperty}", source, 0).intValue();
        if (!(${allowedExpr})) {
            Response.setStatus(409);
            return "{\"error\": \"${name} is allowed only from status [${fromStatuses}] - current status is [" + currentStatus + "]\"}";
        }
#if($guardExpr != "")
        if (!(${guardExpr})) {
            Response.setStatus(409);
            return "{\"error\": \"${name} requires ${guardText}\"}";
        }
#end
        // The status write and its "-transitioned" notice commit together: the topic rides the
        // targeted write into the outbox, so a broker outage delays the announcement instead of losing
        // it, and the event payload is the row exactly as the statement left it - never a re-read a
        // concurrent write could have moved on.
        repository.updateProperties(req.id, java.util.Map.of("${statusProperty}", ${setStatus}),
                "${projectName}-${perspective}-${entity}-transitioned");
        // Reload so the response (and the notify block) carries the committed row, not the pre-check snapshot.
        source = repository.findById(req.id);
#if($notify == "true")
        // The mail is fail-soft - the flip is this endpoint's contract and has already committed - but
        // its outcome RIDES THE RESPONSE, so the person who pressed the button is told when nothing
        // left. A silent 200 on a failed delivery is how a document sits in SENT that nobody received
        // (dirigible #7023). The body is { record, notify } for a transition that mails and the bare
        // record for one that does not: the shape is decided at generation time, and the generated
        // action descriptor carries `notifies` so the client knows which one it is reading.
        java.util.Map<String, Object> notified = sendNotification(source);
#if($personal)
        // The record as the personal surface serves it: its sensitive and role-scoped fields withheld.
        return "{\"record\": " + Json.stringify(personalController.getById(req.id)) + ", \"notify\": " + Json.stringify(notified) + "}";
#else
        return "{\"record\": " + Json.stringify(source) + ", \"notify\": " + Json.stringify(notified) + "}";
#end
#elseif($personal)
        // The record as the personal surface serves it: its sensitive and role-scoped fields withheld.
        return Json.stringify(personalController.getById(req.id));
#else
        return Json.stringify(source);
#end
    }
#if($personal)

    /**
     * The caller's identity record id, resolved exactly as ${entity}MyController resolves it: the
     * ${personalIdentityProperty} of the identity entity matched against the EFFECTIVE username - the
     * acting identity when an entitled user armed "act as", else the real login. Null when no record maps.
     */
    private static Object me() {
        String username = User.getEffectiveName();
        if (username == null || username.isBlank()) {
            return null;
        }
        var matches = new ${personalIdentityRepositoryClass}().findAll(
                org.eclipse.dirigible.components.data.store.java.repository.Criteria.create()
                                                                                   .eq("${personalIdentityProperty}", username));
        return matches.isEmpty() ? null : matches.get(0).Id;
    }
#end
#if($notify == "true")

    /**
     * The transition's `notify` block: mail the counterparty about the record that just transitioned
     * (e.g. "on Void, tell the customer"), optionally with the record's own rendered document
     * attached.
     *
     * FAIL-SOFT by construction: the status flip is this endpoint's contract and it has already
     * committed, so a mail problem (no recipient on the record, SMTP unconfigured or unreachable)
     * must never turn a successful transition into an error. Everything here is logged and swallowed.
     */
#if($forEach != "")
    private static java.util.Map<String, Object> sendNotification(gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity source) {
        // A FAN-OUT: one message per ${forEach} of the transitioned record, each to its own recipient
        // and about its own row. Every row is attempted - one missing address or one failed send never
        // stops the rest, and none of it can fail the transition.
        java.util.List<gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Entity> rows =
                new gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Repository().findAll(
                        org.eclipse.dirigible.components.data.store.java.repository.Criteria.create()
                                                                                           .eq("${forEachFkProperty}", source.${keyProperty}));
#if($attach == "recordPrint")
        // The document belongs to the RECORD, not to the row, so it is rendered ONCE for the whole
        // fan-out - and not at all when there is nobody to mail it to. A render failure means nobody
        // can be given what the message promises, so nothing is mailed (a mail claiming an attachment
        // it lacks is worse than none) and the transition itself still stands.
        java.util.Map document = null;
        if (!rows.isEmpty()) {
            try {
                document = renderDocument(source);
            } catch (Exception ex) {
                LOG.error("Transition ${name}: the ${attachEntity} document could not be rendered - no mail was sent", ex);
                return outcome("failed", "the document could not be rendered: " + notifyFailureReason(ex));
            }
        }
#end
        int sent = 0;
        int skipped = 0;
        int failed = 0;
        String firstFailure = null;
        for (gen.${javaGenFolderName}.data.${javaForEachPerspective}.${forEach}Entity entity : rows) {
            String result = sendOne(${recordArgument}entity#if($attach == "recordPrint"), document#end);
            if (SENT.equals(result)) {
                sent++;
            } else if (SKIPPED.equals(result)) {
                skipped++;
            } else {
                failed++;
                if (firstFailure == null) {
                    firstFailure = result;
                }
            }
        }
        LOG.info("Transition ${name}: mailed [{}] of [{}] ${forEach} recipient(s) for ${entity} [{}], no recipient [{}], failed [{}]", sent,
                rows.size(), source.${keyProperty}, skipped, failed);
        // The aggregate the caller reports: a fan-out is fail-soft per row, so what the acting user
        // needs is "how many, and what went wrong with the first one that did" - not one row's story.
        java.util.Map<String, Object> aggregate = outcome(failed > 0 ? FAILED : sent > 0 ? SENT : SKIPPED, firstFailure);
        aggregate.put("sent", sent);
        aggregate.put("skipped", skipped);
        aggregate.put("failed", failed);
        return aggregate;
    }
#if($attach == "recordPrint")

    /**
     * The transitioned ${attachEntity}'s own document, rendered once for the whole fan-out.
     */
    private static java.util.Map renderDocument(gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity source) {
#if($attachLanguageFkProperty != "")
        gen.${attachLanguageJavaGenFolder}.data.${attachLanguageJavaTargetPerspective}.${attachLanguageTargetEntity}Entity attachLanguageSource =
                source.${attachLanguageFkProperty} == null ? null
                        : new gen.${attachLanguageJavaGenFolder}.data.${attachLanguageJavaTargetPerspective}.${attachLanguageTargetEntity}Repository().findById(source.${attachLanguageFkProperty});
#end
        String language = ${attachLanguageExpression};
        java.util.Map document = new java.util.HashMap();
        document.put("type", "attachment");
        document.put("contentType", "application/pdf");
        document.put("fileName", ${attachFileNameExpression});
        // Bind the render language to the thread so the feeder's multilingual overlay resolves nomenclature
        // values in the SAME language as the template - there is no request here to carry Accept-Language
        // (dirigible #6947). Cleared in the finally so the pooled worker thread never leaks it.
        byte[] data;
        org.eclipse.dirigible.sdk.security.User.setLanguage(language);
        try {
            data = org.eclipse.dirigible.sdk.print.Print.render("${attachEntity}", language,
                    new ${attachEntity}PrintFeeder().feed(source.${attachKeyProperty}));
        } finally {
            org.eclipse.dirigible.sdk.security.User.clearLanguage();
        }
        document.put("data", data);
        return document;
    }
#end

