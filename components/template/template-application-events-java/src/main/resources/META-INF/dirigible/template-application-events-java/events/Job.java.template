package gen.events.${javaGenFolderName};

import java.util.List;
#if($action != "generate")
import java.util.HashMap;
import java.util.Map;
#end

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
import org.eclipse.dirigible.sdk.component.Component;
#if($action != "generate")
import org.eclipse.dirigible.sdk.core.Configurations;
import org.eclipse.dirigible.sdk.mail.Mail;
#end
import org.eclipse.dirigible.sdk.job.JobHandler;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;

import gen.${sourceGenFolder}.data.${javaPerspective}.${entity}Entity;
import gen.${sourceGenFolder}.data.${javaPerspective}.${entity}Repository;
#foreach($load in $relationLoads)
import gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Entity;
import gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Repository;
#end
#if($attachLanguageFkProperty != "")
import gen.${attachLanguageJavaGenFolder}.data.${attachLanguageJavaTargetPerspective}.${attachLanguageTargetEntity}Entity;
import gen.${attachLanguageJavaGenFolder}.data.${attachLanguageJavaTargetPerspective}.${attachLanguageTargetEntity}Repository;
#end

/**
 * Runs the ${name} schedule: on each cron tick, query ${entity} and, per matching row, either notify
 * (mail) or generate a target record (create-from, saved through the target's generated repository so
 * its numbering / status init / calculated fields fire).
 *
 * Generated from the intent schedules block - do not edit; it is re-generated with the application.
 * Entity access goes ONLY through the generated repositories. The mail sender comes from the
 * DIRIGIBLE_MAIL_SENDER configuration.
 */
@Component("${javaGenFolderName}_${className}Job")
public class ${className}Job implements JobHandler {

    /** Application logger - nested under the platform's `app.` root, like every other app logger. */
    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${className}Job");

    @Override
    public String cron() {
        return "${cron}";
    }

    @Override
    public void run() {
        List<${entity}Entity> rows = new ${entity}Repository().findAll(${criteriaExpression});
#if($action != "generate")
        int sent = 0;
        int skipped = 0;
        int failed = 0;
#end
        for (${entity}Entity entity : rows) {
#if($action == "generate")
#foreach($load in $relationLoads)
            // A one-hop `relation.field` map source: the queried row's foreign key loads the related row,
            // once per row, and the mapping below reads a field off it. Null-guarded - a nullable relation
            // is a legitimate empty value, not a reason to skip the row.
            ${load.targetEntity}Entity ${load.local} = entity.${load.fkProperty} == null ? null : new ${load.targetEntity}Repository().findById(entity.${load.fkProperty});
#end
            gen.${genToGenFolder}.data.${genToJavaPerspective}.${genToEntity}Entity target =
                    new gen.${genToGenFolder}.data.${genToJavaPerspective}.${genToEntity}Entity();
#foreach($a in $genFieldAssignments)
            target.${a.targetProp} = ${a.expr};
#end
            var savedTarget = new gen.${genToGenFolder}.data.${genToJavaPerspective}.${genToEntity}Repository().save(target);
#foreach($c in $genChildren)
#if($c.kind == "days")
            // ${c.toEntity}: one row per working day (Mon-Fri) of the current month.
            for (java.time.LocalDate day = java.time.LocalDate.now().withDayOfMonth(1),
                    monthEnd = java.time.LocalDate.now().withDayOfMonth(1).plusMonths(1);
                    day.isBefore(monthEnd); day = day.plusDays(1)) {
                if (day.getDayOfWeek().getValue() >= 6) {
                    continue;
                }
                ${c.toEntityClass} ${c.rowVar} = new ${c.toEntityClass}();
                ${c.rowVar}.${c.parentFkProperty} = savedTarget.${genToPk};
                ${c.rowVar}.${c.dayField} = day;
#foreach($a in $c.fieldAssignments)
                ${c.rowVar}.${a.targetProp} = ${a.expr};
#end
                new ${c.toRepositoryClass}().save(${c.rowVar});
            }
#else
            // ${c.toEntity}: one row per matching ${c.forEachEntity} of the source row.
            for (${c.forEachEntityClass} ${c.rowVar} : new ${c.forEachRepositoryClass}().findAll(
                    org.eclipse.dirigible.components.data.store.java.repository.Criteria.create().eq("${c.matchProperty}", ${c.matchSourceExpression}))) {
                ${c.toEntityClass} child${c.rowVar} = new ${c.toEntityClass}();
                child${c.rowVar}.${c.parentFkProperty} = savedTarget.${genToPk};
#foreach($a in $c.fieldAssignments)
                child${c.rowVar}.${a.targetProp} = ${a.expr};
#end
                var saved${c.rowVar} = new ${c.toRepositoryClass}().save(child${c.rowVar});
#foreach($g in $c.children)
#if($g.kind == "days")
                // ${g.toEntity}: one row per working day (Mon-Fri) of the current month.
                for (java.time.LocalDate day = java.time.LocalDate.now().withDayOfMonth(1),
                        monthEnd = java.time.LocalDate.now().withDayOfMonth(1).plusMonths(1);
                        day.isBefore(monthEnd); day = day.plusDays(1)) {
                    if (day.getDayOfWeek().getValue() >= 6) {
                        continue;
                    }
                    ${g.toEntityClass} ${g.rowVar} = new ${g.toEntityClass}();
                    ${g.rowVar}.${g.parentFkProperty} = saved${c.rowVar}.${c.toPk};
                    ${g.rowVar}.${g.dayField} = day;
#foreach($a in $g.fieldAssignments)
                    ${g.rowVar}.${a.targetProp} = ${a.expr};
#end
                    new ${g.toRepositoryClass}().save(${g.rowVar});
                }
#else
                // ${g.toEntity}: one row per matching ${g.forEachEntity} of the source row.
                for (${g.forEachEntityClass} ${g.rowVar} : new ${g.forEachRepositoryClass}().findAll(
                        org.eclipse.dirigible.components.data.store.java.repository.Criteria.create().eq("${g.matchProperty}", ${g.matchSourceExpression}))) {
                    ${g.toEntityClass} child${g.rowVar} = new ${g.toEntityClass}();
                    child${g.rowVar}.${g.parentFkProperty} = saved${c.rowVar}.${c.toPk};
#foreach($a in $g.fieldAssignments)
                    child${g.rowVar}.${a.targetProp} = ${a.expr};
#end
                    new ${g.toRepositoryClass}().save(child${g.rowVar});
                }
#end
#end
            }
#end
#end
#else
#foreach($load in $relationLoads)
            ${load.targetEntity}Entity ${load.local} = entity.${load.fkProperty} == null ? null : new ${load.targetEntity}Repository().findById(entity.${load.fkProperty});
#end
#if($usesRecordUrl == "true")
            // {recordUrl} - the deep link to the row this message is about. The ROUTE is composed HERE,
            // in the layer that knows the generated application's URL layout; the intent layer
            // contributes only the entity and its key, which is what keeps it path-agnostic.
            String recordUrl = Configurations.get("DIRIGIBLE_APP_BASE_URL", "")
                    + "/services/web/${projectName}/gen/${genFolderName}/index.html#/${recordUrlEntity}/" + entity.${recordUrlKeyProperty}
                    + "/edit";
#end
#if($usesInboxUrl == "true")
            // {inboxUrl} - the deep link to the recipient's process Inbox.
            String inboxUrl = Configurations.get("DIRIGIBLE_APP_BASE_URL", "")
                    + "/services/web/${projectName}/gen/${genFolderName}/index.html#/inbox";
#end
            String to = ${toExpression};
            if (to == null || to.isBlank()) {
                // A row with nobody to mail is a legitimate no-op, but it is COUNTED: "matched 40,
                // mailed 12" is the line that says a query is wider than the addresses behind it.
                skipped++;
                continue;
            }
            String subject = ${subjectExpression};
            String body = ${bodyExpression};
            Map part = new HashMap();
            part.put("type", "text");
            part.put("contentType", "text/plain");
            part.put("text", body);
            List<Map> parts = new java.util.ArrayList<>();
            parts.add(part);
#if($attach == "print")
            // attach: print - render THIS row's own print template to PDF server-side (the generated
            // feeder assembles the { document, items } payload) and attach it, so a periodic notice
            // carries the document itself (a reminder with the invoice, not just about it).
#if($attachLanguageFkProperty != "")
            ${attachLanguageTargetEntity}Entity attachLanguageSource = entity.${attachLanguageFkProperty} == null ? null
                    : new ${attachLanguageTargetEntity}Repository().findById(entity.${attachLanguageFkProperty});
#end
            Map document = new HashMap();
            document.put("type", "attachment");
            document.put("contentType", "application/pdf");
            document.put("fileName", ${attachFileNameExpression});
            document.put("data", org.eclipse.dirigible.sdk.print.Print.render("${attachEntity}", ${attachLanguageExpression},
                    new ${attachEntity}PrintFeeder().feed(entity.${attachKeyProperty})));
            parts.add(document);
#elseif($attach == "report")
            // attach: { report, bind } - run the declared report scoped to THIS recipient and attach the
            // rendered PDF. The bindings ARE the report's parameters, which is what makes the rows this
            // recipient's own: a customer statement is a period of rows, not one record's document.
#if($attachLanguageFkProperty != "")
            ${attachLanguageTargetEntity}Entity attachLanguageSource = entity.${attachLanguageFkProperty} == null ? null
                    : new ${attachLanguageTargetEntity}Repository().findById(entity.${attachLanguageFkProperty});
#end
            Map<String, Object> reportFilter = new HashMap<>();
#foreach($binding in $attachReportBindings)
            reportFilter.put("${binding.parameter}", reportValue(${binding.expression}));
#end
            Map<String, Object> reportData = new HashMap<>();
            // The bound values double as the rendered header, so the PDF states which slice it is - a
            // table of rows never does.
            reportData.put("document", reportFilter);
            reportData.put("items", new gen.${attachReportGenFolder}.data.${attachReportPerspective}.${attachReport}Repository()
                    .findAll(null, null, reportFilter));
            Map document = new HashMap();
            document.put("type", "attachment");
            document.put("contentType", "application/pdf");
            document.put("fileName", ${attachFileNameExpression});
            document.put("data", org.eclipse.dirigible.sdk.print.Print.render("${attachReport}", ${attachLanguageExpression},
                    org.eclipse.dirigible.sdk.utils.Json.stringify(reportData)));
            parts.add(document);
#end
            String from = Configurations.get("DIRIGIBLE_MAIL_SENDER", "noreply@dirigible.io");
            // FAIL-SOFT PER ROW. A schedule tick is a batch - a dunning run mails every overdue
            // invoice - and one unreachable mailbox used to abort the whole loop, so every row after it
            // was silently never mailed and the next tick started over from the top. Each row is now
            // attempted, counted and logged with its own key, and the tick reports the totals.
            try {
                Mail.send(from, new String[] {to}, new String[0], new String[0], subject, parts);
                sent++;
#if($notifyOutcomeProperty != "")
                stampNotifyOutcome(entity.${notifyOutcomeKeyProperty}, null);
#end
            } catch (Exception ex) {
                failed++;
                LOG.error("Schedule ${name}: could not mail ${entity} [{}] at [{}]", entity.${attachKeyProperty}, to, ex);
#if($notifyOutcomeProperty != "")
                stampNotifyOutcome(entity.${notifyOutcomeKeyProperty}, ex);
#end
            }
#end
        }
#if($action != "generate")
        LOG.info("Schedule ${name}: mailed [{}] of [{}] matching ${entity} row(s), no recipient [{}], failed [{}]", sent, rows.size(),
                skipped, failed);
#end
    }
#if($attach == "report")

    /**
     * A bound report parameter as the generated report repository reads one - a String, because the
     * value is JSON-encoded for the named-parameter binder and only a JSON primitive is accepted
     * there (a date arrives as its ISO text). Null is deliberate rather than defensive: an absent
     * value is what makes the repository fall back to the parameter's declared initial, so a
     * nullable source column widens the report instead of emptying it.
     */
    private static String reportValue(Object value) {
        return value == null ? null : String.valueOf(value);
    }
#end
#if($notifyOutcomeProperty != "")

    /**
     * Record what this delivery attempt did, on the record the message was about - the notify block's
     * `outcome: ${notifyOutcomeProperty}` field.
     *
     * A notify block is FAIL-SOFT: the transition, the schedule tick or the process step must not break
     * because a mailbox is unreachable. Until this stamp existed the only trace of a mail that never
     * left was a server log line - the document sat in its sent status, the person who asked for it saw
     * success, and nothing downstream could react. The stamp is that missing trace.
     *
     * It is a TARGETED write, so no "-updated" re-fires and a concurrent edit to any other column of the
     * row cannot be reverted. A FAILURE additionally carries the "-notifyFailed" topic into the outbox
     * with the write, so the trace and its announcement commit together and glue bound to
     * `event: { onNotifyFailed: ${notifyOutcomeEntity} }` observes exactly what the record shows. A
     * delivery that WORKED announces nothing: it is the normal path, and a channel for it would only
     * give every reaction a second copy of an event it already has.
     *
     * The stamp itself never throws. It is a record OF an outcome, so letting it fail would turn a
     * diagnostic into a second and louder failure - and on the per-row paths it would abort the rows
     * still to send. A `checks:` gate refusing the write is exactly such a case: an unbalanced document
     * refuses every authored write, and it must not also lose the reason its mail did not go out.
     */
    private static void stampNotifyOutcome(Object id, Exception failure) {
        if (id == null) {
            return;
        }
        String value = failure == null ? "sent" : "failed: " + notifyFailureReason(failure);
        // Truncated HERE, to the length the parser holds the field to: a column that truncates does it
        // in the database, where nothing reports what was cut.
        if (value.length() > ${notifyOutcomeLength}) {
            value = value.substring(0, ${notifyOutcomeLength});
        }
        try {
            new ${notifyOutcomeRepositoryClass}().updateProperties(id, java.util.Map.of("${notifyOutcomeProperty}", value),
                    failure == null ? null : "${projectName}-${notifyOutcomePerspective}-${notifyOutcomeEntity}-notifyFailed");
        } catch (Exception ex) {
            LOG.error("Could not record the delivery outcome [{}] on ${notifyOutcomeEntity} [{}]", value, id, ex);
        }
    }

    /**
     * What to tell a person about a failed delivery. An exception with no message (an NPE, a socket
     * closed without one) still has to say something actionable, so its class name stands in rather
     * than the literal "null".
     */
    private static String notifyFailureReason(Exception failure) {
        String message = failure == null ? null : failure.getMessage();
        return message == null || message.isBlank() ? failure.getClass()
                                                             .getSimpleName()
                : message;
    }
#end
}
