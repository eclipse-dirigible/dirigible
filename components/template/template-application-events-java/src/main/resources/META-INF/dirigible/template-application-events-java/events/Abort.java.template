package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.sdk.bpm.Process;
import org.eclipse.dirigible.sdk.bpm.ProcessStamps;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.log.Logger;
import org.eclipse.dirigible.sdk.log.Logging;
import org.eclipse.dirigible.sdk.messaging.ListenerKind;
import org.eclipse.dirigible.sdk.messaging.MessageHandler;
import org.eclipse.dirigible.sdk.utils.Json;

import gen.${javaGenFolderName}.data.${javaPerspective}.${entity}Entity;

/**
 * Aborts the ${process} process when a ${entity} transitions into an abort status.
 *
 * Generated from the intent abortOn block - do not edit; it is re-generated with the application.
 * Bound to the ${entity} -transitioned topic (the channel every transition and workflow setter
 * publishes on): when the transitioned record carries a matching status and a stamp for this process,
 * it fires the "${messageName}" message, whose interrupting event subprocess cancels the whole
 * instance - its pending user tasks, parked waits and armed boundary timers. Correlation rides the
 * ProcessIds stamp the trigger listener writes back for THIS process - not the record's single
 * ProcessId, which holds whichever process started last and would abort a stranger's instance once a
 * record is the subject of several flows. Fail-soft: no stamp, no matching parked instance, or an
 * instance already past the abort scope is a no-op, never an error.
 *
 * Self-describing MessageHandler (strong-interface style): the destination/kind come from the
 * interface, not an annotation; @Component makes it a managed bean.
 */
@Component("${javaGenFolderName}_${process}Abort")
public class ${process}Abort implements MessageHandler {

    private static final Logger LOG = Logging.getLogger("gen.events.${javaGenFolderName}.${process}Abort");

    @Override
    public String destination() {
        return "${projectName}-${perspective}-${entity}-transitioned";
    }

    @Override
    public ListenerKind kind() {
        return ListenerKind.TOPIC;
    }

    @Override
    public void onMessage(String message) {
        ${entity}Entity entity = Json.parse(message, ${entity}Entity.class);
        if (entity == null) {
            return;
        }
        // This process's own instance. The ProcessId fallback covers records stamped before ProcessIds
        // existed, where the single column is all there is - for them the old reading was also the only
        // possible one.
        String instance = ProcessStamps.idFor(entity.ProcessIds, "${process}");
        if (instance == null && (entity.ProcessIds == null || entity.ProcessIds.isBlank())) {
            instance = entity.ProcessId;
        }
        if (instance == null || instance.isBlank()) {
            return;
        }
        if (!(${statusMatchExpression})) {
            return;
        }
        try {
            Process.correlateMessageEvent(instance, "${messageName}", java.util.Map.of());
        } catch (RuntimeException notAborting) {
            // The instance is not in the abort scope (already ended or never reached it) - a no-op by
            // the fail-soft glue convention, never an error.
        }
    }

    @Override
    public void onError(String error) {
        LOG.error("Abort ${process}: the listener on [{}] failed - [{}]", destination(), error);
    }
}
