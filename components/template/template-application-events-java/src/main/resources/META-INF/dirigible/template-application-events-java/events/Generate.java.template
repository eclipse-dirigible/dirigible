package gen.events.${javaGenFolderName};
## A create-from writing a value a person typed (`prompt:`) or a link row holds those rows to their
## controller's validation (#7819). A reversal has neither, so its negated twin is not refused by a
## sign check the original passed.
#set($validatesRows = $hasPrompt || $hasLink)
## A report row's cell (#8329): one column, or a closing balance derived from two - converted exactly.
#macro(reportCell $c)#if($c.derive != "")derivedCell(row, "${c.aliasJavaLiteral}", "${c.minusAliasJavaLiteral}", "${c.derive}", ${c.scale}, ${c.sourceScale})#{else}${c.kind}Cell(row, "${c.aliasJavaLiteral}", ${c.scale}, ${c.sourceScale})#end#end
## The report run with the source's own values; one holding none is refused - the report would read its
## all-time initial and book every balance there is.
#macro(reportRows)
            java.util.Map<String, Object> reportFilter = new java.util.LinkedHashMap<>();
#foreach($p in $reportParameters)
            if (source.${p.property} == null) {
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "${fromEntity} [" + sourceId + "] has no ${p.property}, which report ${reportName} is run with as ${p.name}");
            }
            reportFilter.put("${p.name}", source.${p.property});
#end
            java.util.List<java.util.Map<String, Object>> reportRows =
                    new gen.${reportGenFolder}.data.${reportPerspective}.${reportName}Repository().findAll(null, null, reportFilter);
#end
## The row rule: a row failing any condition is not generated from.
#macro(reportRowRule)
#foreach($t in $reportWhere)
                if (!holds(#if($t.derive != "")derivedCell(row, "${t.aliasJavaLiteral}", "${t.minusAliasJavaLiteral}", "${t.derive}", ${t.sourceScale}, ${t.sourceScale})#{else}row.get("${t.aliasJavaLiteral}")#end, "${t.op}", #if($t.isNull)null#else"${t.valueJavaLiteral}"#end)) {
                    continue;
                }
#end
#end

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
#if(!$eventOnly)
import org.eclipse.dirigible.sdk.http.Body;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.http.Controller;
import org.eclipse.dirigible.sdk.http.Post;
import org.eclipse.dirigible.sdk.security.User;
#end
import org.eclipse.dirigible.sdk.utils.Json;
#if($hasItemLines)
import org.eclipse.dirigible.sdk.utils.Calc;
#end
#if(!$eventOnly || $hasPrompt || $hasStatusGuard || $hasRefusals)
import org.eclipse.dirigible.sdk.http.Response;
#end

/**
 * Create-from ${name}: builds a new ${toEntity} from an existing ${fromEntity} (loaded by id), maps the
 * declared fields, and saves it through the target's generated repository - so the target's create-time
 * logic (document numbering, status init, calculated fields) fires. Any composition items are cloned and
 * re-pointed at the new master.
#if($itemWhere != "")
 *
 * Source-row rule (intent `items: where:` - issue #7091): only the source rows the rule qualifies become
 * lines, and a source whose rows all fail it refuses the run rather than committing a header with no
#if($itemRefuse != "")
 * lines. An unqualified row refuses it too (`refuse:`), naming the rows: leaving a rejected line out of
 * the document silently is as wrong as billing it silently, and this document says which it means.
#{else}
 * lines. An unqualified row is simply left out of the document (declare `refuse:` for the other reading).
#end
 * Either refusal is decided before the ${toEntity} header is saved, so a refused run spends no document
 * number and leaves no history entry (issue #7224).
#end
 *
 * Generated from the intent generates block - do not edit; it is re-generated with the application.
 * Entity access goes ONLY through the generated repositories (validations / events / numbering).
#if(!$eventOnly)
 * The endpoint is served under /services/java/<project>/gen/events/${javaGenFolderName}/${className}Generate/run,
 * to a caller holding the write gate of the ${fromEntity} AND of the ${toEntity} (issue #7913) - the roles
 * their own generated controllers demand for the writes a run makes.
#else
 * There is no endpoint: this create-from is event-driven only, so ${className}GenerateOnEvent is its
 * single caller.
#end
#if($hasEvent)
#if($appendMode)
 *
 * Appends (intent `mode: append`): it is triggered by a ${fromEntity} event and keeps NO existing-target
 * lookup, so every delivery creates another ${toEntity} - the "a row per event" shape (a log, a
 * protocol). The ${backRefProperty} back-reference is still written on each row: it is that row's
 * provenance, not a dedup key. This is the ABSENCE of a guard, so an event redelivery appends a
 * duplicate; use `mode: once` for anything that must exist at most once.
#{else}
 *
 * At-most-once: it is triggered by a ${fromEntity} event, so it first looks for a ${toEntity} that
 * already back-references the source through ${backRefProperty} and returns that one instead of
 * creating a second document. That holds for the LIFETIME of that document, not merely for a
 * redelivery of the same event.
#if($hasRetiredStatus)
 * The exception is a RETIRED one: a ${toEntity} whose ${retiredStatusProperty} reached a stage classified
 * `cancelled` or `void` no longer counts, so the guard steps over it and the ${fromEntity} can be
 * generated from again - void and reissue. A draft or live ${toEntity} still blocks.
#end
 * A create-from with no event trigger deliberately keeps NO such guard - minting several targets from
 * one source is a legitimate manual act.
#end
#end
#if($hasStatusGuard)
 *
 * From-status guard (intent `fromStatus:`, or the one implied by `sourceStatus:` - issue #7068): the
 * endpoint refuses the run with 409 unless the source stands in a status the action accepts
 * [${guardStatuses}], and the contributed button stops offering itself in the others. A create-from
 * with a completion hook flips its source and then went on offering the same button on the flipped
 * record, so a second click minted a second document - another invoice for a proforma already invoiced.
 * The guard is on the CLICK: an event-driven run carries its own at-most-once back-reference guard.
#end
#if($hasRefusals || $hasBackLink)
 *
 * A declared reversal (intent `reversals:` - issue #7886): the ${toEntity} created is the original's
 * negated twin, linked back to it.
#if($hasRefusals)
 * The original is locked for the length of the unit before its refusals are read, so two concurrent
 * Reverse clicks cannot both find it unreversed: the second waits, then reads the first one's
 * back-link and is refused with 409 like any other refused click.
#end
#if($hasBackLink)
 * The original's ${backLinkProperty} is set to the twin in the same unit - a targeted system write,
 * which `immutableWhen` (a guard on user writes) does not refuse - so neither record exists without
 * the other.
#end
#end
#if($hasReportItems)
 *
 * Lines read from a report (intent `items: fromReport:` - issue #8329): the ${reportName} report is run
 * with the ${fromEntity}'s values as its parameters, and every result row passing the row rule becomes a
 * ${toItemEntity} line, its cells read off the row's columns - an amount as the exact decimal its field
 * holds, refused rather than rounded. Rows sharing the counter cells other than the amounts share ONE
 * counter line carrying the sum of their amounts. The report reads what is committed on its own
 * connection, so it books the balances as they stand when the run starts.
 * A second run is refused with 409 while a live ${toEntity} back-references the ${fromEntity} through
 * ${backRefProperty}; the ${fromEntity} is locked first, so two concurrent clicks cannot both pass.
#if($hasUndo)
 * The undo endpoint books the ${toEntity}'s declared reversal (${undoReversalClass}) against that live
 * document - which retires it once the reversal is posted, and frees the ${fromEntity} for another run.
#end
#end
#if($hasReportRows)
 *
 * One ${toEntity} per report row (intent `fromReport:` - issue #8329): the ${reportName} report is run with
 * the ${fromEntity}'s values as its parameters, and every result row passing the row rule becomes a
 * ${toEntity} carrying ${backRefProperty} back to the ${fromEntity}, its cells read off the row's columns -
 * an amount as the exact decimal its field holds, refused rather than rounded. The rows are written in ONE
 * unit, and a second run is refused with 409 while any row back-references the ${fromEntity}.
#if($hasUndo)
 * The undo endpoint deletes exactly those rows, through the ${toEntity}'s own repository.
#end
#end
 */
#if(!$eventOnly)
@Controller
@Component("${javaGenFolderName}_${className}Generate")
#end
public class ${className}Generate {
#if($hasRefusals || $hasReportItems || $hasReportRows)

    /** A declared refusal held under the original's row lock - answered with 409 and its message. */
    static final class Refused extends RuntimeException {

        Refused(String message) {
            super(message);
        }
    }
#end
#if(!$eventOnly)

    public static class Request {
        public Integer id;
#if($hasPrompt)
        // The declared `prompt:` inputs (issue #6685), keyed by the target's PascalCase property names.
        public java.util.Map<String, Object> values;
#end
    }

    @Post("/run")
    public String run(@Body Request req) {
        // The role gate (issue #7913): a run changes the ${fromEntity} and creates a ${toEntity}, so its
        // caller must hold the write gate of both - the same roles the two generated controllers demand.
        // Asked before anything is read, so a refused caller cannot probe which ids exist either.
        if (!isInAnyRole("${sourceWriteRolesJavaLiteral}") || !isInAnyRole("${targetWriteRolesJavaLiteral}")) {
            Response.setStatus(403);
            return "{\"error\": \"forbidden\"}";
        }
        // A refusal carries its status (issue #8001): answered 200, a client or a UI checking
        // `response.ok` could not tell a refused run from a created document.
        if (req == null || req.id == null) {
            Response.setStatus(400);
            return "{\"error\": \"missing source id\"}";
        }
#foreach($p in $promptFields)
#if($p.required && $p.defaultProp == "")
        // A required `prompt:` input is refused BEFORE anything is written - the dialog checks the same
        // thing, and this is what makes the check hold for any other caller of the endpoint. One that
        // defaults to a source property is checked in create(), once the default is applied.
        if (req.values == null || req.values.get("${p.prop}") == null
                || String.valueOf(req.values.get("${p.prop}")).isBlank()) {
            Response.setStatus(400);
            return "{\"error\": \"missing required input [${p.prop}]\"}";
        }
#end
#end
#if($hasStatusGuard)
        // The from-status guard, asked BEFORE anything is created and only on this path: the click.
        // Calc reads the status FK with the calculated-field semantics (null -> 0, never a seed id).
        gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Entity guarded =
                new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().findById(req.id);
        if (guarded == null) {
            Response.setStatus(404);
            return "{\"error\": \"source ${fromEntity} not found\"}";
        }
        int currentStatus = org.eclipse.dirigible.sdk.utils.Calc.eval("${guardStatusProperty}", guarded, 0).intValue();
        if (!(${guardStatusExpr})) {
            Response.setStatus(409);
            return "{\"error\": \"${name} ${guardStatusText} - current status is [" + currentStatus + "]\"}";
        }
#end
#if($hasReportRows)
        java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> rows;
        try {
            rows = generateRows(req.id);
        } catch (Refused refused) {
            Response.setStatus(409);
            return Json.stringify(java.util.Map.of("error", refused.getMessage()));
        }
        if (rows == null) {
            Response.setStatus(404);
            return "{\"error\": \"source ${fromEntity} not found\"}";
        }
        return Json.stringify(rows);
#else
#if($hasRefusals || $hasReportItems)
        gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity saved;
        try {
            saved = create(req.id#if($hasPrompt), req.values#end);
        } catch (Refused refused) {
            // Thrown inside the unit, so nothing it wrote survives; the message is the authored one.
            Response.setStatus(409);
            return Json.stringify(java.util.Map.of("error", refused.getMessage()));
        }
#else
        gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity saved = create(req.id#if($hasPrompt), req.values#end);
#end
        if (saved == null) {
            Response.setStatus(404);
            return "{\"error\": \"source ${fromEntity} not found\"}";
        }
        return Json.stringify(saved);
#end
    }
#if($hasUndo)

    /**
     * Undoes what a run generated from the ${fromEntity} (intent `undo: reverse` - issue #8329): the
     * reversal of its live ${toEntity}, booked through the ${toEntity}'s own declared reversal. Gated as
     * run() is - the undo writes what the run wrote.
     */
    @Post("/undo")
    public String undo(@Body Request req) {
        if (!isInAnyRole("${sourceWriteRolesJavaLiteral}") || !isInAnyRole("${targetWriteRolesJavaLiteral}")) {
            Response.setStatus(403);
            return "{\"error\": \"forbidden\"}";
        }
        if (req == null || req.id == null) {
            Response.setStatus(400);
            return "{\"error\": \"missing source id\"}";
        }
        java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> reversals;
        try {
            reversals = undo(req.id);
        } catch (Refused refused) {
            Response.setStatus(409);
            return Json.stringify(java.util.Map.of("error", refused.getMessage()));
        }
        if (reversals == null) {
            Response.setStatus(404);
            return "{\"error\": \"source ${fromEntity} not found\"}";
        }
        return Json.stringify(reversals);
    }
#end

    /** Whether the caller holds ANY role of a comma-separated gate; an empty gate admits nobody. */
    private static boolean isInAnyRole(String roles) {
        for (String role : roles.split(",")) {
            String name = role.trim();
            if (!name.isEmpty() && User.isInRole(name)) {
                return true;
            }
        }
        return false;
    }
#end
#if($hasReportRows)

    /**
     * Generates one ${toEntity} per qualifying row of report ${reportName} for the given ${fromEntity}, in
     * ONE unit, or returns null when the source is gone. Every row is built - and every cell converted -
     * before the first is saved, so a refused cell writes nothing.
     */
    public java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> generateRows(Integer sourceId) {
        return org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.callRetryingDeadlock(() -> {
            // Locked before the guard reads, so two concurrent clicks cannot both find no rows.
            if (!new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().lockForUpdate(sourceId)) {
                return null;
            }
            gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Entity source =
                    new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().findById(sourceId);
            if (source == null) {
                return null;
            }
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository targetRepository =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository();
            // A second run would carry the same balances forward twice.
            int existing = targetRepository.findAll(Criteria.create()
                                                            .eq("${backRefProperty}", sourceId))
                                           .size();
            if (existing > 0) {
                throw new Refused("${name} already generated " + existing + " ${toEntity} rows from this ${fromEntity} - undo them"
                        + " before running it again");
            }
#reportRows()
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> rows = new java.util.ArrayList<>();
            for (java.util.Map<String, Object> row : reportRows) {
#reportRowRule()
                gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity target =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity();
    #foreach($c in $reportCells)
                target.${c.targetProp} = #reportCell($c);
    #end
    #foreach($a in $fieldAssignments)
                target.${a.targetProp} = ${a.expr};
    #end
                target.${backRefProperty} = sourceId;
                rows.add(target);
            }
            if (rows.isEmpty()) {
                // A run that generates nothing is not the run that was asked for, and leaves nothing a
                // second run could be refused over.
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "no row of report ${reportName} qualifies for ${name}, so there is nothing to generate");
            }
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> saved = new java.util.ArrayList<>();
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity target : rows) {
                saved.add(targetRepository.save(target));
            }
            return saved;
        });
    }
#else

    /**
     * Creates the ${toEntity} for the given ${fromEntity}, or returns null when the source is gone.
#if($hasPrompt)
     * The values map carries the declared `prompt:` inputs collected by the action dialog.
#end
     */
    public gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity create(Integer sourceId#if($hasPrompt), java.util.Map<String, Object> values#end) {
        // ONE transaction for the whole create-from: the target header, its lines and the source's
        // sourceStatus flip either all become durable or none of them does. Written as separate
        // transactions, a line that a validation or a constraint refuses left behind a header-only
        // document whose source was already marked as generated-from - a document that exists, counts
        // as the period's billing, and is missing exactly what it was for, with no way back but an
        // administrator (dirigible #7069). Reads inside the block see the block's own writes, so the
        // status the flip below wrote is what the rest of the block - and its announcement's payload -
        // reads. Everything the block writes it builds from what it reads inside it, so a unit the
        // database rolled back to break a deadlock is run again instead of answering 409 (#8341, #8507).
        gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity result =
                org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.callRetryingDeadlock(() -> {
    #if($hasRefusals || $hasReportItems)
            // The refusals below read the original, and the back-link this unit writes is what the
            // first of them reads - so the original is locked BEFORE it is read, for the length of the
            // unit. Without the lock two concurrent clicks both read it unreversed and both mint a twin.
            // A report-sourced run (#8329) holds the lock for the same reason over its second-run guard.
            if (!new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().lockForUpdate(sourceId)) {
                return null;
            }
    #end
            gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Entity source =
                    new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().findById(sourceId);
            if (source == null) {
                return null;
            }
    #foreach($refusal in $refusals)
            if (${refusal.condition}) {
                throw new Refused("${refusal.message}");
            }
    #end
    #if($hasEvent && !$appendMode)
            // Already generated for this source (an event redelivery, or a click after the event) - hand back
            // the existing document rather than minting a duplicate. Best-effort against two concurrent
            // deliveries until a UNIQUE key on the back-reference lands, exactly as postings' guard is.
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> existing =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository().findAll(
                            Criteria.create()
                                    .eq("${backRefProperty}", sourceId));
    #if(!$hasRetiredStatus)
            if (!existing.isEmpty()) {
                return existing.get(0);
            }
    #else
            // ...unless that document was retired: a ${retiredStatusProperty} classified `cancelled` or `void`
            // (the seeded `stage:` classification) means the ${toEntity} no longer counts, so the ${fromEntity}
            // may be generated from again - void and reissue. A draft or live one still blocks (dirigible #6814).
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity candidate : existing) {
                if (candidate.${retiredStatusProperty} == null || !(${retiredStatusCondition})) {
                    return candidate;
                }
            }
    #end
    #end
    #if($hasItems && $itemWhere != "")
            // Source-row rule (intent `items: where:` - issue #7091): only the source rows the rule
            // qualifies become lines. Pushed into the very query that selects them by their master
            // foreign key, so an unqualified row is never loaded. Without a rule every row was cloned,
            // which billed a draft or rejected line at the same footing as an approved one - and, since
            // the target refuses a line missing a required value, let ONE empty row stop the whole month
            // from being invoiced with nothing the intent could say about it.
            // Decided HERE, before the ${toEntity} header is built and saved, and that ordering is as
            // deliberate as the sourceStatus flip's below: both refusals under this rule read nothing
            // but the source's rows, while the header's save records its History create entry OUTSIDE
            // this unit and holds its series' counter row until the unit ends (dirigible #8113). A
            // refusal fired after the save used to leave a spent number in a series that must stay
            // gap-free and a trail row for a document that never existed - one of each per click,
            // three invoice numbers for three presses on a month with one rejected timesheet
            // (dirigible #7224). Refused here, a rejected click writes nothing at all, which is what
            // run() promises for a missing required `prompt:` input too.
            java.util.List<gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity> qualifying =
                    new gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Repository()
                            .findAll(Criteria.create()
                                             .eq("${srcFkProperty}", sourceId)${itemWhere});
    #if($itemRefuse != "")
            // `refuse:` - an unqualified row stops the whole create-from instead of being left out.
            // Dropping a rejected line silently and billing it silently are both wrong, for different
            // months; which one this document means is the author's call, and this is it. The keys of
            // the offending rows travel with the message: which of them to go and fix is the whole
            // question the caller has.
            java.util.Set<Object> qualifyingKeys = new java.util.HashSet<>();
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity row : qualifying) {
                qualifyingKeys.add(row.${fromItemPk});
            }
            java.util.List<Object> unqualified = new java.util.ArrayList<>();
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity row :
                    new gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Repository()
                            .findAll(Criteria.create()
                                             .eq("${srcFkProperty}", sourceId))) {
                if (!qualifyingKeys.contains(row.${fromItemPk})) {
                    unqualified.add(row.${fromItemPk});
                }
            }
            if (!unqualified.isEmpty()) {
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "${itemRefuseJavaLiteral} (${fromItemEntity} " + unqualified + ")");
            }
    #end
            if (qualifying.isEmpty()) {
                // Every row failed the rule, so the ${toEntity} would carry no lines at all. A document
                // of no lines is not the document that was asked for, and it is the harder of the two
                // failures to notice - it exists, it counts as the period's billing, and it is empty.
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "no ${fromItemEntity} row of the ${fromEntity} qualifies for ${name}, so the ${toEntity} would have no lines");
            }
    #end
    #if($hasReportItems)
            // A second run (issue #8329): the document a run made back-references this ${fromEntity}
            // through ${backRefProperty}, and while it stands - not cancelled, not reversed by a posted
            // reversal - another run would book the same balances twice. Refused, never handed back:
            // the click asked for a new document and must learn that one exists.
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository targetRepository =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository();
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity candidate : targetRepository.findAll(
                    Criteria.create()
                            .eq("${backRefProperty}", sourceId))) {
                if (${liveCondition}) {
                    throw new Refused("${name} already generated ${toEntity} [" + candidate.${toPk}
                            + "] from this ${fromEntity} - undo it before running it again");
                }
            }
#reportRows()
            // Every line is built - and every cell converted - BEFORE the header is saved, so a refused
            // cell spends no document number and leaves no history entry (#7224).
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity> reportLines = new java.util.ArrayList<>();
            java.util.Map<java.util.List<Object>, gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity> counterLines =
                    new java.util.LinkedHashMap<>();
            for (java.util.Map<String, Object> row : reportRows) {
#reportRowRule()
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity line =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity();
    #foreach($c in $reportCells)
                line.${c.targetProp} = #reportCell($c);
    #end
    #foreach($a in $itemFieldAssignments)
                line.${a.targetProp} = ${a.expr};
    #end
                reportLines.add(line);
    #if(!$counterCells.isEmpty())
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity counter =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity();
    #foreach($c in $counterCells)
                counter.${c.targetProp} = #reportCell($c);
    #end
    #foreach($a in $itemFieldAssignments)
                counter.${a.targetProp} = ${a.expr};
    #end
                // One counter line per group: the rows whose counter cells other than the amounts are
                // equal share it, and it carries the sum of their amounts.
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity group = counterLines.putIfAbsent(
                        java.util.Arrays.asList(new Object[] {#foreach($c in $counterCells)#if($c.kind != "decimal")counter.${c.targetProp}, #end#end}), counter);
                if (group != null) {
    #foreach($c in $counterCells)
    #if($c.kind == "decimal")
                    group.${c.targetProp} = sum(group.${c.targetProp}, counter.${c.targetProp});
    #end
    #end
                }
    #end
            }
            if (reportLines.isEmpty()) {
                // No row qualifies: a ${toEntity} of no lines is not the document that was asked for.
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "no row of report ${reportName} qualifies for ${name}, so the ${toEntity} would have no lines");
            }
    #end
    #foreach($load in $relationLoads)
            // A one-hop `relation.field` map source: the related row is loaded by the source's foreign key,
            // once, and read below. Loaded AFTER the at-most-once guard so an already-generated source costs
            // no extra query, and null-guarded because a nullable relation is a legitimate empty value.
            gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Entity ${load.local} = source.${load.fkProperty} == null ? null : new gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Repository().findById(source.${load.fkProperty});
    #end
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity target =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity();
    #foreach($a in $fieldAssignments)
            target.${a.targetProp} = ${a.expr};
    #end
    #if($hasPrompt)
            // Declared input form (intent `prompt:` - issue #6685): the values the user supplied in the
            // action dialog, set on the target AFTER map/defaults (the parser rejects overlaps, so every
            // property has exactly one writer). The required ones without a source default were already
            // checked in run(), which is this method's only caller - a prompted create-from cannot be
            // event-driven, there being nobody to answer. An absent optional input with no default leaves
            // the target's own default in place.
    #foreach($p in $promptFields)
            {
                Object raw = values == null ? null : values.get("${p.prop}");
                if (!(raw == null || String.valueOf(raw).isBlank())) {
                    target.${p.prop} = ${p.expr};
    #if($p.defaultProp != "")
                } else {
                    // An input left empty takes its declared default (intent `prompt: default:` - issue
                    // #7748): the source's ${p.defaultProp}, read off the record this unit just loaded, so a
                    // caller posting no value gets what the dialog pre-filled.
                    target.${p.prop} = source.${p.defaultProp};
    #end
                }
    #if($p.required && $p.defaultProp != "")
                if (target.${p.prop} == null) {
                    throw new org.eclipse.dirigible.sdk.db.ValidationException("missing required input [${p.prop}]");
                }
    #end
            }
    #end
    #end
    #if($validatesRows)
            // The ${toEntity}'s own ungated row checks (`compare`, `agree`, `forbidWhen`, `requiredWhen`)
            // and its required / length / pattern rules - the validate its REST controller runs, read on
            // the record as the save will store it (dirigible #7819). Its repository enforces only the
            // status-gated checks, so a typed `prompt:` value its controller refuses - a payment of 0 or
            // -10 - was saved here. Held BEFORE anything below is written, so a refused run flips no
            // source status and spends no document number.
            gen.${toGenFolder}.api.${toJavaPerspective}.${toEntity}Controller.validate(
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository().calculatedForCreate(target));
    #end
    #if($sourceStatusValue != "")
            // Completion hook (intent `sourceStatus:`): the source document reaches its post-generation status
            // (e.g. a proforma flips to INVOICED). It runs BEFORE the target is saved, and that ordering is the
            // whole point: the flip is a lifecycle move the source's repository enforces, so a move its graph
            // does not declare throws here - with nothing yet created. Flipping AFTER the save left a committed
            // document behind whose source never transitioned and never published "-transitioned", so every
            // posting and integration keyed on the new status silently never ran; and because the guard above
            // returns on the existing document, a redelivery could not repair it either. This way a redelivery
            // re-runs the flip as a no-op (previous == next) and goes on to create what is missing.
            // Flip ONLY the status column, through the targeted primitive. A full-row
            // updateWithoutEvent(source) would merge the snapshot loaded at the top of create() and silently
            // revert any concurrent write to the source row (recalculated totals, a workflow status). Same
            // reason the process trigger writes ProcessId through the targeted primitive rather than update().
            // The "-transitioned" notice RIDES that write into the tenant's outbox, inside this unit's
            // own transaction, so the flip and its announcement commit together - a crash between the
            // commit and a separate publish lost the event outright, and the relay cannot recover what
            // was never recorded (dirigible #7160). It still announces a COMPLETED transition: the
            // events a unit records are handed to the broker only once the whole unit has committed,
            // so a target the lines below refuse takes the flip and this notice with it. The payload is
            // the source row exactly as the statement left it - never a re-read a concurrent write
            // could have moved on. No "-updated" re-fire either (no onUpdate reactions): the dedicated
            // "-transitioned" channel is what posting glue and integrations bind, as for a transitions
            // button and a workflow setter.
            gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository sourceRepository =
                    new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository();
            sourceRepository.updateProperties(sourceId, java.util.Map.of("${sourceStatusProperty}", ${sourceStatusValue}),
                    "${fromProjectName}-${fromPerspective}-${fromEntity}-transitioned");
    #end
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity saved =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository().save(target);
    #if($hasItems)
    #if($itemWhere != "")
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity srcItem : qualifying) {
    #else
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity srcItem :
                    new gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Repository()
                            .findAll(Criteria.create()
                                             .eq("${srcFkProperty}", sourceId))) {
    #end
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity item =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity();
    #foreach($a in $itemFieldAssignments)
                item.${a.targetProp} = ${a.expr};
    #end
                item.${toFkProperty} = saved.${toPk};
                try {
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Repository().save(item);
                } catch (org.eclipse.dirigible.sdk.db.ValidationException ex) {
                    // Name the SOURCE line the refused one was mapped from. The target's own message says
                    // which value is missing; without the row it came from, a document of a hundred lines
                    // leaves the caller nothing to go and fix (#7069).
                    throw new org.eclipse.dirigible.sdk.db.ValidationException(
                            ex.getMessage() + " (from ${fromItemEntity} [" + srcItem.${fromItemPk} + "])", ex);
                }
            }
    #end
    #if($hasReportItems)
            // The report's lines, then the counter lines, onto the saved header - through the line's own
            // repository, so its checks and the header's aggregates run as for a line typed by hand.
            gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Repository lineRepository =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Repository();
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity line : reportLines) {
                line.${toFkProperty} = saved.${toPk};
                lineRepository.save(line);
            }
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity counter : counterLines.values()) {
                counter.${toFkProperty} = saved.${toPk};
                lineRepository.save(counter);
            }
    #end
    #if($hasItemLines)
            // Computed line-items (intent `items:` list form - issue #6555): a fixed set of synthetic lines
            // whose cells are expressions over the loaded `source` master (Calc arithmetic / {} string
            // interpolation / source foreign-key copy), each optionally guarded by a `when` condition. Saved
            // through the target item repository so the target document's own line logic fires.
    #foreach($row in $itemLines)
    #if($row.guard != "")
            if (${row.guard})
    #end
            {
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity item =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity();
    #foreach($a in $row.assigns)
                item.${a.targetProp} = ${a.expr};
    #end
                item.${toFkProperty} = saved.${toPk};
                new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Repository().save(item);
            }
    #end
    #end
    #if($hasLink)
            // The link row back to the source (intent `link:` - issue #7748): a ${linkEntity} child of this
            // ${fromEntity} pointing at the ${toEntity} just created, written in THIS unit of work and through
            // its own repository, so its checks and the roll-ups over it run and a refusal takes the
            // ${toEntity} back with it. The unit's events are published only once it commits, so a consumer
            // of the ${toEntity}'s create event already sees this row - an auto-settlement finds the new
            // payment fully allocated here instead of spreading it over the oldest open document.
            gen.${fromGenFolder}.data.${linkJavaPerspective}.${linkEntity}Entity link =
                    new gen.${fromGenFolder}.data.${linkJavaPerspective}.${linkEntity}Entity();
            link.${linkParentFk} = sourceId;
            link.${linkTargetFk} = saved.${toPk};
    #foreach($a in $linkAssignments)
            link.${a.linkProp} = saved.${a.targetProp};
    #end
            // The link row's own row checks too, as its controller runs them (dirigible #7819) - its
            // repository holds only the capacity guard and the status-gated checks. A refusal throws
            // inside the unit, so the ${toEntity} saved above is taken back with it; either refusal reaches
            // the caller as the 400 the controller would have answered.
            gen.${fromGenFolder}.api.${linkJavaPerspective}.${linkEntity}Controller.validate(
                    new gen.${fromGenFolder}.data.${linkJavaPerspective}.${linkEntity}Repository().calculatedForCreate(link));
            new gen.${fromGenFolder}.data.${linkJavaPerspective}.${linkEntity}Repository().save(link);
    #end
    #if($hasBackLink)
            // The original's back-link to its reversal (intent `reversals: backLink:` - issue #7886),
            // written once the twin and its lines exist, in this unit: a refusal of anything above takes
            // it back with them. A targeted write of the one column, so a concurrent write to any other
            // column of the original is not reverted, and no "-updated" re-fires every reaction to it.
            new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().updateProperties(sourceId,
                    java.util.Map.of("${backLinkProperty}", saved.${toPk}));
    #end
            // Answer the ${toEntity} as this unit leaves it, not as it was first inserted: every line saved
            // above re-sums the header's aggregates through a targeted write, and a link row's roll-ups
            // land on the rows they total the same way, so the instance save() returned still carries
            // the zero totals it was inserted with before any line existed. The run answered exactly that
            // while a GET right after it showed the summed document (dirigible #8236). The re-read goes
            // through this unit's session, which a targeted write leaves without a stale copy of the row.
            return new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository().findById(saved.${toPk});
        });
        return result;
    }
#end
#if($hasUndo)

    /**
#if($undoDelete)
     * Deletes the ${toEntity} rows a run generated from the ${fromEntity}, in ONE unit, the ${fromEntity}
     * locked as the run locks it. Returns the deleted rows, or null when the source is gone.
#else
     * Reverses the live ${toEntity} a run generated from the ${fromEntity}, in ONE unit: the ${fromEntity}
     * is locked as run() locks it, and each live document is reversed by ${undoReversalClass}, whose own
     * refusals and back-link write hold. Returns the reversals, or null when the source is gone.
#end
     */
    public java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> undo(Integer sourceId) {
        return org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.callRetryingDeadlock(() -> {
            if (!new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().lockForUpdate(sourceId)) {
                return null;
            }
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository targetRepository =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository();
#if($undoDelete)
            // Exactly the rows a run generated: those carrying ${backRefProperty} back to this ${fromEntity},
            // deleted through the repository so the ${toEntity}'s own delete rules and events hold.
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> deleted =
                    targetRepository.findAll(Criteria.create()
                                                     .eq("${backRefProperty}", sourceId));
            if (deleted.isEmpty()) {
                throw new Refused("${name} has generated no ${toEntity} from this ${fromEntity} - there is nothing to undo");
            }
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity row : deleted) {
                targetRepository.delete(row);
            }
            return deleted;
#else
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> reversals = new java.util.ArrayList<>();
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity candidate : targetRepository.findAll(
                    Criteria.create()
                            .eq("${backRefProperty}", sourceId))) {
                if (!(${liveCondition})) {
                    continue;
                }
                if (candidate.${undoBackLinkProperty} != null) {
                    // Reversed already: the reversal retires it once it is posted.
                    throw new Refused("${toEntity} [" + candidate.${toPk} + "] is already reversed by [" + candidate.${undoBackLinkProperty}
                            + "] - post that reversal");
                }
#if($undoStatusProperty != "")
                int undoStatus = candidate.${undoStatusProperty} == null ? 0 : candidate.${undoStatusProperty};
                if (!(${undoStatusExpr})) {
                    throw new Refused("${toEntity} [" + candidate.${toPk} + "] is not in a status its reversal accepts ${undoStatuses} - current"
                            + " status is [" + undoStatus + "]");
                }
#end
#if($undoReversalRefuses)
                try {
                    reversals.add(new ${undoReversalClass}Generate().create(candidate.${toPk}));
                } catch (${undoReversalClass}Generate.Refused refused) {
                    throw new Refused(refused.getMessage());
                }
#else
                reversals.add(new ${undoReversalClass}Generate().create(candidate.${toPk}));
#end
            }
            if (reversals.isEmpty()) {
                throw new Refused("${name} has generated no live ${toEntity} from this ${fromEntity} - there is nothing to undo");
            }
            return reversals;
#end
        });
    }
#end
#if($hasReportItems || $hasReportRows)

    /**
     * The closing balance as one exact number (#8329): the closing debit less the closing credit
     * ({@code signed}), or the side it stands on ({@code netDebit} / {@code netCredit}) with the other side
     * zero - converted as {@link #decimalCell} converts an amount, and refused rather than rounded.
     */
    private static java.math.BigDecimal derivedCell(java.util.Map<String, Object> row, String debitColumn, String creditColumn,
            String derive, int scale, int sourceScale) {
        java.math.BigDecimal debit = decimalCell(row, debitColumn, sourceScale, sourceScale);
        java.math.BigDecimal credit = decimalCell(row, creditColumn, sourceScale, sourceScale);
        java.math.BigDecimal balance = (debit == null ? java.math.BigDecimal.ZERO : debit).subtract(credit == null ? java.math.BigDecimal.ZERO : credit);
        java.math.BigDecimal value = switch (derive) {
            case "netDebit" -> balance.max(java.math.BigDecimal.ZERO);
            case "netCredit" -> balance.negate()
                                       .max(java.math.BigDecimal.ZERO);
            default -> balance;
        };
        return decimalCell(java.util.Map.of(debitColumn, value), debitColumn, scale, sourceScale);
    }

    /**
     * An amount column of a report row as the exact decimal a field of {@code scale} holds - refused,
     * never rounded, when it cannot be (issue #8329). A report row parsed before report decimals were
     * read exactly (#8487) carries a double: it gives back the decimal it was parsed from only while
     * that decimal has at most 15 significant digits, which for amounts of {@code sourceScale} decimals
     * is below 10^(15 - sourceScale) - a larger one is refused.
     */
    private static java.math.BigDecimal decimalCell(java.util.Map<String, Object> row, String column, int scale, int sourceScale) {
        Object value = row.get(column);
        if (value == null) {
            return null;
        }
        java.math.BigDecimal amount;
        if (value instanceof Double || value instanceof Float) {
            double reading = ((Number) value).doubleValue();
            if (!(Math.abs(reading) < Math.pow(10, 15 - sourceScale))) {
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "report column [" + column + "] holds [" + value + "], too large to be read exactly");
            }
            amount = java.math.BigDecimal.valueOf(reading);
        } else {
            amount = new java.math.BigDecimal(String.valueOf(value));
        }
        try {
            return amount.setScale(scale, java.math.RoundingMode.UNNECESSARY);
        } catch (ArithmeticException needsRounding) {
            throw new org.eclipse.dirigible.sdk.db.ValidationException("report column [" + column + "] holds [" + amount.toPlainString()
                    + "], which a field of " + scale + " decimal places cannot hold without rounding");
        }
    }

    /** A whole-number column of a report row, refused when it is not one an Integer holds. */
    private static Integer integerCell(java.util.Map<String, Object> row, String column, int scale, int sourceScale) {
        Long value = longCell(row, column, scale, sourceScale);
        if (value != null && (value < Integer.MIN_VALUE || value > Integer.MAX_VALUE)) {
            throw new org.eclipse.dirigible.sdk.db.ValidationException("report column [" + column + "] holds [" + value + "], too large");
        }
        return value == null ? null : value.intValue();
    }

    /** A whole-number column of a report row, refused when it is not a whole number. */
    private static Long longCell(java.util.Map<String, Object> row, String column, int scale, int sourceScale) {
        Object value = row.get(column);
        if (value == null) {
            return null;
        }
        try {
            return new java.math.BigDecimal(String.valueOf(value)).longValueExact();
        } catch (NumberFormatException | ArithmeticException notWhole) {
            throw new org.eclipse.dirigible.sdk.db.ValidationException(
                    "report column [" + column + "] holds [" + value + "], which is not a whole number");
        }
    }

    /** A text column of a report row. */
    private static String textCell(java.util.Map<String, Object> row, String column, int scale, int sourceScale) {
        Object value = row.get(column);
        return value == null ? null : String.valueOf(value);
    }

    private static java.math.BigDecimal sum(java.math.BigDecimal left, java.math.BigDecimal right) {
        return left == null ? right : right == null ? left : left.add(right);
    }

    /**
     * Whether a row's cell satisfies one condition of the row rule: against no value, whether the cell
     * is empty ({@code eq}) or not ({@code ne}); against a number, compared as an exact decimal; against
     * text, equal or not.
     */
    private static boolean holds(Object value, String op, String literal) {
        if (literal == null) {
            return "eq".equals(op) ? value == null : value != null;
        }
        if (value == null) {
            return false;
        }
        int order;
        try {
            order = new java.math.BigDecimal(String.valueOf(value)).compareTo(new java.math.BigDecimal(literal));
        } catch (NumberFormatException text) {
            boolean equal = String.valueOf(value)
                                  .equals(literal);
            return "eq".equals(op) ? equal : "ne".equals(op) && !equal;
        }
        return switch (op) {
            case "eq" -> order == 0;
            case "ne" -> order != 0;
            case "gt" -> order > 0;
            case "ge" -> order >= 0;
            case "lt" -> order < 0;
            default -> order <= 0;
        };
    }
#end
}
