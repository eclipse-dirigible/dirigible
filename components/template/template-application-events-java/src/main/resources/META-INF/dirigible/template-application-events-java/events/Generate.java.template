package gen.events.${javaGenFolderName};

import org.eclipse.dirigible.components.data.store.java.repository.Criteria;
#if(!$eventOnly)
import org.eclipse.dirigible.sdk.http.Body;
import org.eclipse.dirigible.sdk.component.Component;
import org.eclipse.dirigible.sdk.http.Controller;
import org.eclipse.dirigible.sdk.http.Post;
#end
import org.eclipse.dirigible.sdk.utils.Json;
#if($hasItemLines)
import org.eclipse.dirigible.sdk.utils.Calc;
#end
#if($hasPrompt || $hasStatusGuard)
import org.eclipse.dirigible.sdk.http.Response;
#end

/**
 * Create-from ${name}: builds a new ${toEntity} from an existing ${fromEntity} (loaded by id), maps the
 * declared fields, and saves it through the target's generated repository - so the target's create-time
 * logic (document numbering, status init, calculated fields) fires. Any composition items are cloned and
 * re-pointed at the new master.
#if($itemWhere != "")
 *
 * Source-row rule (intent `items: where:` - issue #7091): only the source rows the rule qualifies become
 * lines, and a source whose rows all fail it refuses the run rather than committing a header with no
#if($itemRefuse != "")
 * lines. An unqualified row refuses it too (`refuse:`), naming the rows: leaving a rejected line out of
 * the document silently is as wrong as billing it silently, and this document says which it means.
#{else}
 * lines. An unqualified row is simply left out of the document (declare `refuse:` for the other reading).
#end
#end
 *
 * Generated from the intent generates block - do not edit; it is re-generated with the application.
 * Entity access goes ONLY through the generated repositories (validations / events / numbering).
#if(!$eventOnly)
 * The endpoint is served under /services/java/<project>/gen/events/${javaGenFolderName}/${className}Generate/run.
#else
 * There is no endpoint: this create-from is event-driven only, so ${className}GenerateOnEvent is its
 * single caller.
#end
#if($hasEvent)
#if($appendMode)
 *
 * Appends (intent `mode: append`): it is triggered by a ${fromEntity} event and keeps NO existing-target
 * lookup, so every delivery creates another ${toEntity} - the "a row per event" shape (a log, a
 * protocol). The ${backRefProperty} back-reference is still written on each row: it is that row's
 * provenance, not a dedup key. This is the ABSENCE of a guard, so an event redelivery appends a
 * duplicate; use `mode: once` for anything that must exist at most once.
#{else}
 *
 * At-most-once: it is triggered by a ${fromEntity} event, so it first looks for a ${toEntity} that
 * already back-references the source through ${backRefProperty} and returns that one instead of
 * creating a second document. That holds for the LIFETIME of that document, not merely for a
 * redelivery of the same event.
#if($hasRetiredStatus)
 * The exception is a RETIRED one: a ${toEntity} whose ${retiredStatusProperty} reached a stage classified
 * `cancelled` or `void` no longer counts, so the guard steps over it and the ${fromEntity} can be
 * generated from again - void and reissue. A draft or live ${toEntity} still blocks.
#end
 * A create-from with no event trigger deliberately keeps NO such guard - minting several targets from
 * one source is a legitimate manual act.
#end
#end
#if($hasStatusGuard)
 *
 * From-status guard (intent `fromStatus:`, or the one implied by `sourceStatus:` - issue #7068): the
 * endpoint refuses the run with 409 unless the source stands in a status the action accepts
 * [${guardStatuses}], and the contributed button stops offering itself in the others. A create-from
 * with a completion hook flips its source and then went on offering the same button on the flipped
 * record, so a second click minted a second document - another invoice for a proforma already invoiced.
 * The guard is on the CLICK: an event-driven run carries its own at-most-once back-reference guard.
#end
 */
#if(!$eventOnly)
@Controller
@Component("${javaGenFolderName}_${className}Generate")
#end
public class ${className}Generate {
#if(!$eventOnly)

    public static class Request {
        public Integer id;
#if($hasPrompt)
        // The declared `prompt:` inputs (issue #6685), keyed by the target's PascalCase property names.
        public java.util.Map<String, Object> values;
#end
    }

    @Post("/run")
    public String run(@Body Request req) {
        if (req == null || req.id == null) {
            return "{\"error\": \"missing source id\"}";
        }
#foreach($p in $promptFields)
#if($p.required)
        // A required `prompt:` input is refused BEFORE anything is written - the dialog checks the same
        // thing, and this is what makes the check hold for any other caller of the endpoint.
        if (req.values == null || req.values.get("${p.prop}") == null
                || String.valueOf(req.values.get("${p.prop}")).isBlank()) {
            Response.setStatus(400);
            return "{\"error\": \"missing required input [${p.prop}]\"}";
        }
#end
#end
#if($hasStatusGuard)
        // The from-status guard, asked BEFORE anything is created and only on this path: the click.
        // Calc reads the status FK with the calculated-field semantics (null -> 0, never a seed id).
        gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Entity guarded =
                new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().findById(req.id);
        if (guarded == null) {
            Response.setStatus(404);
            return "{\"error\": \"source ${fromEntity} not found\"}";
        }
        int currentStatus = org.eclipse.dirigible.sdk.utils.Calc.eval("${guardStatusProperty}", guarded, 0).intValue();
        if (!(${guardStatusExpr})) {
            Response.setStatus(409);
            return "{\"error\": \"${name} ${guardStatusText} - current status is [" + currentStatus + "]\"}";
        }
#end
        gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity saved = create(req.id#if($hasPrompt), req.values#end);
        if (saved == null) {
            return "{\"error\": \"source ${fromEntity} not found\"}";
        }
        return Json.stringify(saved);
    }
#end

    /**
     * Creates the ${toEntity} for the given ${fromEntity}, or returns null when the source is gone.
#if($hasPrompt)
     * The values map carries the declared `prompt:` inputs collected by the action dialog.
#end
     */
    public gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity create(Integer sourceId#if($hasPrompt), java.util.Map<String, Object> values#end) {
        // ONE transaction for the whole create-from: the target header, its lines and the source's
        // sourceStatus flip either all become durable or none of them does. Written as separate
        // transactions, a line that a validation or a constraint refuses left behind a header-only
        // document whose source was already marked as generated-from - a document that exists, counts
        // as the period's billing, and is missing exactly what it was for, with no way back but an
        // administrator (dirigible #7069). Reads inside the block see the block's own writes, so the
        // status the flip below wrote is what the rest of the block - and its announcement's payload -
        // reads.
        gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity result =
                org.eclipse.dirigible.components.data.store.java.repository.UnitOfWork.call(() -> {
            gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Entity source =
                    new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository().findById(sourceId);
            if (source == null) {
                return null;
            }
    #if($hasEvent && !$appendMode)
            // Already generated for this source (an event redelivery, or a click after the event) - hand back
            // the existing document rather than minting a duplicate. Best-effort against two concurrent
            // deliveries until a UNIQUE key on the back-reference lands, exactly as postings' guard is.
            java.util.List<gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity> existing =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository().findAll(
                            Criteria.create()
                                    .eq("${backRefProperty}", sourceId));
    #if(!$hasRetiredStatus)
            if (!existing.isEmpty()) {
                return existing.get(0);
            }
    #else
            // ...unless that document was retired: a ${retiredStatusProperty} classified `cancelled` or `void`
            // (the seeded `stage:` classification) means the ${toEntity} no longer counts, so the ${fromEntity}
            // may be generated from again - void and reissue. A draft or live one still blocks (dirigible #6814).
            for (gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity candidate : existing) {
                if (candidate.${retiredStatusProperty} == null || !(${retiredStatusCondition})) {
                    return candidate;
                }
            }
    #end
    #end
    #foreach($load in $relationLoads)
            // A one-hop `relation.field` map source: the related row is loaded by the source's foreign key,
            // once, and read below. Loaded AFTER the at-most-once guard so an already-generated source costs
            // no extra query, and null-guarded because a nullable relation is a legitimate empty value.
            gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Entity ${load.local} = source.${load.fkProperty} == null ? null : new gen.${load.javaGenFolder}.data.${load.javaTargetPerspective}.${load.targetEntity}Repository().findById(source.${load.fkProperty});
    #end
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity target =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity();
    #foreach($a in $fieldAssignments)
            target.${a.targetProp} = ${a.expr};
    #end
    #if($hasPrompt)
            // Declared input form (intent `prompt:` - issue #6685): the values the user supplied in the
            // action dialog, set on the target AFTER map/defaults (the parser rejects overlaps, so every
            // property has exactly one writer). The required ones were already checked in run(), which is
            // this method's only caller - a prompted create-from cannot be event-driven, there being
            // nobody to answer. An absent optional input leaves the target's own default in place.
    #foreach($p in $promptFields)
            {
                Object raw = values == null ? null : values.get("${p.prop}");
                if (!(raw == null || String.valueOf(raw).isBlank())) {
                    target.${p.prop} = ${p.expr};
                }
            }
    #end
    #end
    #if($sourceStatusValue != "")
            // Completion hook (intent `sourceStatus:`): the source document reaches its post-generation status
            // (e.g. a proforma flips to INVOICED). It runs BEFORE the target is saved, and that ordering is the
            // whole point: the flip is a lifecycle move the source's repository enforces, so a move its graph
            // does not declare throws here - with nothing yet created. Flipping AFTER the save left a committed
            // document behind whose source never transitioned and never published "-transitioned", so every
            // posting and integration keyed on the new status silently never ran; and because the guard above
            // returns on the existing document, a redelivery could not repair it either. This way a redelivery
            // re-runs the flip as a no-op (previous == next) and goes on to create what is missing.
            // Flip ONLY the status column, through the targeted primitive. A full-row
            // updateWithoutEvent(source) would merge the snapshot loaded at the top of create() and silently
            // revert any concurrent write to the source row (recalculated totals, a workflow status). Same
            // reason the process trigger writes ProcessId through the targeted primitive rather than update().
            // The "-transitioned" notice RIDES that write into the tenant's outbox, inside this unit's
            // own transaction, so the flip and its announcement commit together - a crash between the
            // commit and a separate publish lost the event outright, and the relay cannot recover what
            // was never recorded (dirigible #7160). It still announces a COMPLETED transition: the
            // events a unit records are handed to the broker only once the whole unit has committed,
            // so a target the lines below refuse takes the flip and this notice with it. The payload is
            // the source row exactly as the statement left it - never a re-read a concurrent write
            // could have moved on. No "-updated" re-fire either (no onUpdate reactions): the dedicated
            // "-transitioned" channel is what posting glue and integrations bind, as for a transitions
            // button and a workflow setter.
            gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository sourceRepository =
                    new gen.${fromGenFolder}.data.${fromJavaPerspective}.${fromEntity}Repository();
            sourceRepository.updateProperties(sourceId, java.util.Map.of("${sourceStatusProperty}", ${sourceStatusValue}),
                    "${fromProjectName}-${fromPerspective}-${fromEntity}-transitioned");
    #end
            gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Entity saved =
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toEntity}Repository().save(target);
    #if($hasItems)
    #if($itemWhere != "")
            // Source-row rule (intent `items: where:` - issue #7091): only the source rows the rule
            // qualifies become lines. Pushed into the very query that selects them by their master
            // foreign key, so an unqualified row is never loaded. Without a rule every row was cloned,
            // which billed a draft or rejected line at the same footing as an approved one - and, since
            // the target refuses a line missing a required value, let ONE empty row stop the whole month
            // from being invoiced with nothing the intent could say about it.
            java.util.List<gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity> qualifying =
                    new gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Repository()
                            .findAll(Criteria.create()
                                             .eq("${srcFkProperty}", sourceId)${itemWhere});
    #if($itemRefuse != "")
            // `refuse:` - an unqualified row stops the whole create-from instead of being left out.
            // Dropping a rejected line silently and billing it silently are both wrong, for different
            // months; which one this document means is the author's call, and this is it. The keys of
            // the offending rows travel with the message: which of them to go and fix is the whole
            // question the caller has.
            java.util.Set<Object> qualifyingKeys = new java.util.HashSet<>();
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity row : qualifying) {
                qualifyingKeys.add(row.${fromItemPk});
            }
            java.util.List<Object> unqualified = new java.util.ArrayList<>();
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity row :
                    new gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Repository()
                            .findAll(Criteria.create()
                                             .eq("${srcFkProperty}", sourceId))) {
                if (!qualifyingKeys.contains(row.${fromItemPk})) {
                    unqualified.add(row.${fromItemPk});
                }
            }
            if (!unqualified.isEmpty()) {
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "${itemRefuseJavaLiteral} (${fromItemEntity} " + unqualified + ")");
            }
    #end
            if (qualifying.isEmpty()) {
                // Every row failed the rule, so the ${toEntity} would carry no lines at all. A document
                // of no lines is not the document that was asked for, and it is the harder of the two
                // failures to notice - it exists, it counts as the period's billing, and it is empty.
                throw new org.eclipse.dirigible.sdk.db.ValidationException(
                        "no ${fromItemEntity} row of the ${fromEntity} qualifies for ${name}, so the ${toEntity} would have no lines");
            }
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity srcItem : qualifying) {
    #else
            for (gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Entity srcItem :
                    new gen.${fromGenFolder}.data.${fromItemJavaPerspective}.${fromItemEntity}Repository()
                            .findAll(Criteria.create()
                                             .eq("${srcFkProperty}", sourceId))) {
    #end
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity item =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity();
    #foreach($a in $itemFieldAssignments)
                item.${a.targetProp} = ${a.expr};
    #end
                item.${toFkProperty} = saved.${toPk};
                try {
                    new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Repository().save(item);
                } catch (org.eclipse.dirigible.sdk.db.ValidationException ex) {
                    // Name the SOURCE line the refused one was mapped from. The target's own message says
                    // which value is missing; without the row it came from, a document of a hundred lines
                    // leaves the caller nothing to go and fix (#7069).
                    throw new org.eclipse.dirigible.sdk.db.ValidationException(
                            ex.getMessage() + " (from ${fromItemEntity} [" + srcItem.${fromItemPk} + "])", ex);
                }
            }
    #end
    #if($hasItemLines)
            // Computed line-items (intent `items:` list form - issue #6555): a fixed set of synthetic lines
            // whose cells are expressions over the loaded `source` master (Calc arithmetic / {} string
            // interpolation / source foreign-key copy), each optionally guarded by a `when` condition. Saved
            // through the target item repository so the target document's own line logic fires.
    #foreach($row in $itemLines)
    #if($row.guard != "")
            if (${row.guard})
    #end
            {
                gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity item =
                        new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Entity();
    #foreach($a in $row.assigns)
                item.${a.targetProp} = ${a.expr};
    #end
                item.${toFkProperty} = saved.${toPk};
                new gen.${toGenFolder}.data.${toJavaPerspective}.${toItemEntity}Repository().save(item);
            }
    #end
    #end
            return saved;
        });
        return result;
    }
}
