#macro(captureMatch $relation)
        boolean readAny = false;
        boolean ambiguous = false;
        String last = null;
#foreach($key in $relation.keys)
        String key${foreach.count} = read.text(${key.schemaNameLiteral});
        if (key${foreach.count} != null) {
            readAny = true;
            last = key${foreach.count};
            List<gen.${relation.genFolder}.data.${relation.javaTargetPerspective}.${relation.targetEntity}Entity> matches${foreach.count} =
                    new gen.${relation.genFolder}.data.${relation.javaTargetPerspective}.${relation.targetEntity}Repository().findAll(
                            Criteria.create()
                                    .eq("${key.byProperty}", key${foreach.count}));
            if (matches${foreach.count}.size() == 1) {
                row.${relation.property} = matches${foreach.count}.get(0).${relation.targetKeyProperty};
                return;
            }
            ambiguous |= matches${foreach.count}.size() > 1;
        }
#end
        if (!readAny) {
            flags.add(CaptureFlag.of(label, CaptureFlag.Reason.MISSING, null, "not found on the document"));
        } else if (ambiguous) {
            flags.add(CaptureFlag.of(label, CaptureFlag.Reason.AMBIGUOUS_MATCH, last, "several ${relation.targetEntity} records match what the document prints"));
        } else {
            flags.add(CaptureFlag.of(label, CaptureFlag.Reason.NO_MATCH, last, "no ${relation.targetEntity} matches what the document prints"));
        }
#end
package gen.events.${javaGenFolderName};

