#set($dollar = '$')
/*
 * Generated by Eclipse Dirigible based on model and template.
 *
 * Do not modify the content as it may be re-generated again.
 */

/*
 * Document (header-items) editor for ${name}. One component serves all three routes:
 *   /${name}/create         -> create mode (header only; items enable once the header is saved)
 *   /${name}/{id}/edit      -> edit mode (loads the document, its items, and the totals)
 *   /${name}/{id}/preview   -> preview mode (same data as edit, everything read-only; Print stays)
 *
 * Layout (see ${name}-document.html): the master's own fields as a header form (the `aggregate`
 * totals are excluded here and shown in the footer), an inline-editable line-items table for the
 * ${documentItemsEntity} child (per-row server-side create/update/delete), and a right-aligned totals
 * footer. After every item change the header is re-fetched (GET) so server-side calculated fields
 * (Net / VAT / Total ...) refresh. Built on baseFormPage so a 422 maps onto per-field errors.
 */

/*
 * Neutral arithmetic evaluator — the client mirror of the server-side SDK `Calc`. One formula string,
 * authored once on a model property, runs here for the live line-item preview and (verbatim) in Java.
 *
 * Grammar:  expr   := term (('+'|'-') term)*
 *           term   := factor (('*'|'/') factor)*
 *           factor := NUMBER | IDENT | '(' expr ')' | ('-'|'+') factor | func
 *           func   := IDENT '(' expr (',' expr)* ')'
 * Functions: round(x,n), abs(x), min(a,b), max(a,b), ceil(x), floor(x).
 * Semantics contract (must match the Java side exactly):
 *   - IDENT reads from `vars`; null / '' / missing / non-numeric -> 0
 *   - division by zero -> 0
 *   - round = half-up, ties away from zero (Java RoundingMode.HALF_UP)
 *   - the final result is rounded to `scale` decimals (default 2) with the same rule
 */
function harmoniaCalcEval(expr, vars, scale) {
  const roundHalfUp = (x, n) => {
    if (!isFinite(x)) return 0;
    const f = Math.pow(10, n);
    const sign = x < 0 ? -1 : 1;
    return sign * Math.floor(Math.abs(x) * f + 0.5) / f;
  };
  // Date support (mirrors the Java Calc exactly): a date-shaped identifier reads as its EPOCH DAY,
  // which the *Between functions consume. businessDaysBetween counts Mon-Fri in the CLOSED interval.
  const businessDaysBetween = (from, to) => {
    from = Math.floor(from); to = Math.floor(to);
    if (to < from) return 0;
    const days = to - from + 1;
    let count = Math.floor(days / 7) * 5;
    const startWeekday = ((from + 3) % 7 + 7) % 7; // Monday = 0 ... Sunday = 6 (epoch day 0 = Thursday)
    for (let k = 0; k < days % 7; k++) if ((startWeekday + k) % 7 < 5) count++;
    return count;
  };
  const monthsBetween = (from, to) => {
    const a = new Date(Math.floor(from) * 86400000), b = new Date(Math.floor(to) * 86400000);
    return (b.getUTCFullYear() - a.getUTCFullYear()) * 12 + (b.getUTCMonth() - a.getUTCMonth());
  };
  const fns = {
    round: (x, n) => roundHalfUp(x, n == null ? 0 : Math.trunc(n)),
    abs: Math.abs, min: Math.min, max: Math.max, ceil: Math.ceil, floor: Math.floor,
    daysBetween: (a, b) => Math.floor(b) - Math.floor(a),
    businessDaysBetween: businessDaysBetween,
    monthsBetween: monthsBetween,
  };
  const s = String(expr == null ? '' : expr);
  let i = 0;
  const ws = () => { while (i < s.length && /\s/.test(s[i])) i++; };
  const peek = () => { ws(); return s[i]; };
  function parseExpr() {
    let v = parseTerm();
    for (;;) {
      const c = peek();
      if (c === '+') { i++; v += parseTerm(); }
      else if (c === '-') { i++; v -= parseTerm(); }
      else return v;
    }
  }
  function parseTerm() {
    let v = parseFactor();
    for (;;) {
      const c = peek();
      if (c === '*') { i++; v *= parseFactor(); }
      else if (c === '/') { i++; const d = parseFactor(); v = d === 0 ? 0 : v / d; }
      else return v;
    }
  }
  function parseFactor() {
    const c = peek();
    if (c === '-') { i++; return -parseFactor(); }
    if (c === '+') { i++; return parseFactor(); }
    if (c === '(') { i++; const v = parseExpr(); ws(); if (s[i] === ')') i++; return v; }
    if ((c >= '0' && c <= '9') || c === '.') return parseNumber();
    return parseIdentOrFunc();
  }
  function parseNumber() {
    ws(); const j = i;
    while (i < s.length && /[0-9.]/.test(s[i])) i++;
    return parseFloat(s.slice(j, i)) || 0;
  }
  function parseIdentOrFunc() {
    ws(); const j = i;
    while (i < s.length && /[A-Za-z0-9_]/.test(s[i])) i++;
    const name = s.slice(j, i);
    if (peek() === '(') {
      i++;
      const args = [];
      if (peek() !== ')') { args.push(parseExpr()); while (peek() === ',') { i++; args.push(parseExpr()); } }
      ws(); if (s[i] === ')') i++;
      const fn = fns[name];
      return fn ? (Number(fn.apply(null, args)) || 0) : 0;
    }
    const raw = vars ? vars[name] : undefined;
    if (raw === null || raw === undefined || raw === '') return 0;
    const n = Number(raw);
    if (!isNaN(n)) return n;
    // Date-shaped value (HTML date/datetime input string or a Jackson [y,m,d...] array) -> epoch day,
    // matching the Java Calc's coercion so the date functions preview identically.
    if (Array.isArray(raw) && raw.length >= 3) return Math.floor(Date.UTC(raw[0], raw[1] - 1, raw[2]) / 86400000);
    const m = /^\d{4}-\d{2}-\d{2}/.exec(String(raw).trim());
    if (m) { const d = new Date(m[0] + 'T00:00:00Z'); if (!isNaN(d.getTime())) return Math.floor(d.getTime() / 86400000); }
    return 0;
  }
  const result = parseExpr();
  return roundHalfUp(isFinite(result) ? result : 0, scale == null ? 2 : scale);
}

## Document-role properties (the number/title field and the status FK), derived once here so they are
## available to duplicate()'s clone-strip list below (which runs before the status-pill #set further down).
#set($docNumberProp = "")
#set($docStatusProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_NUMBER")#set($docNumberProp = $property.name)#end
#if($property.widgetType == "DOCUMENT_STATUS")#set($docStatusProp = $property.name)#end
#end
document.addEventListener('alpine:init', () => {
  Alpine.data('${name}DocumentPage', () => ({
    ...baseFormPage(),

    state: 'ready',          // empty-form | loading | ready | saving | validation-error | save-failure | load-failure
    mode: 'create',
    id: null,
    record: {},              // the loaded master (drives the read-only totals footer + calculated header fields)

    // Header form model — the master's editable scalar/relationship fields, EXCLUDING the aggregate
    // totals (those are server-calculated, shown read-only in the footer) and the auto-increment PK.
    form: {
#foreach($property in $properties)
## ProcessIds stays OUT of the form model: it is the per-process at-most-once bookkeeping the
## trigger listener writes, and a form that carried it would post a stale copy back over a stamp
## written while the document was open.
#if(!$property.dataAutoIncrement && $property.aggregate != "true" && $property.name != "ProcessIds")
#if($property.widgetType == "CHECKBOX")
      ${property.name}: false,
#elseif($property.widgetType == "NUMBER")
      ${property.name}: null,
#elseif($property.widgetType == "MULTISELECT")
      ${property.name}: [],
#else
      ${property.name}: '',
#end
#end
#end
    },

#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT") && $property.aggregate != "true")
    options${property.name}: [],
#end
#end

    // Items table state (the ${documentItemsEntity} child, rendered inline).
    itemsDef: null,
    items: [],
    itemsState: 'loading',   // loading | error | empty | default
    itemsError: null,
#if($documentItemsLayout == "chat")
    // Chat composer state (documentItemsLayout: chat): appends a message as a new child row.
    chatDraft: '',
    chatSending: false,
    chatInternal: false,
#end
#if($documentItemsLayout == "calendar")
    // Reactive config for the items x-h-calendar (the items child declares view: calendar); rebuilt
    // after every items load so the calendar re-renders. The view comes from the child's own
    // declaration, which rides its detail registration.
    itemsCalCfg: { view: 'month', events: [] },
#end
    itemOptions: {},         // edit-column name -> [{ value, text }] for relationship cells
    // Depends-On-filtered options for the OPEN item dialog only. Kept apart from itemOptions,
    // which the items table uses to resolve labels for ALL rows and must stay the full set.
    draftOptions: {},
    // Statically-filtered chooser sets (intent `where:` on a column) - loaded once per column;
    // itemOptions keeps the FULL set for the items table's label resolution.
    filteredOptions: {},
    _draftInitializing: false,
    deleteOpen: false,
    deleteTarget: null,
    // Add/edit line dialog
    rowDialogOpen: false,
    draft: {},
    draftMode: 'create',     // 'create' | 'edit'
    draftSaving: false,
    draftError: null,
    // Print (renders the CMS-seeded .print template server-side to PDF)
    printLangOpen: false,
    printLanguages: [],
    printBusy: false,
    printError: null,

    apiPath: '/${javaPerspectiveName}/${name}Controller',
#if($history == "true")

    // Change history (intent `history: true`): the document's field-level trail, read from the
    // controller's GET /{id}/history. Read-only - nothing here writes to the shadow table.
    history: [],
#set($historyFirst = true)
    historyLabels: {#foreach($property in $properties)#if(!$property.dataPrimaryKey && (!$property.auditType || $property.auditType == "NONE"))#if($property.widgetLabel)#set($hlabel = $property.widgetLabel)#else#set($hlabel = $property.name)#end#if($historyFirst)#set($historyFirst = false)#else, #end'${property.name}': ['$projectName:${tprefix}.t.${property.dataName}', '${hlabel}']#end#end},
#end
#if($immutableStatusProperty || $immutableAlways || $periodLock)

    // Immutability pre-check (intent `immutable`/`immutableWhen:`), asked from the controller's
    // GET /{id}/mutable so the Edit affordances stay honest - an /edit URL typed directly opens
    // read-only. The controller's PUT/DELETE 409 stays authoritative; the pre-check fails OPEN
    // (an outage must not lock the UI - the server still refuses the write).
    mutable: true,
#end

    // Entity name used to match developer-contributed custom actions ($store.customActions) targeted
    // at this document. Set here (not inline in the view) so Velocity substitutes it - a $store.*(...)
    // call in the template would emit any nested ${...} verbatim.
    caView: '${name}',

    get isEdit() { return this.mode === 'edit'; },
    get isPreview() { return this.mode === 'preview'; },
    get errorCount() { return Object.keys(this.errors).filter(k => this.errors[k]).length; },
    // Items can only be added once the document (header) exists, so we have a master id to bind them to.
    get itemsEnabled() { return (this.isEdit || this.isPreview) && this.id != null; },
    // Any OTHER composition child of this master (not the line-items entity) renders as a normal panel —
    // like the line items, only once the document (header) exists (nothing to allocate against on Create).
    get secondaryDetails() { return this.itemsEnabled ? App.detailsFor('${name}').filter(d => d.entity !== '${documentItemsEntity}') : []; },
    // Read-only registers of the records REFERENCING this document (empty unless the model declares
    // any). Available once the document exists, like the detail panels.
    get relatedDefs() { return this.itemsEnabled ? App.relatedFor('${name}') : []; },

    // ===== Print: the .print template lives in the CMS (Templates/${name}/Print/<lang>/), where it
    // can be customized via the Documents perspective. One language prints directly; several ask.
    //
    // Print always renders LIVE (fetch languages; one prints directly, several ask). The immutable
    // issued copy stays first-class on its own surface: the read-only Snapshot panel on this page
    // serves every stored version (Open + Download), so a live re-render after master-data changes
    // is acceptable - the copy that IS the record is one click away.
    async openPrint() {
      this.printError = null;
      this.printBusy = true;
      let languages = [];
      try {
        languages = (await App.services.api.get('/services/print/${name}/languages', { baseUrl: '' })) || [];
      } catch (e) {
        console.error('Print languages lookup failed', e);
      }
      this.printBusy = false;
      if (languages.length > 1) {
        // Several templates: ALWAYS ask (auto-printing the configured language here suppressed the
        // dialog entirely, since the locale store always resolves to a value - a shipped regression).
        // The Region & Language setting only pre-sorts its language first as the suggested default.
        const configured = (Alpine.store('locale') || {}).value;
        this.printLanguages = languages.slice().sort((a, b) =>
          (a.code === configured ? -1 : 0) - (b.code === configured ? -1 : 0));
        this.printLangOpen = true;
      } else {
        // zero languages still attempts the default: the server answers with a clear 404
        await this.printDoc(languages.length === 1 ? languages[0].code : 'en');
      }
    },

    async printDoc(lang) {
      this.printError = null;
      this.printBusy = true;
      try {
        // The generated print feeder (gen/events/${javaGenFolderName}/${name}PrintFeeder) loads the document + its related
        // graph through the repositories and returns the { document, items } payload the template binds
        // - so {{document.<Relation>.<Field>}} resolves. It is the auditable source of what a print
        // receives; the browser calls it as the logged-in user (auth + tenant + i18n are the caller's).
        // Pin the feeder's language to the CHOSEN print language, not the UI locale: the repositories'
        // multilingual overlay reads Accept-Language, so without this the nomenclature values (Payment
        // Method, Status, ...) would render in the UI locale while the template is in the print language.
        const payload = await App.services.api.get(
          '/services/java/${projectName}/gen/events/${javaGenFolderName}/${name}PrintFeeder/' + encodeURIComponent(this.id), { baseUrl: '', language: lang });
        const response = await fetch('/services/print/${name}?lang=' + encodeURIComponent(lang), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          this.printError = response.status === 404
            ? 'No print template found. Publish the project or upload one via Documents.'
            : 'Print failed (' + response.status + ')';
          return;
        }
        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        // The object URL must outlive the tab that renders it: a timed revoke kills the PDF
        // viewer's reload/print the moment it fires (observed live - the blob tab worked once,
        // then "the file was removed"). The URL is released when THIS page unloads, which is the
        // blob's natural owner lifetime; a print-sized PDF held until then costs nothing.
        const opened = window.open(url, '_blank');
        if (!opened) {
          // Popup blocked - the open runs after async work, outside the click's gesture stack.
          // Fall back to a download, which the browser always allows.
          const link = document.createElement('a');
          link.href = url;
          link.download = '${name}-' + this.id + '.pdf';
          document.body.appendChild(link);
          link.click();
          link.remove();
        }
      } catch (e) {
        console.error('Print failed', e);
        this.printError = 'Print failed';
      } finally {
        this.printBusy = false;
      }
    },

    async init() {
#if($hasRestrictedFields)
      // Role-scoped fields: ask the controller which ones it withholds from this caller, so the header
      // form and the totals footer leave them out rather than showing an input or a total that is
      // never served and never saved.
      this.loadRestrictedFields();
#end
      const params = (window.PineconeRouter.context && window.PineconeRouter.context.params) || {};
      this.id = params.id ?? null;
      // Read the live hash to tell /preview from /edit (Pinecone's context can lag the hash).
      const routePath = (window.location.hash || '').split('?')[0];
      this.mode = this.id == null ? 'create' : (routePath.endsWith('/preview') ? 'preview' : 'edit');

      // The line-items child registered itself as a detail of this master; pick it by name.
      this.itemsDef = App.detailsFor('${name}').find(d => d.entity === '${documentItemsEntity}') || null;

      // The child declares in its registration whether it HAS role-scoped columns; only then is there
      // anything to ask its controller about. Awaited, so the line dialog's column metadata is already
      // pruned when the watchers below are registered against it.
      if (this.itemsDef && this.itemsDef.restrictedFields) {
        try {
          const answer = await App.services.api.get(this.itemsDef.apiPath + '/restricted');
          this.itemRestricted = (answer && answer.restricted) || [];
        } catch (e) {
          console.error('[restricted] could not read the line-item field visibility', e);
        }
      }

      // Depends-On watchers for the item dialog, one per distinct trigger column (metadata-driven,
      // registered once; openRowDialog suppresses them while a draft is being built).
      const draftDepTriggers = [...new Set(this.editColumns.filter(c => c.dependsOn && !c.dependsOn.header)
                                                           .map(c => c.dependsOn.property))];
      for (const t of draftDepTriggers) {
        this.${dollar}watch('draft.' + t, (v) => {
          if (this._draftInitializing || v == null || v === '') return;
          this.applyDraftDependsOn(t, true);
        });
      }

      // Header-mediated Depends-On (#6358): the trigger is a HEADER relation, so watch the header form
      // and refresh an open line draft when the document's selection changes.
      const headerDepTriggers = [...new Set(this.editColumns.filter(c => c.dependsOn && c.dependsOn.header)
                                                            .map(c => c.dependsOn.property))];
      for (const t of headerDepTriggers) {
        this.${dollar}watch('form.' + t, (v) => {
          if (this._draftInitializing || !this.rowDialogOpen || v == null || v === '') return;
          this.applyHeaderDependsOnToDraft();
        });
      }

      await this.loadOptions();

      if (this.isEdit || this.isPreview) {
        this.state = 'loading';
        try {
          await this.loadHeader();
#if($immutableStatusProperty || $immutableAlways || $periodLock)
          try {
            const m = await App.services.api.get(this.apiPath + '/' + encodeURIComponent(this.id) + '/mutable');
            this.mutable = !m || m.mutable !== false;
          } catch (e) {
            console.error('[${name}DocumentPage] mutable pre-check failed', e);
          }
          // An immutable document opened on the /edit route renders as preview - header, items and
          // panels all read-only, exactly as if Preview had been chosen (or the URL said /preview).
          if (!this.mutable && this.isEdit) this.mode = 'preview';
#end
#if($history == "true")
          await this.loadHistory();
#end
          this.state = 'ready';
          await this.loadItems();
        } catch (e) {
          this.applyLoadError(e, { fallbackMessage: 'Could not load the ${name} document.' });
        }
      } else {
        for (const key of Object.keys(this.form)) {
          const v = this.queryParam(key);
          if (v !== null) this.form[key] = v;
        }
        this.state = 'empty-form';
      }
#foreach($property in $properties)
#if($property.widgetDependsOnProperty && $property.widgetDependsOnControllerUrl && $property.aggregate != "true")
#if($property.widgetType == "DROPDOWN")
      // Depends-On: filter ${property.name}'s options for an already-populated trigger
      // (edit/prefill) WITHOUT touching the stored value, then watch for user changes.
      if (this.form.${property.widgetDependsOnProperty} != null && this.form.${property.widgetDependsOnProperty} !== '') {
        await this.applyDependsOn${property.name}(this.form.${property.widgetDependsOnProperty}, false);
      }
#end
      this.${dollar}watch('form.${property.widgetDependsOnProperty}', (v) => {
        if (v != null && v !== '') this.applyDependsOn${property.name}(v, true);
      });
#end
#end
      this.refreshIcons();
    },

    // GET the master record into both the header form and `record` (the footer reads calculated totals
    // from `record`). Called on load and after every item change so server-side totals stay fresh.
    async loadHeader() {
      const record = await App.services.api.get(this.apiPath + '/' + encodeURIComponent(this.id));
      this.record = record || {};
      for (const key of Object.keys(this.form)) {
        if (record[key] !== undefined) this.form[key] = record[key];
      }
#foreach($property in $properties)
#if($property.isDateType && $property.aggregate != "true")
      if (this.form.${property.name} != null) this.form.${property.name} = this.toDateInput(this.form.${property.name}, '${property.widgetType}');
#end
#end
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS") && $property.aggregate != "true")
      if (this.form.${property.name} != null) this.form.${property.name} = String(this.form.${property.name});
#end
#end
      // A MULTISELECT stores the selected keys as one csv ("1,3"); the select's model is an ARRAY
      // of strings matching the options' data-values, so split on load (empty/null -> []).
#foreach($property in $properties)
#if($property.widgetType == "MULTISELECT" && $property.aggregate != "true")
      this.form.${property.name} = (this.form.${property.name} == null || this.form.${property.name} === '')
          ? [] : String(this.form.${property.name}).split(',').map(v => v.trim());
#end
#end
#foreach($property in $properties)
#if($property.widgetOptionsFilterBy && ($property.widgetType == "DROPDOWN" || $property.widgetType == "MULTISELECT") && $property.aggregate != "true")
      // Static option filter (intent `where:`): a header value stored outside the filter is absent from
      // the filtered chooser list, so its label would not resolve on edit. Splice in that row by id -
      // the filter still governs what may be newly picked. A MULTISELECT holds SEVERAL keys, each of
      // which may have fallen outside the filter.
      await this.ensureFilteredCurrent('${property.name}', '${property.widgetDropdownControllerUrl}', '${property.widgetDropDownKey}', '${property.widgetDropDownValue}');
#end
#end
      this.refreshIcons();
    },

    async loadOptions() {
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT") && $property.aggregate != "true")
      try {
#if($property.widgetOptionsFilterBy)
        // Static option filter (intent `where:`): the chooser lists only matching rows.
        const rows${property.name} = await App.services.api.post('${property.widgetDropdownControllerUrl}/search', {
          conditions: [{ propertyName: '${property.widgetOptionsFilterBy}', operator: 'EQ', value: ${property.widgetOptionsFilterValueJs} }]
        }, { baseUrl: '' });
#else
        const rows${property.name} = await App.services.api.getAll('${property.widgetDropdownControllerUrl}', { baseUrl: '' });
#end
#if($property.widgetLeafOnly && $property.widgetHierarchyProperty)
        // leafOnly hierarchy picker: depth-indented, childless nodes only (server re-validates).
        this.options${property.name} = this.hierarchizeOptions(rows${property.name}, {
          key: '${property.widgetDropDownKey}', text: '${property.widgetDropDownValue}',
          parent: '${property.widgetHierarchyProperty}', leafOnly: true
        });
#else
        this.options${property.name} = (rows${property.name} || []).map(e => ({ value: e.${property.widgetDropDownKey}, text: e.${property.widgetDropDownValue}#if($property.widgetType == "DOCUMENT_STATUS"), description: e.description#end }));
#end
      } catch (e) {
        console.error('[${name}DocumentPage] failed to load options for ${property.name}', e);
      }
#end
#end
#foreach($property in $properties)
#if($property.widgetDependsOnProperty && $property.widgetDependsOnControllerUrl && $property.widgetType == "DROPDOWN" && $property.aggregate != "true")
      // Re-apply the Depends-On filter after a full reload (Refresh / Add-new keep the cascade).
      if (this.form.${property.widgetDependsOnProperty} != null && this.form.${property.widgetDependsOnProperty} !== '') {
        await this.applyDependsOn${property.name}(this.form.${property.widgetDependsOnProperty}, false);
      }
#end
#end
    },

    // "Add new <related>" from a header FK combobox: open the target's own create page in the shared
    // related-create iframe dialog; on save, reload that field's options and select the new record.
    addRelated(field, controllerUrl, entity) {
      Alpine.store('related').create(App.utils.relatedCreateUrl(controllerUrl, entity), T('$projectName:${tprefix}.defaults.newTitle', 'New {{name}}', { name: entity }), async (id) => {
        await this.loadOptions();
        if (id != null) this.form[field] = String(id);
      });
    },
#foreach($property in $properties)
#if($property.widgetDependsOnProperty && $property.widgetDependsOnControllerUrl && $property.aggregate != "true")

    // Depends-On: ${property.name} reacts to ${property.widgetDependsOnProperty} - load the selected
    // ${property.widgetDependsOnEntity} record and read its #if($property.widgetDependsOnValueBy)case-selected property#{else}${property.widgetDependsOnValueFrom}#end.
    async applyDependsOn${property.name}(value, adjust) {
      try {
        const rec = await App.services.api.get('${property.widgetDependsOnControllerUrl}/' + encodeURIComponent(value), { baseUrl: '' });
#if($property.widgetDependsOnValueBy)
        const prop${property.name} = await this.resolveDependsOnSource({ path: '${property.widgetDependsOnValueBy}', header: false, #if($property.widgetDependsOnValueByUrl)url: '${property.widgetDependsOnValueByUrl}', #{end}cases: ${property.widgetDependsOnValueCases}#if($property.widgetDependsOnValueDefault), deflt: '${property.widgetDependsOnValueDefault}'#end }, this.form);
        const from = rec == null || prop${property.name} == null ? null : rec[prop${property.name}];
#else
        const from = rec == null ? null : rec.${property.widgetDependsOnValueFrom};
#end
#if($property.widgetType == "DROPDOWN")
        if (from == null || from === '') return;
        const rows = await App.services.api.post('${property.widgetDropdownControllerUrl}/search', {
          conditions: [{ propertyName: '${property.widgetDependsOnFilterBy}', operator: 'EQ', value: from }#if($property.widgetOptionsFilterBy),
