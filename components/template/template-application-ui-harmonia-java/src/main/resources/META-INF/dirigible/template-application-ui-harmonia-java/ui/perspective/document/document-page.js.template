        }, { baseUrl: '' });
        this.options${property.name} = (rows || []).map(e => ({ value: e.${property.widgetDropDownKey}, text: e.${property.widgetDropDownValue}#if($property.widgetType == "DOCUMENT_STATUS"), description: e.description#end }));
        if (adjust) {
          this.form.${property.name} = this.options${property.name}.length === 1 ? String(this.options${property.name}[0].value) : '';
        }
#elseif($property.isDateType)
        this.form.${property.name} = from == null ? '' : this.toDateInput(from, '${property.widgetType}');
#else
        this.form.${property.name} = from == null ? null : from;
#end
      } catch (e) {
        console.error('[${name}DocumentPage] dependsOn refresh failed for ${property.name}', e);
      }
    },
#end
#end

    // ----- Header (master) save ------------------------------------------------------------------
    validationSchema() {
      return {
#foreach($property in $properties)
#if(!$property.dataAutoIncrement && !$property.isCalculatedProperty && $property.aggregate != "true" && $property.isRequiredProperty == "true" && !$property.dataDefaultValue)
        ${property.name}: [{ rule: 'required', message: 'This field is required.' }],
#elseif(!$property.dataAutoIncrement && !$property.isCalculatedProperty && $property.aggregate != "true" && $property.widgetType == "EMAIL")
        ${property.name}: [{ rule: 'email', message: 'Enter a valid email address.' }],
#end
#end
      };
    },

    validate() {
      const { errors, valid } = FormValidation.validate(this.form, this.validationSchema());
      this.errors = errors;
      return valid;
    },

    async save() {
      if (this.isPreview) return;
      if (!this.validate()) {
        this.state = 'validation-error';
        // Name the failing fields in the visible summary - an invalid field the layout does not
        // render (or one scrolled out of view) is otherwise indistinguishable from a dead button.
        const _failed = Object.keys(this.errors).filter(k => k !== '__summary' && this.errors[k]);
        if (_failed.length) this.errors.__summary = 'Fields that need attention: ' + _failed.join(', ');
        this.scrollToSummary();
        return;
      }
      this.state = 'saving';
      try {
        const payload = this.toPayload();
        if (this.isEdit) {
          await App.services.api.put(this.apiPath + '/' + encodeURIComponent(this.id), payload);
          this.backToList();
          return;
        } else {
          // Create the header, then stay on the document (now in edit mode) so items can be added.
          const created = await App.services.api.post(this.apiPath, payload);
          const newId = created && (created.${primaryKeysString} !== undefined ? created.${primaryKeysString} : created.id);
          if (newId != null) {
            this.id = newId;
            this.mode = 'edit';
            window.PineconeRouter.navigate('/${name}/' + encodeURIComponent(newId) + '/edit');
            await this.loadHeader();
            await this.loadItems();
          }
        }
        this.state = 'ready';
      } catch (e) {
        this.applyApiError(e, { fallbackMessage: this.isEdit ? 'Could not update the document.' : 'Could not create the document.' });
      }
    },

#if($history == "true")
    // Load the document's change trail. It must never keep the document from opening, so a failure
    // leaves the panel empty and is reported to the console only.
    async loadHistory() {
      try {
        this.history = await App.services.api.get(this.apiPath + '/' + encodeURIComponent(this.id) + '/history') || [];
      } catch (e) {
        this.history = [];
        console.error('[${name}DocumentPage] history load failed', e);
      }
    },

    // A history row names the model PROPERTY; label it exactly as the form labels that field, so the
    // trail and the document read as one record.
    historyLabel(property) {
      const entry = this.historyLabels[property];
      return entry ? T(entry[0], entry[1]) : property;
    },

    historyValue(value) {
      return (value === null || value === undefined || value === '') ? '—' : String(value);
    },

    historyWho(entry) {
      const when = window.HarmoniaFormat.date(entry.ChangedAt);
      return entry.ChangedBy ? entry.ChangedBy + ' · ' + when : when;
    },

#end
    // Convert a value to the fixed shape its <input> needs — NOT pattern-driven (shell format.js).
    toDateInput(value, widget) {
      return window.HarmoniaFormat.toDateInput(value, widget);
    },

    toPayload() {
      const payload = { ...this.form };
      for (const _k of Object.keys(payload)) {
        if (payload[_k] === '') payload[_k] = null;
      }
#foreach($property in $properties)
#if($property.isDateType && $property.aggregate != "true")
      payload.${property.name} = window.HarmoniaFormat.toPayload(payload.${property.name}, '${property.widgetType}');
#end
#if($property.widgetType == "MULTISELECT" && $property.aggregate != "true")
      // MULTISELECT: the array joins back to the normative csv - de-duplicated, ascending (numeric
      // where the keys are numbers), empty selection -> null (that is what NOT NULL rejects).
      payload.${property.name} = Array.isArray(payload.${property.name}) && payload.${property.name}.length
          ? [...new Set(payload.${property.name}.map(String))]
              .sort((a, b) => (Number(a) - Number(b)) || String(a).localeCompare(String(b)))
              .join(',')
          : null;
#end
#end
      return payload;
    },

#if($duplicable)
    // Duplicate this document (header + line items) into a new draft and open it. Clones through the
    // normal create path, so the number (calculatedActionOnCreate), the initial status (init default),
    // audit columns and calculated/aggregate fields are reassigned by the server; the source's
    // identity/system/status fields are dropped from the cloned header.
    async duplicate() {
      if (this.id == null) return;
      this.state = 'saving';
      try {
        const src = await App.services.api.get(this.apiPath + '/' + encodeURIComponent(this.id));
        const header = { ...src };
        [
          '${primaryKeysString}', 'ProcessId', 'ProcessIds', 'CreatedAt', 'CreatedBy', 'UpdatedAt', 'UpdatedBy', 'Uuid',
#foreach($property in $properties)
#if($property.isReadOnlyProperty == "true" || $property.aggregate == "true")
          '${property.name}',
#end
#end
#if($docStatusProp != "")
          '${docStatusProp}',
#end
#if($docNumberProp != "")
          '${docNumberProp}',
#end
        ].forEach(f => { delete header[f]; });
        const created = await App.services.api.post(this.apiPath, header);
        const newId = created && (created.${primaryKeysString} !== undefined ? created.${primaryKeysString} : created.id);
        if (newId == null) throw new Error('No id returned for the duplicated document.');
        // Clone the line items, repointed at the new header (editable inputs only; calculated item
        // fields are recomputed by the server on create).
        if (this.itemsDef) {
          const q = '?' + encodeURIComponent(this.itemsDef.masterEntityId) + '=' + encodeURIComponent(this.id);
          const items = (await App.services.api.getAll(this.itemsDef.apiPath + q)) || [];
          for (const it of items) {
            const body = {};
            this.editColumns.forEach(c => { if (!c.readonly && it[c.name] !== undefined) body[c.name] = it[c.name]; });
            body[this.itemsDef.masterEntityId] = newId;
            await App.services.api.post(this.itemsDef.apiPath, body);
          }
        }
        window.PineconeRouter.navigate('/${name}/' + encodeURIComponent(newId) + '/edit');
      } catch (e) {
        this.applyApiError(e, { fallbackMessage: 'Could not duplicate the document.' });
      } finally {
        this.state = 'ready';
      }
    },
#end

    // ----- Items (read-only table + add/edit dialog, server-side) --------------------------------
    // Role-scoped columns of the ITEMS child (intent `visibleTo:` on a line-item field, e.g. a cost
    // price): filled from the child's own controller when its registration says it has any, so the
    // line table and the line dialog drop them for a caller the server does not serve them to.
    itemRestricted: [],

    get editColumns() {
      return ((this.itemsDef && this.itemsDef.editColumns) || []).filter(c => !this.itemRestricted.includes(c.name));
    },

    // The columns the read-only items TABLE shows: the display columns (major fields - `major:
    // false` hides a field/relation from the table), carried with their full edit metadata so
    // lookup labels, dates and number patterns still render. The add/edit DIALOG keeps the full
    // editColumns (a hidden trigger like Product must stay editable there).
    get tableColumns() {
      if (!this.itemsDef) return [];
      const visible = new Set((this.itemsDef.columns || []).map(c => c.name));
      return this.editColumns.filter(c => visible.has(c.name));
    },

    async loadItems() {
      if (!this.itemsDef || this.id == null) { this.items = []; this.itemsState = 'empty'; return; }
      this.itemsState = 'loading';
      this.itemsError = null;
      try {
        await this.loadItemOptions();
        const q = '?' + encodeURIComponent(this.itemsDef.masterEntityId) + '=' + encodeURIComponent(this.id);
        const rows = await App.services.api.getAll(this.itemsDef.apiPath + q);
        this.items = rows || [];
        this.itemsState = this.items.length === 0 ? 'empty' : 'default';
#if($documentItemsLayout == "calendar")
        this.refreshItemsCalendar();
#end
      } catch (e) {
        this.itemsError = App.services.apiErrors.messageFor(e, 'Could not load items.');
        this.itemsState = 'error';
      }
      this.refreshIcons();
    },
#if($documentItemsLayout == "calendar")

    // ----- Items calendar (the items child declares view: calendar) -------------------------------
    // A day-grained line (a booked day, an allocated hour) is entered on a calendar instead of the row
    // grid. The rows and the dialog are the SAME ones the table pane uses - only the presentation
    // differs - and the event mapping is the shared one (services/calendarEvents.js). The calendar's
    // own configuration (start / end / title / colour / initial view / range) rides the items child's
    // detail registration, so this page never enumerates it at generation time.
    itemsCalendar() {
      return (this.itemsDef && this.itemsDef.calendar) || null;
    },

    refreshItemsCalendar() {
      const cal = this.itemsCalendar();
      this.itemsCalCfg = { view: (cal && cal.view) || 'month', events: this.buildItemEvents() };
    },

    buildItemEvents() {
      const cal = this.itemsCalendar();
      if (!cal) return [];
      return window.HarmoniaCalendar.events(this.items, cal, {
        primaryKey: this.itemsDef.primaryKey,
        label: '${documentItemsLabel}',
        title: cal.title ? (row => this.itemEventTitle(cal, row)) : null,
      });
    },

    // The event pill's title: the titling column resolved exactly as the items table renders it (an FK
    // shows its referenced label, a date its formatted value), blank when the row carries no value so
    // the shared mapping falls back to "<label> #<id>".
    itemEventTitle(cal, row) {
      const value = row[cal.title];
      if (value === null || value === undefined || value === '') return '';
      const column = this.editColumns.find(c => c.name === cal.title);
      return column ? this.cellDisplay(column, row) : String(value);
    },

    // Event click -> edit that line in the same dialog the table's Edit opens; empty-day click -> a new
    // line with the clicked day (and, in week/day views, the clicked time) preset on the date field.
    onItemsEventClick(e) {
      const id = window.HarmoniaCalendar.clickedEventId(e);
      if (id === null) return;
      const pk = this.itemsDef.primaryKey;
      const row = (this.items || []).find(r => String(r[pk]) === String(id));
      if (row) this.openRowDialog(row);
    },

    onItemsDateClick(e) {
      const cal = this.itemsCalendar();
      if (!cal) return;
      const value = window.HarmoniaCalendar.clickedDateValue(e);
      this.openRowDialog(null, value ? { [cal.start]: value } : null);
    },

    // Delete from the line dialog: the calendar pane has no per-row menu, so this is the only route to
    // the (shared) delete confirmation.
    askDeleteDraft() {
      const pk = this.itemsDef.primaryKey;
      const row = (this.items || []).find(r => String(r[pk]) === String(this.draft[pk]));
      if (!row) return;
      this.rowDialogOpen = false;
      this.askDeleteRow(row);
    },
#end
#if($documentItemsLayout == "chat")

    // Append a chat message as a new items child (documentItemsLayout: chat). The message body maps to
    // the messageBody property; the internal flag (if the child declares one) rides the composer toggle;
    // the master FK is forced server-side by the child controller anyway. Author + timestamp are stamped
    // by the audit columns. Reloads the thread so the new bubble (and its audit values) appear.
    async sendMessage(value) {
      const body = (value || '').trim();
      if (!body || this.chatSending || !this.itemsDef || this.id == null) return;
      this.chatSending = true;
      this.itemsError = null;
      try {
        const payload = { '${chatBodyProperty}': body };
        payload[this.itemsDef.masterEntityId] = this.id;
#if($chatInternalProperty)
        payload['${chatInternalProperty}'] = !!this.chatInternal;
#end
        await App.services.api.post(this.itemsDef.apiPath, payload);
        this.chatDraft = '';
        this.chatInternal = false;
        await this.loadItems();
      } catch (e) {
        this.itemsError = App.services.apiErrors.messageFor(e, 'Could not send the message.');
      } finally {
        this.chatSending = false;
      }
    },
#end

    async loadItemOptions() {
      for (const col of this.editColumns) {
        if ((col.widget !== 'DROPDOWN' && col.widget !== 'MULTISELECT') || !col.lookup || this.itemOptions[col.name]) continue;
        try {
          const rows = await App.services.api.getAll(col.lookup.url, { baseUrl: '' });
          this.itemOptions[col.name] = (rows || []).map(e => ({ value: e[col.lookup.key], text: e[col.lookup.text] }));
          if (col.hier) {
            // Hierarchy column (leafOnly): the dialog chooser gets depth-indented leaves; the
            // items table label resolution above keeps the full set.
            this.filteredOptions[col.name] = this.hierarchizeOptions(rows, {
              key: col.lookup.key, text: col.lookup.text, parent: col.hier.parent, leafOnly: col.hier.leafOnly
            });
          }
          if (col.filter) {
            // Static option filter (intent `where:`): the dialog chooser sees only matching rows.
            const filtered = await App.services.api.post(col.lookup.url + '/search', {
              conditions: [{ propertyName: col.filter.by, operator: 'EQ', value: col.filter.value }]
            }, { baseUrl: '' });
            this.filteredOptions[col.name] = (filtered || []).map(e => ({ value: e[col.lookup.key], text: e[col.lookup.text] }));
          }
        } catch (e) {
          console.error('[${name}DocumentPage] failed to load item options for ' + col.name, e);
        }
      }
    },


    // Hierarchy-aware picker options (intent `hierarchy:` + `leafOnly:`): depth-first order,
    // em-space indentation per depth, and optionally leaves only (nodes nobody parents). The
    // server enforces leafOnly independently - this mirrors it for the UX.
    hierarchizeOptions(rows, opts) {
      const list = rows || [];
      const byId = new Map(list.map(r => [r[opts.key], r]));
      const parents = new Set(list.map(r => r[opts.parent]).filter(v => v != null));
      const depthOf = r => { let d = 0, c = r[opts.parent]; while (c != null && byId.has(c) && d < 6) { d++; c = byId.get(c)[opts.parent]; } return d; };
      const pathOf = r => { const seg = []; let c = r, guard = 0; while (c && guard++ < 7) { seg.unshift(String(c[opts.text] ?? c[opts.key])); c = byId.get(c[opts.parent]); } return seg.join('\u0000'); };
      return list
        .filter(r => !opts.leafOnly || !parents.has(r[opts.key]))
        .sort((a, b) => pathOf(a).localeCompare(pathOf(b)))
        .map(r => ({ value: r[opts.key], text: '\u2003'.repeat(depthOf(r)) + String(r[opts.text] ?? '') }));
    },

    // Static option filter (intent `where:`) label resolution for a HEADER dropdown or multi-select:
    // fetch each out-of-filter row by id and prepend it to the chooser list so a value stored outside
    // the filter still shows its label on edit. The filter still governs what the user can newly pick.
    // A MULTISELECT's model is an ARRAY of keys, so every stored key is checked - one that fell outside
    // the filter would otherwise vanish from the trigger's label list while the record still stores it.
    async ensureFilteredCurrent(prop, url, key, text) {
      const current = this.form[prop];
      const values = (Array.isArray(current) ? current : [current]).filter(v => v != null && v !== '');
      if (!values.length) return;
      const opts = this['options' + prop];
      if (!Array.isArray(opts)) return;
      for (const value of values) {
        if (opts.some(o => String(o.value) === String(value))) continue;
        try {
          const row = await App.services.api.get(url + '/' + encodeURIComponent(value), { baseUrl: '' });
          if (row && row[key] != null) opts.unshift({ value: row[key], text: row[text] });
        } catch (e) {
          console.error('[${name}DocumentPage] failed to resolve the filtered current option for ' + prop, e);
        }
      }
    },

    optionsFor(name) { return this.itemOptions[name] || []; },

    // The item dialog's option list: the Depends-On-filtered set when one is active, else the static
    // `where:`-filtered set when the column declares one, else the full set.
    dialogOptionsFor(name) { return this.draftOptions[name] || this.filteredOptions[name] || this.itemOptions[name] || []; },

    // Depends-On in the item dialog, metadata-driven off editColumns (col.dependsOn = { property,
    // valueFrom, filterBy?, url }): when the trigger column changes, load its selected record, read
    // valueFrom, and per dependent column either re-filter its dropdown options by filterBy (into
    // draftOptions; on a user change a single remaining option is auto-selected, anything else clears)
    // or copy the value and re-run the calculated-column preview (so price -> net/vat/total chains).
    async applyDraftDependsOn(triggerName, adjust) {
      const value = this.draft[triggerName];
      if (value == null || value === '') return;
      // Header-mediated dependents (#6358) are driven off the header form, not off a draft column, so
      // they must not be picked up by a same-named row column.
      const dependents = this.editColumns.filter(c => c.dependsOn && !c.dependsOn.header && c.dependsOn.property === triggerName);
      for (const col of dependents) {
        try {
          const rec = await App.services.api.get(col.dependsOn.url + '/' + encodeURIComponent(value), { baseUrl: '' });
          // Conditional source (intent valueFrom: { by, cases, default }): the property to copy is
          // picked by the classifier; a plain valueFrom copies its one fixed property.
          const prop = col.dependsOn.valueBy ? await this.resolveDependsOnSource(col.dependsOn.valueBy, this.draft) : col.dependsOn.valueFrom;
          if (prop == null) continue;
          const from = rec == null ? null : rec[prop];
          if (col.widget === 'DROPDOWN' && col.lookup) {
            if (from == null || from === '') continue;
            const conditions = [{ propertyName: col.dependsOn.filterBy, operator: 'EQ', value: from }];
            if (col.filter) conditions.push({ propertyName: col.filter.by, operator: 'EQ', value: col.filter.value });
            const rows = await App.services.api.post(col.lookup.url + '/search', { conditions }, { baseUrl: '' });
            this.draftOptions[col.name] = (rows || []).map(e => ({ value: e[col.lookup.key], text: e[col.lookup.text] }));
            if (adjust) {
              this.draft[col.name] = this.draftOptions[col.name].length === 1 ? String(this.draftOptions[col.name][0].value) : '';
            }
          } else if (from != null) {
            this.draft[col.name] = col.date ? this.toDateInput(from, col.widget) : from;
            this.recalcDraft();
          }
        } catch (e) {
          console.error('[${name}DocumentPage] dependsOn refresh failed for ' + col.name, e);
        }
      }
    },

    // Header-mediated Depends-On (#6358): a line field defaults from a record the open DOCUMENT points
    // at (the header partner's standard discount, say) rather than from one of the line's own
    // relations. The trigger value therefore comes off the header form; the source record is fetched
    // and copied exactly as in the sibling-triggered case. Only ever auto-populates a scalar - a header
    // selection has no business filtering a line's dropdown - and never runs on an existing row, whose
    // stored value the user may have overridden deliberately.
    async applyHeaderDependsOnToDraft() {
      const dependents = this.editColumns.filter(c => c.dependsOn && c.dependsOn.header);
      for (const col of dependents) {
        const value = this.form[col.dependsOn.property];
        if (value == null || value === '') continue;
        try {
          const rec = await App.services.api.get(col.dependsOn.url + '/' + encodeURIComponent(value), { baseUrl: '' });
          const prop = col.dependsOn.valueBy ? await this.resolveDependsOnSource(col.dependsOn.valueBy, this.draft) : col.dependsOn.valueFrom;
          if (prop == null) continue;
          const from = rec == null ? null : rec[prop];
          if (from == null) continue;
          this.draft[col.name] = col.date ? this.toDateInput(from, col.widget) : from;
          this.recalcDraft();
        } catch (e) {
          console.error('[${name}DocumentPage] header dependsOn refresh failed for ' + col.name, e);
        }
      }
    },

    // Conditional Depends-On source (#6358): resolve the classifier from the by-path - a value of
    // the given source object (the item draft, or a form), the open document header (path starts at
    // the item's composition parent relation), or a one-hop related record fetched by url - then
    // pick the trigger-target property from the cases map (fall back to deflt; null = skip).
    async resolveDependsOnSource(vb, src) {
      try {
        const segs = vb.path.split('.');
        let value;
        if (vb.header) {
          value = this.form[segs[1]];
          if (segs.length === 3) {
            if (value == null || value === '') return vb.deflt || null;
            const rec = await App.services.api.get(vb.url + '/' + encodeURIComponent(value), { baseUrl: '' });
            value = rec == null ? null : rec[segs[2]];
          }
        } else {
          value = src[segs[0]];
          if (segs.length === 2) {
            if (value == null || value === '') return vb.deflt || null;
            const rec = await App.services.api.get(vb.url + '/' + encodeURIComponent(value), { baseUrl: '' });
            value = rec == null ? null : rec[segs[1]];
          }
        }
        if (value == null || value === '') return vb.deflt || null;
        return vb.cases[String(value)] || vb.deflt || null;
      } catch (e) {
        console.error('[${name}DocumentPage] dependsOn classifier resolution failed', e);
        return vb.deflt || null;
      }
    },

    // "Add new <related>" from an item-dialog FK combobox.
    addRelatedItem(col) {
      if (!col.lookup) return;
      Alpine.store('related').create(App.utils.relatedCreateUrl(col.lookup.url, col.lookup.entity), T('$projectName:${tprefix}.defaults.newTitle', 'New {{name}}', { name: col.lookup.entity }), async (id) => {
        delete this.itemOptions[col.name];
        // Drop a Depends-On-filtered set so the just-created record is selectable even off-filter.
        delete this.draftOptions[col.name];
        delete this.filteredOptions[col.name];
        await this.loadItemOptions();
        if (id != null) this.draft[col.name] = String(id);
      });
    },

    refreshItemOptions(col) {
      delete this.itemOptions[col.name];
      delete this.draftOptions[col.name];
      delete this.filteredOptions[col.name];
      this.loadItemOptions();
      // Re-apply the Depends-On filter for a populated trigger so Refresh keeps the cascade.
      if (col.dependsOn && this.draft[col.dependsOn.property] != null && this.draft[col.dependsOn.property] !== '') {
        this.applyDraftDependsOn(col.dependsOn.property, false);
      }
    },

    // Read-only cell: a relationship cell shows its referenced label, a date cell is formatted, a
    // checkbox shows Yes/No, otherwise the raw value (em dash when empty).
    cellDisplay(col, row) {
      const v = row[col.name];
      if (v === null || v === undefined || v === '') return '—';
      if (col.widget === 'DROPDOWN') {
        const opt = this.optionsFor(col.name).find(o => String(o.value) === String(v));
        if (opt) return opt.text;
      }
      if (col.widget === 'MULTISELECT') {
        // The cell holds a key LIST ("1,3"): resolve each key against the full option set.
        const opts = this.optionsFor(col.name);
        return String(v).split(',').map(k => {
          const opt = opts.find(o => String(o.value) === k.trim());
          return opt ? opt.text : k.trim();
        }).join(', ');
      }
      if (col.date) return this.displayDate(v);
      if (col.float) return this.displayNumber(v, col.pattern);
      if (col.widget === 'CHECKBOX') return v ? 'Yes' : 'No';
      return v;
    },
#set($docStatusProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_STATUS")#set($docStatusProp = $property.name)#end
#end
#if($docStatusProp != "")

    // Document status pill: resolve the FK id to the status name, then map the name to a badge colour.
    statusText() {
      const v = this.form.${docStatusProp};
      if (v === null || v === undefined || v === '') return '';
      const opt = (this.options${docStatusProp} || []).find(o => String(o.value) === String(v));
      return opt ? opt.text : String(v);
    },
    statusVariant(text) {
      const t = String(text || '').toLowerCase();
      if (/draft/.test(t)) return 'outline';
      if (/(cancel|reject|declin|void|fail|overdue|insufficient|exhaust)/.test(t)) return 'negative';
      if (/(pending|await|hold|review|partial)/.test(t)) return 'warning';
      if (/(approv|accept|activ|complet|paid|done|available)/.test(t)) return 'positive';
      if (/(issu|sent|ship|process|submit)/.test(t)) return 'information';
      return 'default';
    },
    // Forward status flow for the read-only step indicator: the loaded status options minus the
    // terminal / off-path ones (cancel/void/... stay the pill). Each option carries {value, text} and,
    // when the status entity has a `description` seed column, `description` (shown under the title).
    statusSteps() {
      return (this.options${docStatusProp} || []).filter(o => this.statusVariant(o.text) !== 'negative');
    },
    // 1-based index of the current status among the steps (0 when the status is terminal or unset,
    // so no step is active).
    activeStep() {
      const current = this.statusText();
      return this.statusSteps()
                 .findIndex(o => String(o.text) === String(current)) + 1;
    },
#end

    // Render a line-item date/datetime value through the instance Date/Timestamp patterns (shell format.js).
    displayDate(v) {
      return window.HarmoniaFormat.value(v, true);
    },

    // ----- Add / edit line dialog ----------------------------------------------------------------
    // `preset` seeds a CREATE draft with values the caller already knows (the day clicked on the items
    // calendar), applied before the calculated columns are evaluated so a value derived from it is
    // right on first render.
    openRowDialog(row, preset) {
      if (!this.itemsEnabled || this.isPreview) return;
      this.draftError = null;
      this.draftMode = row ? 'edit' : 'create';
      // Suppress the Depends-On watchers while the draft is (re)built - filling an existing row's
      // trigger must not clear/auto-select its stored dependents.
      this._draftInitializing = true;
      this.draftOptions = {};
      const pk = this.itemsDef.primaryKey;
      const draft = {};
      draft[this.itemsDef.masterEntityId] = String(this.id);
      for (const col of this.editColumns) {
        let v = row ? row[col.name] : null;
        if (row && v != null) {
          if (col.widget === 'DROPDOWN') v = String(v);
          // A MULTISELECT draft is an ARRAY (that is what puts the dialog's select in multiple
          // mode): split the stored csv on edit.
          else if (col.widget === 'MULTISELECT') v = String(v).split(',').map(s => s.trim());
          else if (col.date) v = this.toDateInput(v, col.widget);
        }
        // A NEW line takes the column's authored default (intent `defaultValue:`, emitted as col.def)
        // so the dialog opens on the standard values instead of blank ones - what makes a one-click
        // affordance like Fill Month actually one click. An EXISTING row keeps what is stored,
        // including a value the user deliberately cleared: re-defaulting that would silently undo it.
        const blank = col.widget === 'CHECKBOX' ? false : (col.widget === 'NUMBER' ? null : (col.widget === 'MULTISELECT' ? [] : ''));
        draft[col.name] = v == null ? (!row && col.def !== undefined ? col.def : blank) : v;
      }
      if (row && row[pk] != null) draft[pk] = row[pk];
      if (preset) {
        Object.keys(preset)
              .forEach(key => { draft[key] = preset[key]; });
      }
      this.draft = draft;
      this.recalcDraft();
      // Filter dependent dropdowns for already-populated triggers (edit) WITHOUT touching values.
      const depTriggers = [...new Set(this.editColumns.filter(c => c.dependsOn && !c.dependsOn.header)
                                                      .map(c => c.dependsOn.property))];
      for (const t of depTriggers) {
        if (draft[t] != null && draft[t] !== '') this.applyDraftDependsOn(t, false);
      }
      // A NEW line takes its header-mediated defaults (#6358) straight away; an existing row keeps the
      // stored value, which the user may have deliberately overridden.
      if (this.draftMode === 'create') this.applyHeaderDependsOnToDraft();
      this.${dollar}nextTick(() => { this._draftInitializing = false; });
      this.rowDialogOpen = true;
      this.refreshIcons();
    },

    // Recompute every calculated (readonly) column from its `calc` expression, in editColumns order so
    // a later field can read an earlier one (Net -> Vat -> Gross). Called when the dialog opens and on
    // every edit of an input field. The server stays authoritative on save; this is a live preview that
    // shares the SAME expression string as the server-side Calc evaluator.
    recalcDraft() {
      for (const col of this.editColumns) {
        if (!col.calc) continue;
        this.draft[col.name] = harmoniaCalcEval(col.calc, this.draft, col.scale != null ? col.scale : 2);
      }
    },

    closeRowDialog() { this.rowDialogOpen = false; this.draft = {}; this.draftError = null; },

    draftPayload() {
      const payload = {};
      payload[this.itemsDef.masterEntityId] = this.id;
      const pk = this.itemsDef.primaryKey;
      if (this.draftMode === 'edit' && this.draft[pk] != null) payload[pk] = this.draft[pk];
      for (const col of this.editColumns) {
        let v = this.draft[col.name];
        if (v === '') v = null;
        if (col.date && v != null) v = window.HarmoniaFormat.toPayload(v, col.widget || 'DATETIME-LOCAL');
        // MULTISELECT: the array joins back to the normative csv - de-duplicated, ascending,
        // empty selection -> null.
        if (col.widget === 'MULTISELECT') {
          v = Array.isArray(v) && v.length
              ? [...new Set(v.map(String))]
                  .sort((a, b) => (Number(a) - Number(b)) || String(a).localeCompare(String(b)))
                  .join(',')
              : null;
        }
        payload[col.name] = v;
      }
      return payload;
    },

    async saveDraft() {
      if (this.draftMode === 'fill') { await this.fillMonthDraft(); return; }
      this.draftSaving = true;
      this.draftError = null;
      try {
        const pk = this.itemsDef.primaryKey;
        const body = this.draftPayload();
        if (this.draftMode === 'edit' && this.draft[pk] != null) {
          await App.services.api.put(this.itemsDef.apiPath + '/' + encodeURIComponent(this.draft[pk]), body);
        } else {
          await App.services.api.post(this.itemsDef.apiPath, body);
        }
        this.rowDialogOpen = false; this.draft = {};
        await this.loadItems();   // refresh the rows (server defaults / calculated item fields)
        await this.loadHeader();  // refresh the header + totals (server-side calculated aggregates)
      } catch (e) {
        this.draftError = App.services.apiErrors.messageFor(e, 'Could not save the line.');
      } finally {
        this.draftSaving = false;
      }
    },

    // ----- Fill Month (one dialog fill -> a line per working day) ---------------------------------
    // Offered only when the line item carries an editable plain DATE column (the fill target).
    fillDateColumn() {
      return this.editColumns.find(c => c.widget === 'DATE' && !c.readonly) || null;
    },
    fillDateName() { const c = this.fillDateColumn(); return c ? c.name : ''; },

    // The same line dialog, in 'fill' mode: the fill-target date column picks the MONTH (seeded with
    // the current one) and Save creates a line per working day instead of one line.
    openFillDialog() {
      const col = this.fillDateColumn();
      if (!col) return;
      this.openRowDialog(null);
      if (!this.rowDialogOpen) return;   // openRowDialog refused (preview / items disabled)
      this.draftMode = 'fill';
      const now = new Date();
      this.draft[col.name] = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
    },

    // One POST per working day (Mon-Fri) of the picked month with the dialog's values; days that
    // already carry a line are skipped, so a partially filled month can be topped up safely.
    async fillMonthDraft() {
      this.draftSaving = true;
      this.draftError = null;
      try {
        const col = this.fillDateColumn();
        const month = String((col && this.draft[col.name]) || '').slice(0, 7);
        if (!/^\d{4}-\d{2}$/.test(month)) throw new Error('Pick a month to fill.');
        const taken = new Set((this.items || []).map(r => this.itemDayOf(r[col.name])).filter(Boolean));
        const pk = this.itemsDef.primaryKey;
        for (const day of this.monthWorkingDays(month)) {
          if (taken.has(day)) continue;
          const body = this.draftPayload();
          delete body[pk];
          body[col.name] = new Date(day + 'T00:00:00Z').toISOString();
          await App.services.api.post(this.itemsDef.apiPath, body);
        }
        this.rowDialogOpen = false; this.draft = {};
      } catch (e) {
        this.draftError = App.services.apiErrors.messageFor(e, 'Could not fill the month.');
      } finally {
        this.draftSaving = false;
        await this.loadItems();   // reflect what was created even on a mid-loop failure
        await this.loadHeader();
      }
    },

    monthWorkingDays(month) {
      const y = Number(month.slice(0, 4)), m = Number(month.slice(5, 7));
      const days = [];
      for (let day = 1, last = new Date(y, m, 0).getDate(); day <= last; day++) {
        const dow = new Date(y, m - 1, day).getDay();
        if (dow !== 0 && dow !== 6) days.push(month + '-' + String(day).padStart(2, '0'));
      }
      return days;
    },

    // A stored date arrives as an ISO string, epoch number or java.time array - its YYYY-MM-DD part.
    itemDayOf(v) {
      if (v == null || v === '') return '';
      if (Array.isArray(v)) return v[0] + '-' + String(v[1]).padStart(2, '0') + '-' + String(v[2]).padStart(2, '0');
      if (typeof v === 'number') {
        const d = new Date(v < 1e12 ? v * 1000 : v);
        return isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
      }
      return String(v).slice(0, 10);
    },

    askDeleteRow(row) { if (this.isPreview) return; this.deleteTarget = row; this.deleteOpen = true; },

    async confirmDeleteRow() {
      if (!this.deleteTarget) return;
      const pk = this.itemsDef.primaryKey;
      try {
        await App.services.api.delete(this.itemsDef.apiPath + '/' + encodeURIComponent(this.deleteTarget[pk]));
        this.deleteOpen = false; this.deleteTarget = null;
        await this.loadItems();
        await this.loadHeader();
      } catch (e) {
        this.itemsError = App.services.apiErrors.messageFor(e, 'Could not delete the line.');
      }
    },

    // ----- Totals footer (aggregate fields, read-only) -------------------------------------------
    // The totals are server-managed: the DAO recomputes them synchronously on every line change and on
    // the master's own save, so the loaded record is authoritative (re-fetched after each item change).
    totalValue(name, pattern) { return this.displayNumber(this.record[name], pattern); },

    // Decimals from the field pattern, separators from the instance Number setting (shell format.js).
    displayNumber(v, pattern) {
      return window.HarmoniaFormat.number(v, pattern);
    },

    backToList() { window.PineconeRouter.navigate('/${name}'); },

    // Preview -> the editable document for the same record.
    goEdit() { window.PineconeRouter.navigate('/${name}/' + encodeURIComponent(this.id) + '/edit'); },
  }));
}, { once: true });
