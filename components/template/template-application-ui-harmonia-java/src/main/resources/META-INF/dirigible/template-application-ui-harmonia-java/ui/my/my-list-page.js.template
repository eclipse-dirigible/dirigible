/*
 * Personal (my) list page for ${name} - the logged-in user's own records only, served by the
 * scoped ${name}MyController (sensitive fields never arrive). New / row-click navigate to the
 * routed my-form.
 */
## A boolean's words (#8564): its own intent `labels:`, else the shared Yes / No - [key, word] per value,
## resolved by the shared basePage.booleanText.
#macro(booleanWords $property)['$projectName:${tprefix}.${property.booleanTrueKey}', '${property.booleanTrueTextJs}', '$projectName:${tprefix}.${property.booleanFalseKey}', '${property.booleanFalseTextJs}']#end
## The EntityStatus relation (widget DOCUMENT_STATUS) shows as a coloured badge, not a number column.
#set($statusProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_STATUS")
#set($statusProp = $property.name)
#set($statusUrl = $property.widgetDropdownControllerUrl)
#set($statusKey = $property.widgetDropDownKey)
#set($statusVal = $property.widgetDropDownValue)
#end
#end
## A relation labelled by a number: { stampOn: issue } field shows the draft marker, never its UUID
## placeholder (#7722): labelOf reads one row's label, labelRows hands a helper rows already marked.
#macro(labelOf $dnProp $dnRow)#if($dnProp.widgetDropDownDocumentNumber)window.HarmoniaFormat.documentNumber(${dnRow}.${dnProp.widgetDropDownValue})#else${dnRow}.${dnProp.widgetDropDownValue}#end#end
#macro(labelRows $dnProp $dnRows)#if($dnProp.widgetDropDownDocumentNumber)this.documentNumberLabels(${dnRows}, '${dnProp.widgetDropDownValue}')#else${dnRows}#end#end
document.addEventListener('alpine:init', () => {
  Alpine.data('${name}MyListPage', () => ({
    ...basePage(),
    state: 'loading',
    items: [],
    error: null,
#if($statusProp != "")
    statusOptions: [],
#end

    // Controller path for the PERSONAL surface, relative to App.config.restBase.
    apiPath: '/${javaPerspectiveName}/${name}MyController',

    // Entity name used to match the actions contributed for the personal surface ($store.customActions).
    // Set here (not inline in the view) so Velocity substitutes it.
    caView: '${name}',

    async init() {
#if($hasRestrictedFields)
      // Role-scoped fields (intent `visibleTo:`): this surface's own controller strips them from the
      // rows too - owning the record is not a role - so ask which ones and drop those columns.
      this.loadRestrictedFields().then(() => {
        this.columns = this.columns.filter(c => this.canSee(c.name));
      });
#end
#if($statusProp != "")
      try {
        const rows = await App.services.api.getAll('${statusUrl}', { baseUrl: '' });
        this.statusOptions = (rows || []).map((r) => ({ value: r.${statusKey}, text: r.${statusVal} }));
      } catch (e) { this.statusOptions = []; }
#end
      await this.load();
      this.loadLookups();
      // Back on this list through the sidebar or the hosting shell, which re-renders nothing (#8130).
      this.onReentered(() => this.refresh());
      // A row action moved a record (#8406): the row shows its new status and the actions it accepts now.
      this.onActionDone(() => this.refresh());
    },

    lookups: {},   // relationship column name -> { fkValue: label }
    // Resolve every rendered relation column to its label, exactly like the power list - the
    // personal-owner relation and sensitive fields are not rendered, so no lookup is fetched for
    // them. Loaded after the rows so the list paints immediately; cells re-render as maps arrive.
    async loadLookups() {
      const all = {};
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "MULTISELECT") && $property.name != "$!{personalProperty}" && !$property.sensitiveProperty && (!$property.auditType || $property.auditType == "NONE") && $property.widgetIsMajor != "false")
      try {
        const opt${property.name} = await App.services.api.getAll('${property.widgetDropdownControllerUrl}', { baseUrl: '' });
        const map${property.name} = {};
        (opt${property.name} || []).forEach((e) => { map${property.name}[e.${property.widgetDropDownKey}] = #labelOf($property "e"); });
        all['${property.name}'] = map${property.name};
      } catch (e) {
        console.error('[${name}MyListPage] failed to load lookup for ${property.name}', e);
      }
#end
#end
      this.lookups = all;
    },

    // `quiet` keeps the current rows on screen until the fresh rows arrive.
    async load(quiet) {
      if (!quiet) this.state = 'loading';
      try {
        this.items = await App.services.api.get(this.apiPath) || [];
        this.state = this.items.length ? 'default' : 'empty';
        this.lastUpdated = new Date();
      } catch (e) {
        this.error = App.services.apiErrors.refusalMessageFor(e, 'Could not load your ${menuLabel}.');
        this.state = 'error';
      }
    },

    // The header's Refresh (#8130): the rows again, without blanking the table meanwhile.
    async refresh() {
      await this.load(true);
      this.loadLookups();
    },

    display(row, col) {
      const v = row[col.name];
      if (v == null || v === '') return '—';
      // A number: { stampOn: issue } column shows its draft marker until the number is stamped (#7722).
      if (col.documentNumber) return String(window.HarmoniaFormat.documentNumber(v));
      if (col.bool) return this.booleanText(v, col.bool);
      if (col.multi) {
        // A subset cell holds a key LIST ("1,3"): resolve each key and join the labels.
        const map = this.lookups[col.name] || {};
        return String(v).split(',').map(k => {
          const key = k.trim();
          const text = map[key];
          return (text !== undefined && text !== null && text !== '') ? String(text) : key;
        }).join(', ');
      }
      if (col.fk) {
        // a relation column shows its referenced label; a dangling/unloaded FK falls back to the id
        const map = this.lookups[col.name];
        const text = map ? map[v] : undefined;
        if (text !== undefined && text !== null && text !== '') return String(text);
      }
      if (col.date) return window.HarmoniaFormat ? window.HarmoniaFormat.date(v) : String(v);
      if (col.number) return window.HarmoniaFormat ? window.HarmoniaFormat.number(v) : String(v);
      return String(v);
    },
#if($statusProp != "")

    // EntityStatus badge: resolve the FK to its label + semantic colour (same mapping as the forms).
    statusText(row) {
      const opt = this.statusOptions.find((o) => String(o.value) === String(row.${statusProp}));
      return opt ? opt.text : '';
    },
#set($statusVariantsJs = "{}")
#foreach($svProperty in $properties)
#if($svProperty.widgetType == "DOCUMENT_STATUS" && "$!svProperty.widgetStatusVariants" != "")#set($statusVariantsJs = $svProperty.widgetStatusVariants)#end
#end
    // What the model says each status means (seed `stage:` / `variant:`, #8373): status id -> badge
    // variant. A status it does not classify is coloured by a guess from its name.
    statusVariants: ${statusVariantsJs},
    statusVariant(text, id) {
      const declared = id === undefined || id === null ? undefined : this.statusVariants[String(id)];
      if (declared) return declared;
      const t = String(text || '').toLowerCase();
      if (/draft/.test(t)) return 'outline';
      if (/(cancel|reject|declin|void|fail|overdue|insufficient|exhaust)/.test(t)) return 'negative';
      if (/(pending|await|hold|review|partial)/.test(t)) return 'warning';
      if (/(approv|accept|activ|complet|paid|done|available)/.test(t)) return 'positive';
      if (/(issu|sent|ship|process|submit)/.test(t)) return 'information';
      return 'default';
    },
#end

    columns: [
#foreach($property in $listProperties)
#if(!$property.dataAutoIncrement && !$property.collectionColumn && !$property.sensitiveProperty && $property.name != "$!{personalProperty}" && $property.name != "ProcessId" && !$property.isHiddenProperty && (!$property.auditType || $property.auditType == "NONE") && $property.widgetIsMajor != "false")
      { name: '${property.name}', label: '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end', tkey: '$projectName:${tprefix}.t.${property.dataName}'#if($property.widgetType == "DOCUMENT_STATUS"), status: true#elseif($property.widgetType == "MULTISELECT"), multi: true#elseif($property.widgetType == "DROPDOWN"), fk: true#elseif($property.isNumberType), number: true#end#if($property.isDateType), date: true#end#if($property.numberStampOnIssue), documentNumber: true#end#if($property.booleanTrueKey), bool: #booleanWords($property)#end },
#end
#end
    ],

    // ----- Export / print of the own rows: same columns and cell resolution as the table
    // (FK labels, status text, formatted dates) via the shared basePage helpers.
    exportCell(row, col) {
      if (row[col.name] == null || row[col.name] === '') return '';
      return col.status ? this.statusText(row) : this.display(row, col);
    },
    exportCsv() {
      this.exportRowsCsv(this.items, this.columns, (r, c) => this.exportCell(r, c), '${name}.csv');
    },
    printList() {
      this.printRows(this.items, this.columns, (r, c) => this.exportCell(r, c),
        'My ' + (window.T ? window.T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}') : '${menuLabel}'));
    },

#if($calendarView)
    // Switch to the additional personal calendar page, which owns /my/${name}.
    goCalendar() { this.navigate('/my/${name}'); },
#end
    newEntity() { this.navigate('/my/${name}/create'); },
    openEntity(row) { this.navigate('/my/${name}/' + row.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end + '/edit'); },
    // A click on a row opens it - except one that started in the row's own "..." menu, which acts on
    // its own. Not @click.stop on the menu: that would keep the click from the document, where
    // Harmonia closes an open menu (#8259).
    rowClicked(event, row) {
      if (event.target.closest('[data-row-actions]')) return;
      this.openEntity(row);
    },

    // ----- The rows' own actions on the personal surface (#8406) ----------------------------------
    // Only the actions contributed for this surface - their endpoints are scoped to the caller's own
    // records - by the store call the power list makes, so the same status guards apply per row.
    // Whether this surface has any per-record action at all decides the actions column.
    get hasRowActions() {
      const actions = Alpine.store('customActions');
      return Boolean(actions && actions.getActions(this.caView, 'entity', null, 'my').length);
    },
    rowActions(row) {
      const actions = Alpine.store('customActions');
      return (row && actions) ? actions.getActions(this.caView, 'entity', row, 'my').filter((a) => !actions.isDestructive(a)) : [];
    },
    rowDestructiveActions(row) {
      const actions = Alpine.store('customActions');
      return (row && actions) ? actions.getActions(this.caView, 'entity', row, 'my').filter((a) => actions.isDestructive(a)) : [];
    },
    // Runs one of a row's actions on that row. Here rather than in the markup: there, a $store call
    // whose arguments carry the row's key expression is read by Velocity as one reference, and refused.
    runRowAction(action, row) {
      Alpine.store('customActions').trigger(action, row.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end, row);
    },
  }));
});
