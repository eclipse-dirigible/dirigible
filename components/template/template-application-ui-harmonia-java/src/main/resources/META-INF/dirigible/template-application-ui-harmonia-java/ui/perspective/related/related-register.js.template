/*
 * Registers the read-only records-that-reference-${name} registers, so ${name}'s form / document /
 * master pages can render a generic relatedPanel for each. Runs at load (App is already defined).
 *
 * Unlike a detail registration - contributed by the composition CHILD, which is generated with its
 * master - a register is contributed by the entity being referenced: the referencing entity may be
 * owned by another model in another project, generated at another time, which is exactly why the
 * declaration lives here. Its controller and application URLs are therefore absolute.
 */
#foreach($register in $relatedEntities)
App.registerRelated('${name}', {
  entity: '${register.entity}',
  label: '${register.label}',
#if($register.local && $register.dataName)
  // A same-project source shares this app's label catalog, so the heading translates through the
  // entry that source's own navigation already contributes. A cross-project one cannot - its
  // catalog belongs to its own application - and falls back to the authored label.
  tkey: '$projectName:${tprefix}.t.${register.dataName}_plural',
#end
  apiPath: '${register.apiPath}',
  appUrl: '${register.appUrl}',
  local: #if($register.local)true#{else}false#end,
  fkProperty: '${register.fkProperty}',
  primaryKey: '${register.primaryKey}',
  columns: [
#foreach($column in $register.columns)
## A subset column (intent `kind: subset`) holds a key LIST ("1,3"): the `multi` flag routes the cell
## through the same lookup PER KEY and joins the labels - without it the register shows the raw ids.
    { name: '${column.name}', label: '${column.label}'#if($register.local && $column.dataName), tkey: '$projectName:${tprefix}.t.${column.dataName}'#end#if($column.multi), multi: true#end#if($column.lookup), lookup: { url: '${column.lookup.url}', key: '${column.lookup.key}', text: '${column.lookup.text}' }#end#if($column.date), date: true#end#if($column.float), number: true, float: true, pattern: '${column.pattern}'#elseif($column.number), number: true#end#if($column.sensitive), sensitive: true#end },
#end
  ],
});
#end
