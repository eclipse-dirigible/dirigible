#set($dollar = '$')
/*
 * Generated by Eclipse Dirigible based on model and template.
 *
 * Do not modify the content as it may be re-generated again.
 */

/*
 * Standalone report page for ${name}. Queries the generated Java report controller
 * (reportFileEntity): GET / (rows, with limit/offset), GET /count, POST /export (all rows). Carries
 * its own minimal fetch client so the page is self-contained (not part of the SPA shell).
 */
const reportHttp = {
  // A failure carries the status and the server's text the way the shell's ApiError does, so the
  // shared apiErrors gate decides what the page may show: a 400/409 refusal (a parameter the report
  // controller rejected) is quoted, anything else keeps the neutral fallback (#7151, #7263).
  async failure(r) {
    const text = await r.text().catch(() => '');
    let reason = text;
    try { const j = JSON.parse(text); reason = j.errorMessage || j.message || text; } catch (_) { /* non-JSON */ }
    const err = new Error('HTTP ' + r.status);
    err.httpStatus = r.status;
    err.errorMessage = reason;
    return err;
  },
  async get(url) {
    const r = await fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' });
    if (!r.ok) throw await this.failure(r);
    const t = await r.text();
    return t ? JSON.parse(t) : null;
  },
  async post(url, body) {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body || {}),
      credentials: 'same-origin',
    });
    if (!r.ok) throw await this.failure(r);
    const t = await r.text();
    return t ? JSON.parse(t) : null;
  },
};

document.addEventListener('alpine:init', () => {
  Alpine.data('reportPage', () => ({
    apiBase: '/services/java/${projectName}/gen/${javaGenFolderName}/api/${javaPerspectiveName}/${name}Controller',
    displayName: '${name}',   // humanised in init() — "MembersWithLoansDue" -> "Members With Loans Due"
    rows: [],
    columns: [],        // derived from the data — the controller returns rows keyed by column alias
    // The report's typed output columns (generation-time metadata) — the filterable surface. Each
    // entry is { key: <result-set alias>, kind: date|number|boolean|text }, driving the per-column
    // filter controls (date/number ranges, boolean select, text contains).
    reportColumns: [
#foreach($column in $columns)
      { key: '${column.alias}', kind: #if($column.typeTypescript == "Date")'date'#elseif($column.typeTypescript == "number")'number'#elseif($column.typeTypescript == "boolean")'boolean'#{else}'text'#end, align: '${column.align}', agg: '${column.aggregate}'#if($column.pattern), pattern: '${column.pattern}'#end },
#end
    ],
    // The report's declared runtime parameters (the .report `parameters` block - e.g. the balance
    // window's fromDate/toDate): first-class inputs sent by name in every query body. An empty
    // value falls back to the parameter's server-side default.
    reportParams: [
#if($parameters)
#foreach($parameter in $parameters)
      { name: '${parameter.name}', tId: '${parameter.tId}', kind: #if($parameter.typeTypescript == "Date")'date'#elseif($parameter.typeTypescript == "number")'number'#{else}'text'#end },
#end
#end
    ],
    params: {},         // parameter name -> value ('' = use the server-side default)
    // The movable window (#8506): the .report `period` - the from/to parameters it fills, the default
    // preset and each offered preset's bounds as relative moments, resolved here when chosen. `preset`
    // is the active one; editing either date switches it to 'custom'. Null without a period.
    period: #if($periodJs)${periodJs}#{else}null#end,
    preset: '',
#if($drill)
    // Drill-down (#8374): each row links to the source's list, filtered by the row's dimension values -
    // a relation by its label, a number or boolean by its value. `app` is the application's shell page,
    // `route` the list's route in it.
    drill: {
      app: '${drill.app}',
      route: '${drill.route}',
      columns: [
#foreach($drillColumn in $drill.columns)
        { alias: '${drillColumn.alias}', property: '${drillColumn.property}', by: '${drillColumn.by}' },
#end
      ],
    },
#end
    filters: {},        // column key -> { from, to, min, max, contains, equals } (per kind)
    // The Filter menu, the manage list's (#7390): step one picks a column, step two edits a copy of
    // its filter, and Apply writes the copy into `filters`. A chip edits the same copy.
    filterOpen: false,
    // Which step the menu shows. The menu's own: a chip sets filterEditing but never this, and any
    // open or close of the menu resets it, so the menu always opens on its column list.
    filterMenuEditing: false,
    filterEditing: null, // the key of the column being edited, from the menu or a chip
    // Always an object: every open editor (the menu's and each chip's) binds its fields, and Alpine
    // re-reads those bindings while a closing editor is still on the page.
    filterDraft: {},
    state: 'loading',   // loading | error | empty | no-results | default
    error: null,
    // An Export or Print that failed. Kept apart from `error`, which replaces the rows: those are
    // still good when only the download failed.
    actionError: null,
    // A quiet re-read (Refresh) is in flight; the rows on screen stay until it answers.
    reloading: false,
    // When the rows on screen were read, for the "Updated <time>" stamp beside Refresh (#8130).
    lastUpdated: null,
    page: 1,
#if($kind == 'statement')
    // A statement's rows ARE its structure - a balance sheet split across pages stops being one, and
    // its line count is bounded by the definition rather than by the data. So the whole statement is
    // fetched at once; the pagination controls stay for the (unexpected) longer definition.
    limit: 500,
#else
    limit: 20,
#end
    count: 0,
    // Preview mode (dashboard tile): only the first few rows, no toolbar / pagination. Driven by
    // the ?preview=1 query param the dashboard tile passes when it embeds this page in an iframe.
    preview: false,
#if($chart)
    // Chart rendering (chart: ${chart} in the .report), drawn by the native x-h-chart-* directive in
    // the view (no external chart library). `view` toggles the chart/table surfaces; labels come from
    // the grouping dimension column and one series per aggregate (measure). chartConfig is reactive -
    // the directive redraws whenever it changes. `view` is the value of the view switch's group.
    chartType: '${chart}',
    view: 'chart',      // 'chart' | 'table'
    chartConfig: { labels: [], series: [] },
#end

    init() {
      this.displayName = String(this.displayName || '')
        .replace(/[_-]+/g, ' ').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/\s+/g, ' ').trim()
        .replace(/^./, c => c.toUpperCase());
      try {
        this.preview = new URLSearchParams(location.search).get('preview') === '1';
      } catch (e) { /* no location */ }
      if (this.preview) this.limit = 5;
      for (const col of this.reportColumns) {
        this.filters[col.key] = this.blankFilter();
      }
      for (const p of this.reportParams) {
        this.params[p.name] = '';
      }
      if (this.period) {
        this.preset = this.period.default || 'custom';
        this.applyPreset(this.preset);
        // A typed or picked date leaves the preset's window: the select says Custom from then on.
        this.${dollar}watch(() => this.params[this.period.from] + '|' + this.params[this.period.to], () => this.onPeriodEdited());
        // Choosing a preset fills both dates and re-reads the report.
        this.${dollar}watch('preset', (name) => {
          if (name !== 'custom' && this.applyPreset(name)) this.applyFilters();
        });
      }
      try { document.title = this.displayName; } catch (e) { /* no document */ }
      // Closing the Filter menu - however it closes - resets it to its column list.
      this.$watch('filterOpen', () => { this.filterMenuEditing = false; });
      this.load();
    },

    // The non-empty declared-parameter values, keyed by name - merged into every query body.
    paramValues() {
      const out = {};
      for (const p of this.reportParams) {
        const v = this.params[p.name];
        if (v !== '' && v != null) out[p.name] = v;
      }
      return out;
    },

    // The preset's window as two ISO dates, or null for 'custom' (and an unknown name).
    presetWindow(name) {
      const preset = this.period && (this.period.presets || []).find(p => p.name === name);
      return preset ? { from: this.momentDate(preset.from), to: this.momentDate(preset.to) } : null;
    },

    // Fill the period's two date inputs from a preset; false when there is nothing to fill ('custom').
    applyPreset(name) {
      const range = this.presetWindow(name);
      if (!range) return false;
      this.params[this.period.from] = range.from;
      this.params[this.period.to] = range.to;
      return true;
    },

    // A date the user set by hand: the window is no longer the preset's.
    onPeriodEdited() {
      if (this.preset === 'custom') return;
      const range = this.presetWindow(this.preset);
      if (!range || range.from !== this.params[this.period.from] || range.to !== this.params[this.period.to]) {
        this.preset = 'custom';
      }
    },

    // A relative moment (#8506) as the ISO date it names today - the grammar the generated repository
    // resolves: CURRENT_DATE or START_OF_YEAR / _QUARTER / _MONTH, then signed periods applied left to
    // right, each by its years, then months (clamped to the month's last day), then days.
    momentDate(moment) {
      const m = String(moment || '').match(/^(CURRENT_DATE|START_OF_YEAR|START_OF_QUARTER|START_OF_MONTH)(.*)/);
      if (!m) return '';
      const now = new Date();
      let y = now.getFullYear(), mo = now.getMonth(), d = now.getDate();
      if (m[1] === 'START_OF_YEAR') { mo = 0; d = 1; }
      else if (m[1] === 'START_OF_QUARTER') { mo = Math.floor(mo / 3) * 3; d = 1; }
      else if (m[1] === 'START_OF_MONTH') { d = 1; }
      const offset = /([+-])P(?:(\d+)Y)?(?:(\d+)M)?(?:(\d+)W)?(?:(\d+)D)?/g;
      let o;
      while ((o = offset.exec(m[2])) !== null) {
        const sign = o[1] === '-' ? -1 : 1;
        const total = y * 12 + mo + sign * (Number(o[2] || 0) * 12 + Number(o[3] || 0));
        y = Math.floor(total / 12);
        mo = total - y * 12;
        d = Math.min(d, new Date(y, mo + 1, 0).getDate());
        const t = new Date(y, mo, d + sign * (Number(o[4] || 0) * 7 + Number(o[5] || 0)));
        y = t.getFullYear(); mo = t.getMonth(); d = t.getDate();
      }
      return y + '-' + String(mo + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
    },

    // A preset's translated name - the select's options and the window named in the title.
    presetLabel(name) {
      const fallback = {
        custom: 'Custom', last7Days: 'Last 7 days', last30Days: 'Last 30 days', currentMonth: 'Current month',
        previousMonth: 'Previous month', currentQuarter: 'Current quarter', lastQuarter: 'Last quarter',
        yearToDate: 'Year to date', currentYear: 'Current year', previousYear: 'Previous year',
      };
      return T('application-core:shell.report.periods.' + name, fallback[name] || name);
    },

    // The active window, for the title: the preset's name, or a custom window's two dates (#8506).
    // Empty without a period, and for a custom window left open on both ends.
    get periodText() {
      if (!this.period) return '';
      if (this.preset && this.preset !== 'custom') return this.presetLabel(this.preset);
      const from = this.params[this.period.from], to = this.params[this.period.to];
      if (!from && !to) return '';
      const show = (v) => v ? HarmoniaFormat.date(v) : '...';
      return show(from) + ' - ' + show(to);
    },

    // "fromDate" -> "From Date": a parameter's label when the report's catalog has none for it.
    paramLabel(name) {
      return String(name || '')
        .replace(/[_-]+/g, ' ').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/\s+/g, ' ').trim()
        .replace(/^./, c => c.toUpperCase());
    },

    // The active per-column conditions in the controller's shape: [{ column, operator, value }].
    // Ranges become GTE/LTE pairs, text a case-insensitive CONTAINS (#8431), boolean an EQ.
    conditions() {
      const conditions = [];
      for (const col of this.reportColumns) {
        const f = this.filters[col.key];
        if (!f) continue;
        if (col.kind === 'date') {
          if (f.from) conditions.push({ column: col.key, operator: 'GTE', value: f.from });
          if (f.to) conditions.push({ column: col.key, operator: 'LTE', value: f.to });
        } else if (col.kind === 'number') {
          if (this.isBound(f.min)) conditions.push({ column: col.key, operator: 'GTE', value: f.min });
          if (this.isBound(f.max)) conditions.push({ column: col.key, operator: 'LTE', value: f.max });
        } else if (col.kind === 'boolean') {
          if (f.equals !== '') conditions.push({ column: col.key, operator: 'EQ', value: f.equals === 'true' });
        } else if (f.contains) {
          conditions.push({ column: col.key, operator: 'CONTAINS', value: f.contains });
        }
      }
      return conditions;
    },

    get activeFilterCount() { return this.conditions().length; },

    applyFilters() { this.page = 1; this.load(); },

    clearFilters() {
      for (const col of this.reportColumns) {
        this.filters[col.key] = this.blankFilter();
      }
      this.page = 1;
      this.load();
    },

    blankFilter() { return { from: '', to: '', min: null, max: null, contains: '', equals: '' }; },

    // A number bound is set once something was typed: an emptied number input reads ''.
    isBound(v) { return v !== null && v !== undefined && v !== ''; },

    // ----- The Filter menu and its chips (presentation over `filters` and conditions()) -----------
    // Whether a column's filter narrows anything: a range needs at least one of its ends.
    filterHasValue(col) {
      const f = this.filters[col.key];
      if (!f) return false;
      if (col.kind === 'date') return !!(f.from || f.to);
      if (col.kind === 'number') return this.isBound(f.min) || this.isBound(f.max);
      if (col.kind === 'boolean') return f.equals !== '';
      return !!f.contains;
    },

    // The filters in force, as chips.
    get activeFilterChips() {
      return this.reportColumns.filter(c => this.filterHasValue(c))
        .map(c => ({ key: c.key, text: this.filterValueText(c) }));
    },

    // A filter's value as its chip prints it: "01.10.2026 - 31.10.2026", "From 01.10.2026",
    // "100 - 500", "At least 100", Yes / No, or the text. Empty for a column without a filter, since
    // the menu's first step evaluates it for every column.
    filterValueText(col) {
      if (!this.filterHasValue(col)) return '';
      const f = this.filters[col.key];
      if (col.kind === 'date') {
        const from = f.from ? HarmoniaFormat.date(f.from) : '';
        const to = f.to ? HarmoniaFormat.date(f.to) : '';
        if (from && to) return from + ' - ' + to;
        return from ? T('application-core:shell.list.dateFromValue', 'From {{date}}', { date: from })
                    : T('application-core:shell.list.dateToValue', 'To {{date}}', { date: to });
      }
      if (col.kind === 'number') {
        const min = this.isBound(f.min) ? this.filterNumber(col, f.min) : '';
        const max = this.isBound(f.max) ? this.filterNumber(col, f.max) : '';
        if (min && max) return min + ' - ' + max;
        return min ? T('application-core:shell.report.atLeast', 'At least {{value}}', { value: min })
                   : T('application-core:shell.report.atMost', 'At most {{value}}', { value: max });
      }
      if (col.kind === 'boolean') {
        return f.equals === 'true' ? T('application-core:shell.report.true', 'Yes') : T('application-core:shell.report.false', 'No');
      }
      return f.contains;
    },

    // A number bound printed the way its column prints: with the column's pattern when it has one.
    filterNumber(col, v) { return col.pattern ? this.displayNumber(v, col.pattern) : String(v); },

    // Open the editor for one column on a copy of its filter, so Cancel leaves the one in force untouched.
    openFilterEditor(key) {
      this.filterEditing = key;
      this.filterDraft = { ...(this.filters[key] || this.blankFilter()) };
    },
    backToFilterMenu() { this.filterMenuEditing = false; this.filterEditing = null; this.filterDraft = {}; },
    closeFilterMenu() { this.filterOpen = false; this.filterEditing = null; this.filterDraft = {}; },
    get editedFilterColumn() { return this.reportColumns.find(c => c.key === this.filterEditing) || null; },

    // Apply writes the draft into `filters` and runs the one query it implies. A range entered back
    // to front is meant the right way round.
    applyFilterDraft() {
      if (!this.filterEditing) return;
      const draft = { ...this.filterDraft };
      if (draft.from && draft.to && draft.from > draft.to) [draft.from, draft.to] = [draft.to, draft.from];
      if (this.isBound(draft.min) && this.isBound(draft.max) && Number(draft.min) > Number(draft.max)) [draft.min, draft.max] = [draft.max, draft.min];
      this.filters[this.filterEditing] = draft;
      this.closeFilterMenu();
      this.applyFilters();
    },

    // Drop one filter (a chip's x). The rest stay in force.
    removeFilter(key) {
      this.filters[key] = this.blankFilter();
      this.applyFilters();
    },

    // The quick periods of a date filter, the list's (#8131); each fills From and To, and Apply runs
    // the query as for a typed range. A week starts on Monday. Days are local YYYY-MM-DD.
    datePresets: [
      { key: 'today',     label: 'Today' },
      { key: 'thisWeek',  label: 'This week' },
      { key: 'thisMonth', label: 'This month' },
      { key: 'lastMonth', label: 'Last month' },
      { key: 'thisYear',  label: 'This year' },
    ],
    applyDatePreset(key) {
      const now = new Date();
      const y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
      const monday = d - ((now.getDay() + 6) % 7);
      const range = {
        today:     [new Date(y, m, d), new Date(y, m, d)],
        thisWeek:  [new Date(y, m, monday), new Date(y, m, monday + 6)],
        thisMonth: [new Date(y, m, 1), new Date(y, m + 1, 0)],
        lastMonth: [new Date(y, m - 1, 1), new Date(y, m, 0)],
        thisYear:  [new Date(y, 0, 1), new Date(y, 11, 31)],
      }[key];
      this.filterDraft = { ...this.filterDraft, from: this.toDay(range[0]), to: this.toDay(range[1]) };
    },
    toDay(date) {
      return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
    },

    // Re-read under the parameters, filters and page in force, keeping the rows on screen meanwhile.
    refresh() { return this.load(true); },

    // `quiet` keeps the current rows on screen while the query runs (Refresh); otherwise the page
    // shows the loading state, as on a first load or a filter change.
    async load(quiet) {
      const keepRows = quiet && (this.state === 'default' || this.state === 'no-results' || this.state === 'empty');
      if (keepRows) this.reloading = true;
      else this.state = 'loading';
      this.error = null;
      try {
        const conditions = this.conditions();
        const params = this.paramValues();
        const filtered = conditions.length > 0 || Object.keys(params).length > 0;
        // Fetch the total first so preview mode (the dashboard tile) can window to the LAST rows -
        // the most recent records in the report's natural order - rather than the first ones.
        try {
          const c = filtered
            ? await reportHttp.post(this.apiBase + '/count', { conditions, ...params })
            : await reportHttp.get(this.apiBase + '/count');
          this.count = (c && c.count != null) ? c.count : 0;
        } catch (e) { this.count = 0; }
        const offset = this.preview
          ? Math.max(0, this.count - this.limit)
          : (this.page - 1) * this.limit;
        let rows;
        if (filtered) {
          rows = await reportHttp.post(this.apiBase + '/search', { ${dollar}limit: this.limit, ${dollar}offset: offset, conditions, ...params });
        } else {
          rows = await reportHttp.get(this.apiBase + '?${dollar}limit=' + this.limit + '&${dollar}offset=' + offset);
        }
        this.rows = rows || [];
        // Columns come from the row keys (the report's result-set aliases, e.g. "Member Name"),
        // falling back to the generation-time metadata when a filter empties the page.
        if (this.rows.length) this.columns = Object.keys(this.rows[0]);
        else if (!this.columns.length && this.reportColumns.length) this.columns = this.reportColumns.map(c => c.key);
        if (!this.count) this.count = this.rows.length;
        // Rows the column filters exclude are an answer about the filters, not an empty report.
        if (this.rows.length) this.state = 'default';
        else this.state = conditions.length ? 'no-results' : 'empty';
        this.lastUpdated = new Date();
      } catch (e) {
        this.error = App.services.apiErrors.refusalMessageFor(e, 'Could not run the ${name} report.');
        this.state = 'error';
      } finally {
        this.reloading = false;
      }
#if($chart)
      if (this.chartType && this.rows.length) this.chartConfig = this.buildChartConfig();
#end
    },
#if($chart)

    // Build the native chart config from the aggregated rows: the grouping dimension (aggregate NONE)
    // labels the axis, each aggregate column becomes a series. Recomputed on every load/filter.
    buildChartConfig() {
      const category = this.reportColumns.find(c => c.agg === 'NONE') || this.reportColumns[0];
      let series = this.reportColumns.filter(c => c.agg && c.agg !== 'NONE');
      if (!series.length) series = this.reportColumns.filter(c => c !== category);
      const labels = this.rows.map(r => this.axisLabel(category ? r[category.key] : '', category));
      const data = series.map(c => ({ name: c.key, data: this.rows.map(r => Number(r[c.key]) || 0) }));
      // A circular chart slices the FIRST measure by the dimension, so the dimension values are named
      // by the legend alone - it stays on whatever the series count - and each legend entry carries
      // the slice's share of the measure total. Pie and doughnut additionally suppress the in-slice
      // data label: the chart library prints the raw measure there with a percent sign, so a 336-hour
      // sum reads "336%" (codbex/harmonia#113, fixed after 2.14.2). The share belongs in the legend
      // either way.
      if (this.chartType === 'pie' || this.chartType === 'doughnut') {
        return { labels: this.shareLabels(labels, data[0]), series: data, legend: true, dataLabels: false };
      }
      if (this.chartType === 'polarArea') {
        return { labels: this.shareLabels(labels, data[0]), series: data, legend: true };
      }
      return { labels, series: data, legend: data.length > 1 };
    },

    // "Billable" -> "Billable - 62%": a slice label with its share of the measure total, so a circular
    // chart's legend reads as a split. Left untouched when there is no positive total to share, and
    // when the fetched rows are only a window on the result (the dashboard tile fetches a few) - a
    // page-local share is not the report's, the same rule the table footer applies to its totals.
    shareLabels(labels, measure) {
      if (this.count > this.rows.length) return labels;
      const values = (measure && measure.data) || [];
      const total = values.reduce((sum, v) => sum + (v > 0 ? v : 0), 0);
      if (!(total > 0)) return labels;
      return labels.map((label, i) => {
        const v = values[i];
        if (!(v > 0)) return label;
        const pct = (v / total) * 100;
        return label + ' - ' + (pct < 10 ? pct.toFixed(1) : String(Math.round(pct))) + '%';
      });
    },

    // month(date) buckets are YYYYMM integers (e.g. 202607) - render them as "2026-07"; a boolean
    // dimension reads as Yes/No, never as the raw true/false.
    axisLabel(v, meta) {
      if (typeof v === 'boolean' || (meta && meta.kind === 'boolean' && v != null && v !== '')) return this.yesNo(v);
      const n = Number(v);
      if (Number.isInteger(n) && n >= 190001 && n <= 999912 && (n % 100) >= 1 && (n % 100) <= 12) {
        return Math.floor(n / 100) + '-' + String(n % 100).padStart(2, '0');
      }
      return v == null ? '' : String(v);
    },
#end

#if($drill)
    // The list route filtered to the records one row counts - '/Ticket?Priority=High&Status=REOPENED' -
    // or null when a dimension of the row is empty: the list's filters cannot say "is empty".
    drillLink(row) {
      const parts = [];
      for (const c of this.drill.columns) {
        const v = row[c.alias];
        if (v === null || v === undefined || v === '') return null;
        parts.push(encodeURIComponent(c.property) + '=' + encodeURIComponent(String(v)));
      }
      return this.drill.route + '?' + parts.join('&');
    },
    // The row's link: the application shell at that route. The page is hosted by the shell's /reports
    // route (or a dashboard tile), so the link opens in the parent and only its hash changes; opened
    // standalone, the page navigates itself to the application.
    drillHref(row) {
      const link = this.drillLink(row);
      return link ? this.drill.app + '#' + link : null;
    },

#end
    columnMeta(key) { return this.reportColumns.find(c => c.key === key) || null; },

    // Numeric columns right-align (from the .report column metadata).
    alignClass(key) {
      const meta = this.columnMeta(key);
      return meta && meta.align === 'right' ? 'text-right' : '';
    },

    // Cell text: decimals format by the column's DecimalFormat-style pattern (grouped thousands,
    // fixed decimals - the platform money pattern); everything else renders as-is.
    cellText(key, row) {
      const v = row[key];
      const meta = this.columnMeta(key);
      if (meta && meta.pattern) return this.displayNumber(v, meta.pattern);
      // Pattern-less numeric columns (counts, year/month buckets) still render as clean integers -
      // the DB returns them as decimals (1.0, 202607.0). NB: the pattern must stay '0' - never a
      // hash-style DecimalFormat literal, because two hashes start a Velocity line comment and
      // swallow the rest of the line (unterminated string in the generated file).
      if (meta && meta.kind === 'number') return this.displayNumber(v, '0');
      if (meta && meta.kind === 'boolean' && v != null && v !== '') return this.yesNo(v);
      return v;
    },

    // A boolean as the page prints it - Yes / No, never the raw true/false - in a cell, an axis label
    // or a legend entry. Some databases answer a boolean column as 1 / 0.
    yesNo(v) {
      const yes = v === true || v === 'true' || v === 1 || v === '1';
      return yes ? T('application-core:shell.report.true', 'Yes') : T('application-core:shell.report.false', 'No');
    },

    // The stamp's time, in the instance's date-time format - the Inbox's and the lists' stamp.
    updatedTime() {
      if (!this.lastUpdated) return '';
      try { return window.HarmoniaFormat.value(this.lastUpdated, true); } catch (e) { return String(this.lastUpdated); }
    },

    // Decimals from the column pattern, separators from the instance Number setting (shell format.js).
    displayNumber(v, pattern) {
      return window.HarmoniaFormat.number(v, pattern, '');
    },

    // Column totals over the fetched rows (balance reports render them as a table footer) - shown
    // only when the whole (filtered) result fits on one page, so the footer never presents a
    // page-local sum as the report total.
    get showTotals() { return this.rows.length > 0 && this.count <= this.limit; },
    totalText(key) {
      const meta = this.columnMeta(key);
      if (!meta || meta.agg !== 'SUM') return '';
      let sum = 0;
      for (const row of this.rows) sum += Number(row[key]) || 0;
      return this.displayNumber(sum, meta.pattern || '0');
    },

    get totalPages() { return Math.max(1, Math.ceil(this.count / this.limit)); },
    // Server-side paging: a page change re-queries; the clamp keeps a stale pager click in range.
    goPage(n) {
      const page = Math.max(1, Math.min(n, this.totalPages));
      if (page === this.page) return;
      this.page = page;
      this.load();
    },
    // The page numbers the pager shows: first, last and the current page's neighbours, '...' over
    // each gap - at most 7 entries, so a long report never renders a link per page.
    pageWindow() {
      const total = this.totalPages, current = this.page;
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const start = Math.max(2, current - 1), end = Math.min(total - 1, current + 1);
      const pages = [1];
      if (start > 2) pages.push('...');
      for (let p = start; p <= end; p++) pages.push(p);
      if (end < total - 1) pages.push('...');
      pages.push(total);
      return pages;
    },

    // Export / Print take a scope (#8434): 'all' (the default) re-queries the full result under the
    // filters and parameters in force; 'page' is the page of rows on screen.
    async exportScopeRows(scope) {
      if (scope === 'page') return (this.rows || []).slice();
      const data = await reportHttp.post(this.apiBase + '/export', { conditions: this.conditions(), ...this.paramValues() });
      return Array.isArray(data) ? data : [];
    },
    // Export the rows in scope as CSV.
    async exportCsv(scope) {
      this.actionError = null;
      try {
        // The export honors the active per-column filters and parameters - it downloads what the
        // table shows.
        const rows = await this.exportScopeRows(scope);
        if (!rows.length) return;
        const cols = Object.keys(rows[0]);
        const esc = (v) => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
        const csv = [cols.join(',')].concat(rows.map(r => cols.map(c => esc(r[c])).join(','))).join('\n');
        const blob = new Blob([csv], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = '${name}.csv';
        a.click();
        URL.revokeObjectURL(a.href);
      } catch (e) {
        this.actionError = App.services.apiErrors.refusalMessageFor(e, 'Export failed.');
      }
    },

    // Print the report: the rows in scope (the same as the CSV export) rendered into a minimal print
    // document in a new window.
    async printReport(scope) {
      this.actionError = null;
      try {
        const rows = await this.exportScopeRows(scope);
        if (!rows.length) return;
        const cols = Object.keys(rows[0]);
        const esc = (v) => String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        const th = cols.map(c => '<th class="' + this.alignClass(c) + '">' + esc(c) + '</th>').join('');
        const body = rows.map(r => '<tr>' + cols.map(c => '<td class="' + this.alignClass(c) + '">' + esc(this.cellText(c, r)) + '</td>').join('') + '</tr>').join('');
        // Fixed table layout + column-count font scaling so a wide table fits the page instead of
        // being clipped at the right edge (mirrors the server-side XslFoRenderer PDF path).
        const fontSize = Math.max(6, 10 - Math.max(0, cols.length - 3));
        const html = '<!doctype html><html><head><title>' + esc(this.displayName) + '</title><style>'
          + 'body{font-family:system-ui,-apple-system,sans-serif;margin:24px;color:#111}'
          + 'h1{font-size:18px;margin:0 0 4px}'
          + '.meta{font-size:11px;color:#555;margin:0 0 16px}'
          + 'table{border-collapse:collapse;width:100%;table-layout:fixed;font-size:' + fontSize + 'pt}'
          + 'th,td{border:1px solid #999;padding:2pt;text-align:left;overflow-wrap:anywhere;word-break:break-word}'
          + 'th{background:#eee}.text-right{text-align:right}'
          + '</style></head><body><h1>' + esc(this.displayName) + '</h1>'
          + '<p class="meta">' + rows.length + ' rows' + (this.activeFilterCount ? ' (filtered)' : '') + ' - ' + esc(HarmoniaFormat.value(new Date(), true)) + '</p>'
          + '<table><thead><tr>' + th + '</tr></thead><tbody>' + body + '</tbody></table></body></html>';
        const w = window.open('', '_blank');
        if (!w) return;
        w.document.write(html);
        w.document.close();
        w.focus();
        w.print();
      } catch (e) {
        this.actionError = App.services.apiErrors.refusalMessageFor(e, 'Print failed.');
      }
    },
  }));
}, { once: true });
