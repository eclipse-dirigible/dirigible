<!--
  Generated by Eclipse Dirigible based on model and template.
  Personal (my) DOCUMENT fragment for ${name}. Rendered into #app on /my/${name}/:id/preview,
  /my/${name}/:id/edit and /my/${name}/create, laid out as the power document (#7390). Header form + inline ${documentItemsEntity} line-items table + totals footer,
  all scoped to the logged-in user's own document (the *MyController). No owner control, no sensitive
  fields; the EntityStatus shows as a read-only badge.
-->
#set($statusProp = "")
#set($docNumProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_STATUS")#set($statusProp = $property.name)#end
#if($property.widgetType == "DOCUMENT_NUMBER")#set($docNumProp = $property.name)#end
#end
## Role-scoped field (intent `visibleTo:`): rendered only for a caller the server actually serves it
## to - the page asked the controller which fields it withholds (canSee). Emits nothing for an
## unrestricted property. Owning the record (or being the partner it belongs to) does not grant a
## role, so this surface hides exactly what its own controller strips from the wire.
## Status-gated field (intent `visibleWhen:`, #7502): absent until the condition holds against the
## record the page shows (visibleWhenJs, rendered by ModelParameterProcessor). An element holds one
## x-show, so a field carrying both gates gets them ANDed in it. UI-only - the value is still served.
#macro(visibleGate $property)#if($property.roleRead && $property.visibleWhenJs) x-show="canSee('${property.name}') && ${property.visibleWhenJs}"#elseif($property.roleRead) x-show="canSee('${property.name}')"#elseif($property.visibleWhenJs) x-show="${property.visibleWhenJs}"#end#end
## A field shown as a value, not a control (the read-only cards): its display text through the
## shared basePage.fieldDisplay - option label(s), instance date format, a float's own pattern, the
## translated Yes/No (a checkbox's options are its two states) - and the row shown only when that
## text is non-empty and the caller may see the field (issue #7522).
## The column length the controller enforces, as the input's maxlength (#8135): a string column with a
## declared length - the same set the server refuses past ("exceeds the maximum length of N").
#macro(maxLength $p)#if($p.dataTypeJavaClass == "String" && $p.dataLength && "$p.dataLength" != "" && $p.dataTypeJava != "time") maxlength="${p.dataLength}"#end#end
## ...and says why it stops (#8135): once the value fills the column, the field's description names the
## limit - nothing is shown before, so a long form stays as it was.
#macro(maxLengthHint $p)
#if($p.dataTypeJavaClass == "String" && $p.dataLength && "$p.dataLength" != "" && $p.dataTypeJava != "time")
        <p x-h-field-description x-show="String(form.${p.name} ?? '').length >= ${p.dataLength}" x-text="T('$projectName:${tprefix}.messages.maxLengthReached', 'Maximum {{count}} characters', { count: ${p.dataLength} })"></p>
#end
#end
#macro(valueOptions $property)#if($property.widgetType == "CHECKBOX")[{ value: true, text: T('$projectName:${tprefix}.${property.booleanTrueKey}', '${property.booleanTrueTextJs}') }, { value: false, text: T('$projectName:${tprefix}.${property.booleanFalseKey}', '${property.booleanFalseTextJs}') }]#elseif($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT")options['${property.name}']#{else}null#end#end
## A shown value reads the record as the server answered it (`record`, #8367), never the input buffer:
## `form` holds a date cut to the shape its input takes (13:49:11 -> 13:49). The gate only tests for
## emptiness, so it may read the form.
#macro(displayArgs $property)'#if($property.numberStampOnIssue)DOCUMENT_NUMBER#else$!{property.widgetType}#end', '#if($property.isFloatType)$!{property.formatPattern}#end', #valueOptions($property)#end
## intent `emptyText:` (#8605): the text an empty value reads as, translated through t.<DATA_NAME>_empty;
## also the placeholder of a text-like or number input. Nothing is emitted for a property without it.
#macro(emptyTextArgs $p)'$projectName:${tprefix}.t.${p.dataName}_empty', '${p.widgetEmptyTextJs}'#end
#macro(emptyPlaceholder $p)#if($p.widgetEmptyText) :placeholder="T(#emptyTextArgs($p))"#end#end
#macro(valueDisplay $property)#if($property.widgetEmptyText)orEmptyText(record.${property.name}, fieldDisplay(record.${property.name}, #displayArgs($property)), #emptyTextArgs($property))#{else}fieldDisplay(record.${property.name}, #displayArgs($property))#end#end
#macro(valueGate $property)#if($property.widgetEmptyText)#if($property.roleRead || $property.visibleWhenJs)x-show="#if($property.roleRead)canSee('${property.name}')#if($property.visibleWhenJs) && #end#end$!{property.visibleWhenJs}"#end#{else}x-show="#if($property.roleRead)canSee('${property.name}') && #end#if($property.visibleWhenJs)${property.visibleWhenJs} && #{end}fieldDisplay(form.${property.name}, #displayArgs($property)) !== ''"#end#end
<div x-data="${name}MyDocumentPage" class="vbox w-full"
     @keydown.window.ctrl.s.prevent="saveShortcut()" @keydown.window.meta.s.prevent="saveShortcut()"
     @keydown.escape.window="escapeDismiss()">

  <!-- Document header + action bar, the power document's (#7390, after #7770): two lines on the
       left - the caption and the document's number with its status, then the subtitle in preview or the required legend
       while editing - and the action cluster on the right. Sticky: the page root grows with its
       content, so the bar pins itself and paints the background or the form scrolls through it.
       Ctrl/Cmd+S saves; Escape leaves a preview, the same as Close. -->
  <div class="sticky top-0 z-10 border-b border-border bg-background px-4 py-3">
    <div class="hbox items-start justify-between gap-4">

      <div class="vbox min-w-0 gap-1">
        <span x-h-text.muted class="text-xs" data-record-caption x-show="headerCaption()" x-text="headerCaption()"></span>
        <div class="hbox flex-wrap items-center gap-2">
          <h1 x-h-text.h3 class="truncate" x-text="headerTitle()"></h1>
#if($statusProp != "")
          <!-- EntityStatus badge beside the title, once the record's status resolves. -->
          <span x-h-badge class="shrink-0" :data-variant="statusVariant(statusText(), form.${statusProp})" x-show="mode !== 'create' &amp;&amp; statusText()" x-text="statusText()"></span>
#end
#if($immutableStatusProperty || $immutableAlways || $periodLock)
          <!-- Immutability pre-check: the record refuses user edits/deletes, so the page opens in preview
               and says why (the controller's 409 stays authoritative). Neutral (#8368): it explains the
               missing Edit, it reports nothing wrong - and its tooltip names the lock the entity declares:
               always, by status, or by accounting period. -->
          <span x-h-badge class="shrink-0" data-variant="outline" x-show="!mutable" :title="#if($immutableAlways)T('$projectName:${tprefix}.messages.immutableAlways', 'This record cannot be changed once it is created.')#elseif($immutableStatusProperty)T('$projectName:${tprefix}.messages.immutable', 'This record is read-only in its current status - corrections go through the workflow.')#{else}T('$projectName:${tprefix}.messages.immutablePeriod', 'This record is read-only - its accounting period is closed; book the correction in an open period.')#end" x-text="T('$projectName:${tprefix}.defaults.readOnly', 'Read-only')"></span>
#end
        </div>
        <!-- Preview prints the line the model declares under the title (intent `subtitle:`, #8370), each
             value with its field's label as the tooltip; the editable modes say what the asterisks mean. -->
        <span x-h-text.muted class="truncate text-sm" data-record-subtitle x-show="isPreview &amp;&amp; subtitleParts().length">
          <template x-for="(part, i) in subtitleParts()" :key="i">
            <span><span x-text="i ? ' \u00b7 ' : ''"></span><span :title="part.title" x-text="part.text"></span></span>
          </template>
        </span>
        <span x-h-text.muted class="text-sm" x-show="!isPreview &amp;&amp; writable" x-text="T('$projectName:${tprefix}.messages.requiredLegend', 'Fields marked * are required')"></span>
      </div>

      <!-- At most one filled button, chosen by the component (primaryAction), never by competing
           x-shows here. Order: dirty marker, dismiss, overflow, secondary, primary. On a phone the same
           cluster pins to the bottom of the screen, where a thumb reaches. -->
      <div role="toolbar" :aria-label="T('$projectName:${tprefix}.t.${dataName}', '${documentLabel}')"
           class="hbox items-center gap-2"
           :class="isNarrow ? 'fixed bottom-0 left-0 right-0 z-20 w-full justify-end border-t bg-background px-4 py-3' : 'shrink-0'">

        <!-- Unsaved-changes marker (issue #7359): a dot and a line of text - a note about the form, not
             a status the record has. -->
        <div class="hbox shrink-0 items-center gap-2 text-sm text-warning" x-show="isDirty()">
          <span class="size-2 shrink-0 rounded-full bg-warning"></span>
          <span x-text="T('$projectName:${tprefix}.messages.unsavedChanges', 'Unsaved changes')"></span>
        </div>

        <!-- Dismiss. Preview keeps Close; the editable modes say what leaving will cost. -->
        <button type="button" x-h-button data-variant="transparent" class="shrink-0" x-show="isPreview" @click="goBack()" x-text="T('$projectName:${tprefix}.defaults.close', 'Close')"></button>
        <button type="button" x-h-button data-variant="transparent" class="shrink-0" x-show="!isPreview" @click="goBack()" :disabled="saving" x-text="isDirty() ? T('$projectName:${tprefix}.defaults.discard', 'Discard') : T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>

        <!-- Overflow, in preview: the record's own actions on the personal surface (#8406) - a
             transition its owner runs on it, only those its status accepts - then the destructive group
             last: the destructive actions (#8364) and Delete. -->
        <button type="button" x-h-button data-variant="outline" data-size="icon" class="shrink-0" x-h-menu-trigger.dropdown :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')" x-show="isPreview &amp;&amp; hasOverflowMenu">
          <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
        </button>
        <ul x-h-menu data-align="bottom-end">
          <template x-for="action in menuRecordActions" :key="action.id">
            <li x-h-menu-item @click="runRecordAction(action)"
                x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
          </template>
#if(!$personalReadOnly && !$systemWritten)
          <!-- Edit folds in here on a narrow viewport when an action holds the filled slot. -->
          <template x-if="editInMenu">
            <li x-h-menu-item @click="goEdit()">
              <svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span>
            </li>
          </template>
#end
          <template x-if="(menuRecordActions.length || editInMenu) &amp;&amp; (destructiveRecordActions().length || menuHasDelete)">
            <li x-h-menu-separator></li>
          </template>
          <template x-for="action in destructiveRecordActions()" :key="action.id">
            <li x-h-menu-item data-variant="negative" @click="runRecordAction(action)"
                x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
          </template>
#if(!$personalReadOnly && !$systemWritten)
          <template x-if="menuHasDelete">
            <li x-h-menu-item data-variant="negative" @click="deleteOpen = true">
              <svg role="presentation" x-h-lucide data-lucide="trash-2"></svg><span x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></span>
            </li>
          </template>
#end
        </ul>

#if(!$personalReadOnly && !$systemWritten)
        <!-- Secondary: Edit steps down to outlined when a contributed action holds the filled slot. -->
        <button type="button" x-h-button data-variant="outline" class="shrink-0" x-show="isPreview &amp;&amp; showsSecondaryEdit" @click="goEdit()">
          <svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span>
        </button>
#end
        <!-- Primary, in preview: a contributed action declared primary that applies to this record
             (#8119), else Edit - or nothing on a record its owner may not change. -->
        <button type="button" x-h-button data-variant="primary" class="shrink-0" x-show="isPreview &amp;&amp; primaryAction === 'action'" @click="runPrimaryAction()">
          <span x-text="primaryActionLabel()"></span>
        </button>
#if(!$personalReadOnly && !$systemWritten)
        <button type="button" x-h-button data-variant="primary" class="shrink-0" x-show="isPreview &amp;&amp; primaryAction === 'edit'" @click="goEdit()">
          <svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span>
        </button>
        <!-- Primary, in the editable modes: Save (Create on a new record). Nothing to save on an
             unchanged record. -->
        <button type="button" x-h-button data-variant="primary" class="shrink-0" x-show="!isPreview &amp;&amp; writable" :disabled="saving || (mode === 'edit' &amp;&amp; !isDirty())" @click="saveAndPreview()">
          <span x-show="saving" x-h-spinner></span>
          <svg x-h-lucide role="presentation" data-lucide="save" x-show="!saving"></svg><span x-text="mode === 'edit' ? T('$projectName:${tprefix}.defaults.save', 'Save') : T('$projectName:${tprefix}.defaults.create', 'Create')"></span>
        </button>
#end
      </div>
    </div>
  </div>

  <div x-show="state === 'loading'" class="p-4"><div x-h-spinner></div></div>
  <!-- An alert is icon, title, description: the title names what failed, the description why. -->
  <div x-show="error" class="px-4 pt-4">
    <div x-h-alert data-variant="negative" role="alert">
      <svg x-h-lucide role="presentation" data-lucide="circle-x"></svg>
      <div x-h-alert-title x-text="state === 'error' ? T('$projectName:${tprefix}.messages.error.loading', 'Could not load') : T('$projectName:${tprefix}.messages.error.saving', 'Could not save')"></div>
      <div x-h-alert-description x-text="error"></div>
    </div>
  </div>

  <!-- The document: its header fields, then the lines, the totals and the other children - each
       group a heading and a rule, the page's own card the only frame (#7770). -->
  <div x-show="state === 'default'" class="vbox w-full gap-4 px-4 py-6"
       :style="isNarrow ? 'padding-bottom: 5rem' : ''">
    <h3 x-h-text.h4 x-text="T('$projectName:${tprefix}.defaults.general', 'General')"></h3>
    <!-- Header form (aggregate totals + document number + status are excluded - number/status show in
         the title bar, totals in the footer). -->
    <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
#foreach($property in $properties)
#if(!$property.dataAutoIncrement && !$property.sensitiveProperty && $property.name != "ProcessId" && !$property.isHiddenProperty && (!$property.auditType || $property.auditType == "NONE") && $property.name != "Name" && $property.name != "$!{personalProperty}" && $property.isReadOnlyProperty != "true" && $property.widgetType != "DOCUMENT_STATUS" && !($property.widgetType == "DOCUMENT_NUMBER" && $property.numberSeries) && $property.aggregate != "true")
      <div x-h-field class="#if($property.widgetType =="MULTISELECT")sm:col-span-12#elseif($property.widgetSize && $property.widgetSize != "")sm:col-span-${property.widgetSize}#{else}sm:col-span-6#end"#visibleGate($property) :data-invalid="fieldError === '${property.name}'">
        <!-- Preview shows the VALUE, not a disabled input (#7770): the label muted above it, an empty
             value as an em dash. -->
        <template x-if="isPreview">
          <div class="vbox gap-1">
            <span x-h-text.muted class="text-xs" x-text="T('$projectName:${tprefix}.t.${property.dataName}', '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end')"></span>
            <div class="text-sm wrap-anywhere#if($property.widgetType == "TEXTAREA") whitespace-pre-wrap#end" x-text="(#valueDisplay($property)) || '\u2014'"></div>
          </div>
        </template>
        <template x-if="!isPreview">
          <div class="vbox gap-2">
## A CHECKBOX carries its label BESIDE it, inside the branch below - not above, as every
## other control does.
#if($property.widgetType != "CHECKBOX")
        <label x-h-label>
          <span x-text="T('$projectName:${tprefix}.t.${property.dataName}', '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end')"></span>#if($property.isRequiredProperty == "true") <span class="text-negative">*</span>#end
        </label>
#end
## fixedAfterCreate on a FIELD (#8363): the same rule as the picker below - read-only on edit where the
## input has a read-only state (text, number), disabled where it has none (checkbox, the pickers).
#if($property.fixedAfterCreate == "true")#set($fixedRo = ' :readonly="mode === ''edit''"')#set($fixedDis = ' :disabled="mode === ''edit''"')#else#set($fixedRo = '')#set($fixedDis = '')#end
#if($property.widgetType == "DROPDOWN")
## fixedAfterCreate (#7903): picked on create, read-only once the record exists (the controller refuses a change).
## data-clearable (#8658): an optional picker is cleared by re-clicking its selected option; a required one keeps its value.
        <!-- A target the caller's role may not read (#8728): the stored value read-only, with a line
             saying why, instead of a picker with nothing to pick. -->
        <template x-if="readRefused('${property.widgetDropdownControllerUrl}')">
          <div class="vbox gap-1">
            <input x-h-input type="text" readonly :value="form.${property.name} == null ? '' : String(form.${property.name})" />
            <p x-h-field-description x-text="T('application-core:shell.related.unreadable', 'Your role cannot list these records, so the stored one is kept.')"></p>
          </div>
        </template>
        <template x-if="!readRefused('${property.widgetDropdownControllerUrl}')">
        <div x-h-select#if($property.isRequiredProperty != "true") data-clearable="true"#end>
          <input x-h-select-input x-model="form.${property.name}"#if($property.fixedAfterCreate == "true") :disabled="mode === 'edit'"#end :aria-invalid="fieldError === '${property.name}'" :placeholder="T('$projectName:${tprefix}.messages.inputSelect', 'Select {{name}}...', { name: T('$projectName:${tprefix}.t.${property.dataName}', '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end') })" />
          <div x-h-select-content>
            <div x-h-select-search data-filter="contains"></div>
            <div x-h-select-list>
              <template x-for="opt in #if($property.widgetPickable)visibleOptions(options['${property.name}'], form.${property.name})#{else}(options['${property.name}'] || [])#end" :key="opt.value">
                <div x-h-select-option="opt.text" :data-value="String(opt.value)"#if($property.widgetPickable) :aria-disabled="opt.disabled ? 'true' : null" :data-description="opt.description || null"#end></div>
              </template>
            </div>
          </div>
        </div>
        </template>
#elseif($property.widgetType == "MULTISELECT")
        <!-- Subset (intent `kind: subset`): the bound ARRAY model puts the select in
             multiple mode - the csv is split on load and joined back on save. -->
        <div x-h-select>
          <input x-h-select-input x-model="form.${property.name}" :aria-invalid="fieldError === '${property.name}'" :placeholder="T('$projectName:${tprefix}.messages.inputSelect', 'Select {{name}}...', { name: T('$projectName:${tprefix}.t.${property.dataName}', '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end') })" />
          <div x-h-select-content>
            <div x-h-select-search data-filter="contains"></div>
            <div x-h-select-list>
              <template x-for="opt in (options['${property.name}'] || [])" :key="opt.value">
                <div x-h-select-option="opt.text" :data-value="String(opt.value)"></div>
              </template>
            </div>
          </div>
        </div>
#elseif($property.widgetType == "NUMBER")
        <div x-h-input-number><input type="number" step="any" x-model.number="form.${property.name}"#emptyPlaceholder($property) :aria-invalid="fieldError === '${property.name}'"${fixedRo} /></div>
#elseif($property.widgetType == "CHECKBOX")
        <!-- The checkbox goes beside its label, inside a plain box: x-h-field stretches every
             direct child to full width, which turns the checkbox's own square into a full-width
             bordered rectangle - indistinguishable from an empty text input (#7103). The wrapper
             absorbs the stretch, and the layout is then the power form's. -->
        <div class="hbox items-center gap-3">
          <span x-h-checkbox><input type="checkbox" id="f_${property.name}" x-model="form.${property.name}" :aria-invalid="fieldError === '${property.name}'"${fixedDis} /></span>
## No required marker on a checkbox (#8563): unticked is a valid answer (false), so a NOT NULL boolean is always satisfied.
          <label x-h-label for="f_${property.name}"><span x-text="T('$projectName:${tprefix}.t.${property.dataName}', '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end')"></span></label>
        </div>
#elseif($property.widgetType == "DATE")
        <div x-h-date-picker>
          <input type="text" :placeholder="HarmoniaFormat.dateHint()" :aria-invalid="fieldError === '${property.name}'"${fixedDis} />
          <button x-h-date-picker-trigger aria-label="Choose date"></button>
          <div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="form.${property.name}"></div>
        </div>
#elseif($property.widgetType == "DATETIME-LOCAL")
        <div x-h-datetime-picker>
          <input type="text" :aria-invalid="fieldError === '${property.name}'"${fixedDis} />
          <button x-h-datetime-picker-trigger aria-label="Choose date and time"></button>
          <div x-h-datetime-picker-popup="HarmoniaFormat.pickerConfig('dateTime')" x-model="form.${property.name}"></div>
        </div>
#elseif($property.widgetType == "TIME")
        <div x-h-time-picker>
          <input type="text" x-h-time-picker-input x-model="form.${property.name}" :aria-invalid="fieldError === '${property.name}'"${fixedDis} />
          <div x-h-time-picker-popup></div>
        </div>
#elseif($property.widgetType == "MONTH")
        <!-- Harmonia month picker: model is a YYYY-MM string, so form.${property.name} round-trips unchanged. -->
        <div x-h-month-picker>
          <input type="text" :aria-invalid="fieldError === '${property.name}'"${fixedDis} />
          <button x-h-month-picker-trigger aria-label="Choose month"></button>
          <div x-h-month-picker-popup x-model="form.${property.name}"></div>
        </div>
#elseif($property.widgetType == "WEEK")
        <!-- Harmonia week picker: model is a YYYY-Www ISO-week string, so form.${property.name} round-trips unchanged. -->
        <div x-h-week-picker>
          <input type="text" :aria-invalid="fieldError === '${property.name}'"${fixedDis} />
          <button x-h-week-picker-trigger aria-label="Choose week"></button>
          <div x-h-week-picker-popup x-model="form.${property.name}"></div>
        </div>
#else
        <input x-h-input type="text" x-model="form.${property.name}"#emptyPlaceholder($property)#maxLength($property) :aria-invalid="fieldError === '${property.name}'"${fixedRo}#if($property.widgetPattern) pattern="${property.widgetPattern}"#if($property.patternMessageTkey) :title="T('${property.patternMessageTkey}', '${property.widgetPatternMessageJs}')"#end#end#if($property.normalizeJs) @blur="form.${property.name} = ${property.normalizeJs}(form.${property.name})"#end />
#end
#maxLengthHint($property)
          </div>
        </template>
      </div>
#end
#end
    </div>

#if($documentItemsLayout == "chat")
    <!-- Conversation thread (chat items) - the personal document renders the SAME chat the power
         document does (x-h-bubble messages + an input-group composer through the personal items
         controller), never the generic line-items table. Own vs other alignment keys on the audit
         CreatedBy vs the logged-in user (own = right, primary; other = left, outline); an internal memo
         is a warning bubble with an Internal badge, so it can't be mistaken for a shared reply. -->
    <div class="vbox gap-3" x-show="itemsEnabled">
      <div x-h-separator data-orientation="horizontal"></div>
      <div class="hbox items-center gap-2">
        <h3 x-h-text.h4 x-text="itemsDef ? T(itemsDef.tkey, '${documentItemsLabel}') : '${documentItemsLabel}'"></h3>
      </div>
      <div x-show="itemsError" x-h-alert data-variant="negative" role="alert"><div x-h-alert-description x-text="itemsError"></div></div>
      <!-- The thread is a live region so a new message is announced; it caps its height and scrolls on
           its own (no max-h utility of this size exists). -->
      <div class="vbox gap-2 w-full" style="max-height: 28rem; overflow-y: auto" role="log" aria-live="polite">
        <template x-for="(row, idx) in items" :key="row[itemsDef.primaryKey] != null ? row[itemsDef.primaryKey] : idx">
          <div x-h-bubble style="max-width: 85%"
               :data-align="row.CreatedBy === $store.currentUser.name ? 'right' : 'left'"
               :data-variant="#if($chatInternalProperty)row.${chatInternalProperty} ? 'warning' : (#end(row.CreatedBy === $store.currentUser.name ? 'primary' : 'outline')#if($chatInternalProperty))#end">
            <div x-h-bubble-header>
              <span x-text="row.CreatedBy || T('$projectName:${tprefix}.defaults.system', 'System')"></span>
              <!-- A <time> in the bubble header is de-emphasised by the component on every variant. -->
              <time x-text="window.HarmoniaFormat.value(row.CreatedAt, true)"></time>
#if($chatInternalProperty)
              <!-- outline, not warning: the memo's bubble is already the warning colour. -->
              <span x-show="row.${chatInternalProperty}" x-h-badge data-variant="outline" x-text="T('$projectName:${tprefix}.defaults.internal', 'Internal')"></span>
#end
            </div>
            <div x-h-bubble-content class="whitespace-pre-wrap wrap-anywhere" x-text="row.${chatBodyProperty}"></div>
          </div>
        </template>
        <div x-show="items.length === 0" x-h-text.muted class="p-2" x-text="T('$projectName:${tprefix}.messages.noMessagesYet', 'No messages yet.')"></div>
      </div>
#if(!$documentItemsReadOnly)
      <!-- Composer: Enter sends (the hint says so); the send button also submits. -->
      <!-- Hidden in preview: a message is written while the document is being worked on. -->
      <div x-show="!isPreview">
        <div x-h-input-group>
          <textarea x-h-textarea.group rows="2" x-model="chatDraft" @keydown.enter.prevent="sendMessage(chatDraft)" :disabled="chatSending" :aria-label="T('$projectName:${tprefix}.defaults.writeMessageLabel', 'Write a message')" :placeholder="T('$projectName:${tprefix}.defaults.writeMessage', 'Write a message...')"></textarea>
          <div x-h-input-group-addon data-align="block-end" class="border-t">
#if($chatInternalProperty)
            <label class="hbox items-center gap-2 text-sm">
              <span x-h-switch data-size="sm"><input type="checkbox" x-model="chatInternal" /></span>
              <span x-text="T('$projectName:${tprefix}.defaults.internalNote', 'Internal note (not visible to the requester)')"></span>
            </label>
#end
            <span x-h-input-group-text class="ml-auto hidden text-xs md:flex" x-text="T('$projectName:${tprefix}.defaults.enterToSend', 'Enter to send')"></span>
            <button type="button" x-h-button.addon data-size="icon-sm" data-variant="primary" class="rounded-full" @click="sendMessage(chatDraft)" :disabled="chatSending || !chatDraft.trim()" :aria-label="T('$projectName:${tprefix}.defaults.send', 'Send')">
              <svg x-h-lucide role="presentation" data-lucide="arrow-up"></svg>
            </button>
          </div>
        </div>
      </div>
#end
    </div>
#elseif($documentItemsLayout == "calendar")
    <!-- Line items on a calendar (the items child declares view: calendar): the same rows and the same
         add/edit dialog as the table pane, placed on a timeline. Event-click edits that line,
         empty-day click adds one with that date preset (both suppressed while read-only/immutable). -->
    <div class="vbox gap-3" x-show="itemsEnabled">
      <div x-h-separator data-orientation="horizontal"></div>
      <div class="hbox items-center gap-2">
        <h3 x-h-text.h4 x-text="itemsDef ? T(itemsDef.tkey, '${documentItemsLabel}') : '${documentItemsLabel}'"></h3>
        <div class="flex-1"></div>
#if(!$documentItemsReadOnly)
        <button x-h-button data-variant="outline" data-size="sm" x-show="!isPreview" @click="openItem(null)">
          <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
          <span x-text="T('$projectName:${tprefix}.defaults.add', 'Add')"></span>
        </button>
        <!-- Fill Month: one dialog fill -> a line per working day. Offered only when the line item
             carries an editable plain DATE column (the fill target). -->
        <button x-h-button data-variant="outline" data-size="sm" x-show="!isPreview &amp;&amp; fillDateColumn()" @click="openFillMonth()">
          <svg role="presentation" x-h-lucide data-lucide="calendar-plus"></svg>
          <span x-text="T('$projectName:${tprefix}.defaults.fillMonth', 'Fill Month')"></span>
        </button>
#end
      </div>
      <div x-show="itemsError" x-h-alert data-variant="negative" role="alert"><div x-h-alert-description x-text="itemsError"></div></div>
      <div x-h-calendar="itemsCalCfg" style="height: 420px" @event-click="onItemsEventClick" @date-click="onItemsDateClick"></div>
    </div>
#else
    <!-- Line items (only once the document exists). Add/edit via a dialog; delete inline. -->
    <div class="vbox gap-3" x-show="itemsEnabled">
      <div x-h-separator data-orientation="horizontal"></div>
      <div class="hbox items-center gap-2">
        <h3 x-h-text.h4 x-text="itemsDef ? T(itemsDef.tkey, '${documentItemsLabel}') : '${documentItemsLabel}'"></h3>
        <div class="flex-1"></div>
#if(!$documentItemsReadOnly)
        <button x-h-button data-variant="outline" data-size="sm" x-show="!isPreview" @click="openItem(null)">
          <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
          <span x-text="T('$projectName:${tprefix}.defaults.add', 'Add')"></span>
        </button>
        <!-- Fill Month: one dialog fill -> a line per working day. Offered only when the line item
             carries an editable plain DATE column (the fill target). -->
        <button x-h-button data-variant="outline" data-size="sm" x-show="!isPreview &amp;&amp; fillDateColumn()" @click="openFillMonth()">
          <svg role="presentation" x-h-lucide data-lucide="calendar-plus"></svg>
          <span x-text="T('$projectName:${tprefix}.defaults.fillMonth', 'Fill Month')"></span>
        </button>
#end
      </div>
      <div x-show="itemsError" x-h-alert data-variant="negative" role="alert"><div x-h-alert-description x-text="itemsError"></div></div>
      <div x-h-table-container data-border="true">
        <table x-h-table data-borders="rows">
          <thead x-h-table-header>
            <tr x-h-table-row>
              <template x-for="(col, ci) in tableColumns()" :key="col.name">
                <th x-h-table-head scope="col" :data-sticky="ci === 0 ? 'start' : null" :class="col.number ? 'text-right' : ''" x-text="T(col.tkey, col.label)"></th>
              </template>
#if(!$documentItemsReadOnly)
              <th x-h-table-head scope="col" x-show="!isPreview"></th>
#end
            </tr>
          </thead>
          <tbody x-h-table-body>
            <template x-for="row in items" :key="row[itemsDef.primaryKey]">
              <tr x-h-table-row data-hoverable="true" class="cursor-pointer" @click="itemRowClicked($event, row)">
                <template x-for="(col, ci) in tableColumns()" :key="col.name">
                  <td x-h-table-cell :data-sticky="ci === 0 ? 'start' : null" :class="col.number ? 'text-right' : ''" x-text="displayItem(row, col)"></td>
                </template>
#if(!$documentItemsReadOnly)
                <td x-h-table-cell class="text-right" x-show="!isPreview">
                  <button x-h-button data-variant="transparent" data-size="icon-sm" aria-label="Delete" data-row-control @click="deleteItem(row)"><svg role="presentation" x-h-lucide data-lucide="trash-2"></svg></button>
                </td>
#end
              </tr>
            </template>
            <tr x-h-table-row x-show="items.length === 0">
              <td x-h-table-cell :colspan="tableColumns().length#if(!$documentItemsReadOnly) + (isPreview ? 0 : 1)#end" class="text-center" x-text="T('$projectName:${tprefix}.messages.noLineItemsYet', 'No line items yet.')"></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
#end

    <!-- Totals footer (aggregate fields, read-only). A SENSITIVE aggregate is omitted entirely: the
         personal controller nulls it on the wire, so rendering the row would only show a permanently
         empty value the owner is not meant to see. -->
#set($hasAgg = false)
#foreach($property in $properties)
#if($property.aggregate == "true" && !$property.sensitiveProperty)#set($hasAgg = true)#end
#end
#if($hasAgg)
    <div class="hbox justify-end" x-show="itemsEnabled">
      <div x-h-card class="min-w-3xs">
        <div x-h-card-content class="vbox gap-1">
#foreach($property in $properties)
#if($property.aggregate == "true" && !$property.sensitiveProperty)
          <div class="hbox items-baseline justify-between gap-4"#visibleGate($property)>
            <span class="text-sm text-secondary-foreground" x-text="T('$projectName:${tprefix}.t.${property.dataName}', '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end')"></span>
            <span class="text-sm tabular-nums" x-text="window.HarmoniaFormat ? window.HarmoniaFormat.number(form.${property.name}) : form.${property.name}"></span>
          </div>
#end
#end
        </div>
      </div>
    </div>
#end

#set($docChildren = [])
#if($myChildren)
#foreach($child in $myChildren)
#if($child.name != "$!{documentItemsEntity}")
#set($ignore = $docChildren.add($child))
#end
#end
#end
#if($docChildren.size() > 0)

    <!-- Non-item children inheriting the personal scope: an embedded calendar (view: calendar on
         the child) or a table - the SAME panels the my-form renders (e.g. the day-allocation
         calendar on a timesheet document). Only once the document exists. -->
    <template x-if="mode !== 'create'">
      <div class="vbox gap-4">
        <template x-for="child in children" :key="child.name">
          <div class="vbox gap-3" x-show="visibleWhenHolds(child.visibleWhen, form)">
            <div x-h-separator data-orientation="horizontal"></div>
            <div class="hbox items-center gap-2">
              <h3 x-h-text.h4 x-text="T(child.tkey, child.label)"></h3>
              <div class="flex-1"></div>
#if(!$personalReadOnly)
              <!-- A see-only child (its composition edge declares personalReadOnly) refuses the write
                   with 403, so its panel offers no Add; nor does a locked document. -->
              <button x-h-button data-variant="outline" data-size="sm" x-show="!child.readOnly#if($immutableStatusProperty || $immutableAlways || $periodLock) &amp;&amp; mutable#end" @click="addChild(child)">
                <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
                <span x-text="T('$projectName:${tprefix}.defaults.add', 'Add')"></span>
              </button>
#end
            </div>
            <div x-show="child.state === 'loading'"><div x-h-spinner></div></div>
            <template x-if="child.calendar">
              <div x-show="child.state === 'default'" style="min-height: 420px">
                <div x-h-calendar="child.calCfg" style="height: 420px"
                     @event-click="onChildEventClick(child, $event)" @date-click="onChildDateClick(child, $event)"></div>
              </div>
            </template>
            <template x-if="!child.calendar">
              <div x-show="child.state === 'default'" x-h-table-container data-border="true">
                <table x-h-table data-borders="rows">
                  <thead x-h-table-header>
                    <tr x-h-table-row>
                      <template x-for="(col, ci) in child.columns" :key="col.name">
                        <th x-h-table-head scope="col" :data-sticky="ci === 0 ? 'start' : null" :class="col.number ? 'text-right' : ''" x-text="T(col.tkey, col.label)"></th>
                      </template>
                    </tr>
                  </thead>
                  <tbody x-h-table-body>
                    <template x-for="row in child.rows" :key="row.Id">
                      <tr x-h-table-row data-hoverable="true" class="cursor-pointer" @click="openChild(child, row.Id)">
                        <template x-for="(col, ci) in child.columns" :key="col.name">
                          <td x-h-table-cell :data-sticky="ci === 0 ? 'start' : null" :class="col.number ? 'text-right' : ''" x-text="displayChild(child, row, col)"></td>
                        </template>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </div>
            </template>
          </div>
        </template>
      </div>
    </template>
#end
  </div>

  <!-- Line-item dialog (add/edit). Fields come from the reused detail-register column metadata. -->
  <div x-h-dialog-overlay :data-open="itemDialog">
    <div x-h-dialog style="width: 92vw; max-width: 640px;">
      <div x-h-dialog-header>
        <h2 x-h-dialog-title x-text="(itemMode === 'fill' ? T('$projectName:${tprefix}.defaults.fillMonth', 'Fill Month') + ' - ' : '') + (itemsDef ? T(itemsDef.tkey, '${documentItemsLabel}') : '${documentItemsLabel}')"></h2>
        <button type="button" x-h-dialog-close @click="itemDialog = false" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content>
        <div x-show="itemError" x-h-alert data-variant="negative" role="alert"><div x-h-alert-description x-text="itemError"></div></div>
        <p x-h-text.muted x-show="itemMode === 'fill'" x-text="T('$projectName:${tprefix}.messages.fillMonthHint', 'One line is created for every working day (Mon-Fri) of the picked month; days that already have a line are skipped.')"></p>
        <div class="grid grid-cols-2 gap-4">
          <template x-for="col in itemColumns()" :key="col.name">
            <!-- A rejected save names ONE column (itemFieldError): its control carries aria-invalid,
                 which is what Harmonia colours the label and the border from - the same marking the
                 header form's fields use. -->
            <div x-h-field :class="col.kind === 'text' ? 'col-span-2' : ''" :data-invalid="itemFieldError === col.name">
              <!-- A required line column carries the same marker as the header form (never a checkbox,
                   #8563: unticked is a valid false): the dialog is
                   where the value is entered, so hiding which ones are mandatory only defers the
                   rejection to the server. -->
              <label x-h-label><span x-text="T(col.tkey, col.label)"></span><span x-show="col.required &amp;&amp; !col.readonly &amp;&amp; col.widget !== 'CHECKBOX'" class="text-negative"> *</span></label>
              <template x-if="!col.readonly && col.lookup">
                <!-- An optional column's picker is cleared by re-clicking its selected option (#8658). -->
                <div x-h-select :data-clearable="col.required ? null : 'true'">
                  <input x-h-select-input x-model="draft[col.name]" :aria-invalid="itemFieldError === col.name" :placeholder="T('$projectName:${tprefix}.messages.inputSelect', 'Select {{name}}...', { name: T(col.tkey, col.label) })" />
                  <div x-h-select-content>
                    <div x-h-select-search data-filter="contains"></div>
                    <div x-h-select-list>
                      <template x-for="opt in visibleOptions(itemOptions[col.name], draft[col.name])" :key="opt.value">
                        <div x-h-select-option="opt.text" :data-value="String(opt.value)" :aria-disabled="opt.disabled ? 'true' : null" :data-description="opt.description || null"></div>
                      </template>
                    </div>
                  </div>
                </div>
              </template>
              <template x-if="!col.readonly && !col.lookup && col.number">
                <div x-h-input-number><input type="number" step="any" x-model.number="draft[col.name]" :aria-invalid="itemFieldError === col.name" /></div>
              </template>
              <template x-if="!col.readonly && !col.lookup && col.widget === 'CHECKBOX'">
                <div class="hbox items-center"><span x-h-checkbox><input type="checkbox" x-model="draft[col.name]" :aria-invalid="itemFieldError === col.name" /></span></div>
              </template>
              <template x-if="!col.readonly && !col.lookup && col.date && !(itemMode === 'fill' && col.name === fillDateName())">
                <div x-h-date-picker><input type="text" :placeholder="HarmoniaFormat.dateHint()" :aria-invalid="itemFieldError === col.name" /><button x-h-date-picker-trigger aria-label="Choose date"></button><div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="draft[col.name]"></div></div>
              </template>
              <!-- Fill Month: the fill-target date column picks the MONTH - every working day gets a line. -->
              <template x-if="!col.readonly && !col.lookup && col.date && itemMode === 'fill' && col.name === fillDateName()">
                <div x-h-month-picker><input type="text" :aria-invalid="itemFieldError === col.name" /><button x-h-month-picker-trigger aria-label="Choose month"></button><div x-h-month-picker-popup x-model="draft[col.name]"></div></div>
              </template>
              <template x-if="!col.readonly && !col.lookup && !col.date && !col.number && col.widget !== 'CHECKBOX'">
                <input x-h-input type="text" x-model="draft[col.name]" :maxlength="col.maxLength" :pattern="col.pattern" :title="col.patternTkey ? T(col.patternTkey, col.patternMessage) : null" @blur="if (col.normalize) draft[col.name] = col.normalize(draft[col.name])" :aria-invalid="itemFieldError === col.name" />
              </template>
              <p x-h-field-description x-show="col.maxLength && String(draft[col.name] ?? '').length >= col.maxLength" x-text="T('$projectName:${tprefix}.messages.maxLengthReached', 'Maximum {{count}} characters', { count: col.maxLength })"></p>
              <!-- A read-only column (calculated / intent readOnly) is a VALUE, not a control: the
                   server recomputes it on save, so rendering an input only faked editability. -->
              <template x-if="col.readonly">
                <div class="text-sm py-2 text-secondary-foreground" x-text="displayItem(draft, col)"></div>
              </template>
            </div>
          </template>
        </div>
      </div>
      <div x-h-dialog-footer>
#if($documentItemsLayout == "calendar")
#if(!$documentItemsReadOnly)
        <!-- The calendar pane has no per-row button, so Delete lives here (edit mode only). The margin
             is an inline style, not a utility class: the shipped Harmonia CSS only carries the classes
             its own source scanned. -->
        <button x-h-button data-variant="negative" style="margin-right: auto" x-show="itemMode === 'edit'" @click="deleteDraftItem()" x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></button>
#end
#end
        <button x-h-button data-variant="transparent" @click="itemDialog = false" x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
#if(!$documentItemsReadOnly)
        <button x-h-button data-variant="primary" @click="saveItem()" x-text="itemMode === 'fill' ? T('$projectName:${tprefix}.defaults.fillMonth', 'Fill Month') : T('$projectName:${tprefix}.defaults.save', 'Save')"></button>
#end
      </div>
    </div>
  </div>

  <!-- Delete confirmation (nested inside the overlay so it hides when closed). -->
  <div x-h-dialog-overlay :data-open="deleteOpen">
    <div x-h-dialog>
      <div x-h-dialog-header>
        <span x-h-dialog-title x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete') + '?'"></span>
        <button type="button" x-h-dialog-close @click="deleteOpen = false" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content><p x-h-text.muted x-text="T('$projectName:${tprefix}.messages.deleteConfirm', 'Are you sure you want to delete {{name}}? This action cannot be undone.', { name: T('$projectName:${tprefix}.t.${dataName}', '${documentLabel}') })"></p></div>
      <div x-h-dialog-footer>
        <button x-h-button data-variant="transparent" @click="deleteOpen = false" :disabled="deleteBusy" x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
        <button x-h-button data-variant="negative" @click="confirmDelete()" :disabled="deleteBusy">
          <span x-show="deleteBusy" x-h-spinner></span>
          <span x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></span>
        </button>
      </div>
    </div>
  </div>
  <!-- Unsaved-changes guard (issue #7359): the one dialog every exit from a dirty form goes
       through - Back to list, Cancel/Discard, a sidebar entry, the browser Back button, and the
       actions that would otherwise save something behind an unsaved header (a line item, a line
       delete). "Save and continue" is the same first button when the user is staying on the page. -->
  <div x-h-dialog-overlay :data-open="leaveOpen">
    <div x-h-dialog>
      <div x-h-dialog-header>
        <h2 x-h-dialog-title x-text="T('$projectName:${tprefix}.messages.unsavedChanges', 'Unsaved changes')"></h2>
        <button x-h-dialog-close @click="leaveKeepEditing()" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content>
        <p x-text="T('$projectName:${tprefix}.messages.unsavedChangesConfirm', 'This form has changes that have not been saved yet.')"></p>
      </div>
      <div x-h-dialog-footer>
        <button type="button" x-h-button data-variant="outline" @click="leaveKeepEditing()" :disabled="leaveBusy" x-text="T('$projectName:${tprefix}.defaults.keepEditing', 'Keep editing')"></button>
        <button type="button" x-h-button data-variant="negative" @click="leaveDiscard()" :disabled="leaveBusy" x-text="T('$projectName:${tprefix}.defaults.discard', 'Discard')"></button>
        <button type="button" x-h-button data-variant="primary" @click="leaveSave()" :disabled="leaveBusy">
          <span x-show="leaveBusy" x-h-spinner></span>
          <span x-text="leaveIntent === 'continue' ? T('$projectName:${tprefix}.defaults.saveAndContinue', 'Save and continue') : T('$projectName:${tprefix}.defaults.saveAndLeave', 'Save and leave')"></span>
        </button>
      </div>
    </div>
  </div>

</div>
