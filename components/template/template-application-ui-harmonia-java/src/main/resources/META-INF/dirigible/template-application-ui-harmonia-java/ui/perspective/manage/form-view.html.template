<!--
  Generated by Eclipse Dirigible based on model and template.
  Create/Edit/Preview form fragment for ${name}. Rendered into #app on /${name}/create,
  /${name}/{id}/edit and /${name}/{id}/preview; its root x-data binds the generated ${name}FormPage.
  Preview shows the same data as edit with every control disabled (fieldset) and the footer swapped
  to Close + Edit. On edit/preview the entity's registered detail collections (masters) render as
  panels below the form - the same panels as the master browse view.
-->
## Role-scoped field (intent `visibleTo:`): the input is rendered only for a caller the server serves
## the value to - the page asked the controller which fields it withholds (canSee). Emits nothing for
## an unrestricted property. The server ignoring the field on writes stays the authoritative half;
## this only keeps an input that could never be saved off the form.
## Status-gated field (intent `visibleWhen:`, #7502): absent until the condition holds against the
## record the page shows (visibleWhenJs, rendered by ModelParameterProcessor). An element holds one
## x-show, so a field carrying both gates gets them ANDed in it. UI-only - the value is still served.
#macro(visibleGate $property)#if($property.roleRead && $property.visibleWhenJs) x-show="canSee('${property.name}') && ${property.visibleWhenJs}"#elseif($property.roleRead) x-show="canSee('${property.name}')"#elseif($property.visibleWhenJs) x-show="${property.visibleWhenJs}"#end#end
## A field shown as a value, not a control (the Details card): the row is shown only when the
## shared basePage.fieldDisplay text is non-empty and the caller may see the field (issue #7522).
## The value itself is printed by the record page's own fieldText helpers (issue #7491).
#macro(valueOptions $property)#if($property.widgetType == "CHECKBOX")[{ value: true, text: T('$projectName:${tprefix}.defaults.yes', 'Yes') }, { value: false, text: T('$projectName:${tprefix}.defaults.no', 'No') }]#elseif(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT") && $property.aggregate != "true")options${property.name}#{else}null#end#end
#macro(valueDisplay $property)fieldDisplay(form.${property.name}, '$!{property.widgetType}', '#if($property.isFloatType)$!{property.formatPattern}#end', #valueOptions($property))#end
#macro(valueGate $property)x-show="#if($property.roleRead)canSee('${property.name}') && #end#if($property.visibleWhenJs)${property.visibleWhenJs} && #end#valueDisplay($property) !== ''"#end
## The EntityStatus relation (widget DOCUMENT_STATUS) renders as a read-only coloured badge in the
## title bar (same treatment as the document layout), never as an editable input.
#set($statusProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_STATUS")#set($statusProp = $property.name)#end
#end
<div x-data="${name}FormPage" class="vbox w-full">

  <!-- Record header + action bar (issue #7491). Two lines on the left - the entity name with its
       status, and one line of the record's own identity - and the action cluster on the right.
       Sticky since #7434: the page root grows with its content, so the bar has to pin itself and
       paint the card's own background or the form scrolls through it. Hidden ONLY inside the FK
       "Add" iframe dialog (?dialog=1), which supplies its own chrome and carries Cancel/Save in the
       slim footer below; the shell-hosted app passes ?embedded but is NOT a dialog, so the header
       must still show there - gate on isDialog, not isEmbedded.
       Ctrl/Cmd+S saves; Escape leaves a preview, the same as Close. -->
  <div x-show="!isDialog" class="sticky top-0 z-10 border-b border-border bg-background px-4 py-3"
       @keydown.window.ctrl.s.prevent="saveShortcut()" @keydown.window.meta.s.prevent="saveShortcut()"
       @keydown.escape.window="escapeDismiss()">
    <div class="hbox items-start justify-between gap-4">

      <div class="vbox min-w-0 gap-1">
        <div class="hbox flex-wrap items-center gap-2">
          <h1 x-h-text.h3 class="truncate" x-text="headerTitle()"></h1>
#if($statusProp != "")
          <!-- EntityStatus badge beside the title; shown once the record's status resolves
               (edit/preview - a new record has no status until the DB default applies). -->
          <span x-h-badge class="shrink-0" :data-variant="statusVariant(statusText())" x-show="(isEdit || isPreview) &amp;&amp; statusText()" x-text="statusText()"></span>
#end
#if($immutableStatusProperty || $immutableAlways || $periodLock)
          <!-- Immutability pre-check: the record refuses user edits/deletes in its current status,
               so the page renders read-only and says so (the controller's 409 stays authoritative). -->
          <span x-h-badge class="shrink-0" data-variant="warning" x-show="!mutable" :title="T('$projectName:${tprefix}.messages.immutable', '#if($periodLock && !$immutableStatusProperty && !$immutableAlways)This record is read-only - its accounting period is closed; book the correction in an open period.#{else}This record is read-only in its current status - corrections go through the workflow.#end')" x-text="T('$projectName:${tprefix}.defaults.readOnly', 'Read-only')"></span>
#end
        </div>
        <!-- Preview says WHICH record this is, from the properties the model marks as major; the
             editable modes say what the asterisks mean instead. -->
        <span x-h-text.muted class="truncate text-sm" x-show="isPreview &amp;&amp; summaryLine()" x-text="summaryLine()"></span>
        <span x-h-text.muted class="text-sm" x-show="!isPreview" x-text="T('$projectName:${tprefix}.messages.requiredLegend', 'Fields marked * are required')"></span>
      </div>

      <!-- At most one filled button, chosen by the component (primaryAction), never by competing
           x-shows here. Order: status text, dismiss, overflow, secondary, primary. -->
      <!-- On a phone this same cluster - not a second copy of it - pins to the bottom of the
           screen, where a thumb reaches. The content above gets matching bottom padding so the last
           section is not hidden behind it. The overflow menu needs no bottom-sheet variant: its
           popover flips upward on its own when there is no room below. -->
      <div role="toolbar" :aria-label="T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}')"
           class="hbox items-center gap-2"
           :class="isNarrow ? 'fixed bottom-0 left-0 right-0 z-20 w-full justify-end border-t bg-background px-4 py-3' : 'shrink-0'">

#if($hasPrint == "true")
        <span class="text-sm text-secondary-foreground" x-show="printError" x-text="printError"></span>
#end
        <!-- The dirty marker sits with the actions in the editable modes, where it is about the
             Save beside it. A dot and a line of text rather than a filled pill: a badge reads as a
             status the record HAS, and this is a note about the form in front of you. -->
        <!-- A div, not a span: the label lives in exactly one span, so a page carries one element
             whose text is "Unsaved changes" and a test can address it. -->
        <div class="hbox shrink-0 items-center gap-2 text-sm text-warning" x-show="isDirty()">
          <span class="size-2 shrink-0 rounded-full bg-warning"></span>
          <span x-text="T('$projectName:${tprefix}.messages.unsavedChanges', 'Unsaved changes')"></span>
        </div>

        <!-- Dismiss. Preview keeps Close; the editable modes say what leaving will cost. -->
        <button type="button" x-h-button data-variant="transparent" class="shrink-0" x-show="isPreview" @click="cancel()" x-text="T('$projectName:${tprefix}.defaults.close', 'Close')"></button>
        <button type="button" x-h-button data-variant="transparent" class="shrink-0" x-show="!isPreview" @click="cancel()" :disabled="state === 'saving'" x-text="isDirty() ? T('$projectName:${tprefix}.defaults.discard', 'Discard') : T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>

        <!-- Overflow: everything discretionary, grouped, with the destructive group last. Tasks and
             record actions are hidden while editing - the only thing to do then is finish. -->
        <button type="button" x-h-button data-variant="outline" data-size="icon" class="shrink-0" x-h-menu-trigger.dropdown :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')" x-show="isPreview &amp;&amp; hasOverflowMenu">
          <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
        </button>
        <ul x-h-menu data-align="bottom-end">
          <!-- Edit folds in here on a narrow viewport; the primary never folds. -->
          <template x-if="editInMenu">
            <li x-h-menu-item @click="goEdit()">
              <svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span>
            </li>
          </template>
#if($hasPrint == "true")
          <li x-h-menu-item :aria-disabled="printBusy" @click="openPrint()">
            <svg role="presentation" x-h-lucide data-lucide="printer"></svg><span x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></span>
          </li>
          <template x-if="menuHasCalendars || menuHasDelete">
            <li x-h-menu-separator></li>
          </template>
#end
#if($scopedCalendars)
## Scoped calendars (intent `calendar.scope`): an entity whose calendar filters its events to THIS
## record. The filter is a query parameter on the calendar's own route, so without an entry here the
## URL is knowledge the user has to type. Leaving the form is guarded like any other exit.
#foreach($scopedCalendar in $scopedCalendars)
          <li x-h-menu-item @click="guardExit(() => openScopedCalendar('${scopedCalendar.entity}', '${scopedCalendar.scopeProperty}', id))">
            <svg role="presentation" x-h-lucide data-lucide="calendar-days"></svg><span x-text="T('$projectName:${tprefix}.t.${scopedCalendar.dataName}_plural', '${scopedCalendar.label}')"></span>
          </li>
#end
#end
          <!-- Destructive, alone in the last group - which needs no rule above it when it is the
               only group there is. -->
          <template x-if="menuHasAboveDelete &amp;&amp; menuHasDelete">
            <li x-h-menu-separator></li>
          </template>
          <template x-if="menuHasDelete">
            <li x-h-menu-item data-variant="negative" @click="askDelete()">
              <svg role="presentation" x-h-lucide data-lucide="trash-2"></svg><span x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></span>
            </li>
          </template>
        </ul>

        <!-- Secondary: Edit steps down to outlined when a task holds the filled slot. -->
        <button type="button" x-h-button data-variant="outline" class="shrink-0" x-show="isPreview &amp;&amp; showsSecondaryEdit" @click="goEdit()">
          <svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span>
        </button>

#if($hasProcess)
        <!-- Primary, case 1: the workflow task. One task is a plain button; several make it a split
             button whose main part runs the oldest and whose arrow lists them all.
             x-show, never x-if: an x-if here produced a NEW copy of its content on every
             re-evaluation without removing the old one, so the bar grew another Review button on
             every processTasks poll (measured: three button-groups in the toolbar after ~15s, ten in
             the reported screenshot). x-show only toggles display, so the element is created once and
             Harmonia initialises it once. The two cases are separate elements rather than one group
             with a conditional arrow, because a lone child of x-h-button-group still gets the group's
             squared-off edges. -->
        <button type="button" x-h-button data-variant="primary" class="shrink-0"
                x-show="isPreview &amp;&amp; primaryAction === 'task' &amp;&amp; recordTasks.length === 1" @click="openPrimaryTask()">
          <svg role="presentation" x-h-lucide data-lucide="square-check-big"></svg><span x-text="taskButtonLabel()"></span>
        </button>
        <div x-h-button-group class="shrink-0" x-show="isPreview &amp;&amp; primaryAction === 'task' &amp;&amp; recordTasks.length > 1">
          <button type="button" x-h-button data-variant="primary" @click="openPrimaryTask()">
            <svg role="presentation" x-h-lucide data-lucide="square-check-big"></svg>
            <span x-text="taskButtonLabel()"></span>
            <span x-h-badge data-variant="outline" x-text="recordTasks.length"></span>
          </button>
          <button type="button" x-h-button data-variant="primary" data-size="icon" x-h-menu-trigger.dropdown :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')">
            <svg role="presentation" x-h-lucide data-lucide="chevron-down"></svg>
          </button>
          <ul x-h-menu data-align="bottom-end">
            <template x-for="task in recordTasks" :key="task.id">
              <li x-h-menu-item @click="Alpine.store('processTasks').openTask(task)" x-text="Alpine.store('processTasks').taskName(task)"></li>
            </template>
          </ul>
        </div>
#end
        <!-- Primary, case 2: Edit, when nothing else claims the slot. A record the user cannot
             change leaves the slot empty rather than offering a button that would 403. -->
        <button type="button" x-h-button data-variant="primary" class="shrink-0" x-show="isPreview &amp;&amp; primaryAction === 'edit'" @click="goEdit()">
          <svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span>
        </button>

        <!-- Primary, editable modes: Save. Nothing to save on an unchanged record; a create is
             always offerable. -->
        <button type="button" x-h-button data-variant="primary" class="shrink-0" x-show="!isPreview" :disabled="state === 'saving' || (isEdit &amp;&amp; !isDirty())" @click="save()">
          <span x-show="state === 'saving'" x-h-spinner></span>
          <svg x-h-lucide role="presentation" data-lucide="save" x-show="state !== 'saving'"></svg><span x-text="isEdit ? T('$projectName:${tprefix}.defaults.update', 'Save') : T('$projectName:${tprefix}.defaults.create', 'Create')"></span>
        </button>
      </div>
    </div>
  </div>
#if($hasProcess)
  <!-- Task strip (issue #7434, reworked by #7491): a "your step" band under the header while this
       record has an actionable BPM user task. It is INFORMATION ONLY - the task itself is the
       primary button in the action bar above, so a strip with its own button would be a second way
       to do the same thing. In the editable modes it goes neutral and says why: the task is waiting
       on the form being finished. A record with no pending step renders no strip. -->
  <template x-if="recordTasks.length">
    <div class="hbox w-full items-center gap-2 border-t px-4 py-2 text-sm" x-show="(isEdit || isPreview) &amp;&amp; !isDialog"
         :style="isPreview ? 'background: color-mix(in srgb, var(--primary) 8%, transparent)' : 'background: var(--muted)'">
      <svg role="presentation" x-h-lucide data-lucide="flag" class="size-4 shrink-0" :class="isPreview ? 'text-primary' : 'text-muted-foreground'"></svg>
      <div>
        <span class="font-semibold text-foreground" x-text="taskButtonLabel()"></span>
        <span class="text-muted-foreground" x-show="isPreview" x-text="' ' + T('$projectName:${tprefix}.messages.workflowWaiting', 'is waiting for you') + taskAssignedLine()"></span>
        <span class="text-muted-foreground" x-show="!isPreview" x-text="' — ' + T('$projectName:${tprefix}.messages.workflowEditing', 'save or cancel your changes to continue')"></span>
      </div>
    </div>
  </template>
#end

  <!-- Load failure (edit) -->
  <div x-show="state === 'load-failure'" x-h-info-page class="p-4">
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon>
        <svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg>
      </div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.error.loading', 'Could not load')"></div>
      <div x-h-info-page-description x-text="loadFailureMessage"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="outline" @click="cancel()" x-text="T('$projectName:${tprefix}.defaults.back', 'Back')"></button>
    </div>
  </div>

  <!-- Loading (edit) -->
  <div x-show="state === 'loading'" class="p-4"><div x-h-spinner></div></div>

  <!-- Form area: the main column holds the field form, the detail collections and the action footer
       (in that order, so the Save/Cancel bar is the LAST thing on the page - below the panels, like
       the document view); the read-only/audit sidebar is the second column of this hbox. -->
  <div x-show="state !== 'loading' && state !== 'load-failure'"
        class="vbox lg:hbox w-full items-start gap-6 px-4 py-6"
        :style="isNarrow ? 'padding-bottom: 5rem' : ''">
    <!-- Main content column -->
    <div class="vbox gap-4 flex-1 min-w-0">

    <!-- The record's groups, separated by headings and rules and nothing else (issue #7491). The
         page's own white card is the only frame: the fields used to sit bare on the background while
         every collection around them carried its own, so an entity with two details read as a stack
         of boxes. Each group - the fields first, then every detail and related register - is a
         heading and a rule above it. Nothing nests. -->
    <div class="vbox gap-4 w-full">
      <h3 x-h-text.h4 x-text="T('$projectName:${tprefix}.defaults.general', 'General')"></h3>

    <!-- The header form holds the editable fields only. The Save button lives in the footer below
         (outside this form, beneath the detail panels) so the footer can sit at the very bottom; it
         calls save() directly, while @submit.prevent keeps Enter-to-save working inside a field. -->
    <form @submit.prevent="save()" class="vbox gap-4 w-full">
    <!-- Error summary banner: save failure or unmatched 422 causes -->
    <div x-show="saveFailureMessage || errors.__summary" x-h-alert data-variant="negative" role="alert">
      <svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg>
      <div x-h-alert-title x-text="T('$projectName:${tprefix}.messages.error.saving', 'Could not save')"></div>
      <div x-h-alert-description>
        <span x-show="saveFailureMessage" x-text="saveFailureMessage"></span>
        <span x-show="errors.__summary" x-text="errors.__summary"></span>
      </div>
    </div>

    <!-- 12-column responsive field grid (single column on narrow viewports). Each field's width
         comes from the model's widgetSize (number of columns out of 12: Small=3, Medium=4, Large=6,
         XLarge=12); consecutive narrow fields (e.g. two dates) therefore share a row. Wide widgets
         (textarea/checkbox) always span the full width. Mirrors codbex-athena-app's create forms.
         The fieldset (display: contents keeps the grid layout intact) disables EVERY control at once
         in preview mode - the one switch that guarantees the whole form is read-only. -->
    <fieldset :disabled="isPreview" style="display: contents;">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
#foreach($property in $properties)
## Read-only / system fields (ProcessId, audit columns, uuid, any field marked read-only) are not
## editable inputs here - they render in the read-only details block below, above the buttons. They
## still stay in the form model so they round-trip on edit. Calculated fields remain inline (read-only).
## The EntityStatus FK (DOCUMENT_STATUS) is excluded too - it renders as the title-bar badge above.
## A relation whose value the NAVIGATION CONTEXT already implies (the composition parent, when the
## form was opened from that master's panel) is NOT excluded - it renders as a locked label, see the
## DROPDOWN branch below: showing which parent the record is being filed under is the point, while a
## free dropdown there would let the record be re-pointed mid-flow. A composition parent that is not
## a lookup (an .edm authored with a TEXTBOX on the master FK) has no label to show and only a raw id
## to offer, so it stays out of the grid entirely.
#if(!$property.dataAutoIncrement && $property.isReadOnlyProperty != "true" && $property.widgetType != "DOCUMENT_STATUS" && !($property.relationshipType == "COMPOSITION" && $property.widgetType != "DROPDOWN") && !($property.auditType && $property.auditType != "NONE"))
## Read-only only when DERIVED - an expression, or an update-time recompute. A field whose only
## calculated aspect is calculatedActionOnCreate is a server-side DEFAULT (Due, Currency, a tax
## event date): pre-filled, but the user's pick is respected - it must stay editable (#6696).
#set($readonly = ($property.isCalculatedProperty == "true" && ($property.calculatedPropertyExpressionCreate || $property.calculatedPropertyExpressionUpdate || $property.calculatedActionOnUpdate)))
## A non-setting association dropdown gets an inline "Add new / Refresh" control and spans the full row.
#set($lookup = ($property.widgetType == "DROPDOWN" && $property.relationshipEntityName && $property.relationshipEntityPerspectiveName != "Settings" && !$readonly))
#if($property.widgetLabel)#set($label = $property.widgetLabelJs)#else#set($label = $property.name)#end
#if($property.widgetSize)#set($span = $property.widgetSize)#else#set($span = "6")#end
#if($property.widgetType == "TEXTAREA" || $property.widgetType == "CHECKBOX" || $property.widgetType == "MULTISELECT")#set($span = "12")#end
#if($lookup)#set($span = "12")#end
      <!-- ${property.name} (${property.widgetType}) -->
      <div x-h-field#if($span == "12") class="md:col-span-12"#else class="md:col-span-${span}"#end#visibleGate($property) :data-invalid="!!errors.${property.name}">
        <!-- Preview shows the VALUE, not a disabled input (issue #7491): a greyed-out control reads
             as "you may not change this", where the record is simply being read. The label goes
             muted above it and an empty value reads as an em dash rather than an empty box. -->
        <template x-if="isPreview">
          <div class="vbox gap-1">
            <span x-h-text.muted class="text-xs" x-text="T('$projectName:${tprefix}.t.${property.dataName}', '${label}')"></span>
            <div class="text-sm wrap-anywhere" x-text="#if($property.widgetType == "DROPDOWN")fieldText(form.${property.name}, false, false, options${property.name})#elseif($property.widgetType == "MULTISELECT")multiText(form.${property.name}, options${property.name})#elseif($property.widgetType == "CHECKBOX")checkboxText(form.${property.name})#elseif($property.isDateType)fieldText(form.${property.name}, true, false, null)#elseif($property.isNumberType)fieldText(form.${property.name}, false, true, null)#{else}fieldText(form.${property.name}, false, false, null)#end"></div>
          </div>
        </template>
        <template x-if="!isPreview">
          <div class="vbox gap-2">
#if($property.widgetType == "CHECKBOX")
        <div class="hbox items-center gap-3">
          <span x-h-checkbox>
            <input type="checkbox" id="f_${property.name}" x-model="form.${property.name}"#if($readonly) disabled#end />
          </span>
          <label x-h-label for="f_${property.name}"><span x-text="T('$projectName:${tprefix}.t.${property.dataName}', '${label}')"></span>#if($property.isRequiredProperty == "true") <span class="text-negative">*</span>#end</label>
        </div>
#else
        <label x-h-label for="f_${property.name}"><span x-text="T('$projectName:${tprefix}.t.${property.dataName}', '${label}')"></span>#if($property.isRequiredProperty == "true") <span class="text-negative">*</span>#end</label>
#if($property.widgetType == "DROPDOWN")
        <!-- Context-locked: the URL that opened this form already names ${property.name} (a master's
             detail panel presets its FK, a create-from flow presets its source), so the value is
             implied by where the user is standing, not a choice. It renders as the referenced
             record's label, read-only - a dropdown here would let the record be re-pointed
             mid-flow. x-if, not a disabled select: showing the referenced record's label beats a
             greyed-out combobox. The value stays in the form model and is
             saved exactly as before. With no such param (the entity's own top-level create) the
             normal combobox renders.
             Combobox per the Harmonia select contract (the Harmonia skill is the source of truth):
             x-model on the
             x-h-select-input holds the VALUE (the option data-value), a string; the input shows the
             matched option's label. data-filter enables type-to-search; x-h-select-search adds the
             in-dropdown search box for longer option lists. A non-setting association ($lookup) is laid
             out on one row with an "Add new" button (opens the target's own create page in an iframe
             dialog) and a Refresh button. -->
        <template x-if="isContextLocked('${property.name}')">
          <input x-h-input type="text" id="f_${property.name}" readonly :value="contextLabel(form.${property.name}, options${property.name})" />
        </template>
        <template x-if="!isContextLocked('${property.name}')">
#if($lookup)
        <div class="hbox gap-1 items-center">
          <div x-h-select class="flex-1">
            <input x-h-select-input id="f_${property.name}" x-model="form.${property.name}" :aria-invalid="!!errors.${property.name}" :disabled="isPreview" :placeholder="T('$projectName:${tprefix}.messages.inputSelect', 'Select ${label}...', { name: T('$projectName:${tprefix}.t.${property.dataName}', '${label}') })" />
            <div x-h-select-content>
              <div x-h-select-search data-filter="contains"></div>
              <div x-h-select-list>
                <template x-for="opt in #if($property.widgetPickable)visibleOptions(options${property.name}, form.${property.name})#{else}options${property.name}#end" :key="opt.value">
                  <div x-h-select-option="opt.text" :data-value="String(opt.value)"#if($property.widgetPickable) :aria-disabled="opt.disabled ? 'true' : null" :data-description="opt.description || null"#end></div>
                </template>
              </div>
            </div>
          </div>
          <button type="button" x-h-button data-variant="outline" class="shrink-0" x-show="!isPreview" @click="addRelated('${property.name}', '${property.widgetDropdownAppUrl}', '${property.relationshipEntityName}')"><svg role="presentation" x-h-lucide data-lucide="plus" class="size-4"></svg> <span x-text="T('$projectName:${tprefix}.defaults.new', 'New')"></span>&nbsp;<span x-text="T('$projectName:${tprefix}.t.${property.relationshipEntityName}', '${property.relationshipEntityName}')"></span></button>
          <button type="button" x-h-button data-variant="transparent" class="shrink-0" x-show="!isPreview" aria-label="Refresh" @click="loadOptions()"><svg role="presentation" x-h-lucide data-lucide="refresh-cw" class="size-4"></svg></button>
        </div>
#else
        <div x-h-select>
          <input x-h-select-input id="f_${property.name}" x-model="form.${property.name}"
                 :aria-invalid="!!errors.${property.name}"#if($readonly) disabled#else :disabled="isPreview"#end
                 :placeholder="T('$projectName:${tprefix}.messages.inputSelect', 'Select ${label}...', { name: T('$projectName:${tprefix}.t.${property.dataName}', '${label}') })" />
          <div x-h-select-content>
            <div x-h-select-search data-filter="contains"></div>
            <div x-h-select-list>
              <template x-for="opt in #if($property.widgetPickable)visibleOptions(options${property.name}, form.${property.name})#{else}options${property.name}#end" :key="opt.value">
                <div x-h-select-option="opt.text" :data-value="String(opt.value)"#if($property.widgetPickable) :aria-disabled="opt.disabled ? 'true' : null" :data-description="opt.description || null"#end></div>
              </template>
            </div>
          </div>
        </div>
#end
        </template>
#elseif($property.widgetType == "MULTISELECT")
        <!-- Subset (intent `kind: subset`): the record holds a SUBSET of the lookup's rows
             as one csv ("1,3"). The same x-h-select contract as a dropdown - Harmonia switches into
             multiple mode because the bound model is an ARRAY (split on load, joined on save), the
             trigger shows the selected labels comma-joined. Refresh reloads the option set; there is
             deliberately no "New" button - the add-dialog return path writes a single value, and a
             lookup this widget targets is curated, not grown mid-form. -->
        <div class="hbox gap-1 items-center">
          <div x-h-select class="flex-1">
            <input x-h-select-input id="f_${property.name}" x-model="form.${property.name}" :aria-invalid="!!errors.${property.name}" :disabled="isPreview" :placeholder="T('$projectName:${tprefix}.messages.inputSelect', 'Select ${label}...', { name: T('$projectName:${tprefix}.t.${property.dataName}', '${label}') })" />
            <div x-h-select-content>
              <div x-h-select-search data-filter="contains"></div>
              <div x-h-select-list>
                <template x-for="opt in options${property.name}" :key="opt.value">
                  <div x-h-select-option="opt.text" :data-value="String(opt.value)"></div>
                </template>
              </div>
            </div>
          </div>
          <button type="button" x-h-button data-variant="transparent" class="shrink-0" data-size="icon" x-show="!isPreview" aria-label="Refresh" @click="loadOptions()"><svg x-h-lucide data-lucide="refresh-cw"></svg></button>
        </div>
#elseif($property.widgetType == "NUMBER")
        <!-- step="any": without it the browser default step=1 rejects fractional input on DECIMAL fields. -->
        <div x-h-input-number>
          <input type="number" step="any" id="f_${property.name}" x-model.number="form.${property.name}"
                 :aria-invalid="!!errors.${property.name}"#if($readonly) readonly#end />
        </div>
#elseif($property.widgetType == "TEXTAREA")
        <textarea x-h-textarea id="f_${property.name}" rows="4" x-model="form.${property.name}"
                  :aria-invalid="!!errors.${property.name}"#if($readonly) readonly#end></textarea>
#elseif($property.widgetType == "COLOR")
        <input x-h-input type="color" id="f_${property.name}" x-model="form.${property.name}"#if($readonly) readonly#end />
#elseif($property.widgetType == "EMAIL")
        <input x-h-input type="email" id="f_${property.name}" x-model="form.${property.name}"
               :aria-invalid="!!errors.${property.name}"#if($property.widgetPattern) pattern="${property.widgetPattern}"#end#if($readonly) readonly#end />
#elseif($property.widgetType == "URL")
        <input x-h-input type="url" id="f_${property.name}" x-model="form.${property.name}"
               :aria-invalid="!!errors.${property.name}"#if($property.widgetPattern) pattern="${property.widgetPattern}"#end#if($readonly) readonly#end />
#elseif($property.widgetType == "TEL")
        <input x-h-input type="tel" id="f_${property.name}" x-model="form.${property.name}"
               :aria-invalid="!!errors.${property.name}"#if($property.widgetPattern) pattern="${property.widgetPattern}"#end#if($readonly) readonly#end />
#elseif($property.widgetType == "DATE")
        <!-- Harmonia date picker: model is YYYY-MM-DD (same as the native date input it replaces), so
             form.${property.name} round-trips unchanged. Readonly (preview) -> the input is disabled. -->
        <div x-h-date-picker>
          <input type="text" :placeholder="HarmoniaFormat.dateHint()" id="f_${property.name}" :aria-invalid="!!errors.${property.name}"#if($readonly) disabled#end />
          <button x-h-date-picker-trigger aria-label="Choose date"></button>
          <div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="form.${property.name}"></div>
        </div>
#elseif($property.widgetType == "DATETIME-LOCAL")
        <div x-h-datetime-picker>
          <input type="text" id="f_${property.name}" :aria-invalid="!!errors.${property.name}"#if($readonly) disabled#end />
          <button x-h-datetime-picker-trigger aria-label="Choose date and time"></button>
          <div x-h-datetime-picker-popup="HarmoniaFormat.pickerConfig('dateTime')" x-model="form.${property.name}"></div>
        </div>
#elseif($property.widgetType == "TIME")
        <div x-h-time-picker>
          <input type="text" x-h-time-picker-input id="f_${property.name}" x-model="form.${property.name}" :aria-invalid="!!errors.${property.name}"#if($readonly) disabled#end />
          <div x-h-time-picker-popup></div>
        </div>
#elseif($property.widgetType == "MONTH")
        <!-- Harmonia month picker: model is a YYYY-MM string, so form.${property.name} round-trips unchanged. -->
        <div x-h-month-picker>
          <input type="text" id="f_${property.name}" :aria-invalid="!!errors.${property.name}"#if($readonly) disabled#end />
          <button x-h-month-picker-trigger aria-label="Choose month"></button>
          <div x-h-month-picker-popup x-model="form.${property.name}"></div>
        </div>
#elseif($property.widgetType == "WEEK")
        <!-- Harmonia week picker: model is a YYYY-Www ISO-week string, so form.${property.name} round-trips unchanged. -->
        <div x-h-week-picker>
          <input type="text" id="f_${property.name}" :aria-invalid="!!errors.${property.name}"#if($readonly) disabled#end />
          <button x-h-week-picker-trigger aria-label="Choose week"></button>
          <div x-h-week-picker-popup x-model="form.${property.name}"></div>
        </div>
#else
        <input x-h-input type="text" id="f_${property.name}" x-model="form.${property.name}"
               :aria-invalid="!!errors.${property.name}"#if($property.widgetPattern) pattern="${property.widgetPattern}"#end#if($readonly) readonly#end />
#end
#end
        <p x-h-field-error x-show="errors.${property.name}" x-text="errors.${property.name}"></p>
#if($property.description)
        <p x-h-field-description data-hide-on-error="true">${property.description}</p>
#end
          </div>
        </template>
      </div>
#end
#end
    </div>
    </fieldset>
    </form>

    <!-- Detail collections (masters only; App.detailsFor returns [] otherwise): the same generic
         detail panels the master browse view renders, so the record's children are visible and
         manageable while editing. Rendered INSIDE the main column, above the footer, so the
         Save/Cancel bar stays at the very bottom of the page. Outside the <form> on purpose (the
         panel's buttons must not submit it). Add/Edit/Delete route back to THIS page (returnTo
         override); in preview the panels are read-only. -->
    <div class="vbox gap-4 w-full"
         x-show="(isEdit || isPreview) && detailDefs.length && state !== 'loading' && state !== 'load-failure'">
      <template x-for="d in detailDefs" :key="d.entity + ':' + id">
        <div x-data="detailPanel({...d, returnTo: '/${name}/' + id + (isPreview ? '/preview' : '/edit')}, id, form)" x-show="visibleWhenHolds(d.visibleWhen, form)" class="vbox gap-4 w-full">
          <!-- Each group is separated from the one above by a rule, not by its own frame, so the
               record reads as one card (issue #7491). -->
          <div x-h-separator data-orientation="horizontal"></div>
          <div class="hbox items-center gap-2">
            <h3 x-h-text.h4 x-text="d.label"></h3>
            <span x-h-badge data-variant="outline" x-show="rows.length" x-text="rows.length"></span>
            <div class="ml-auto hbox items-center gap-2">
              <!-- Refresh (#7612): the rows a server-side chain writes behind the panel's back - the Snapshot
                   copy minted after Issue, an allocation a settlement recorded - without reloading the page. -->
              <button type="button" x-h-button data-variant="transparent" data-size="icon-sm" :disabled="refreshing" @click="refresh()" :aria-label="T('$projectName:${tprefix}.defaults.refresh', 'Refresh')" :title="T('$projectName:${tprefix}.defaults.refresh', 'Refresh')"><svg role="presentation" x-h-lucide data-lucide="refresh-cw" :class="refreshing ? 'animate-spin' : ''"></svg></button>
              <button type="button" x-h-button data-variant="primary" data-size="sm" x-show="(!isPreview || def.locksWithMaster === false) && !def.files && !isForbidden()" @click="addRow()"><svg role="presentation" x-h-lucide data-lucide="plus"></svg><span x-text="T('$projectName:${tprefix}.defaults.add', 'Add')"></span></button>
            </div>
          </div>
          <div class="vbox gap-4">
            <div x-show="state === 'loading'"><div x-h-spinner></div></div>
            <div x-show="state === 'error'" x-h-text.muted x-text="error"></div>
            <div x-show="state === 'empty'" x-h-text.muted x-text="T('$projectName:${tprefix}.messages.noData', 'No records yet.')"></div>
            <!-- A calendar detail (intent view: calendar on the composition child): the same
                 master-filtered rows as events - event-click edits, empty-day click adds with the
                 master FK + the clicked date preset. -->
            <template x-if="def.calendar">
              <div x-show="state === 'default'" style="min-height: 420px">
                <div x-h-calendar="calCfg" style="height: 420px" @event-click="onEventClick" @date-click="onDateClick"></div>
              </div>
            </template>
#set($dollar = '$')
            <!-- A files detail (function: Attachment / Snapshot): download always; upload + remove
                 only when editable (not preview) and not a read-only Snapshot (copies are generated
                 server-side). $refs is escaped (${dollar}refs) so Velocity leaves the Alpine ref alone. -->
            <template x-if="def.files">
              <div x-show="state === 'default'" class="vbox gap-3">
                <div x-show="fileError" x-h-alert data-variant="negative" role="alert"><div x-h-alert-description x-text="fileError"></div></div>
                <template x-if="!isPreview &amp;&amp; !filesReadOnly">
                  <div class="hbox items-center gap-2">
                    <input type="file" multiple class="hidden" x-ref="fileInput" @change="onFilePick(${dollar}event)" :disabled="uploading" />
                    <button type="button" x-h-button data-variant="outline" data-size="sm" :disabled="uploading" @click="${dollar}refs.fileInput.click()">
                      <span x-show="uploading" x-h-spinner></span>
                      <svg x-show="!uploading" role="presentation" x-h-lucide data-lucide="upload"></svg>
                      <span x-text="uploading ? T('$projectName:${tprefix}.defaults.uploading', 'Uploading…') : T('$projectName:${tprefix}.defaults.upload', 'Upload')"></span>
                    </button>
                  </div>
                </template>
                <template x-if="rows.length === 0">
                  <div x-h-info-page>
                    <div x-h-info-page-header>
                      <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="paperclip"></svg></div>
                      <div x-h-info-page-title x-text="filesReadOnly ? T('$projectName:${tprefix}.messages.noCopies', 'No copies yet') : T('$projectName:${tprefix}.messages.noFiles', 'No attachments')"></div>
                      <div x-h-info-page-description x-text="filesReadOnly ? T('$projectName:${tprefix}.messages.noCopiesHint', 'A copy is stored automatically when the document is issued.') : T('$projectName:${tprefix}.messages.noFilesHint', 'Upload files to attach them to this record.')"></div>
                    </div>
                  </div>
                </template>
                <template x-if="rows.length > 0">
                  <div class="vbox gap-2">
                    <template x-for="row in rows" :key="row[def.primaryKey]">
                      <div class="hbox items-center gap-3 rounded-lg border p-3">
                        <svg role="presentation" x-h-lucide data-lucide="file-text" class="shrink-0"></svg>
                        <div class="vbox flex-1 min-w-0">
                          <span class="text-sm truncate" x-text="row.FileName"></span>
                          <span class="text-xs text-muted-foreground" x-text="fileSizeText(row)"></span>
                        </div>
                        <template x-if="filesReadOnly">
                          <a x-h-button data-variant="transparent" data-size="sm" :href="openHref(row)" target="_blank" rel="noopener" aria-label="Print"><svg role="presentation" x-h-lucide data-lucide="printer"></svg></a>
                        </template>
                        <a x-h-button data-variant="transparent" data-size="sm" :href="downloadHref(row)" target="_blank" rel="noopener" aria-label="Download"><svg role="presentation" x-h-lucide data-lucide="download"></svg></a>
                        <template x-if="!isPreview &amp;&amp; !filesReadOnly">
                          <button type="button" x-h-button data-variant="transparent" data-size="sm" @click="askDelete(row)" aria-label="Remove"><svg role="presentation" x-h-lucide data-lucide="trash-2"></svg></button>
                        </template>
                      </div>
                    </template>
                  </div>
                </template>
              </div>
            </template>
            <template x-if="!def.calendar &amp;&amp; !def.files">
            <div x-show="state === 'default'" x-h-table-container.scroll style="max-height: 320px">
              <table x-h-table data-borders="rows">
                <thead x-h-table-header>
                  <tr x-h-table-row>
                    <template x-for="col in def.columns" :key="col.name">
                      <th x-h-table-head scope="col" :class="col.number ? 'text-right' : ''" x-text="T(col.tkey, col.label || col.name)"></th>
                    </template>
                    <th x-h-table-head scope="col" x-show="!isPreview || def.locksWithMaster === false"></th>
                  </tr>
                </thead>
                <tbody x-h-table-body>
                  <template x-for="row in rows" :key="row[def.primaryKey]">
                    <tr x-h-table-row data-hoverable="true">
                      <template x-for="col in def.columns" :key="col.name">
                        <td x-h-table-cell :class="col.number ? 'text-right' : ''">
                          <template x-if="col.number"><span x-text="cellValue(col, row)"></span></template>
                          <template x-if="!col.number">
                            <div style="white-space: normal; overflow-wrap: break-word; max-width: 28rem;" x-text="cellValue(col, row)"></div>
                          </template>
                        </td>
                      </template>
                      <td x-h-table-cell data-row-actions x-show="!isPreview || def.locksWithMaster === false">
                        <button type="button" x-h-menu-trigger.dropdown x-h-table-cell-button aria-label="Row actions"><svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg></button>
                        <ul x-h-menu data-align="bottom-end">
                          <li x-h-menu-item @click="previewRow(row)" x-text="T('$projectName:${tprefix}.defaults.preview', 'Preview')"></li>
                          <li x-h-menu-item x-show="!isForbidden()" @click="editRow(row)" x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></li>
                          <li x-h-menu-separator x-show="!isForbidden()"></li>
                          <li x-h-menu-item x-show="!isForbidden()" data-variant="negative" @click="askDelete(row)" x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></li>
                        </ul>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
            </template>
          </div>

          <!-- Detail delete confirmation -->
          <div x-h-dialog-overlay :data-open="deleteOpen">
            <div x-h-dialog>
              <div x-h-dialog-header>
                <h2 x-h-dialog-title x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete') + ' ' + T(def.tkey, def.label)"></h2>
                <button type="button" x-h-dialog-close @click="deleteOpen = false" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
              </div>
              <div x-h-dialog-content><p x-text="T('$projectName:${tprefix}.messages.deleteConfirm', 'Are you sure you want to delete {{name}}? This action cannot be undone.', { name: T(def.tkey, def.label) })"></p></div>
              <div x-h-dialog-footer>
                <button type="button" x-h-button data-variant="outline" @click="deleteOpen = false" :disabled="deleteBusy" x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
                <button type="button" x-h-button data-variant="negative" @click="confirmDelete()" :disabled="deleteBusy"><span x-show="deleteBusy" x-h-spinner></span><span x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></span></button>
              </div>
            </div>
          </div>
        </div>
      </template>
    </div>

    <div class="vbox gap-4 w-full" x-show="(isEdit || isPreview) && relatedDefs.length && state !== 'loading' && state !== 'load-failure'">
      <!-- ===== Related registers: the records that REFERENCE this one, read-only. Those records are
           owned by their own entities - own lifecycle, own pages, own processes - so this is a
           window onto them and never an editor: a row opens the source's own record page in the
           shared dialog (the source may live in another application entirely). ===== -->
      <template x-for="r in relatedDefs" :key="r.entity + ':' + id">
        <div x-data="relatedPanel(r, id)" class="vbox gap-4 w-full">
          <!-- Each group is separated from the one above by a rule, not by its own frame, so the
               record reads as one card (issue #7491). -->
          <div x-h-separator data-orientation="horizontal"></div>
          <div class="hbox items-center gap-2">
            <h3 x-h-text.h4 x-text="title"></h3>
            <span x-h-badge data-variant="outline" x-show="rows.length" x-text="rows.length"></span>
          </div>
          <div class="vbox gap-4">
            <div x-show="state === 'loading'"><div x-h-spinner></div></div>
            <div x-show="state === 'error'" x-h-text.muted x-text="error"></div>
            <div x-show="state === 'empty'" x-h-text.muted x-text="T('$projectName:${tprefix}.messages.noData', 'No records yet.')"></div>
            <div x-show="state === 'default'" x-h-table-container.scroll style="max-height: 320px">
              <table x-h-table data-borders="rows">
                <thead x-h-table-header>
                  <tr x-h-table-row>
                    <template x-for="col in def.columns" :key="col.name">
                      <th x-h-table-head scope="col" :class="col.number ? 'text-right' : ''" x-text="columnHeader(col)"></th>
                    </template>
                    <th x-h-table-head scope="col"></th>
                  </tr>
                </thead>
                <tbody x-h-table-body>
                  <template x-for="row in rows" :key="row[def.primaryKey]">
                    <tr x-h-table-row data-hoverable="true">
                      <template x-for="col in def.columns" :key="col.name">
                        <td x-h-table-cell :class="col.number ? 'text-right' : ''">
                          <template x-if="col.number"><span x-text="cellValue(col, row)"></span></template>
                          <template x-if="!col.number">
                            <div style="white-space: normal; overflow-wrap: break-word; max-width: 28rem;" x-text="cellValue(col, row)"></div>
                          </template>
                        </td>
                      </template>
                      <td x-h-table-cell data-row-actions>
                        <button type="button" x-h-button data-variant="transparent" data-size="sm" @click="openRow(row)" :aria-label="T('$projectName:${tprefix}.defaults.open', 'Open')"><svg role="presentation" x-h-lucide data-lucide="external-link"></svg></button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </template>
    </div>

    </div>

    <!-- Dialog-only footer (issue #7434): the FK "Add" iframe (?dialog=1) hides the sticky header bar
         above, so a create dialog carries its Cancel + Save here. A full-page form (not a dialog) has
         its actions in the header bar and hides this. Save is type=button @click=save() because it
         lives outside the header <form>. -->
    <div x-h-toolbar.footer x-show="isDialog">
      <div x-h-toolbar-spacer></div>
      <!-- The button says what it will do: leaving a dirty form discards the edit (issue #7359). -->
      <button type="button" x-h-button data-variant="transparent" x-show="!isPreview" @click="cancel()" :disabled="state === 'saving'" x-text="isDirty() ? T('$projectName:${tprefix}.defaults.discard', 'Discard') : T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
      <!-- Nothing to save on an unchanged record; a create is always offerable. -->
      <button type="button" x-h-button data-variant="primary" x-show="!isPreview" :disabled="state === 'saving' || (isEdit &amp;&amp; !isDirty())" @click="save()">
        <span x-show="state === 'saving'" x-h-spinner></span>
        <svg x-h-lucide role="presentation" data-lucide="save" x-show="state !== 'saving'"></svg><span x-text="isEdit ? T('$projectName:${tprefix}.defaults.update', 'Save') : T('$projectName:${tprefix}.defaults.create', 'Create')"></span>
      </button>
    </div>
    </div>

    <!-- Right sidebar: read-only / audit fields (audit, ProcessId, uuid, read-only), single column,
         top-to-bottom (edit/preview only). -->
#set($hasReadOnly = false)
#foreach($property in $properties)
#if(($property.isReadOnlyProperty == "true" || ($property.auditType && $property.auditType != "NONE")) && !$property.isHiddenProperty)#set($hasReadOnly = true)#end
#end
#if($hasReadOnly || $history == "true")
    <!-- Beside the record on a wide screen, the last section of it on a narrow one: same content,
         a rule on the left or above it. Bound rather than a responsive class - border, padding and
         container widths ship no md:/lg: variants. -->
    <div class="vbox gap-6" x-show="(isEdit || isPreview) &amp;&amp; hasRailContent"
         :class="isWide ? 'w-2xs shrink-0 border-l pl-6' : 'w-full border-t pt-6'"
         :style="isPreview ? '' : 'opacity: .7'">
#if($hasReadOnly)
      <div class="vbox gap-3" x-show="hasDetailValues">
        <h3 x-h-text.h4 x-text="T('$projectName:${tprefix}.defaults.details', 'Details')"></h3>
        <div>
          <div class="grid grid-cols-1 gap-y-3">
#foreach($property in $properties)
#if(($property.isReadOnlyProperty == "true" || ($property.auditType && $property.auditType != "NONE")) && !$property.isHiddenProperty)
#if($property.widgetLabel)#set($rolabel = $property.widgetLabelJs)#else#set($rolabel = $property.name)#end
            <div class="vbox" #valueGate($property)>
              <span class="text-xs text-muted-foreground" x-text="T('$projectName:${tprefix}.t.${property.dataName}', '${rolabel}')"></span>
#if($property.widgetType == "DROPDOWN")
              <span class="text-sm wrap-anywhere" x-text="(options${property.name}.find(o => String(o.value) === String(form.${property.name})) || {}).text || form.${property.name}"></span>
#elseif($property.widgetType == "MULTISELECT")
              <span class="text-sm wrap-anywhere" x-text="(Array.isArray(form.${property.name}) ? form.${property.name} : String(form.${property.name} || '').split(',')).filter(v => v !== '').map(v => (options${property.name}.find(o => String(o.value) === String(v).trim()) || {}).text || v).join(', ')"></span>
#elseif($property.widgetType == "CHECKBOX")
              <!-- The translated state, as the preview shows it - fieldText would print true/false (#7522). -->
              <span class="text-sm wrap-anywhere" x-text="checkboxText(form.${property.name})"></span>
#else
              <!-- Through the same formatter every other surface uses: these are the audit columns, so
                   most of them ARE dates, and printed raw they read as the backend's serialization
                   (2026-09-30T10:29) rather than the instance's date format. -->
              <span class="text-sm wrap-anywhere" x-text="fieldText(form.${property.name}, #if($property.isDateType)true#{else}false#end, #if($property.isNumberType)true#{else}false#end, null)"></span>
#end
            </div>
#end
#end
          </div>
        </div>
      </div>
#end
#if($history == "true")
      <!-- Change history (intent `history: true`): the record's field-level trail, newest first.
           Read-only everywhere - the shadow table has no write verb on any surface. -->
      <div class="vbox gap-3" x-show="history.length">
        <!-- Only a rule BETWEEN two sections: with Details hidden, History is the rail's first. -->
        <div x-h-separator data-orientation="horizontal" x-show="hasDetailValues"></div>
        <h3 x-h-text.h4 x-text="T('$projectName:${tprefix}.defaults.history', 'History')"></h3>
        <div>
          <div class="vbox gap-3">
            <template x-for="entry in history" :key="entry.GUID">
              <div class="vbox">
                <div class="hbox items-center gap-2">
                  <span class="text-xs font-medium" x-text="historyLabel(entry.Property)"></span>
                  <span x-h-badge data-variant="outline" x-show="entry.Source === 'SYSTEM'" x-text="T('$projectName:${tprefix}.defaults.system', 'System')"></span>
                </div>
                <span class="text-sm wrap-anywhere">
                  <span class="text-muted-foreground line-through" x-show="entry.OldValue" x-text="entry.OldValue"></span>
                  <span x-show="entry.OldValue"> &rarr; </span>
                  <span x-text="historyValue(entry.NewValue)"></span>
                </span>
                <span class="text-xs text-muted-foreground" x-text="historyWho(entry)"></span>
              </div>
            </template>
          </div>
        </div>
      </div>
#end
    </div>
#end
  </div>
#if($hasPrint == "true")

  <!-- Print language picker: shown when more than one template language exists under
       Templates/${name}/Print/ in the CMS ("English" -> en, "Bulgarian" -> bg, ...) -->
  <div x-h-dialog-overlay :data-open="printLangOpen">
    <div x-h-dialog>
      <div x-h-dialog-header>
        <h2 x-h-dialog-title x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></h2>
        <p x-h-dialog-description x-text="T('$projectName:${tprefix}.messages.printLanguage', 'Choose the template language.')"></p>
        <button x-h-dialog-close @click="printLangOpen = false" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content>
        <div class="vbox gap-2">
          <template x-for="lang in printLanguages" :key="lang.code">
            <button type="button" x-h-button data-variant="outline" @click="printLangOpen = false; printDoc(lang.code)">
              <svg role="presentation" x-h-lucide data-lucide="printer"></svg><span x-text="lang.name"></span>
            </button>
          </template>
        </div>
      </div>
    </div>
  </div>
#end

  <!-- Delete the record from its own page (issue #7491). The list has carried this since it
       existed; on the record page it used to be one navigation away. -->
  <div x-h-dialog-overlay :data-open="deleteOpen">
    <div x-h-dialog>
      <div x-h-dialog-header>
        <h2 x-h-dialog-title x-text="T('$projectName:${tprefix}.defaults.deleteTitle', 'Delete ${entityLabel}', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></h2>
        <button x-h-dialog-close @click="deleteOpen = false" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content>
        <p x-text="T('$projectName:${tprefix}.messages.deleteConfirm', 'Are you sure you want to delete this record?', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></p>
        <div x-show="deleteError" x-h-alert data-variant="negative" role="alert" class="mt-2">
          <div x-h-alert-description x-text="deleteError"></div>
        </div>
      </div>
      <div x-h-dialog-footer>
        <button type="button" x-h-button data-variant="outline" @click="deleteOpen = false" :disabled="deleteBusy" x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
        <button type="button" x-h-button data-variant="negative" @click="confirmDelete()" :disabled="deleteBusy">
          <span x-show="deleteBusy" x-h-spinner></span>
          <span x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Unsaved-changes guard (issue #7359): the one dialog every exit from a dirty form goes
       through - Cancel/Discard, Escape, a sidebar entry, the browser Back button, and the actions
       that would otherwise save something behind an unsaved header (a line item, a line delete).
       "Save and continue" is the same first button when the user is staying on the page. -->
  <div x-h-dialog-overlay :data-open="leaveOpen">
    <div x-h-dialog>
      <div x-h-dialog-header>
        <h2 x-h-dialog-title x-text="T('$projectName:${tprefix}.messages.unsavedChanges', 'Unsaved changes')"></h2>
        <button x-h-dialog-close @click="leaveKeepEditing()" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content>
        <p x-text="T('$projectName:${tprefix}.messages.unsavedChangesConfirm', 'This form has changes that have not been saved yet.')"></p>
      </div>
      <div x-h-dialog-footer>
        <button type="button" x-h-button data-variant="outline" @click="leaveKeepEditing()" :disabled="leaveBusy" x-text="T('$projectName:${tprefix}.defaults.keepEditing', 'Keep editing')"></button>
        <button type="button" x-h-button data-variant="negative" @click="leaveDiscard()" :disabled="leaveBusy" x-text="T('$projectName:${tprefix}.defaults.discard', 'Discard')"></button>
        <button type="button" x-h-button data-variant="primary" @click="leaveSave()" :disabled="leaveBusy">
          <span x-show="leaveBusy" x-h-spinner></span>
          <span x-text="leaveIntent === 'continue' ? T('$projectName:${tprefix}.defaults.saveAndContinue', 'Save and continue') : T('$projectName:${tprefix}.defaults.saveAndLeave', 'Save and leave')"></span>
        </button>
      </div>
    </div>
  </div>

</div>
