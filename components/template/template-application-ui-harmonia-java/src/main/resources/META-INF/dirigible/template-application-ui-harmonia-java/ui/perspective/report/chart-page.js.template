 *
 * Do not modify the content as it may be re-generated again.
 */

/* Report chart page for ${name}: rows from the report controller rendered as a native Harmonia chart
   (the x-h-chart-* directive in the view; no external chart library). */
document.addEventListener('alpine:init', () => {
  Alpine.data('${name}ReportPage', () => ({
    ...basePage(),
    apiPath: '/${javaPerspectiveName}/${name}Controller',
    state: 'loading',   // loading | error | empty | default
    error: null,
    // Reactive config consumed by the chart directive in the view; the directive re-renders on change.
    chartConfig: { labels: [], series: [] },

    // A quiet re-read (Refresh) is in flight; the chart on screen stays until it answers.
    reloading: false,

    async init() {
      // The sidebar entry of the report on screen re-renders nothing, so it re-reads instead (#8130).
      this.onReentered(() => this.refresh());
      await this.load();
    },

    // Re-read the report, keeping the chart on screen meanwhile.
    refresh() { return this.load(true); },

    async load(quiet) {
      const keepChart = quiet && (this.state === 'default' || this.state === 'empty');
      if (keepChart) this.reloading = true;
      else this.state = 'loading';
      this.error = null;
      try {
        const rows = await App.services.api.get(this.apiPath);
        this.state = rows.length === 0 ? 'empty' : 'default';
        if (rows.length) this.chartConfig = this.buildConfig(rows);
        this.lastUpdated = new Date();
      } catch (e) {
        this.error = App.services.apiErrors.messageFor(e, 'Could not run the ${name} report.');
        this.state = 'error';
      } finally {
        this.reloading = false;
      }
    },

    // Labels from the primary-key column; one series per non-key (measure) property. Circular charts
    // (pie/doughnut/polar area) derive their slices from the labels + the first series.
    buildConfig(rows) {
      const labels = rows.map(e => e.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end);
      const series = [
#foreach($property in $properties)
#if(!$property.dataPrimaryKey)
        { name: #if($property.widgetLabel)'${property.widgetLabelJs}'#else'${property.name}'#end, data: rows.map(e => Number(e.${property.name}) || 0) },
#end
#end
      ];
#if($layoutType == "REPORT_PIE" || $layoutType == "REPORT_DOUGHNUT" || $layoutType == "REPORT_POLARAREA")
      // A circular chart's slices ARE the label column's values, named by the legend alone, so each
      // label carries its share of the first series' total.
      const values = (series[0] && series[0].data) || [];
      const total = values.reduce((sum, v) => sum + (v > 0 ? v : 0), 0);
      const sliceLabels = total > 0
        ? labels.map((label, i) => {
            const v = values[i];
            if (!(v > 0)) return label;
            const pct = (v / total) * 100;
            return label + ' - ' + (pct < 10 ? pct.toFixed(1) : String(Math.round(pct))) + '%';
          })
        : labels;
#if($layoutType == "REPORT_POLARAREA")
      return { labels: sliceLabels, series, legend: true };
#else
      // dataLabels off: the chart library prints the raw value inside a pie/doughnut slice with a
      // percent sign, so a 336-hour sum reads "336%" (codbex/harmonia#113, fixed after 2.14.2). The
      // share is in the legend instead.
      return { labels: sliceLabels, series, legend: true, dataLabels: false };
#end
#else
      return { labels, series };
#end
    },

    // Print the chart: rasterize the rendered SVG to a PNG (Harmonia.chartToImage) into a minimal
    // print document in a new window.
    async printChart() {
      const el = this.$refs.chartEl;
      if (!el || this.state !== 'default' || typeof Harmonia === 'undefined') return;
      const data = await Harmonia.chartToImage(el);
      const w = window.open('', '_blank');
      if (!w) return;
      w.document.write('<!doctype html><html><head><title>${name}</title><style>'
        + 'body{font-family:system-ui,-apple-system,sans-serif;margin:24px;color:#111}'
        + 'h1{font-size:18px;margin:0 0 16px}img{max-width:100%}'
        + '</style></head><body><h1>${name}</h1>'
        + '<img src="' + data + '" onload="window.focus();window.print()" /></body></html>');
      w.document.close();
    },
  }));
}, { once: true });
