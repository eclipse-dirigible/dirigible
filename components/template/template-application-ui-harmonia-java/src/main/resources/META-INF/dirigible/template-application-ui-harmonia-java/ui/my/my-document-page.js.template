/*
 * Generated by Eclipse Dirigible based on model and template.
 *
 * Do not modify the content as it may be re-generated again.
 */

/*
 * Personal (my) DOCUMENT page for ${name} - the logged-in user's own document (header + line items),
 * scoped to the ${name}MyController (header) and the ${documentItemsEntity}MyController (items). It
 * reuses the item COLUMN metadata that detail-register already published (App.detailsFor), but reads
 * and writes item DATA through the personal items controller so ownership + sensitive-field stripping
 * are enforced server-side. Sensitive fields never arrive; the owner is forced by the server.
 */
#set($statusProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_STATUS")#set($statusProp = $property.name)#end
#end
document.addEventListener('alpine:init', () => {
  Alpine.data('${name}MyDocumentPage', () => ({
    ...basePage(),
    state: 'loading',
    mode: 'create',
    id: null,
    error: null,
    saving: false,
    ownerName: '',
    deleteOpen: false,
    deleteBusy: false,
    form: {
#foreach($property in $properties)
#if(!$property.dataAutoIncrement && !$property.sensitiveProperty && $property.name != "ProcessId" && $property.name != "ProcessIds" && (!$property.auditType || $property.auditType == "NONE") && $property.name != "Name")
      ${property.name}: #if($property.widgetType == "CHECKBOX")false#elseif($property.widgetType == "MULTISELECT")[]#{else}''#end,
#end
#end
    },
    options: {},

    apiPath: '/${javaPerspectiveName}/${name}MyController',
    // The personal items controller (composition child inherits the personal scope one hop).
    itemsApiPath: '/${javaPerspectiveName}/${documentItemsEntity}MyController',

    // Role-scoped line-item columns withheld from this caller (see init).
    itemRestricted: [],
#if($immutableStatusProperty || $immutableAlways)

    // Immutability pre-check (intent `immutable`/`immutableWhen:`), asked from the scoped
    // controller's GET /{id}/mutable so the Edit affordances stay honest - an /edit URL typed
    // directly opens read-only (header AND item actions). The controller's PUT/DELETE 409 stays
    // authoritative; the pre-check fails OPEN (an outage must not lock the UI).
    mutable: true,
#end

    // Items state (the ${documentItemsEntity} line items, rendered inline).
    itemsDef: null,        // column metadata reused from detail-register (App.detailsFor)
    items: [],
    itemsEnabled: false,   // items only after the header exists
    itemsError: null,
    itemDialog: false,
    itemMode: 'create',
    draft: {},
    itemOptions: {},
#if($documentItemsLayout == "chat")
    // Chat composer state (documentItemsLayout: chat) - the personal document renders the same
    // conversation thread the power document does, through the personal items controller.
    chatDraft: '',
    chatSending: false,
#if($chatInternalProperty)
    chatInternal: false,
#end
#end
#if($documentItemsLayout == "calendar")
    // Reactive config for the items x-h-calendar (the items child declares view: calendar); rebuilt
    // after every items load. The configuration itself rides the child's detail registration.
    itemsCalCfg: { view: 'month', events: [] },
#end

    // The item column metadata, reused from detail-register (App.detailsFor). Resolved lazily: the
    // detail-register script may run after this component's init, so re-resolve until it is present.
    def() {
      if (!this.itemsDef) {
        this.itemsDef = App.detailsFor('${name}').find((d) => d.entity === '${documentItemsEntity}') || null;
      }
      return this.itemsDef;
    },

    async init() {
#if($hasRestrictedFields)
      // Role-scoped fields (intent `visibleTo:`): this surface's own controller strips them from the
      // document and ignores them on writes, so the header form and the totals hide them too.
      this.loadRestrictedFields();
#end
      this.def();
      // Role-scoped columns of the line-items child: the child registered whether it has any,
      // and its own scoped controller says which of them this caller may not see.
      if (this.def() && this.def().restrictedFields) {
        try {
          const answer = await App.services.api.get(this.itemsApiPath + '/restricted');
          this.itemRestricted = (answer && answer.restricted) || [];
        } catch (e) {
          console.error('[restricted] could not read the line-item field visibility', e);
        }
      }
      await this.loadOwnerName();
      await this.loadOptions();
      const params = (window.PineconeRouter.context && window.PineconeRouter.context.params) || {};
      this.id = params.id || null;
      this.mode = this.id ? 'edit' : 'create';
      if (this.id) {
        try {
          const record = await App.services.api.get(this.apiPath + '/' + this.id);
#if($immutableStatusProperty || $immutableAlways)
          try {
            const m = await App.services.api.get(this.apiPath + '/' + this.id + '/mutable');
            this.mutable = !m || m.mutable !== false;
          } catch (e) {
            console.error('[${name}MyDocumentPage] mutable pre-check failed', e);
          }
#end
          for (const key of Object.keys(this.form)) {
            if (record[key] !== undefined && record[key] !== null) this.form[key] = record[key];
          }
#foreach($property in $properties)
#if(($property.widgetType == "DATE" || $property.widgetType == "DATETIME-LOCAL") && !$property.sensitiveProperty)
          if (this.form.${property.name} != null && this.form.${property.name} !== '') this.form.${property.name} = window.HarmoniaFormat.toDateInput(this.form.${property.name}, '${property.widgetType}');
#end
#end
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS") && !$property.sensitiveProperty)
          if (this.form.${property.name} != null && this.form.${property.name} !== '') this.form.${property.name} = String(this.form.${property.name});
#end
#if($property.widgetType == "MULTISELECT" && !$property.sensitiveProperty)
          // MULTISELECT: split the stored csv into the ARRAY the multiple-mode select binds.
          this.form.${property.name} = (this.form.${property.name} == null || this.form.${property.name} === '')
              ? [] : String(this.form.${property.name}).split(',').map(v => v.trim());
#end
#end
          this.itemsEnabled = true;
          await this.loadItems();
          if (this.loadChildren) this.loadChildren();
          this.state = 'default';
        } catch (e) {
          this.error = (e && e.message) || 'Could not load the document.';
          this.state = 'error';
        }
      } else {
        // A MULTISELECT field (an ARRAY - what keeps the select in multiple mode) takes no prefill.
        for (const key of Object.keys(this.form)) {
          if (Array.isArray(this.form[key])) continue;
          const v = this.queryParam(key);
          if (v !== null) this.form[key] = v;
        }
        this.state = 'default';
      }
    },

    queryParam(name) {
      const search = (window.location.hash.split('?')[1] || '');
      const params = new URLSearchParams(search);
      return params.has(name) ? params.get(name) : null;
    },

    /** The mapped identity record's display name (for "New/Edit <Doc> for <owner>"). */
    async loadOwnerName() {
      try {
        const me = await App.services.api.get(this.apiPath + '/me');
        this.ownerName = (me && (me.name || me.Name)) || '';
      } catch (e) { this.ownerName = ''; }
    },

    async loadOptions() {
      const loaded = {};
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT") && !$property.sensitiveProperty)
      try {
        const rows = await App.services.api.getAll('${property.widgetDropdownControllerUrl}', { baseUrl: '' });
        loaded['${property.name}'] = (rows || []).map(r => ({ value: r.${property.widgetDropDownKey}, text: r.${property.widgetDropDownValue} }));
      } catch (e) { loaded['${property.name}'] = []; }
#end
#end
      this.options = loaded;
    },

    // ----- Header (master) save -------------------------------------------------------------------
    toPayload() {
      const payload = { ...this.form };
      for (const key of Object.keys(payload)) {
        if (payload[key] === '') payload[key] = null;
      }
#foreach($property in $properties)
#if(($property.widgetType == "DATE" || $property.widgetType == "DATETIME-LOCAL") && !$property.sensitiveProperty)
      if (payload.${property.name} != null) payload.${property.name} = window.HarmoniaFormat.toPayload(payload.${property.name}, '${property.widgetType}');
#end
#if($property.widgetType == "MULTISELECT" && !$property.sensitiveProperty)
      // MULTISELECT: join the array back to the normative csv (de-duplicated, ascending); empty -> null.
      payload.${property.name} = Array.isArray(payload.${property.name}) && payload.${property.name}.length
          ? [...new Set(payload.${property.name}.map(String))]
              .sort((a, b) => (Number(a) - Number(b)) || String(a).localeCompare(String(b)))
              .join(',')
          : null;
#end
#end
      return payload;
    },

    async save() {
      this.saving = true;
      this.error = null;
      try {
        if (this.mode === 'edit') {
          await App.services.api.put(this.apiPath + '/' + this.id, this.toPayload());
          await this.loadItems();
        } else {
          const created = await App.services.api.post(this.apiPath, this.toPayload());
          const pk = created && (created.Id != null ? created.Id : created.id);
          if (pk != null) {
            this.id = pk;
            this.mode = 'edit';
            this.itemsEnabled = true;
            const url = '#/my/${name}/' + encodeURIComponent(this.id) + '/edit';
            if (window.location.hash !== url && window.history && window.history.replaceState) {
              window.history.replaceState(window.history.state, '', url);
            }
            await this.loadItems();
          }
        }
      } catch (e) {
        this.error = (e && e.message) || 'Could not save.';
      } finally {
        this.saving = false;
      }
    },

    // ----- Items (personal items controller) ------------------------------------------------------
    async loadItems() {
      const d = this.def();
      if (!d || this.id == null) return;
      this.itemsError = null;
      // Pre-load the lookup options so the items TABLE resolves FK columns to their labels (not raw
      // ids) on first render - not only after the item dialog has been opened once.
      await this.ensureItemOptions();
      try {
        // The personal items controller requires the master id as a query param (?<masterEntityId>=<id>);
        // it returns only that document's items and enforces ownership (requireMyParent).
        const q = '?' + encodeURIComponent(d.masterEntityId) + '=' + encodeURIComponent(this.id);
        const rows = await App.services.api.getAll(this.itemsApiPath + q);
        this.items = rows || [];
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not load the line items.';
        this.items = [];
      }
#if($documentItemsLayout == "calendar")
      this.refreshItemsCalendar();
#end
    },
#if($documentItemsLayout == "calendar")

    // ----- Items calendar (the items child declares view: calendar) -------------------------------
    // The personal counterpart of the power document's items calendar: the same rows, the same
    // personal item dialog, placed on a timeline. The event mapping is the shared one
    // (services/calendarEvents.js) and the calendar's configuration rides the child's registration.
    refreshItemsCalendar() {
      const d = this.def();
      const cal = (d && d.calendar) || null;
      this.itemsCalCfg = {
        view: (cal && cal.view) || 'month',
        events: cal ? window.HarmoniaCalendar.events(this.items, cal, {
          primaryKey: d.primaryKey,
          label: '${documentItemsLabel}',
          title: cal.title ? (row => this.itemEventTitle(cal, row)) : null,
        }) : [],
      };
    },

    // The event pill's title: the titling column resolved exactly as the items table renders it.
    itemEventTitle(cal, row) {
      const value = row[cal.title];
      if (value === null || value === undefined || value === '') return '';
      const column = this.itemColumns()
                         .find(c => c.name === cal.title);
      return column ? this.displayItem(row, column) : String(value);
    },

    // A read-only personal surface (or an immutable document) still SHOWS the calendar - it just never
    // opens the item dialog from it.
    itemsEditable() {
      return #if($personalReadOnly)false#{else}#if($immutableStatusProperty || $immutableAlways)this.mutable === true#{else}true#end#end;
    },

    onItemsEventClick(e) {
      if (!this.itemsEditable()) return;
      const id = window.HarmoniaCalendar.clickedEventId(e);
      if (id === null) return;
      const pk = this.def().primaryKey;
      const row = (this.items || []).find(r => String(r[pk]) === String(id));
      if (row) this.openItem(row);
    },

    onItemsDateClick(e) {
      if (!this.itemsEditable()) return;
      const cal = (this.def() || {}).calendar;
      if (!cal) return;
      const value = window.HarmoniaCalendar.clickedDateValue(e);
      this.openItem(null, value ? { [cal.start]: value } : null);
    },
#end

    // A sensitive column never renders on the personal surface (neither in the table nor in the
    // dialog): the personal items controller nulls the value on the wire, so showing the column
    // would only display a permanently empty field the owner is not meant to see.
    itemColumns() {
      const d = this.def();
      return ((d && d.editColumns) || []).filter((c) => !c.sensitive && !this.itemRestricted.includes(c.name));
    },
    // The read-only items TABLE shows the display columns (major fields - `major: false` hides a
    // field/relation from the table) with their full edit metadata; the dialog keeps itemColumns().
    tableColumns() {
      const d = this.def();
      if (!d) return [];
      const visible = new Set((d.columns || []).map(c => c.name));
      return this.itemColumns().filter(c => visible.has(c.name));
    },

    displayItem(row, col) {
      const v = row[col.name];
      if (v == null || v === '') return '—';
      if (col.multi) {
        // A subset cell holds a key LIST ("1,3"): resolve each key and join the labels.
        const opts = this.itemOptions[col.name] || [];
        return String(v).split(',').map(k => {
          const opt = opts.find(o => String(o.value) === k.trim());
          return opt ? opt.text : k.trim();
        }).join(', ');
      }
      if (col.lookup && this.itemOptions[col.name]) {
        const opt = (this.itemOptions[col.name] || []).find((o) => String(o.value) === String(v));
        if (opt) return opt.text;
      }
      if (col.date) return window.HarmoniaFormat ? window.HarmoniaFormat.date(v) : String(v);
      if (col.number) return window.HarmoniaFormat ? window.HarmoniaFormat.number(v) : String(v);
      if (col.widget === 'CHECKBOX') return window.T ? (v ? window.T('$projectName:${tprefix}.defaults.yes', 'Yes') : window.T('$projectName:${tprefix}.defaults.no', 'No')) : String(!!v);
      return String(v);
    },

    // `preset` seeds a CREATE draft with values the caller already knows (the day clicked on the items
    // calendar).
    async openItem(row, preset) {
      const d = this.def();
      await this.ensureItemOptions();
      this.itemMode = row ? 'edit' : 'create';
      this.draft = row ? { ...row } : {};
      // MULTISELECT columns bind an ARRAY draft (that is what puts the dialog's select in multiple
      // mode): split the stored csv on edit, start empty on create.
      for (const col of this.itemColumns()) {
        if (col.widget !== 'MULTISELECT') continue;
        const v = this.draft[col.name];
        this.draft[col.name] = (v == null || v === '') ? [] : String(v).split(',').map(s => s.trim());
      }
      this.draft[d.masterEntityId] = String(this.id);
      if (preset) {
        Object.keys(preset)
              .forEach((key) => { this.draft[key] = preset[key]; });
      }
      this.itemDialog = true;
    },

    async ensureItemOptions() {
      if (Object.keys(this.itemOptions).length) return;
      const loaded = {};
      for (const col of this.itemColumns()) {
        if (col.lookup && col.lookup.url) {
          try {
            const rows = await App.services.api.getAll(col.lookup.url, { baseUrl: '' });
            loaded[col.name] = (rows || []).map((r) => ({ value: r[col.lookup.key], text: r[col.lookup.text] }));
          } catch (e) { loaded[col.name] = []; }
        }
      }
      this.itemOptions = loaded;
    },

    async saveItem() {
      if (this.itemMode === 'fill') { await this.fillMonthItems(); return; }
      const d = this.def();
      const body = { ...this.draft };
      for (const key of Object.keys(body)) { if (body[key] === '') body[key] = null; }
      // MULTISELECT: join the array back to the normative csv (de-duplicated, ascending); empty -> null.
      for (const col of this.itemColumns()) {
        if (col.widget !== 'MULTISELECT') continue;
        const v = body[col.name];
        body[col.name] = Array.isArray(v) && v.length
            ? [...new Set(v.map(String))].sort((a, b) => (Number(a) - Number(b)) || String(a).localeCompare(String(b))).join(',')
            : null;
      }
      body[d.masterEntityId] = this.id;
      try {
        const pk = d.primaryKey;
        if (this.itemMode === 'edit' && body[pk] != null) {
          await App.services.api.put(this.itemsApiPath + '/' + encodeURIComponent(body[pk]), body);
        } else {
          await App.services.api.post(this.itemsApiPath, body);
        }
        this.itemDialog = false;
        await this.loadItems();
        await this.reloadHeaderTotals();
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not save the line item.';
      }
    },

    // ----- Fill Month (one dialog fill -> a line per working day) ---------------------------------
    // Offered only when the line item carries an editable plain DATE column (the fill target).
    fillDateColumn() {
      return this.itemColumns().find((c) => c.date && !c.readonly && !c.lookup && c.widget === 'DATE') || null;
    },
    fillDateName() { const c = this.fillDateColumn(); return c ? c.name : ''; },

    // The same item dialog, in 'fill' mode: the date column picks the MONTH (seeded with the current
    // one) and Save creates a line per working day instead of one line.
    async openFillMonth() {
      await this.openItem(null);
      const dateCol = this.fillDateColumn();
      if (!dateCol) return;
      this.itemMode = 'fill';
      const now = new Date();
      this.draft[dateCol.name] = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');
    },

    // One POST per working day (Mon-Fri) of the picked month with the dialog's values; days that
    // already carry a line are skipped, so a partially filled month can be topped up safely.
    async fillMonthItems() {
      const d = this.def();
      const dateCol = this.fillDateColumn();
      const month = String((dateCol && this.draft[dateCol.name]) || '').slice(0, 7);
      if (!/^\d{4}-\d{2}$/.test(month)) {
        this.itemsError = 'Pick a month to fill.';
        return;
      }
      const taken = new Set((this.items || []).map((r) => this.itemDayOf(r[dateCol.name])).filter(Boolean));
      const body = { ...this.draft };
      for (const key of Object.keys(body)) { if (body[key] === '') body[key] = null; }
      body[d.masterEntityId] = this.id;
      delete body[d.primaryKey];
      try {
        for (const day of this.monthWorkingDays(month)) {
          if (taken.has(day)) continue;
          await App.services.api.post(this.itemsApiPath, { ...body, [dateCol.name]: day });
        }
        this.itemDialog = false;
        await this.loadItems();
        await this.reloadHeaderTotals();
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not fill the month.';
        await this.loadItems();
        await this.reloadHeaderTotals();
      }
    },

    monthWorkingDays(month) {
      const y = Number(month.slice(0, 4)), m = Number(month.slice(5, 7));
      const days = [];
      for (let day = 1, last = new Date(y, m, 0).getDate(); day <= last; day++) {
        const dow = new Date(y, m - 1, day).getDay();
        if (dow !== 0 && dow !== 6) days.push(month + '-' + String(day).padStart(2, '0'));
      }
      return days;
    },

    // A stored date arrives as an ISO string, epoch number or java.time array - its YYYY-MM-DD part.
    itemDayOf(v) {
      if (v == null || v === '') return '';
      if (Array.isArray(v)) return v[0] + '-' + String(v[1]).padStart(2, '0') + '-' + String(v[2]).padStart(2, '0');
      if (typeof v === 'number') {
        const d = new Date(v < 1e12 ? v * 1000 : v);
        return isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
      }
      return String(v).slice(0, 10);
    },

#if($documentItemsLayout == "calendar")

    // Delete from the line dialog: the calendar pane has no per-row button, so this is the only route.
    async deleteDraftItem() {
      const pk = this.def().primaryKey;
      const row = (this.items || []).find(r => String(r[pk]) === String(this.draft[pk]));
      if (!row) return;
      this.itemDialog = false;
      await this.deleteItem(row);
    },
#end

    async deleteItem(row) {
      try {
        await App.services.api.delete(this.itemsApiPath + '/' + encodeURIComponent(row[this.def().primaryKey]));
        await this.loadItems();
        await this.reloadHeaderTotals();
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not delete the line item.';
      }
    },
#if($documentItemsLayout == "chat")

    // Append a chat message through the PERSONAL items controller - ownership of the parent
    // document is enforced server-side (requireMyParent), so a foreign document cannot be
    // written to even by hand-crafting the request.
    async sendMessage(value) {
      const body = (value || '').trim();
      if (!body || this.chatSending || !this.def() || this.id == null) return;
      this.chatSending = true;
      this.itemsError = null;
      try {
        const payload = { '${chatBodyProperty}': body };
        payload[this.def().masterEntityId] = this.id;
#if($chatInternalProperty)
        payload['${chatInternalProperty}'] = !!this.chatInternal;
#end
        await App.services.api.post(this.itemsApiPath, payload);
        this.chatDraft = '';
#if($chatInternalProperty)
        this.chatInternal = false;
#end
        await this.loadItems();
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not send the message.';
      } finally {
        this.chatSending = false;
      }
    },
#end

    /** After an item change the server recomputes the header aggregates - re-read them. */
    async reloadHeaderTotals() {
      try {
        const record = await App.services.api.get(this.apiPath + '/' + this.id);
#foreach($property in $properties)
#if($property.aggregate == "true")
        if (record.${property.name} !== undefined) this.form.${property.name} = record.${property.name};
#end
#end
      } catch (e) { /* totals refresh best-effort */ }
    },

#if($statusProp != "")
    statusText() {
      const opt = (this.options['${statusProp}'] || []).find((o) => String(o.value) === String(this.form.${statusProp}));
      return opt ? opt.text : '';
    },
    statusVariant(text) {
      const t = String(text || '').toLowerCase();
      if (/draft/.test(t)) return 'outline';
      if (/(cancel|reject|declin|void|fail|overdue|insufficient|exhaust)/.test(t)) return 'negative';
      if (/(pending|await|hold|review|partial)/.test(t)) return 'warning';
      if (/(approv|accept|activ|complet|paid|done|available)/.test(t)) return 'positive';
      if (/(issu|sent|ship|process|submit)/.test(t)) return 'information';
      return 'default';
    },
#end

    async confirmDelete() {
      this.deleteBusy = true;
      try {
        await App.services.api.delete(this.apiPath + '/' + this.id);
        this.deleteOpen = false;
        this.goBack();
      } catch (e) {
        this.error = (e && e.message) || 'Could not delete.';
        this.deleteOpen = false;
      } finally {
        this.deleteBusy = false;
      }
    },

    goBack() { this.navigate('/my/${name}'); },
#set($docChildren = [])
#if($myChildren)
#foreach($child in $myChildren)
#if($child.name != "$!{documentItemsEntity}")
#set($ignore = $docChildren.add($child))
#end
#end
#end
#if($docChildren.size() > 0)

    // --- non-item children inheriting the personal scope (panels below the document) --------------
    // The SAME panels the my-form renders: an embedded calendar for a view: calendar child (e.g. a
    // day-allocation calendar on a timesheet document), a table otherwise.
    children: [
#foreach($child in $docChildren)
      { name: '${child.name}', label: '${child.label}', fkProperty: '${child.fkProperty}',
        apiPath: '${child.apiPath}', rows: [], state: 'loading',
        calendar: #if($child.calendar){ start: '${child.calendar.start}', end: #if($child.calendar.end)'${child.calendar.end}'#{else}null#end, title: #if($child.calendar.title)'${child.calendar.title}'#{else}null#end, titleLookup: #if($child.calendar.titleLookup){ url: '${child.calendar.titleLookup.url}', key: '${child.calendar.titleLookup.key}', value: '${child.calendar.titleLookup.value}' }#{else}null#end, view: '${child.calendar.view}' }#{else}null#end,
        calCfg: { view: '#if($child.calendar)${child.calendar.view}#{else}month#end', events: [] },
        columns: [#foreach($col in $child.columns){ name: '${col.name}', label: '${col.label}'#if($col.number), number: true#end#if($col.date), date: true#end }#if($foreach.hasNext), #end#end],
        // Role-scoped columns (intent `visibleTo:`): asked from the child's own scoped controller
        // on first load, so the panel drops what this caller is not served.
        restrictedFields: #if($child.restrictedFields)true#{else}false#end },
#end
    ],

    async loadChildren() {
      for (const child of this.children) {
        try {
          if (child.restrictedFields && !child.restrictedLoaded) {
            child.restrictedLoaded = true;
            const answer = await App.services.api.get(child.apiPath + '/restricted').catch((e) => {
              console.error('[restricted] could not read the field visibility of ' + child.apiPath, e);
              return null;
            });
            const hidden = (answer && answer.restricted) || [];
            child.columns = child.columns.filter(c => !hidden.includes(c.name));
          }
          child.rows = await App.services.api.get(child.apiPath + '?' + encodeURIComponent(child.fkProperty) + '=' + encodeURIComponent(this.id)) || [];
          if (child.calendar) {
            // a title naming a RELATION resolves to its referenced label (fail-soft: raw value stays)
            if (child.calendar.titleLookup && !child.titleMap) {
              try {
                const rows = await App.services.api.getAll(child.calendar.titleLookup.url, { baseUrl: '' });
                const m = {};
                (rows || []).forEach(r => { m[r[child.calendar.titleLookup.key]] = r[child.calendar.titleLookup.value]; });
                child.titleMap = m;
              } catch (e) { child.titleMap = {}; }
            }
            child.calCfg = { view: child.calendar.view, events: this.buildChildEvents(child) };
          }
          child.state = 'default';
        } catch (e) {
          child.state = 'error';
        }
      }
      this.refreshIcons && this.refreshIcons();
    },

    // Row -> event mapping, the same conventions as the shared detailPanel (Jackson java.time
    // arrays / epoch seconds / ISO strings normalize via childToISO).
    buildChildEvents(child) {
      return (child.rows || []).map(row => {
        const start = this.childToISO(row[child.calendar.start]);
        if (!start) return null;
        const ev = { id: row.Id, title: this.childEventTitle(child, row), start: start, allDay: true };
        if (child.calendar.end) {
          const end = this.childToISO(row[child.calendar.end]);
          if (end) ev.end = end;
        }
        return ev;
      }).filter(Boolean);
    },
    childEventTitle(child, row) {
      if (child.calendar.title) {
        const v = row[child.calendar.title];
        const m = child.titleMap;
        const resolved = m ? m[v] : undefined;
        if (resolved !== undefined && resolved !== null && String(resolved) !== '') return String(resolved);
        if (v !== undefined && v !== null && String(v) !== '') return String(v);
      }
      return child.label + ' #' + row.Id;
    },
    childToISO(v) {
      if (v === undefined || v === null || v === '') return '';
      if (Array.isArray(v)) {
        const p = n => String(n).padStart(2, '0');
        const date = v[0] + '-' + p(v[1]) + '-' + p(v[2]);
        if (v.length <= 3) return date;
        return date + 'T' + p(v[3] || 0) + ':' + p(v[4] || 0) + ':' + p(v[5] || 0);
      }
      if (typeof v === 'number') {
        const ms = v < 1e12 ? v * 1000 : v;
        try { return new Date(ms).toISOString(); } catch (e) { return ''; }
      }
      return String(v);
    },
    displayChild(child, row, col) {
      const v = row[col.name];
      if (v == null || v === '') return '—';
      if (col.date) return this.childToISO(v).split('T')[0];
      return String(v);
    },

    addChild(child) {
      this.navigate('/my/' + child.name + '/create?' + encodeURIComponent(child.fkProperty) + '='
          + encodeURIComponent(this.id) + '&returnTo=' + encodeURIComponent('/my/${name}/' + this.id + '/edit'));
    },
    editChild(child, id) {
      this.navigate('/my/' + child.name + '/' + id + '/edit?returnTo=' + encodeURIComponent('/my/${name}/' + this.id + '/edit'));
    },
    onChildEventClick(child, e) {
      const id = e && e.detail && e.detail.event ? e.detail.event.id : null;
      if (id) this.editChild(child, id);
    },
    onChildDateClick(child, e) {
      let q = '?' + encodeURIComponent(child.fkProperty) + '=' + encodeURIComponent(this.id)
            + '&returnTo=' + encodeURIComponent('/my/${name}/' + this.id + '/edit');
      const d = e && e.detail ? e.detail.date : null;
      if (d instanceof Date && !isNaN(d.getTime())) {
        const p = n => String(n).padStart(2, '0');
        let val = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
        if (e.detail.time) val += 'T' + e.detail.time;
        q += '&' + encodeURIComponent(child.calendar.start) + '=' + encodeURIComponent(val);
      }
      this.navigate('/my/' + child.name + '/create' + q);
    },
#end
  }));
});
