<!-- Generated by Eclipse Dirigible. Report table view for ${name}. -->
<div x-data="${name}ReportPage" class="vbox size-full gap-4 p-4">
  <!-- One action row, the manage list's (#7491): no title (the shell's breadcrumb names the report),
       the Inbox's Refresh with its Updated stamp (#8130), and Export / Print in a More actions menu. -->
  <div class="hbox flex-wrap items-center gap-2">
    <!-- A re-read is in flight: the rows on screen stay (see load(quiet)), this only signals it. -->
    <span x-show="reloading" x-h-spinner aria-hidden="true"></span>
    <div class="flex-1"></div>
    <span x-show="lastUpdated" x-h-text.muted x-text="T('application-core:shell.inbox.updated', 'Updated {{time}}', { time: updatedTime() })"></span>
    <button x-h-button data-variant="outline" @click="refresh()">
      <svg role="presentation" x-h-lucide data-lucide="refresh-cw"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.refresh', 'Refresh')"></span>
    </button>
    <button x-h-button data-variant="outline" data-size="icon" x-h-menu-trigger.dropdown
            :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')">
      <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
    </button>
    <ul x-h-menu data-align="bottom-end">
      <!-- Both take the FULL result (POST /export), not only the rows on screen. -->
      <li x-h-menu-item :aria-disabled="state !== 'default'" @click="exportCsv()">
        <svg role="presentation" x-h-lucide data-lucide="download"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.export', 'Export')"></span>
      </li>
      <li x-h-menu-item :aria-disabled="state !== 'default'" @click="printReport()">
        <svg role="presentation" x-h-lucide data-lucide="printer"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></span>
      </li>
    </ul>
  </div>
  <!-- An Export or Print that failed: the rows on screen are still good, so it is said beside them. -->
  <div x-show="actionError" x-h-alert data-variant="negative" role="alert">
    <div x-h-alert-description x-text="actionError"></div>
    <div x-h-alert-actions>
      <button x-h-button data-variant="transparent" data-size="icon-sm" @click="actionError = null"
              :aria-label="T('$projectName:${tprefix}.defaults.close', 'Close')">
        <svg role="presentation" x-h-lucide data-lucide="x"></svg>
      </button>
    </div>
  </div>
  <div x-show="state === 'loading'"><div x-h-spinner></div></div>
  <div x-show="state === 'error'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.error.loading', 'Could not load')"></div>
      <div x-h-info-page-description x-text="error"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="load()" x-text="T('$projectName:${tprefix}.defaults.retry', 'Retry')"></button>
    </div>
  </div>
  <div x-show="state === 'empty'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="inbox"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.noDataTitle', 'No data')"></div>
      <div x-h-info-page-description x-text="T('$projectName:${tprefix}.messages.reportNoRows', 'The ${name} report returned no rows.', { name: '${name}' })"></div>
    </div>
  </div>
  <div x-show="state === 'default'" class="vbox flex-1 min-h-0">
    <div x-h-table-container.scroll data-border="true" class="min-h-0">
      <table x-h-table data-borders="both">
        <thead x-h-table-header>
          <tr x-h-table-row>
#foreach($property in $properties)
            <th x-h-table-head scope="col"#if($property.isNumberType) class="text-right"#end>#if($property.widgetLabel)${property.widgetLabel}#else${property.name}#end</th>
#end
          </tr>
        </thead>
        <tbody x-h-table-body>
          <template x-for="(row, i) in rows" :key="i">
            <tr x-h-table-row data-hoverable="true">
#foreach($property in $properties)
#if($property.isFloatType)
              <td x-h-table-cell class="text-right" x-text="displayNumber(row.${property.name}, '${property.formatPattern}')"></td>
#elseif($property.isNumberType)
              <td x-h-table-cell class="text-right" x-text="row.${property.name}"></td>
#else
              <td x-h-table-cell x-text="row.${property.name}"></td>
#end
#end
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </div>
</div>
