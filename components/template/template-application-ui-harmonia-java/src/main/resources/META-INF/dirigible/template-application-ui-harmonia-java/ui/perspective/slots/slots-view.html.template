<!--
  Generated by Eclipse Dirigible based on model and template.
  Slot-picker fragment for ${name}. Rendered into #app on /${name}.
  Binds the generated ${name}SlotsPage; a free slot routes to the shared create form prefilled with the
  chosen datetime, a taken one to its booking. (@slot-click / @range-change reference bare handlers so
  Alpine passes the event.)
-->
<div x-data="${name}SlotsPage" class="vbox size-full gap-4 p-4">

  <!-- One action row, the manage list's: the page carries no title (the shell's breadcrumb names it),
       the view switch and New stay visible, and the contributed actions collapse into the overflow. -->
  <div class="hbox flex-wrap items-center gap-2">
    <!-- The bookings of the days in view are being read; the picker stays on screen meanwhile. -->
    <span x-show="state === 'loading'" x-h-spinner aria-hidden="true"></span>
    <div class="flex-1"></div>

    <!-- The picker is an ADDITIONAL browse page: the entity's own layout (its list / document list)
         browses at /${name}/list, and this is the same switch that list carries. -->
    <div x-h-button-group x-model="viewChoice" :aria-label="T('$projectName:${tprefix}.defaults.listView', 'View')">
      <button type="button" x-h-button data-variant="outline" data-size="icon" x-h-button-group-radio="'slots'"
              :aria-label="T('$projectName:${tprefix}.defaults.slots', 'Slots')" :title="T('$projectName:${tprefix}.defaults.slots', 'Slots')">
        <svg role="presentation" x-h-lucide data-lucide="clock"></svg>
      </button>
      <button type="button" x-h-button data-variant="outline" data-size="icon" x-h-button-group-radio="'table'"
              :aria-label="T('$projectName:${tprefix}.defaults.list', 'List')" :title="T('$projectName:${tprefix}.defaults.list', 'List')">
        <svg role="presentation" x-h-lucide data-lucide="table"></svg>
      </button>
    </div>

    <button x-h-button data-variant="primary" @click="newEntity()">
      <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.new', 'New')"></span>
    </button>

    <!-- Developer-contributed page actions for this view (customActions extension point): never the
         primary, so they live behind the overflow, which shows only when there is one. -->
    <template x-if="$store.customActions.getActions(caView, 'page').length">
      <div class="inline-flex">
        <button x-h-button data-variant="outline" data-size="icon" x-h-menu-trigger.dropdown
                :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')">
          <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
        </button>
        <ul x-h-menu data-align="bottom-end">
          <template x-for="action in $store.customActions.getActions(caView, 'page')" :key="action.id">
            <li x-h-menu-item @click="$store.customActions.trigger(action)"
                x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
          </template>
        </ul>
      </div>
    </template>
  </div>

  <!-- Error -->
  <div x-show="state === 'error'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.error.loading', 'Could not load')"></div>
      <div x-h-info-page-description x-text="error"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="load()" x-text="T('$projectName:${tprefix}.defaults.retry', 'Retry')"></button>
    </div>
  </div>

  <!--
    The picker stays mounted from the start: it reports the days it shows (range-change) as soon as it
    initialises, and that report is what loads their bookings. It renders only the day grid; the
    date-navigation toolbar is composed here from the x-h-slot-picker-* control directives (they must be
    descendants of x-h-slot-picker). The `responsive` modifier stacks the day columns into one on a
    narrow screen. No x-model is bound on purpose: a slot is an action (create a booking, or open the
    one that took it), never a selection the picker should hold.
  -->
  <div x-show="state !== 'error'" class="flex-1 min-h-0 overflow-auto">
    <div x-h-slot-picker.responsive="slotCfg" @slot-click="onSlotClick" @range-change="onRange"
         :aria-label="T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}')"
         :data-unavailable-label="T('$projectName:${tprefix}.defaults.notAvailable', 'Not available')">
      <div x-h-toolbar data-variant="transparent">
        <div x-h-button-group>
          <button x-h-button data-variant="outline" data-size="icon" x-h-slot-picker-previous
                  :aria-label="T('$projectName:${tprefix}.defaults.previous', 'Previous')">
            <svg x-h-icon data-icon="chevron-left" role="presentation"></svg>
          </button>
          <button x-h-button data-variant="outline" data-size="icon" x-h-slot-picker-calendar
                  :aria-label="T('$projectName:${tprefix}.defaults.chooseDate', 'Choose date')">
            <svg x-h-icon data-icon="calendar" role="presentation"></svg>
          </button>
          <button x-h-button data-variant="outline" data-size="icon" x-h-slot-picker-next
                  :aria-label="T('$projectName:${tprefix}.defaults.next', 'Next')">
            <svg x-h-icon data-icon="chevron-right" role="presentation"></svg>
          </button>
        </div>
        <div x-h-slot-picker-title></div>
        <button x-h-button data-variant="outline" x-h-slot-picker-today
                x-text="T('$projectName:${tprefix}.defaults.today', 'Today')"></button>
      </div>
    </div>
  </div>

</div>
