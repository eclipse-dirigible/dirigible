<!--
  Generated by Eclipse Dirigible based on model and template.
  Manage (CRUD) list fragment for ${name}. Rendered into #app on /${name}.
  Root x-data binds the generated ${name}ManageListPage.
-->
## Role-scoped field (intent `visibleTo:`): rendered only for a caller the server actually serves it
## to - the page asked the controller which fields it withholds (canSee). Emits nothing for an
## unrestricted property. The redaction applied to every response stays the authoritative one; this
## only keeps a permanently empty column off the page.
#macro(visibleGate $property)#if($property.roleRead) x-show="canSee('${property.name}')"#end#end
## The editor for one column's filter value, emitted in the Filter menu's second step and again in
## every chip's own popover - the same control either place, over the same filterDraft. $dismiss is
## what the host needs done before the value is applied: the Filter menu closes itself through
## closeFilterMenu(), while a chip owns its popover's open flag and has to drop it here too, or
## Enter would clear the editor and leave the chip's panel standing empty.
#macro(filterValueEditor $dismiss)
            <template x-if="editedFilterColumn &amp;&amp; editedFilterColumn.type === 'fk'">
              <select x-model="filterDraft" class="w-full text-sm rounded-md border border-border px-2 py-1">
                <option value="" x-text="T('$projectName:${tprefix}.defaults.all', 'All')"></option>
                <template x-for="opt in optionsForFilter(editedFilterColumn.name)" :key="opt.value">
                  <option :value="opt.value" x-text="opt.text"></option>
                </template>
              </select>
            </template>
            <!-- A date column filters through the same Harmonia picker the forms use, configured from
                 the instance Date pattern, so the shape it shows and accepts is the one the cells
                 print. A native <input type="date"> renders in the BROWSER's locale instead, which is
                 how one screen could offer dd.mm.yyyy while the form beside it read the same digits as
                 m/d/yyyy. The model stays the ISO the search expects. -->
            <template x-if="editedFilterColumn &amp;&amp; editedFilterColumn.type === 'date'">
              <div x-h-date-picker>
                <input type="text" :placeholder="HarmoniaFormat.dateHint()" />
                <button x-h-date-picker-trigger :aria-label="T('$projectName:${tprefix}.defaults.chooseDate', 'Choose date')"></button>
                <div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="filterDraft"></div>
              </div>
            </template>
            <template x-if="editedFilterColumn &amp;&amp; editedFilterColumn.type !== 'fk' &amp;&amp; editedFilterColumn.type !== 'date'">
              <input x-h-input type="text" class="w-full" x-model="filterDraft" @keydown.enter="${dismiss}applyFilterDraft()"
                     :placeholder="T('$projectName:${tprefix}.defaults.filter', 'Filter')" />
            </template>
#end
<div x-data="${name}ManageListPage" class="vbox size-full gap-4 p-4" @keydown.escape.window="if (selected &amp;&amp; !deleteOpen) closeDetails()">

  <!-- One action row: what you came to do (New) stays visible beside the search and the Filter
       menu, and every discretionary action collapses into the overflow menu. A plain hbox rather
       than x-h-toolbar - the reference list page frames nothing here, the page's own gutter does it.
       The page carries no title of its own either; the shell's breadcrumb names it. -->
  <div class="hbox flex-wrap items-center gap-2">
    <div x-h-input-group class="max-w-sm">
      <input x-h-input.group type="text" :placeholder="T('$projectName:${tprefix}.messages.inputSearch', 'Search ${menuLabel}...', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"
             x-model="searchTerm" @input="onSearchChange()" />
      <div x-h-input-group-addon data-align="inline-start">
        <svg x-h-icon data-icon="search" class="size-4" role="img" aria-label="search"></svg>
      </div>
      <div x-h-input-group-addon data-align="inline-end" x-show="searchTerm" x-cloak>
        <button x-h-button.addon data-variant="transparent" data-size="icon-sm" @click="clearSearch()"
                :aria-label="T('$projectName:${tprefix}.defaults.clearSearch', 'Clear search')">
          <svg role="presentation" x-h-lucide data-lucide="x" class="size-4"></svg>
        </button>
      </div>
    </div>

    <!-- The per-column filters live in this menu rather than in a row inside the table: step one
         lists the columns, step two edits the one picked, and Apply writes it into columnFilters and
         runs the single query that implies. The conditions themselves (LIKE on a string, EQ on a
         number, FK or date - see buildConditions) are unchanged. overflow-visible lets the date
         picker's popup overhang the panel, which Harmonia's no-scroll body would otherwise clip. -->
    <div class="relative inline-flex">
      <button x-h-button data-variant="outline" x-h-popover-trigger.chevron="filterOpen" :data-toggled="filterOpen">
        <svg role="presentation" x-h-lucide data-lucide="list-filter"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.filter', 'Filter')"></span>
        <svg role="presentation" x-h-lucide data-lucide="chevron-down"></svg>
      </button>
      <div x-h-popover.no-scroll data-align="bottom-start" data-innerclicks="true" class="overflow-visible" style="min-width: 18rem">

        <!-- Step one: which column to filter by. A column already filtered shows its value, so the
             same entry is how that filter is changed. -->
        <div class="vbox p-1" x-show="!filterEditing">
          <span x-h-text.muted class="px-2 pt-1 pb-2 text-sm" x-text="T('$projectName:${tprefix}.defaults.addFilter', 'Add filter')"></span>
          <template x-for="col in availableFilters" :key="col.name">
            <button x-h-button data-variant="transparent" class="h-auto justify-start py-2" @click="openFilterEditor(col.name)">
              <span class="vbox min-w-0 flex-1 items-start">
                <span class="truncate" x-text="filterLabel(col)"></span>
                <span class="truncate text-xs text-muted-foreground" x-show="columnFilters[col.name]" x-text="filterValueText(col)"></span>
              </span>
            </button>
          </template>
        </div>

        <!-- Step two: the value. The controls are the ones the table's filter row carried. -->
        <div class="vbox" x-show="filterEditing" x-cloak>
          <div x-h-toolbar data-variant="transparent" data-size="sm">
            <button x-h-button data-variant="transparent" data-size="icon-sm" @click="backToFilterMenu()"
                    :aria-label="T('$projectName:${tprefix}.defaults.back', 'Back')">
              <svg role="presentation" x-h-lucide data-lucide="chevron-left"></svg>
            </button>
            <span x-h-toolbar-title class="truncate" x-text="editedFilterColumn ? filterLabel(editedFilterColumn) : ''"></span>
          </div>
          <div class="p-3">
#filterValueEditor("")
          </div>
          <div x-h-toolbar.footer data-size="sm">
            <div x-h-toolbar-spacer></div>
            <button x-h-button data-variant="outline" data-size="sm" @click="closeFilterMenu()"
                    x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
            <button x-h-button data-variant="primary" data-size="sm" @click="applyFilterDraft()"
                    x-text="T('$projectName:${tprefix}.defaults.apply', 'Apply')"></button>
          </div>
        </div>
      </div>
    </div>

    <!-- A filter query is in flight: the table keeps the previous rows (see displayState), this
         spinner just signals the refresh so the empty state is never shown mid-query (#7461). -->
    <span x-show="filtering" x-h-spinner aria-hidden="true"></span>
    <div class="flex-1"></div>

    <button x-h-button data-variant="primary" @click="newEntity()">
      <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.new', 'New')"></span>
    </button>

    <!-- Everything discretionary: the exports, the other views of the same records, and whatever the
         customActions extension point contributes to this page. -->
    <button x-h-button data-variant="outline" data-size="icon" x-h-menu-trigger.dropdown
            :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')">
      <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
    </button>
    <ul x-h-menu data-align="bottom-end">
#if($calendarView)
      <!-- The entity also renders on a calendar (intent `view: calendar|range`), which owns /${name};
           this browse page lives at /${name}/list. -->
      <li x-h-menu-item @click="goCalendar()">
        <svg role="presentation" x-h-lucide data-lucide="calendar"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.calendar', 'Calendar')"></span>
      </li>
#end
#if($slotsView)
      <!-- The entity also renders as a slot picker (intent `view: slots`), which owns /${name};
           this browse page lives at /${name}/list. -->
      <li x-h-menu-item @click="goSlots()">
        <svg role="presentation" x-h-lucide data-lucide="clock"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.slots', 'Slots')"></span>
      </li>
#end
      <!-- Export the filtered rows as CSV / print them (Save as PDF via the browser dialog). -->
      <li x-h-menu-item :aria-disabled="sortedItems.length === 0" @click="exportCsv()">
        <svg role="presentation" x-h-lucide data-lucide="download"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.export', 'Export')"></span>
      </li>
      <li x-h-menu-item :aria-disabled="sortedItems.length === 0" @click="printList()">
        <svg role="presentation" x-h-lucide data-lucide="printer"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></span>
      </li>
      <!-- Developer-contributed page actions for this view (customActions extension point). -->
      <template x-for="action in $store.customActions.getActions(caView, 'page')" :key="action.id">
        <li x-h-menu-item @click="$store.customActions.trigger(action)"
            x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
      </template>
    </ul>
  </div>

  <!-- The filters in force. A chip names its column and prints its value the way the table prints
       that column; its x drops that one filter and re-queries. -->
  <div class="hbox items-center gap-2 flex-wrap" x-show="hasActiveColumnFilters" x-cloak>
    <span class="text-xs font-medium text-muted-foreground" x-text="T('$projectName:${tprefix}.defaults.activeFilters', 'Active filters')"></span>
    <template x-for="chip in activeFilterChips" :key="chip.name">
      <!-- A chip is the filter it names, so it edits it: its body opens the same editor the Filter
           menu's second step shows. The shape is the documented one - trigger, close, then the
           popover, all inside the chip, which is what x-h-popover resolves against (it walks
           previousElementSibling for the trigger and throws when it finds none, and an uncaught
           directive throw aborts Alpine's walk over everything below it).
           The trigger carries BOTH a bound state and an @click, which is how Harmonia hands over
           full manual control (auto: !(expression && ownClick)) - so this toggles `open` itself and
           restores the outside-click dismissal that goes with the automatic mode. -->
      <!-- relative z-20: x-h-chip carries transform-gpu, which makes it a stacking context, so the
           popover inside it cannot escape however high its own z-index is - and the scrolling table
           below gives its sticky thead z-2, which would then paint over the open panel. Lifting the
           CHIP above that row lifts the popover with it. -->
      <div x-h-chip data-variant="information" class="relative z-20" x-data="{ open: false }" @click.outside="open = false">
        <button x-h-chip-button x-h-popover-trigger="open" @click="open = !open; open &amp;&amp; openFilterEditor(chip.name)">
          <span class="text-muted-foreground" x-text="chip.label + ':'"></span>
          <span class="truncate" style="max-width: 14rem" x-text="chip.text"></span>
        </button>
        <button x-h-chip-close :aria-label="T('$projectName:${tprefix}.defaults.removeFilter', 'Remove {{name}} filter', { name: chip.label })"
                @click="removeFilter(chip.name)"></button>
        <div x-h-popover.no-scroll data-align="bottom-start" data-innerclicks="true" class="overflow-visible" style="min-width: 18rem">
          <div class="p-3">
#filterValueEditor("open = false; ")
          </div>
          <div x-h-toolbar.footer data-size="sm">
            <button x-h-button data-variant="transparent" data-size="sm" @click="open = false; removeFilter(chip.name)"
                    x-text="T('$projectName:${tprefix}.defaults.remove', 'Remove')"></button>
            <div x-h-toolbar-spacer></div>
            <button x-h-button data-variant="outline" data-size="sm" @click="open = false; backToFilterMenu()"
                    x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
            <button x-h-button data-variant="primary" data-size="sm" @click="open = false; applyFilterDraft()"
                    x-text="T('$projectName:${tprefix}.defaults.apply', 'Apply')"></button>
          </div>
        </div>
      </div>
    </template>
    <button x-h-button data-variant="transparent" data-size="sm" @click="clearColumnFilters()"
            x-text="T('$projectName:${tprefix}.defaults.clearFilters', 'Clear filters')"></button>
  </div>

  <!-- Loading -->
  <div x-show="displayState === 'loading'"><div x-h-spinner></div></div>

  <!-- Error -->
  <div x-show="displayState === 'error'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.error.loading', 'Could not load')"></div>
      <div x-h-info-page-description x-text="error"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="load()" x-text="T('$projectName:${tprefix}.defaults.retry', 'Retry')"></button>
    </div>
  </div>

  <!-- Empty -->
  <div x-show="displayState === 'empty'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="inbox"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.noDataYet', 'No ${menuLabel} yet', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></div>
      <div x-h-info-page-description x-text="T('$projectName:${tprefix}.messages.getStarted', 'Get started by creating the first record.')"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="newEntity()" x-text="T('$projectName:${tprefix}.defaults.formHeadCreate', 'New ${entityLabel}', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></button>
    </div>
  </div>

  <!-- Data: master-detail — the table shows only the major columns; selecting a row reveals the
       record's full property list (and its actionable process tasks) in the right-hand pane. -->
  <div x-show="displayState === 'default' || displayState === 'no-results'" class="vbox min-w-0 gap-4">
#if($hierarchyProperty)
        <!-- Hierarchy (intent `hierarchy:`): the records render as a Harmonia tree off
             ${hierarchyProperty} when no search/filter is active; searching falls back to the flat
             table so matches outside collapsed branches stay findable. Markup recursion is a fixed
             6 levels deep - deeper nodes are not rendered. (Harmonia's x-h-template can render a
             tree of any depth from data; folding these six copies into one is a worthwhile
             follow-up, but it is a behaviour change and not part of the 2.9 API migration.) -->
        <div x-show="treeVisible" x-h-table-container.scroll class="flex-1" data-border="true">
          <ul x-h-tree class="p-2" :aria-label="T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}')">
              <template x-for="n1 in childrenOf(null)" :key="n1.${primaryKeysString}">
                <li x-h-tree-item="true" :aria-selected="isSelected(n1)" @tree-item-click.self="selectRow(n1)">
                  <div x-h-tree-row>
                    <svg x-h-lucide role="presentation" :data-lucide="hasChildren(n1) ? 'folder' : 'file-text'"></svg>
                    <span x-h-tree-label x-text="nodeLabel(n1)"></span>
                  </div>
                  <template x-if="hasChildren(n1)">
                    <ul x-h-tree.sub data-line="true">
                      <template x-for="n2 in childrenOf(n1)" :key="n2.${primaryKeysString}">
                <li x-h-tree-item="true" :aria-selected="isSelected(n2)" @tree-item-click.self="selectRow(n2)">
                  <div x-h-tree-row>
                    <svg x-h-lucide role="presentation" :data-lucide="hasChildren(n2) ? 'folder' : 'file-text'"></svg>
                    <span x-h-tree-label x-text="nodeLabel(n2)"></span>
                  </div>
                  <template x-if="hasChildren(n2)">
                    <ul x-h-tree.sub data-line="true">
                      <template x-for="n3 in childrenOf(n2)" :key="n3.${primaryKeysString}">
                <li x-h-tree-item="true" :aria-selected="isSelected(n3)" @tree-item-click.self="selectRow(n3)">
                  <div x-h-tree-row>
                    <svg x-h-lucide role="presentation" :data-lucide="hasChildren(n3) ? 'folder' : 'file-text'"></svg>
                    <span x-h-tree-label x-text="nodeLabel(n3)"></span>
                  </div>
                  <template x-if="hasChildren(n3)">
                    <ul x-h-tree.sub data-line="true">
                      <template x-for="n4 in childrenOf(n3)" :key="n4.${primaryKeysString}">
                <li x-h-tree-item="true" :aria-selected="isSelected(n4)" @tree-item-click.self="selectRow(n4)">
                  <div x-h-tree-row>
                    <svg x-h-lucide role="presentation" :data-lucide="hasChildren(n4) ? 'folder' : 'file-text'"></svg>
                    <span x-h-tree-label x-text="nodeLabel(n4)"></span>
                  </div>
                  <template x-if="hasChildren(n4)">
                    <ul x-h-tree.sub data-line="true">
                      <template x-for="n5 in childrenOf(n4)" :key="n5.${primaryKeysString}">
                <li x-h-tree-item="true" :aria-selected="isSelected(n5)" @tree-item-click.self="selectRow(n5)">
                  <div x-h-tree-row>
                    <svg x-h-lucide role="presentation" :data-lucide="hasChildren(n5) ? 'folder' : 'file-text'"></svg>
                    <span x-h-tree-label x-text="nodeLabel(n5)"></span>
                  </div>
                  <template x-if="hasChildren(n5)">
                    <ul x-h-tree.sub data-line="true">
                      <template x-for="n6 in childrenOf(n5)" :key="n6.${primaryKeysString}">
                <li x-h-tree-item="true" :aria-selected="isSelected(n6)" @tree-item-click.self="selectRow(n6)">
                  <div x-h-tree-row>
                    <svg x-h-lucide role="presentation" :data-lucide="hasChildren(n6) ? 'folder' : 'file-text'"></svg>
                    <span x-h-tree-label x-text="nodeLabel(n6)"></span>
                  </div>
                  <template x-if="hasChildren(n6)">
                    <ul x-h-tree.sub data-line="true">
                      <!-- depth limit: 6 levels (see the page comment) -->
                    </ul>
                  </template>
                </li>
              </template>
                    </ul>
                  </template>
                </li>
              </template>
                    </ul>
                  </template>
                </li>
              </template>
                    </ul>
                  </template>
                </li>
              </template>
                    </ul>
                  </template>
                </li>
              </template>
                    </ul>
                  </template>
                </li>
              </template>
          </ul>
        </div>
#end
        <!-- A search or filter that matches nothing: the table's own header would say it in one cell,
             which reads as a broken row rather than an answer. -->
        <div x-show="displayState === 'no-results'" x-h-info-page>
          <div x-h-info-page-header>
            <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="search-x"></svg></div>
            <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.noMatch', 'No matching ${menuLabel}', { name: T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}') })"></div>
            <div x-h-info-page-description x-text="T('$projectName:${tprefix}.messages.noMatchHint', 'Try adjusting your search or filter.')"></div>
          </div>
          <div x-h-info-page-content>
            <button x-h-button data-variant="outline" @click="clearSearch(); clearColumnFilters()"
                    x-text="T('$projectName:${tprefix}.defaults.clearFilters', 'Clear filters')"></button>
          </div>
        </div>

        <div x-show="displayState !== 'no-results'#if($hierarchyProperty) &amp;&amp; !treeVisible#end" x-h-table-container data-border="true">
          <table x-h-table data-borders="rows">
            <thead x-h-table-header>
              <tr x-h-table-row>
#foreach($property in $properties)
#if(!$property.dataAutoIncrement && $property.widgetIsMajor)
                <th x-h-table-head scope="col"#if($property.isNumberType && $property.widgetType != "DROPDOWN" && $property.widgetType != "DOCUMENT_STATUS") class="text-right"#end#visibleGate($property) :aria-sort="ariaSort('${property.name}')">
                  <button class="hbox #if($property.isNumberType && $property.widgetType != "DROPDOWN" && $property.widgetType != "DOCUMENT_STATUS")w-full justify-end #{end}cursor-pointer items-center gap-1" @click="cycleSort('${property.name}')">
                    <span x-text="T('$projectName:${tprefix}.t.${property.dataName}', '${property.name}')"></span>
                    <svg x-h-lucide role="presentation" class="size-4"
                         :data-lucide="isSortedAsc('${property.name}') ? 'arrow-up' : (isSortedDesc('${property.name}') ? 'arrow-down' : 'chevrons-up-down')"></svg>
                  </button>
                </th>
#end
#end
                <th x-h-table-head scope="col" class="w-12"><span class="sr-only" x-text="T('$projectName:${tprefix}.aria.tableRowMenu', 'Table Row Menu')"></span></th>
              </tr>
            </thead>
            <tbody x-h-table-body>
              <template x-for="row in paginatedItems" :key="row.${primaryKeysString}">
                <tr x-h-table-row data-hoverable="true" :data-state="isSelected(row) ? 'selected' : ''" @click="selectRow(row)" style="cursor:pointer;">
#foreach($property in $properties)
#if(!$property.dataAutoIncrement && $property.widgetIsMajor)
#if($property.widgetType == "DOCUMENT_STATUS")
                  <!-- EntityStatus column: the resolved status name as a coloured badge pill. -->
                  <td x-h-table-cell#visibleGate($property)><span x-h-badge :data-variant="statusVariant(lookupText('${property.name}', row.${property.name}))" x-show="lookupText('${property.name}', row.${property.name})" x-text="lookupText('${property.name}', row.${property.name})"></span></td>
#elseif($property.widgetType == "DROPDOWN")
                  <td x-h-table-cell#visibleGate($property) x-text="lookupText('${property.name}', row.${property.name})"></td>
#elseif($property.widgetType == "MULTISELECT")
                  <td x-h-table-cell#visibleGate($property) x-text="multiLookupText('${property.name}', row.${property.name})"></td>
#elseif($property.isDateType)
                  <td x-h-table-cell#visibleGate($property) x-text="displayValue(row.${property.name}, true)"></td>
#elseif($property.isFloatType)
                  <td x-h-table-cell class="text-right"#visibleGate($property) x-text="formatNumber(row.${property.name}, '${property.formatPattern}')"></td>
#elseif($property.isNumberType)
                  <td x-h-table-cell class="text-right"#visibleGate($property) x-text="displayValue(row.${property.name})"></td>
#else
                  <td x-h-table-cell#visibleGate($property) x-text="displayValue(row.${property.name})"></td>
#end
#end
#end
                  <td x-h-table-cell data-row-actions class="text-right" @click.stop>
                    <button x-h-menu-trigger.dropdown x-h-table-cell-button aria-label="Row actions">
                      <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
                    </button>
                    <ul x-h-menu data-align="bottom-end">
                      <li x-h-menu-item @click="previewEntity(row)" x-text="T('$projectName:${tprefix}.defaults.preview', 'Preview')"></li>
#if($immutableStatusProperty || $immutableAlways)
                      <!-- Edit/Delete are hidden for an immutable record (the controller would 409);
                           Preview stays - the record remains readable. -->
                      <li x-h-menu-item x-show="!isRowImmutable(row)" @click="editEntity(row)" x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></li>
                      <li x-h-menu-separator x-show="!isRowImmutable(row)"></li>
                      <li x-h-menu-item x-show="!isRowImmutable(row)" data-variant="negative" @click="askDelete(row)" x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></li>
#else
                      <li x-h-menu-item @click="editEntity(row)" x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></li>
                      <li x-h-menu-separator></li>
                      <li x-h-menu-item data-variant="negative" @click="askDelete(row)" x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></li>
#end
                    </ul>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>

## Pager: first / last / the current page's neighbours with an ellipsis over each gap (pageWindow).
## A hierarchical entity hides it while the (unpaged) tree is showing - one x-show, both conditions.
        <div class="hbox items-center justify-between gap-2" x-show="#if($hierarchyProperty)!treeVisible &amp;&amp; #{end}sortedItems.length > 0">
          <span class="text-sm text-muted-foreground" x-text="showingRange()"></span>
        <nav x-h-pagination class="w-fit!" x-show="totalPages > 1">
          <ul x-h-pagination-content>
            <li x-h-pagination-item>
              <a x-h-pagination-link.previous href="#" :aria-label="T('$projectName:${tprefix}.defaults.previous', 'Previous')" :aria-disabled="currentPage <= 1" :tabindex="currentPage <= 1 ? -1 : 0" @click.prevent="if (currentPage > 1) goPage(currentPage - 1)">
                <svg x-h-lucide role="presentation" data-lucide="chevron-left"></svg>
                <span x-h-pagination-link-label x-text="T('$projectName:${tprefix}.defaults.previous', 'Previous')"></span>
              </a>
            </li>
            <template x-for="(p, i) in pageWindow()" :key="i">
              <li x-h-pagination-item>
                <template x-if="p === '...'"><span x-h-pagination-ellipsis></span></template>
                <template x-if="p !== '...'"><a x-h-pagination-link="currentPage === p" href="#" @click.prevent="goPage(p)" x-text="p"></a></template>
              </li>
            </template>
            <li x-h-pagination-item>
              <a x-h-pagination-link.next href="#" :aria-label="T('$projectName:${tprefix}.defaults.next', 'Next')" :aria-disabled="currentPage >= totalPages" :tabindex="currentPage >= totalPages ? -1 : 0" @click.prevent="if (currentPage < totalPages) goPage(currentPage + 1)">
                <span x-h-pagination-link-label x-text="T('$projectName:${tprefix}.defaults.next', 'Next')"></span>
                <svg x-h-lucide role="presentation" data-lucide="chevron-right"></svg>
              </a>
            </li>
          </ul>
        </nav>
        </div>
  </div>

  <!-- The selected record's full property list + its actionable process tasks, in a sheet over the
       list rather than a panel beside it, so the table keeps the full width it is read in. The
       overlay owns detailsOpen two-way: dismissing it by the scrim goes through the same
       closeDetails() the Close button calls (see the watcher in the page component). -->
  <div x-h-sheet-overlay="detailsOpen">
    <div x-h-sheet data-align="right" style="width: min(38rem, 100vw)">
      <div class="vbox size-full overflow-auto">
        <div x-h-toolbar data-variant="transparent" data-size="sm">
          <span x-h-toolbar-title class="shrink-0" x-text="T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') + ' #' + selectedId"></span>
          <div x-h-toolbar-spacer></div>
#if($scopedCalendars)
          <!-- Scoped calendars (intent `calendar.scope`): an entity whose calendar filters its events
               to the selected record. The filter is a query parameter on the calendar's own route,
               so without a button here the URL is knowledge the user has to type. -->
#foreach($scopedCalendar in $scopedCalendars)
          <button x-h-button data-variant="outline" data-size="sm" @click="openScopedCalendar('${scopedCalendar.entity}', '${scopedCalendar.scopeProperty}', selectedId)"><svg role="presentation" x-h-lucide data-lucide="calendar-days"></svg><span x-text="T('$projectName:${tprefix}.t.${scopedCalendar.dataName}_plural', '${scopedCalendar.label}')"></span></button>
#end
#end
          <button x-h-button data-variant="outline" data-size="sm" @click="previewEntity(selected)"><svg role="presentation" x-h-lucide data-lucide="eye"></svg><span x-text="T('$projectName:${tprefix}.defaults.preview', 'Preview')"></span></button>
#if($immutableStatusProperty || $immutableAlways)
          <!-- Edit/Delete are disabled for an immutable record (the controller would 409). -->
          <button x-h-button data-variant="outline" data-size="sm" :disabled="isRowImmutable(selected)" :title="isRowImmutable(selected) ? T('$projectName:${tprefix}.messages.immutable', 'This record is read-only in its current status - corrections go through the workflow.') : null" @click="editEntity(selected)"><svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span></button>
          <button x-h-button data-variant="transparent" data-size="sm" :disabled="isRowImmutable(selected)" @click="askDelete(selected)" aria-label="Delete"><svg role="presentation" x-h-lucide data-lucide="trash-2"></svg></button>
#else
          <button x-h-button data-variant="outline" data-size="sm" @click="editEntity(selected)"><svg role="presentation" x-h-lucide data-lucide="pencil"></svg><span x-text="T('$projectName:${tprefix}.defaults.edit', 'Edit')"></span></button>
          <button x-h-button data-variant="transparent" data-size="sm" @click="askDelete(selected)" aria-label="Delete"><svg role="presentation" x-h-lucide data-lucide="trash-2"></svg></button>
#end
          <!-- Close the detail panel: returns to the full-width list and clears the selection (Esc
               does the same). Without it the panel could not be dismissed once opened (issue #7463). -->
          <button x-h-button data-variant="transparent" data-size="sm" @click="closeDetails()" :aria-label="T('$projectName:${tprefix}.defaults.close', 'Close')" :title="T('$projectName:${tprefix}.defaults.close', 'Close')"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
        </div>

#if($hasProcess)
        <!-- Actionable user tasks for this record, one button each (claimed on open). -->
        <div x-show="$store.processTasks.getTasks(selected).length" class="hbox gap-2 flex-wrap px-4 pt-4 pb-2">
          <template x-for="task in $store.processTasks.getTasks(selected)" :key="task.id">
            <button x-h-button data-variant="primary" data-size="sm" @click="$store.processTasks.openTask(task)">
              <svg role="presentation" x-h-lucide data-lucide="inbox"></svg><span x-text="$store.processTasks.taskName(task)"></span>
            </button>
          </template>
        </div>
#end

        <!-- Developer-contributed per-record actions for this entity (customActions extension point).
             Passes the selected record's id to the action page. The selected ROW also goes to
             getActions, so an action its current status can never accept - a transition outside its
             `from:`, a create-from outside its `fromStatus:` - is not offered at all (#7073, #7068). -->
        <div x-show="$store.customActions.getActions(caView, 'entity', selected).length" class="hbox gap-2 flex-wrap px-4 pt-4 pb-2">
          <template x-for="action in $store.customActions.getActions(caView, 'entity', selected)" :key="action.id">
            <button x-h-button data-variant="outline" data-size="sm" @click="$store.customActions.trigger(action, selectedId)">
              <span x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></span>
            </button>
          </template>
        </div>

        <!-- Every property of the selected record (the table above shows only the major ones). A framed
             condensed two-column grid (matches the master-detail pane). -->
        <div x-h-card class="m-4">
          <div x-h-card-header><h3 x-h-card-title x-text="T('$projectName:${tprefix}.defaults.details', 'Details')"></h3></div>
          <div x-h-card-content>
            <!-- Stack the field pairs into a single column until the pane is wide enough for two
                 (lg:), and let every cell shrink and wrap its value (min-w-0 wrap-anywhere) so an
                 unbreakable value - an email, a phone number - breaks onto a new line instead of
                 overflowing its column and colliding with the neighbour (issue #7462). -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
#foreach($property in $properties)
## ProcessIds is per-process at-most-once bookkeeping (Process=instanceId pairs) - plumbing with
## nothing to say to a reader, unlike ProcessId, which names the flow the record is in.
#if(!$property.dataAutoIncrement && !$property.isHiddenProperty)
#if($property.widgetLabel)#set($plabel = $property.widgetLabelJs)#else#set($plabel = $property.name)#end
#if($property.isDateType)#set($isDate = "true")#else#set($isDate = "false")#end
          <div class="vbox min-w-0 wrap-anywhere"#visibleGate($property)>
            <span x-h-text.muted class="text-xs" x-text="T('$projectName:${tprefix}.t.${property.dataName}', '${plabel}')"></span>
#if($property.widgetType == "DOCUMENT_STATUS")
            <span><span x-h-badge :data-variant="statusVariant(lookupText('${property.name}', selected?.${property.name}))" x-show="lookupText('${property.name}', selected?.${property.name})" x-text="lookupText('${property.name}', selected?.${property.name})"></span></span>
#elseif($property.widgetType == "DROPDOWN")
            <span x-text="lookupText('${property.name}', selected?.${property.name})"></span>
#elseif($property.widgetType == "MULTISELECT")
            <span x-text="multiLookupText('${property.name}', selected?.${property.name})"></span>
#elseif($property.isFloatType)
            <span x-text="formatNumber(selected?.${property.name}, '${property.formatPattern}')"></span>
#else
            <span x-text="displayValue(selected?.${property.name}, $isDate)"></span>
#end
          </div>
#end
#end
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete confirmation -->
  <div x-h-dialog-overlay :data-open="deleteOpen">
    <div x-h-dialog>
      <div x-h-dialog-header>
        <h2 x-h-dialog-title x-text="T('$projectName:${tprefix}.defaults.deleteTitle', 'Delete ${entityLabel}', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></h2>
        <p x-h-dialog-description></p>
        <button x-h-dialog-close @click="deleteOpen = false" aria-label="Close"><svg role="presentation" x-h-lucide data-lucide="x"></svg></button>
      </div>
      <div x-h-dialog-content>
        <p x-text="T('$projectName:${tprefix}.messages.deleteConfirm', 'Are you sure you want to delete this record?', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></p>
        <div x-show="deleteError" x-h-alert data-variant="negative" role="alert" class="mt-2">
          <div x-h-alert-description x-text="deleteError"></div>
        </div>
      </div>
      <div x-h-dialog-footer>
        <button x-h-button data-variant="outline" @click="deleteOpen = false" :disabled="deleteBusy" x-text="T('$projectName:${tprefix}.defaults.cancel', 'Cancel')"></button>
        <button x-h-button data-variant="negative" @click="confirmDelete()" :disabled="deleteBusy">
          <span x-show="deleteBusy" x-h-spinner></span>
          <span x-text="T('$projectName:${tprefix}.defaults.delete', 'Delete')"></span>
        </button>
      </div>
    </div>
  </div>

</div>
