## Native Harmonia chart directive for this report's layout type (a generation-time constant).
#if($layoutType == "REPORT_LINE")#set($chartDirective = "x-h-chart-line")#elseif($layoutType == "REPORT_PIE")#set($chartDirective = "x-h-chart-pie")#elseif($layoutType == "REPORT_DOUGHNUT")#set($chartDirective = "x-h-chart-doughnut")#elseif($layoutType == "REPORT_POLARAREA")#set($chartDirective = "x-h-chart-polar-area")#elseif($layoutType == "REPORT_RADAR")#set($chartDirective = "x-h-chart-radar")#else#set($chartDirective = "x-h-chart-bar")#end
<!-- Generated by Eclipse Dirigible. Report chart view for ${name} (native Harmonia chart). -->
<div x-data="${name}ReportPage" class="vbox size-full gap-4 p-4">
  <!-- One action row, the manage list's (#7491): no title (the shell's breadcrumb names the report),
       the Inbox's Refresh with its Updated stamp (#8130), and Print in a More actions menu. -->
  <div class="hbox flex-wrap items-center gap-2">
    <!-- A re-read is in flight: the chart on screen stays (see load(quiet)), this only signals it. -->
    <span x-show="reloading" x-h-spinner aria-hidden="true"></span>
    <div class="flex-1"></div>
    <span x-show="lastUpdated" x-h-text.muted x-text="T('application-core:shell.inbox.updated', 'Updated {{time}}', { time: updatedTime() })"></span>
    <button x-h-button data-variant="outline" @click="refresh()">
      <svg role="presentation" x-h-lucide data-lucide="refresh-cw"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.refresh', 'Refresh')"></span>
    </button>
    <button x-h-button data-variant="outline" data-size="icon" x-h-menu-trigger.dropdown
            :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')">
      <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
    </button>
    <ul x-h-menu data-align="bottom-end">
      <li x-h-menu-item :aria-disabled="state !== 'default'" @click="printChart()">
        <svg role="presentation" x-h-lucide data-lucide="printer"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></span>
      </li>
    </ul>
  </div>
  <div x-show="state === 'loading'"><div x-h-spinner></div></div>
  <div x-show="state === 'error'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.error.loading', 'Could not load')"></div>
      <div x-h-info-page-description x-text="error"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="load()" x-text="T('$projectName:${tprefix}.defaults.retry', 'Retry')"></button>
    </div>
  </div>
  <div x-show="state === 'empty'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="inbox"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.noDataTitle', 'No data')"></div>
      <div x-h-info-page-description x-text="T('$projectName:${tprefix}.messages.reportNoRows', 'The ${name} report returned no rows.', { name: '${name}' })"></div>
    </div>
  </div>
  <!-- The chart, named for assistive technology by its report (Harmonia exposes it as a figure with a
       visually hidden table of its values). -->
  <div x-show="state === 'default'" class="flex-1" style="min-height: 20rem;">
    <div x-ref="chartEl" ${chartDirective}="chartConfig" class="size-full" aria-label="${name}"></div>
  </div>
</div>
