#set($railReadOnly = false)
#foreach($property in $properties)
#if($property.isReadOnlyProperty == "true" && !$property.sensitiveProperty && $property.name != "ProcessId" && !$property.isHiddenProperty && (!$property.auditType || $property.auditType == "NONE"))#set($railReadOnly = true)#end
