    // A rejected save that NAMES one of this form's properties ("The 'Name' property is required")
    // marks that one control (fieldError -> aria-invalid) and repeats the server's own reason;
    // anything else - a fault, a refusal naming nothing this form owns - keeps the generic banner.
    // Mirrors baseFormPage.applyApiError / the line dialog's applyItemError (#7062/#7152); never the
    // developer-facing e.message.
    applyApiError(e, fallback) {
      const named = App.services.apiErrors.namedProperty(e, Object.keys(this.form));
      if (named) {
        this.fieldError = named;
        this.error = App.services.apiErrors.messageWithLabels(e, {});
        return;
      }
      this.fieldError = null;
      this.error = App.services.apiErrors.refusalMessageFor(e, fallback);
    },

    async save() {
      this.saving = true;
      this.error = null;
      this.fieldError = null;
      try {
        let created = null;
        if (this.mode === 'edit') {
          await App.services.api.put(this.apiPath + '/' + this.id, this.toPayload());
        } else {
          created = await App.services.api.post(this.apiPath, this.toPayload());
        }
        // The write landed, so there is nothing left to protect - clear the guard before the page
        // navigates itself, or it would veto its own route change (issue #7359).
        this.clearPristine();
        // A new record lands on its own preview, as an edited one returns to it (goBack, in edit mode).
        const pk = created && (created.Id != null ? created.Id : created.id);
        if (pk != null) {
          this.id = pk;
          this.navigate(this.previewRoute());
          return;
        }
        this.goBack();
      } catch (e) {
        this.applyApiError(e, 'Could not save.');
      } finally {
        this.saving = false;
      }
    },

    async confirmDelete() {
      this.deleteBusy = true;
      try {
        await App.services.api.delete(this.apiPath + '/' + this.id);
        this.deleteOpen = false;
        this.clearPristine();
        this.goBack();
      } catch (e) {
        this.error = App.services.apiErrors.refusalMessageFor(e, 'Could not delete.');
        this.deleteOpen = false;
      } finally {
        this.deleteBusy = false;
      }
    },

    // A form with unsaved edits asks before it is abandoned (issue #7359); a clean one leaves
    // silently, as before. Close, Cancel / Discard and a successful save all come through here: an
    // edit of a stored record returns to its preview, a preview or a new record leaves the page.
    goBack() { this.guardExit(() => (this.mode === 'edit' ? this.navigate(this.previewRoute()) : this.leavePage())); },

    // The record's own preview, returnTo carried over: where an edit of a stored record ends - saved or
    // discarded - rather than the list it was opened from.
    previewRoute() {
      const ret = this.queryParam('returnTo');
      return '/my/${name}/' + encodeURIComponent(this.id) + '/preview' + (ret ? '?returnTo=' + encodeURIComponent(ret) : '');
    },

    leavePage() {
      const returnTo = this.queryParam('returnTo');
      if (returnTo) { this.navigate(returnTo); return; }
#if($personalParent)
      // A child returns to its parent's my-form (the panel it was opened from).
      const parent = this.form.${personalParent.fkProperty} || this.queryParam('${personalParent.fkProperty}');
      if (parent) { this.navigate('/my/${personalParent.entity}/' + parent + '/preview'); return; }
      this.navigate('/');
#else
      this.navigate('/my/${name}');
#end
    },
#if($myChildren && $myChildren.size() > 0)

    // --- children inheriting the personal scope (panels below the form) --------------------------
    children: [
#foreach($child in $myChildren)
      { name: '${child.name}', label: '${child.label}', tkey: '$projectName:${tprefix}.t.${child.dataName}_plural', fkProperty: '${child.fkProperty}',
        apiPath: '${child.apiPath}', rows: [], state: 'loading',
        calendar: #if($child.calendar){ start: '${child.calendar.start}', end: #if($child.calendar.end)'${child.calendar.end}'#{else}null#end, title: #if($child.calendar.title)'${child.calendar.title}'#{else}null#end, titleLookup: #if($child.calendar.titleLookup){ url: '${child.calendar.titleLookup.url}', key: '${child.calendar.titleLookup.key}', value: '${child.calendar.titleLookup.value}' }#{else}null#end, view: '${child.calendar.view}' }#{else}null#end,
        calCfg: { view: '#if($child.calendar)${child.calendar.view}#{else}month#end', events: [] },
        columns: [#foreach($col in $child.columns){ name: '${col.name}', label: '${col.label}', tkey: '$projectName:${tprefix}.t.${col.dataName}'#if($col.number), number: true#end#if($col.date), date: true#end }#if($foreach.hasNext), #end#end],
        // Role-scoped columns (intent `visibleTo:`): asked from the child's own scoped controller
        // on first load, so the panel drops what this caller is not served.
        restrictedFields: #if($child.restrictedFields)true#{else}false#end,
        // A see-only child (its composition edge declares personalReadOnly): the panel shows its rows
        // but never opens a create - the child's MyController refuses the write with 403.
        readOnly: #if($child.readOnly)true#{else}false#end,
        // A status-gated panel (intent `visibleWhen:`, #7502): shown once its terms hold against the
        // record this page holds (basePage.visibleWhenHolds).
        visibleWhen: #if($child.visibleWhen)${child.visibleWhen}#{else}null#end },
#end
    ],

    async loadChildren() {
      for (const child of this.children) {
        try {
          if (child.restrictedFields && !child.restrictedLoaded) {
            child.restrictedLoaded = true;
            const answer = await App.services.api.get(child.apiPath + '/restricted').catch((e) => {
              console.error('[restricted] could not read the field visibility of ' + child.apiPath, e);
              return null;
            });
            const hidden = (answer && answer.restricted) || [];
            child.columns = child.columns.filter(c => !hidden.includes(c.name));
          }
          child.rows = await App.services.api.get(child.apiPath + '?' + encodeURIComponent(child.fkProperty) + '=' + encodeURIComponent(this.id)) || [];
          if (child.calendar) {
            // a title naming a RELATION resolves to its referenced label (fail-soft: raw value stays)
            if (child.calendar.titleLookup && !child.titleMap) {
              try {
                const rows = await App.services.api.getAll(child.calendar.titleLookup.url, { baseUrl: '' });
                const m = {};
                (rows || []).forEach(r => { m[r[child.calendar.titleLookup.key]] = r[child.calendar.titleLookup.value]; });
                child.titleMap = m;
              } catch (e) { child.titleMap = {}; }
            }
            child.calCfg = { view: child.calendar.view, events: this.buildEvents(child) };
          }
          child.state = 'default';
        } catch (e) {
          child.state = 'error';
        }
      }
      this.refreshIcons && this.refreshIcons();
    },

    // Row -> event mapping, the same conventions as the shared detailPanel (Jackson java.time
    // arrays / epoch seconds / ISO strings normalize via toISO).
    buildEvents(child) {
      return (child.rows || []).map(row => {
        const start = this.toISO(row[child.calendar.start]);
        if (!start) return null;
        const ev = { id: row.Id, title: this.eventTitle(child, row), start: start, allDay: true };
        if (child.calendar.end) {
          const end = this.toISO(row[child.calendar.end]);
          if (end) ev.end = end;
        }
        return ev;
      }).filter(Boolean);
    },
    eventTitle(child, row) {
      if (child.calendar.title) {
        const v = row[child.calendar.title];
        const m = child.titleMap;
        const resolved = m ? m[v] : undefined;
        if (resolved !== undefined && resolved !== null && String(resolved) !== '') return String(resolved);
        if (v !== undefined && v !== null && String(v) !== '') return String(v);
      }
      return T(child.tkey, child.label) + ' #' + row.Id;
    },
    toISO(v) {
      if (v === undefined || v === null || v === '') return '';
      if (Array.isArray(v)) {
        const p = n => String(n).padStart(2, '0');
        const date = v[0] + '-' + p(v[1]) + '-' + p(v[2]);
        if (v.length <= 3) return date;
        return date + 'T' + p(v[3] || 0) + ':' + p(v[4] || 0) + ':' + p(v[5] || 0);
      }
      if (typeof v === 'number') {
        const ms = v < 1e12 ? v * 1000 : v;
        try { return new Date(ms).toISOString(); } catch (e) { return ''; }
      }
      return String(v);
    },
    displayChild(child, row, col) {
      const v = row[col.name];
      if (v == null || v === '') return '—';
      if (col.date) return this.toISO(v).split('T')[0];
      return String(v);
    },

    // A child opens in its own preview and comes back here, to the record it was opened from - in the
    // mode this page is in.
    returnHere() { return '/my/${name}/' + this.id + (this.isPreview ? '/preview' : '/edit'); },
    addChild(child) {
      if (child.readOnly) return;
      this.guardExit(() => this.navigate('/my/' + child.name + '/create?' + encodeURIComponent(child.fkProperty) + '='
          + encodeURIComponent(this.id) + '&returnTo=' + encodeURIComponent(this.returnHere())));
    },
    openChild(child, id) {
      this.guardExit(() => this.navigate('/my/' + child.name + '/' + id + '/preview?returnTo=' + encodeURIComponent(this.returnHere())));
    },
    onChildEventClick(child, e) {
      const id = e && e.detail && e.detail.event ? e.detail.event.id : null;
      if (id) this.openChild(child, id);
    },
    onChildDateClick(child, e) {
      if (child.readOnly) return;
      let q = '?' + encodeURIComponent(child.fkProperty) + '=' + encodeURIComponent(this.id)
            + '&returnTo=' + encodeURIComponent(this.returnHere());
      const d = e && e.detail ? e.detail.date : null;
      if (d instanceof Date && !isNaN(d.getTime())) {
        const p = n => String(n).padStart(2, '0');
        q += '&' + encodeURIComponent(child.calendar.start) + '='
           + encodeURIComponent(d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()));
      }
      this.guardExit(() => this.navigate('/my/' + child.name + '/create' + q));
    },
#end
  }));
});
