<!-- Generated by Eclipse Dirigible. Home dashboard: model-generated KPI tiles — report-attached
     KPI widgets and custom widgets — plus a preview tile per report (click -> open it embedded).
     Report tiles come from the reports store; custom widgets are baked into dashboardPage from the
     model. Two card shapes, both composed from the card's own slots: a NUMBER tile (description =
     label, title = value, action = the icon in an avatar, footer = hint) and, for everything that
     carries content of its own - a top-N table, an embedded report preview, a custom page - the
     reference's table-card shape (plain title over its description, a border-b header, flush
     content, the navigation on a "View all" button). The blocks carry no headings - every tile names
     itself, so a heading above them only repeats what the cards already say, and the reference's
     dashboard is likewise bare grids separated by the page's own gap. The KPI widgets are grouped
     by the shape they render as - scalars in one row, top-N tables in the next - because one grid
     holding both leaves holes around the wide tiles. The page carries
     no title of its own; the shell's breadcrumb names it. Reached via the Home icon ('/' and
     /dashboard). -->
<div x-data="dashboardPage" class="vbox gap-4 p-4">

  <!-- Key Indicators: report-attached KPI widgets (reports[].widget) plus custom kpi widgets
       (top-level widgets: - the number comes from the developer's REST endpoint). Clicking a report
       tile opens the full report. -->
  <section class="vbox gap-4" x-show="kpis.length > 0 || customKpis.length > 0" x-cloak>
    <!-- Scalars: one compact number tile each. -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
         x-show="customKpis.length > 0 || summaryKpis.length > 0">
      <template x-for="w in customKpis" :key="w.name">
        <div x-h-card>
          <div x-h-card-header>
            <div x-h-card-description x-text="T(w.tkey, w.label)"></div>
            <template x-if="w.value === null && !w.error"><div x-h-skeleton class="mt-1 h-8 w-1/2"></div></template>
            <div x-show="w.value !== null && !w.error" x-h-card-title class="text-2xl" x-text="customValueText(w)"></div>
            <div x-show="w.error" x-h-card-title class="text-2xl text-muted-foreground">—</div>
            <div x-h-card-action>
              <div x-h-avatar class="rounded-lg" data-variant="primary">
                <svg role="presentation" x-h-lucide :data-lucide="w.icon"></svg>
              </div>
            </div>
          </div>
          <!-- x-if, not x-show: the header pads its own bottom only while nothing but a <template>
               follows it (last-rendered:pb-6 is :not(:has(~:not(template)))), so a hidden-but-present
               spacer or footer would leave a tile with no hint sitting on its bottom edge. -->
          <template x-if="w.detail"><div class="flex-1" aria-hidden="true"></div></template>
          <template x-if="w.detail">
            <div x-h-card-footer class="pt-4 text-sm text-muted-foreground" x-text="w.detail"></div>
          </template>
        </div>
      </template>
      <template x-for="r in summaryKpis" :key="r.name">
        <div x-h-card role="button" tabindex="0" class="cursor-pointer"
             @click="openReport(r)" @keydown.enter.prevent="openReport(r)">
          <div x-h-card-header>
            <div x-h-card-description x-text="$store.reports.widgetLabel(r)"></div>
            <template x-if="!kpiState(r).loaded"><div x-h-skeleton class="mt-1 h-8 w-1/2"></div></template>
            <div x-show="kpiState(r).loaded && !kpiState(r).error" x-h-card-title class="text-2xl" x-text="kpiValueText(r)"></div>
            <div x-show="kpiState(r).error" x-h-card-title class="text-2xl text-muted-foreground">—</div>
            <div x-h-card-action>
              <div x-h-avatar class="rounded-lg" data-variant="primary">
                <svg role="presentation" x-h-lucide :data-lucide="r.widget.icon"></svg>
              </div>
            </div>
          </div>
          <template x-if="r.description"><div class="flex-1" aria-hidden="true"></div></template>
          <template x-if="r.description">
            <div x-h-card-footer class="pt-4 text-sm text-muted-foreground" x-text="r.description"></div>
          </template>
        </div>
      </template>
    </div>

    <!-- Top-N lists: a table each, spanning the card edge to edge (x-h-card-content pads itself in
         Harmonia 3, so a full-bleed table is the flush modifier, not a cancelled padding). The card
         is the reference's table-card shape verbatim (card.md, "Recent orders"): a plain title over
         its description, the navigation on a labelled "View all" button rather than on the title
         itself, and a border-b separating the header from the table that starts right below it.
         Column alignment and number formatting come from the .report's own column metadata, so a
         numeric column right-aligns here exactly as it does on the report page. -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2" x-show="listKpis.length > 0" x-cloak>
      <template x-for="r in listKpis" :key="r.name">
        <div x-h-card class="overflow-hidden">
          <div x-h-card-header class="border-b">
            <div x-h-card-title x-text="$store.reports.widgetLabel(r)"></div>
            <div x-h-card-description x-show="r.description" x-text="r.description"></div>
            <div x-h-card-action>
              <button x-h-button data-variant="outline" @click="openReport(r)"
                      :aria-label="T('application-core:shell.dashboard.viewAllOf', 'Open the {{name}} report', { name: $store.reports.widgetLabel(r) })"
                      x-text="T('application-core:shell.dashboard.viewAll', 'View all')"></button>
            </div>
          </div>
          <div x-h-card-content.flush>
            <template x-if="!kpiState(r).loaded"><div class="p-4"><div x-h-skeleton class="h-9 w-full"></div></div></template>
            <div x-show="kpiState(r).error" x-h-text.muted class="p-4">—</div>
            <div x-show="kpiState(r).loaded && !kpiState(r).error" x-h-table-container>
              <table x-h-table>
                <caption class="sr-only" x-text="$store.reports.widgetLabel(r)"></caption>
                <thead x-h-table-header>
                  <tr x-h-table-row>
                    <template x-for="c in kpiColumns(r)" :key="c.alias">
                      <th x-h-table-head scope="col" :class="kpiAlignClass(c)" x-text="c.label"></th>
                    </template>
                  </tr>
                </thead>
                <tbody x-h-table-body>
                  <template x-for="(row, i) in kpiRows(r)" :key="i">
                    <tr x-h-table-row data-hoverable="true">
                      <template x-for="c in kpiColumns(r)" :key="c.alias">
                        <td x-h-table-cell :class="kpiAlignClass(c)" x-text="kpiCellText(r, row, c)"></td>
                      </template>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </template>
    </div>
  </section>

  <!-- Custom page widgets (top-level widgets: kind page): the developer's own HTML pages, embedded
       like the report preview tiles, in the same table-card shape. No "View all" button here: the
       widget declares a URL to embed and no destination of its own, and a button that reopened the
       same page in place of the card would say nothing. -->
  <section class="vbox" x-show="customPages.length > 0" x-cloak>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <template x-for="w in customPages" :key="w.name">
        <div x-h-card class="overflow-hidden">
          <div x-h-card-header class="border-b">
            <div x-h-card-title x-text="T(w.tkey, w.label)"></div>
            <div x-h-card-description x-show="w.detail" x-text="w.detail"></div>
          </div>
          <div x-h-card-content.flush>
            <iframe :src="w.url" :title="w.label" loading="lazy"
                    style="width:100%; height:220px; border:0;"></iframe>
          </div>
        </div>
      </template>
    </div>
  </section>

  <!-- Reports without a KPI widget: a simplified preview of the report itself (first rows, no
       toolbar/pagination), embedded from the report's own generated page so the query, its
       parameters and its role gate stay in one place. The full report opens from the "View all"
       button - the title is plain text, so the one way in is the one a keyboard reaches and a
       screen reader announces; the description comes from the .report. The tile takes the shape of
       what the embedded page actually renders: a report declaring chart: draws a chart (the report
       page defaults to its chart surface), which is the reference's padded borderless card, while
       a report without one draws rows, which is the bordered full-bleed table card. -->
  <section class="vbox" x-show="reports.length > 0" x-cloak>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <template x-for="r in reports" :key="r.url">
        <div x-h-card :class="r.chart ? '' : 'overflow-hidden'">
          <div x-h-card-header :class="r.chart ? '' : 'border-b'">
            <div x-h-card-title x-text="$store.reports.displayLabel(r)"></div>
            <div x-h-card-description x-show="r.description" x-text="r.description"></div>
            <div x-h-card-action>
              <button x-h-button data-variant="outline" @click="openReport(r)"
                      :aria-label="T('application-core:shell.dashboard.viewAllOf', 'Open the {{name}} report', { name: $store.reports.displayLabel(r) })"
                      x-text="T('application-core:shell.dashboard.viewAll', 'View all')"></button>
            </div>
          </div>
          <!-- flush is a directive modifier, not a class, so the two shapes are two elements behind
               an x-if rather than one element with a bound class. A chart keeps the content padding
               (the reference's chart cards are padded and borderless); rows go edge to edge. The
               taller frame for a chart is not cosmetic: the report page sizes its chart surface in
               vh, which inside an iframe resolves against the FRAME's height, so a short frame
               squashes the chart while the same markup fills the window on the report page. -->
          <template x-if="r.chart">
            <div x-h-card-content>
              <iframe :src="r.url + '?preview=1'" title="Report preview" loading="lazy"
                      style="width:100%; height:18rem; border:0;"></iframe>
            </div>
          </template>
          <template x-if="!r.chart">
            <div x-h-card-content.flush>
              <iframe :src="r.url + '?preview=1'" title="Report preview" loading="lazy"
                      style="width:100%; height:220px; border:0;"></iframe>
            </div>
          </template>
        </div>
      </template>
    </div>
  </section>
</div>
