<!-- Generated by Eclipse Dirigible. Home dashboard: model-generated KPI tiles — report-attached
     KPI widgets and custom widgets — plus a preview tile per report (click -> open it embedded).
     Report tiles come from the reports store; custom widgets are baked into dashboardPage from the
     model. Two card shapes, both composed from the card's own slots: a NUMBER tile (description =
     label, title = value, action = the icon in an avatar, footer = hint) and, for everything that
     carries content of its own - a top-N table, an embedded report preview, a custom page - the
     reference's table-card shape (title over its description, a border-b header, flush
     content; both the title - a button inside it - and a "View all" button open the report). The
     blocks carry no headings - every tile names itself, so a heading above them only repeats what
     the cards already say. The page is two 12-column grids (at lg; one column below): the number
     tiles first, in rows of up to four that fill the row evenly, then ONE grid of content tiles
     (top-N lists, custom pages, report previews) where each tile is wide (8) or narrow (4) by what
     it shows - a many-column table or a line chart wide, a donut or a short table narrow - and the
     tiles are packed into full rows, a chart beside a chart (a line chart with its pie) and a table
     beside a table (services/dashboardLayout.js, sized in dashboardPage). The
     page carries no title of its own; the shell's breadcrumb names it. Reached via the Home icon
     ('/' and /dashboard). -->
<div x-data="dashboardPage" class="vbox gap-4 p-4">

  <!-- Key Indicators: report-attached KPI widgets (reports[].widget) plus custom kpi widgets
       (top-level widgets: - the number comes from the developer's REST endpoint). Clicking a report
       tile opens the full report. -->
  <section class="vbox" x-show="customKpis.length > 0 || summaryKpis.length > 0" x-cloak>
    <!-- Number tiles: one compact tile each; kpiSpans spreads them over rows of up to four. -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12">
      <template x-for="(w, i) in customKpis" :key="w.name">
        <div x-h-card :class="kpiSpans[i]">
          <div x-h-card-header>
            <div x-h-card-description x-text="T(w.tkey, w.label)"></div>
            <template x-if="w.value === null && !w.error"><div x-h-skeleton class="mt-1 h-8 w-1/2"></div></template>
            <div x-show="w.value !== null && !w.error" x-h-card-title class="text-2xl" x-text="customValueText(w)"></div>
            <div x-show="w.error" x-h-card-title class="text-2xl text-muted-foreground">—</div>
            <div x-h-card-action>
              <div x-h-avatar class="rounded-lg" data-variant="primary">
                <svg role="presentation" x-h-lucide :data-lucide="w.icon"></svg>
              </div>
            </div>
          </div>
          <!-- x-if, not x-show: the header pads its own bottom only while nothing but a <template>
               follows it (last-rendered:pb-6 is :not(:has(~:not(template)))), so a hidden-but-present
               spacer or footer would leave a tile with no hint sitting on its bottom edge. -->
          <template x-if="w.detail"><div class="flex-1" aria-hidden="true"></div></template>
          <template x-if="w.detail">
            <div x-h-card-footer class="pt-4 text-sm text-muted-foreground" :title="w.detail"><span class="line-clamp-1" x-text="w.detail"></span></div>
          </template>
        </div>
      </template>
      <template x-for="(r, i) in summaryKpis" :key="r.name">
        <div x-h-card role="button" tabindex="0" class="cursor-pointer" :class="kpiSpans[customKpis.length + i]"
             @click="openReport(r)" @keydown.enter.prevent="openReport(r)">
          <div x-h-card-header>
            <div x-h-card-description x-text="$store.reports.tileWidgetLabel(r)"></div>
            <template x-if="!kpiState(r).loaded"><div x-h-skeleton class="mt-1 h-8 w-1/2"></div></template>
            <div x-show="kpiState(r).loaded && !kpiState(r).error" x-h-card-title class="text-2xl" x-text="kpiValueText(r)"></div>
            <div x-show="kpiState(r).error" x-h-card-title class="text-2xl text-muted-foreground">—</div>
            <div x-h-card-action>
              <div x-h-avatar class="rounded-lg" data-variant="primary">
                <svg role="presentation" x-h-lucide :data-lucide="r.widget.icon"></svg>
              </div>
            </div>
          </div>
          <template x-if="r.description"><div class="flex-1" aria-hidden="true"></div></template>
          <template x-if="r.description">
            <div x-h-card-footer class="pt-4 text-sm text-muted-foreground" :title="r.description"><span class="line-clamp-1" x-text="r.description"></span></div>
          </template>
        </div>
      </template>
    </div>
  </section>

  <!-- Content tiles: ONE grid. contentTiles lists the top-N tables, then the custom pages, then the
       report previews, each with its span (wide or narrow, packed - see dashboardPage). Each x-for
       item is one grid cell holding the card, which fills the cell so tiles of a row are equally
       tall; an x-if per kind picks the card.
       Top-N list: a table spanning the card edge to edge (x-h-card-content pads itself in Harmonia 3,
       so a full-bleed table is the flush modifier, not a cancelled padding). The card is the
       reference's table-card shape (card.md, "Recent orders"): a title over its description, a
       labelled "View all" button, and a border-b separating the header from the table. The title
       opens the report too, through a native button inside it (a @click on the div would reach
       neither a keyboard nor a screen reader). Column alignment and number formatting come from the
       .report's own column metadata.
       Custom page (top-level widgets: kind page): the developer's own HTML page embedded in the same
       card shape; no "View all" button, the widget declares a URL to embed and no destination.
       Report preview: a simplified preview of a report without a KPI widget (first rows, no
       toolbar/pagination), embedded from the report's own generated page so the query, its
       parameters and its role gate stay in one place. A chart report is the reference's padded
       borderless card, a report without one the bordered full-bleed table card. -->
  <section class="vbox" x-show="contentTiles.length > 0" x-cloak>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
      <template x-for="p in contentTiles" :key="p.tile.key">
        <div :class="p.span" x-data="{ get r() { return p.tile.item }, get w() { return p.tile.item } }">
          <template x-if="p.tile.type === 'list'">
              <div x-h-card class="h-full overflow-hidden">
                <div x-h-card-header class="border-b">
                  <div x-h-card-title><button type="button" class="cursor-pointer text-left" @click="openReport(r)" x-text="$store.reports.tileWidgetLabel(r)"></button></div>
                  <div x-h-card-description x-show="r.description" x-text="r.description"></div>
                  <div x-h-card-action>
                    <button x-h-button data-variant="outline" @click="openReport(r)"
                            :aria-label="T('application-core:shell.dashboard.viewAllOf', 'Open the {{name}} report', { name: $store.reports.tileWidgetLabel(r) })"
                            x-text="T('application-core:shell.dashboard.viewAll', 'View all')"></button>
                  </div>
                </div>
                <div x-h-card-content.flush>
                  <template x-if="!kpiState(r).loaded"><div class="p-4"><div x-h-skeleton class="h-9 w-full"></div></div></template>
                  <div x-show="kpiState(r).error" x-h-text.muted class="p-4">—</div>
                  <div x-show="kpiState(r).loaded && !kpiState(r).error" x-h-table-container>
                    <table x-h-table>
                      <caption class="sr-only" x-text="$store.reports.tileWidgetLabel(r)"></caption>
                      <thead x-h-table-header>
                        <tr x-h-table-row>
                          <template x-for="c in kpiColumns(r)" :key="c.alias">
                            <th x-h-table-head scope="col" :class="kpiAlignClass(c)" x-text="$store.reports.widgetColumnLabel(r, c)"></th>
                          </template>
                        </tr>
                      </thead>
                      <tbody x-h-table-body>
                        <template x-for="(row, i) in kpiRows(r)" :key="i">
                          <tr x-h-table-row data-hoverable="true">
                            <!-- A report that drills (#8374): the row's first cell opens the list of the records it counts. -->
                            <template x-for="(c, ci) in kpiColumns(r)" :key="c.alias">
                              <td x-h-table-cell :class="kpiAlignClass(c)">
                                <template x-if="ci === 0 && kpiDrillLink(r, row)"><a :href="'#' + kpiDrillLink(r, row)" @click.prevent="openDrill(kpiDrillLink(r, row))" class="font-medium underline" x-text="kpiCellText(r, row, c)"></a></template>
                                <template x-if="!(ci === 0 && kpiDrillLink(r, row))"><span x-text="kpiCellText(r, row, c)"></span></template>
                              </td>
                            </template>
                          </tr>
                        </template>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
          </template>
          <template x-if="p.tile.type === 'page'">
              <div x-h-card class="h-full overflow-hidden">
                <div x-h-card-header class="border-b">
                  <div x-h-card-title x-text="T(w.tkey, w.label)"></div>
                  <div x-h-card-description x-show="w.detail" x-text="w.detail"></div>
                </div>
                <div x-h-card-content.flush>
                  <iframe :src="w.url" :title="w.label" loading="lazy"
                          style="width:100%; height:220px; border:0;"></iframe>
                </div>
              </div>
          </template>
          <template x-if="p.tile.type === 'report'">
              <div x-h-card class="h-full" :class="r.chart ? '' : 'overflow-hidden'">
                <div x-h-card-header :class="r.chart ? '' : 'border-b'">
                  <div x-h-card-title><button type="button" class="cursor-pointer text-left" @click="openReport(r)" x-text="$store.reports.tileLabel(r)"></button></div>
                  <div x-h-card-description x-show="r.description" x-text="r.description"></div>
                  <div x-h-card-action>
                    <button x-h-button data-variant="outline" @click="openReport(r)"
                            :aria-label="T('application-core:shell.dashboard.viewAllOf', 'Open the {{name}} report', { name: $store.reports.tileLabel(r) })"
                            x-text="T('application-core:shell.dashboard.viewAll', 'View all')"></button>
                  </div>
                </div>
                <!-- flush is a directive modifier, not a class, so the two shapes are two elements behind
                     an x-if rather than one element with a bound class. A chart keeps the content padding
                     (the reference's chart cards are padded and borderless); rows go edge to edge. The
                     taller frame for a chart is not cosmetic: the report page sizes its chart surface in
                     vh, which inside an iframe resolves against the FRAME's height, so a short frame
                     squashes the chart while the same markup fills the window on the report page. -->
                <template x-if="r.chart">
                  <div x-h-card-content>
                    <iframe :src="r.url + '?preview=1'" title="Report preview" loading="lazy"
                            style="width:100%; height:18rem; border:0;"></iframe>
                  </div>
                </template>
                <template x-if="!r.chart">
                  <div x-h-card-content.flush>
                    <iframe :src="r.url + '?preview=1'" title="Report preview" loading="lazy"
                            style="width:100%; height:220px; border:0;"></iframe>
                  </div>
                </template>
              </div>
          </template>
        </div>
      </template>
    </div>
  </section>
</div>
