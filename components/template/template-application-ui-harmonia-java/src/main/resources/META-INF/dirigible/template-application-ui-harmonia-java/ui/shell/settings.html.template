#set($dollar = '$')
<!-- Generated by Eclipse Dirigible. Settings section: a master-detail split - every settings item is
     a row in the list on the left, its content opens in the pane on the right (the Harmonia reference
     inbox shape). The list is grouped with x-h-list-header: the platform preferences (Region &
     Language, Display formats) first, then this module's own setting entities. The list scrolls
     inside its own panel rather than with the page, so a long nomenclature list never pushes the
     content out of view. An entity's CRUD list is fetched only when its row is picked - a module may
     declare many nomenclatures and loading them all up front would be slow. Below 1024px the two
     panels take turns: the list fills the pane until a row is picked, and the back control returns to
     it. Generated once over the whole model (no collection); reached via the single "Settings"
     sidebar entry, keeping the individual settings out of the main navigation. The page carries no
     title of its own - the shell's breadcrumb names it. -->
<div x-data="settingsPage" class="size-full">
  <div x-h-split class="size-full" data-orientation="horizontal" data-variant="border" data-key="dirigible-settings-split">

    <!-- Master: every settings item, grouped -->
    <div x-h-split-panel data-size="30%" data-min="20%" :data-hidden="isCompact && !!selected">
      <div class="vbox size-full min-w-0">
        <ul x-h-list class="flex-1 overflow-auto" :aria-label="T('application-core:shell.nav.settings', 'Settings')">

          <li x-h-list-header x-text="T('application-core:shell.settings.preferences', 'Preferences')"></li>

          <!-- Region & Language holds both presentation preferences: the platform's language flag and
               the display formats. The row is always offered - the language card inside hides itself
               when the platform configures a single language, the formats do not. -->
          <li x-h-list-item>
            <button x-h-list-item-button class="gap-3 px-4 py-3" :aria-current="selected === 'regionLanguage'"
                    @click="select('regionLanguage', null, T('application-core:shell.settings.regionLanguage', 'Region &amp; Language'))">
              <svg role="presentation" x-h-lucide data-lucide="languages"></svg>
              <span class="flex-1 truncate text-left" x-text="T('application-core:shell.settings.regionLanguage', 'Region &amp; Language')"></span>
            </button>
          </li>

#set($hasSettings = false)
#foreach($entity in $models)#if($entity.type == "SETTING")#set($hasSettings = true)#end#end
#if($hasSettings)
          <li x-h-list-header x-text="T('application-core:shell.settings.configuration', 'Configuration')"></li>
#foreach($entity in $models)
#if($entity.type == "SETTING")
          <li x-h-list-item>
            <button x-h-list-item-button class="gap-3 px-4 py-3" :aria-current="selected === '${entity.name}'"
                    @click="select('${entity.name}', './views/${entity.perspectiveName}/${entity.name}-manage-list.html', T('$projectName:${tprefix}.t.${entity.dataName}_plural', '#if($entity.menuLabel && $entity.menuLabel != '')${entity.menuLabel}#{else}${entity.name}#end'))">
              <svg role="presentation" x-h-lucide data-lucide="#if($entity.iconName && $entity.iconName != '')${entity.iconName}#{else}settings#end"></svg>
              <span class="flex-1 truncate text-left" x-text="T('$projectName:${tprefix}.t.${entity.dataName}_plural', '#if($entity.menuLabel && $entity.menuLabel != '')${entity.menuLabel}#{else}${entity.name}#end')"></span>
            </button>
          </li>
#end
#end
#end
        </ul>
      </div>
    </div>

    <!-- Detail: the selected item's content -->
    <div x-h-split-panel data-min="40%" :data-hidden="isCompact && !selected">
      <div class="vbox size-full min-w-0">

        <!-- Compact only: the list is hidden while something is selected, so the way back is here -
             and with it the name of what is open, which the hidden list would otherwise be the only
             thing saying. -->
        <div x-h-toolbar data-size="sm" data-variant="transparent" x-show="isCompact && selected" x-cloak>
          <button x-h-button data-variant="transparent" data-size="icon-sm"
                  :aria-label="T('application-core:shell.settings.backToList', 'Back to the settings list')"
                  @click="back()">
            <svg role="presentation" x-h-lucide data-lucide="arrow-left"></svg>
          </button>
          <span x-h-toolbar-title class="truncate" x-text="selectedTitle"></span>
        </div>

        <div class="hbox size-full items-center justify-center p-4" x-show="!selected" x-cloak>
          <div x-h-info-page>
            <div x-h-info-page-header>
              <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="settings"></svg></div>
              <div x-h-info-page-title x-text="T('application-core:shell.settings.selectSetting', 'Select a setting')"></div>
              <div x-h-info-page-description x-text="T('application-core:shell.settings.selectSettingHint', 'Choose a setting on the left to manage it here.')"></div>
            </div>
          </div>
        </div>

        <!-- Region & Language: the PLATFORM's single language flag (mirrors the IDE's Region &
             Language setting) and, under it, the display formats - both are how values are PRESENTED
             to this user, both apply to every application on this origin, so they share one pane.
             The offered language codes are the platform's supported set
             (DIRIGIBLE_APPLICATION_LANGUAGES, default en,bg) - never per-app. One preference drives
             both sides: the fetch client sends it as Accept-Language, so multilingual entities come
             back translated; Print prefers it too. The language card alone is hidden when the
             platform configures a single language - there is then nothing to choose. -->
        <div class="vbox flex-1 overflow-auto p-4" x-show="selected === 'regionLanguage'" x-cloak>

          <div class="vbox" x-show="languageOptions().length > 1" x-cloak>
            <h2 x-h-text.h5 x-text="T('application-core:shell.settings.regionLanguage', 'Region &amp; Language')"></h2>
            <p x-h-text.muted x-text="T('application-core:shell.settings.rlDescription', 'One preference for the whole stack: the user interface, the data and document printing all follow the selected language.')"></p>
            <div x-h-card class="mt-4 w-full overflow-hidden">
              <ul x-h-list>
                <li x-h-list-item class="gap-3 px-4 py-3">
                  <p class="flex-1 text-base font-medium" x-text="T('application-core:shell.settings.language', 'Language')"></p>
                  <div x-h-select class="flex-1" style="max-width: 14rem">
                    <input x-h-select-input x-model="language" :aria-label="T('application-core:shell.settings.language', 'Language')" />
                    <div x-h-select-content>
                      <div x-h-select-list>
                        <template x-for="opt in languageOptions()" :key="opt.value">
                          <div x-h-select-option="opt.text" :data-value="String(opt.value)"></div>
                        </template>
                      </div>
                    </div>
                  </div>
                </li>
              </ul>
            </div>
          </div>

          <!-- Display formats: instance-wide patterns for dates, timestamps and floating-point
               numbers, persisted per user in localStorage (shell format.js). The number pattern sets
               the grouping/decimal separators; each field keeps its own decimals. Apply reloads so
               every view re-formats at once. -->
          <div class="vbox" :class="languageOptions().length > 1 ? 'mt-8' : ''">
            <h2 x-h-text.h5 x-text="T('application-core:shell.settings.formats', 'Display formats')"></h2>
            <p x-h-text.muted x-text="T('application-core:shell.settings.formatsHint', 'Patterns for dates, timestamps and numbers across all applications.')"></p>
            <div x-h-card class="mt-4 w-full overflow-hidden">
              <ul x-h-list>
                <li x-h-list-item class="gap-3 px-4 py-3">
                  <p class="flex-1 text-base font-medium" x-text="T('application-core:shell.settings.dateFormat', 'Date format')"></p>
                  <input x-h-input class="flex-1" style="max-width: 14rem" x-model="${dollar}store.formats.date"
                         placeholder="yyyy-MM-dd" :aria-label="T('application-core:shell.settings.dateFormat', 'Date format')" />
                </li>
                <li x-h-list-item class="gap-3 px-4 py-3">
                  <p class="flex-1 text-base font-medium" x-text="T('application-core:shell.settings.timestampFormat', 'Timestamp format')"></p>
                  <input x-h-input class="flex-1" style="max-width: 14rem" x-model="${dollar}store.formats.dateTime"
                         placeholder="yyyy-MM-dd HH:mm:ss" :aria-label="T('application-core:shell.settings.timestampFormat', 'Timestamp format')" />
                </li>
                <li x-h-list-item class="gap-3 px-4 py-3">
                  <p class="flex-1 text-base font-medium" x-text="T('application-core:shell.settings.numberFormat', 'Number format')"></p>
                  <input x-h-input class="flex-1" style="max-width: 14rem" x-model="${dollar}store.formats.number"
                         placeholder="#[[### ### ### ##0.00]]#" :aria-label="T('application-core:shell.settings.numberFormat', 'Number format')" />
                </li>
              </ul>
              <div x-h-card-footer class="hbox justify-end gap-2 border-t pt-4">
                <button x-h-button data-variant="outline" @click="${dollar}store.formats.reset()"
                        x-text="T('application-core:shell.settings.resetDefaults', 'Reset to defaults')"></button>
                <button x-h-button data-variant="primary" @click="${dollar}store.formats.apply()"
                        x-text="T('application-core:shell.settings.apply', 'Apply')"></button>
              </div>
            </div>
          </div>
        </div>

        <!-- A setting entity's own generated CRUD list. The host carries x-h-include: Harmonia
             fetches the fragment and initializes Alpine on it (binding its <Entity>ManageListPage
             and every Harmonia directive in it), destroying and re-initializing only the children so
             the host's own directives - this ref, the x-show - stay live. Deliberately not an
             x-html="content" binding: Alpine re-runs such an effect on its own account and the
             re-run replaced the whole subtree, destroying the list's Filter popover and its record
             sheet in the tick they opened. x-h-include reports no failure of its own, so the page
             waits for the fragment:loaded it dispatches (see awaitFragment). -->
        <div class="vbox flex-1 overflow-hidden" x-show="entityUrl" x-cloak>
          <div class="p-4" x-show="loading"><div x-h-spinner></div></div>
          <div x-h-alert data-variant="negative" role="alert" class="m-4" x-show="error">
            <div x-h-alert-description x-text="error"></div>
          </div>
          <div class="size-full min-w-0" x-show="!loading &amp;&amp; !error"
               x-ref="entityView" x-h-include="entityUrl" @fragment:loaded="onFragmentLoaded()"></div>
        </div>
      </div>
    </div>
  </div>
</div>
