/*
 * Partner (my) DOCUMENT page for ${name} - the logged-in user's own document (header + line items),
 * scoped to the ${name}PartnerController (header) and the ${documentItemsEntity}PartnerController (items). It
 * reuses the item COLUMN metadata that detail-register already published (App.detailsFor), but reads
 * and writes item DATA through the partner items controller so ownership + sensitive-field stripping
 * are enforced server-side. Sensitive fields never arrive; the owner is forced by the server.
 */
#set($statusProp = "")
#foreach($property in $properties)
#if($property.widgetType == "DOCUMENT_STATUS")#set($statusProp = $property.name)#end
#end
document.addEventListener('alpine:init', () => {
  Alpine.data('${name}PartnerDocumentPage', () => ({
    ...basePage(),
    state: 'loading',
    mode: 'create',
    id: null,
    error: null,
    saving: false,
    ownerName: '',
    deleteOpen: false,
    deleteBusy: false,
    form: {
#foreach($property in $properties)
#if(!$property.dataAutoIncrement && !$property.sensitiveProperty && $property.name != "ProcessId" && (!$property.auditType || $property.auditType == "NONE") && $property.name != "Name")
      ${property.name}: #if($property.widgetType == "CHECKBOX")false#elseif($property.widgetType == "MULTISELECT")[]#{else}''#end,
#end
#end
    },
    options: {},

    apiPath: '/${javaPerspectiveName}/${name}PartnerController',
    // The partner items controller (composition child inherits the partner scope one hop).
    itemsApiPath: '/${javaPerspectiveName}/${documentItemsEntity}PartnerController',

    // Role-scoped line-item columns withheld from this caller (see init).
    itemRestricted: [],
#if($immutableStatusProperty || $immutableAlways)

    // Immutability pre-check (intent `immutable`/`immutableWhen:`), asked from the scoped
    // controller's GET /{id}/mutable so the Edit affordances stay honest - an /edit URL typed
    // directly opens read-only (header AND item actions). The controller's PUT/DELETE 409 stays
    // authoritative; the pre-check fails OPEN (an outage must not lock the UI).
    mutable: true,
#end

    // Items state (the ${documentItemsEntity} line items, rendered inline).
    itemsDef: null,        // column metadata reused from detail-register (App.detailsFor)
    items: [],
    itemsEnabled: false,   // items only after the header exists
    itemsError: null,
    itemDialog: false,
    itemMode: 'create',
    draft: {},
    itemOptions: {},
#if($documentItemsLayout == "calendar")
    // Reactive config for the items x-h-calendar (the items child declares view: calendar); rebuilt
    // after every items load. The configuration itself rides the child's detail registration.
    itemsCalCfg: { view: 'month', events: [] },
#end

    // The item column metadata, reused from detail-register (App.detailsFor). Resolved lazily: the
    // detail-register script may run after this component's init, so re-resolve until it is present.
    def() {
      if (!this.itemsDef) {
        this.itemsDef = App.detailsFor('${name}').find((d) => d.entity === '${documentItemsEntity}') || null;
      }
      return this.itemsDef;
    },

    async init() {
#if($hasRestrictedFields)
      // Role-scoped fields (intent `visibleTo:`): this surface's own controller strips them from the
      // document and ignores them on writes, so the header form and the totals hide them too.
      this.loadRestrictedFields();
#end
      this.def();
      // Role-scoped columns of the line-items child: the child registered whether it has any,
      // and its own scoped controller says which of them this caller may not see.
      if (this.def() && this.def().restrictedFields) {
        try {
          const answer = await App.services.api.get(this.itemsApiPath + '/restricted');
          this.itemRestricted = (answer && answer.restricted) || [];
        } catch (e) {
          console.error('[restricted] could not read the line-item field visibility', e);
        }
      }
      await this.loadOwnerName();
      await this.loadOptions();
      const params = (window.PineconeRouter.context && window.PineconeRouter.context.params) || {};
      this.id = params.id || null;
      this.mode = this.id ? 'edit' : 'create';
      if (this.id) {
        try {
          const record = await App.services.api.get(this.apiPath + '/' + this.id);
#if($immutableStatusProperty || $immutableAlways)
          try {
            const m = await App.services.api.get(this.apiPath + '/' + this.id + '/mutable');
            this.mutable = !m || m.mutable !== false;
          } catch (e) {
            console.error('[${name}PartnerDocumentPage] mutable pre-check failed', e);
          }
#end
          for (const key of Object.keys(this.form)) {
            if (record[key] !== undefined && record[key] !== null) this.form[key] = record[key];
          }
#foreach($property in $properties)
#if(($property.widgetType == "DATE" || $property.widgetType == "DATETIME-LOCAL") && !$property.sensitiveProperty)
          if (this.form.${property.name} != null && this.form.${property.name} !== '') this.form.${property.name} = window.HarmoniaFormat.toDateInput(this.form.${property.name}, '${property.widgetType}');
#end
#end
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS") && !$property.sensitiveProperty)
          if (this.form.${property.name} != null && this.form.${property.name} !== '') this.form.${property.name} = String(this.form.${property.name});
#end
#if($property.widgetType == "MULTISELECT" && !$property.sensitiveProperty)
          // MULTISELECT: split the stored csv into the ARRAY the multiple-mode select binds.
          this.form.${property.name} = (this.form.${property.name} == null || this.form.${property.name} === '')
              ? [] : String(this.form.${property.name}).split(',').map(v => v.trim());
#end
#end
          this.itemsEnabled = true;
          await this.loadItems();
          this.state = 'default';
        } catch (e) {
          this.error = (e && e.message) || 'Could not load the document.';
          this.state = 'error';
        }
      } else {
        // A MULTISELECT field (an ARRAY - what keeps the select in multiple mode) takes no prefill.
        for (const key of Object.keys(this.form)) {
          if (Array.isArray(this.form[key])) continue;
          const v = this.queryParam(key);
          if (v !== null) this.form[key] = v;
        }
        this.state = 'default';
      }
    },

    queryParam(name) {
      const search = (window.location.hash.split('?')[1] || '');
      const params = new URLSearchParams(search);
      return params.has(name) ? params.get(name) : null;
    },

    /** The mapped identity record's display name (for "New/Edit <Doc> for <owner>"). */
    async loadOwnerName() {
      try {
        const me = await App.services.api.get(this.apiPath + '/me');
        this.ownerName = (me && (me.name || me.Name)) || '';
      } catch (e) { this.ownerName = ''; }
    },

    async loadOptions() {
      const loaded = {};
#foreach($property in $properties)
#if(($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT") && !$property.sensitiveProperty)
      try {
        const rows = await App.services.api.getAll('${property.widgetDropdownControllerUrl}', { baseUrl: '' });
        loaded['${property.name}'] = (rows || []).map(r => ({ value: r.${property.widgetDropDownKey}, text: r.${property.widgetDropDownValue} }));
      } catch (e) { loaded['${property.name}'] = []; }
#end
#end
      this.options = loaded;
    },

    // ----- Header (master) save -------------------------------------------------------------------
    toPayload() {
      const payload = { ...this.form };
      for (const key of Object.keys(payload)) {
        if (payload[key] === '') payload[key] = null;
      }
#foreach($property in $properties)
#if(($property.widgetType == "DATE" || $property.widgetType == "DATETIME-LOCAL") && !$property.sensitiveProperty)
      if (payload.${property.name} != null) payload.${property.name} = window.HarmoniaFormat.toPayload(payload.${property.name}, '${property.widgetType}');
#end
#if($property.widgetType == "MULTISELECT" && !$property.sensitiveProperty)
      // MULTISELECT: join the array back to the normative csv (de-duplicated, ascending); empty -> null.
      payload.${property.name} = Array.isArray(payload.${property.name}) && payload.${property.name}.length
          ? [...new Set(payload.${property.name}.map(String))]
              .sort((a, b) => (Number(a) - Number(b)) || String(a).localeCompare(String(b)))
              .join(',')
          : null;
#end
#end
      return payload;
    },

    async save() {
      this.saving = true;
      this.error = null;
      try {
        if (this.mode === 'edit') {
          await App.services.api.put(this.apiPath + '/' + this.id, this.toPayload());
          await this.loadItems();
        } else {
          const created = await App.services.api.post(this.apiPath, this.toPayload());
          const pk = created && (created.Id != null ? created.Id : created.id);
          if (pk != null) {
            this.id = pk;
            this.mode = 'edit';
            this.itemsEnabled = true;
            const url = '#/partner/${name}/' + encodeURIComponent(this.id) + '/edit';
            if (window.location.hash !== url && window.history && window.history.replaceState) {
              window.history.replaceState(window.history.state, '', url);
            }
            await this.loadItems();
          }
        }
      } catch (e) {
        this.error = (e && e.message) || 'Could not save.';
      } finally {
        this.saving = false;
      }
    },

    // ----- Items (partner items controller) ------------------------------------------------------
    async loadItems() {
      const d = this.def();
      if (!d || this.id == null) return;
      this.itemsError = null;
      // Pre-load the lookup options so the items TABLE resolves FK columns to their labels (not raw
      // ids) on first render - not only after the item dialog has been opened once.
      await this.ensureItemOptions();
      try {
        // The partner items controller requires the master id as a query param (?<masterEntityId>=<id>);
        // it returns only that document's items and enforces ownership (requireMyParent).
        const q = '?' + encodeURIComponent(d.masterEntityId) + '=' + encodeURIComponent(this.id);
        const rows = await App.services.api.getAll(this.itemsApiPath + q);
        this.items = rows || [];
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not load the line items.';
        this.items = [];
      }
#if($documentItemsLayout == "calendar")
      this.refreshItemsCalendar();
#end
    },
#if($documentItemsLayout == "calendar")

    // ----- Items calendar (the items child declares view: calendar) -------------------------------
    // The partner counterpart of the power document's items calendar: the same rows, the same partner
    // item dialog, placed on a timeline. The event mapping is the shared one
    // (services/calendarEvents.js) and the calendar's configuration rides the child's registration.
    refreshItemsCalendar() {
      const d = this.def();
      const cal = (d && d.calendar) || null;
      this.itemsCalCfg = {
        view: (cal && cal.view) || 'month',
        events: cal ? window.HarmoniaCalendar.events(this.items, cal, {
          primaryKey: d.primaryKey,
          label: '${documentItemsLabel}',
          title: cal.title ? (row => this.itemEventTitle(cal, row)) : null,
        }) : [],
      };
    },

    // The event pill's title: the titling column resolved exactly as the items table renders it.
    itemEventTitle(cal, row) {
      const value = row[cal.title];
      if (value === null || value === undefined || value === '') return '';
      const column = this.itemColumns()
                         .find(c => c.name === cal.title);
      return column ? this.displayItem(row, column) : String(value);
    },

    // An immutable document still SHOWS the calendar - it just never opens the item dialog from it.
    itemsEditable() {
      return #if($immutableStatusProperty || $immutableAlways)this.mutable === true#{else}true#end;
    },

    onItemsEventClick(e) {
      if (!this.itemsEditable()) return;
      const id = window.HarmoniaCalendar.clickedEventId(e);
      if (id === null) return;
      const pk = this.def().primaryKey;
      const row = (this.items || []).find(r => String(r[pk]) === String(id));
      if (row) this.openItem(row);
    },

    onItemsDateClick(e) {
      if (!this.itemsEditable()) return;
      const cal = (this.def() || {}).calendar;
      if (!cal) return;
      const value = window.HarmoniaCalendar.clickedDateValue(e);
      this.openItem(null, value ? { [cal.start]: value } : null);
    },

    // Delete from the line dialog: the calendar pane has no per-row button, so this is the only route.
    async deleteDraftItem() {
      const pk = this.def().primaryKey;
      const row = (this.items || []).find(r => String(r[pk]) === String(this.draft[pk]));
      if (!row) return;
      this.itemDialog = false;
      await this.deleteItem(row);
    },
#end

    // A sensitive column never renders on the partner surface (neither in the table nor in the
    // dialog): the partner items controller nulls the value on the wire, so showing the column
    // would only display a permanently empty field the partner is not meant to see.
    itemColumns() {
      const d = this.def();
      return ((d && d.editColumns) || []).filter((c) => !c.sensitive && !this.itemRestricted.includes(c.name));
    },
    // The read-only items TABLE shows the display columns (major fields - `major: false` hides a
    // field/relation from the table) with their full edit metadata; the dialog keeps itemColumns().
    tableColumns() {
      const d = this.def();
      if (!d) return [];
      const visible = new Set((d.columns || []).map(c => c.name));
      return this.itemColumns().filter(c => visible.has(c.name));
    },

    displayItem(row, col) {
      const v = row[col.name];
      if (v == null || v === '') return '—';
      if (col.multi) {
        // A subset cell holds a key LIST ("1,3"): resolve each key and join the labels.
        const opts = this.itemOptions[col.name] || [];
        return String(v).split(',').map(k => {
          const opt = opts.find(o => String(o.value) === k.trim());
          return opt ? opt.text : k.trim();
        }).join(', ');
      }
      if (col.lookup && this.itemOptions[col.name]) {
        const opt = (this.itemOptions[col.name] || []).find((o) => String(o.value) === String(v));
        if (opt) return opt.text;
      }
      if (col.date) return window.HarmoniaFormat ? window.HarmoniaFormat.date(v) : String(v);
      if (col.number) return window.HarmoniaFormat ? window.HarmoniaFormat.number(v) : String(v);
      if (col.widget === 'CHECKBOX') return window.T ? (v ? window.T('$projectName:${tprefix}.defaults.yes', 'Yes') : window.T('$projectName:${tprefix}.defaults.no', 'No')) : String(!!v);
      return String(v);
    },

    // `preset` seeds a CREATE draft with values the caller already knows (the day clicked on the items
    // calendar).
    async openItem(row, preset) {
      const d = this.def();
      await this.ensureItemOptions();
      this.itemMode = row ? 'edit' : 'create';
      this.draft = row ? { ...row } : {};
      // MULTISELECT columns bind an ARRAY draft (that is what puts the dialog's select in multiple
      // mode): split the stored csv on edit, start empty on create.
      for (const col of this.itemColumns()) {
        if (col.widget !== 'MULTISELECT') continue;
        const v = this.draft[col.name];
        this.draft[col.name] = (v == null || v === '') ? [] : String(v).split(',').map(s => s.trim());
      }
      this.draft[d.masterEntityId] = String(this.id);
      if (preset) {
        Object.keys(preset)
              .forEach((key) => { this.draft[key] = preset[key]; });
      }
      this.itemDialog = true;
    },

    async ensureItemOptions() {
      if (Object.keys(this.itemOptions).length) return;
      const loaded = {};
      for (const col of this.itemColumns()) {
        if (col.lookup && col.lookup.url) {
          try {
            const rows = await App.services.api.getAll(col.lookup.url, { baseUrl: '' });
            loaded[col.name] = (rows || []).map((r) => ({ value: r[col.lookup.key], text: r[col.lookup.text] }));
          } catch (e) { loaded[col.name] = []; }
        }
      }
      this.itemOptions = loaded;
    },

    async saveItem() {
      const d = this.def();
      const body = { ...this.draft };
      for (const key of Object.keys(body)) { if (body[key] === '') body[key] = null; }
      // MULTISELECT: join the array back to the normative csv (de-duplicated, ascending); empty -> null.
      for (const col of this.itemColumns()) {
        if (col.widget !== 'MULTISELECT') continue;
        const v = body[col.name];
        body[col.name] = Array.isArray(v) && v.length
            ? [...new Set(v.map(String))].sort((a, b) => (Number(a) - Number(b)) || String(a).localeCompare(String(b))).join(',')
            : null;
      }
      body[d.masterEntityId] = this.id;
      try {
        const pk = d.primaryKey;
        if (this.itemMode === 'edit' && body[pk] != null) {
          await App.services.api.put(this.itemsApiPath + '/' + encodeURIComponent(body[pk]), body);
        } else {
          await App.services.api.post(this.itemsApiPath, body);
        }
        this.itemDialog = false;
        await this.loadItems();
        await this.reloadHeaderTotals();
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not save the line item.';
      }
    },

    async deleteItem(row) {
      try {
        await App.services.api.delete(this.itemsApiPath + '/' + encodeURIComponent(row[this.def().primaryKey]));
        await this.loadItems();
        await this.reloadHeaderTotals();
      } catch (e) {
        this.itemsError = (e && e.message) || 'Could not delete the line item.';
      }
    },

    /** After an item change the server recomputes the header aggregates - re-read them. */
    async reloadHeaderTotals() {
      try {
        const record = await App.services.api.get(this.apiPath + '/' + this.id);
#foreach($property in $properties)
#if($property.aggregate == "true")
        if (record.${property.name} !== undefined) this.form.${property.name} = record.${property.name};
#end
#end
      } catch (e) { /* totals refresh best-effort */ }
    },

#if($statusProp != "")
    statusText() {
      const opt = (this.options['${statusProp}'] || []).find((o) => String(o.value) === String(this.form.${statusProp}));
      return opt ? opt.text : '';
    },
    statusVariant(text) {
      const t = String(text || '').toLowerCase();
      if (/draft/.test(t)) return 'outline';
      if (/(cancel|reject|declin|void|fail|overdue|insufficient|exhaust)/.test(t)) return 'negative';
      if (/(pending|await|hold|review|partial)/.test(t)) return 'warning';
      if (/(approv|accept|activ|complet|paid|done|available)/.test(t)) return 'positive';
      if (/(issu|sent|ship|process|submit)/.test(t)) return 'information';
      return 'default';
    },
#end

    async confirmDelete() {
      this.deleteBusy = true;
      try {
        await App.services.api.delete(this.apiPath + '/' + this.id);
        this.deleteOpen = false;
        this.goBack();
      } catch (e) {
        this.error = (e && e.message) || 'Could not delete.';
        this.deleteOpen = false;
      } finally {
        this.deleteBusy = false;
      }
    },

    goBack() { this.navigate('/partner/${name}'); },
  }));
});
