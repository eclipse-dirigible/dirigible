<!DOCTYPE html>
<!--
  Generated by Eclipse Dirigible based on model and template.
  Standalone Alpine.js + Harmonia report page for ${name}, rendered from a .report artifact. Opened
  directly (its own URL under gen/<javaGenFolder>/reports/<name>/); queries the generated Java report
  controller via the self-contained client in report.js. Follows the platform colour scheme: Harmonia
  applies the saved choice - or the OS scheme in `auto` mode - itself, in sync with the shell that
  embeds it.
-->
## The editor for one column's filter, emitted in the Filter menu's second step and again in every
## chip's own popover - the same control either place, over the same filterDraft (the manage list's
## filterValueEditor, #7390). $dismiss is what the host needs done before the value is applied: the
## Filter menu closes itself through closeFilterMenu(), while a chip owns its popover's open flag.
## Only the text and number inputs apply on Enter: a date input's Enter would run before the picker
## has taken the typed day, so a date is applied with the Apply button.
#macro(reportFilterEditor $dismiss)
            <template x-if="editedFilterColumn && editedFilterColumn.kind === 'date'">
              <div class="vbox gap-3">
                <div class="hbox flex-wrap gap-1">
                  <template x-for="preset in datePresets" :key="preset.key">
                    <button x-h-button data-variant="outline" data-size="sm" @click="applyDatePreset(preset.key)"
                            x-text="T('application-core:shell.list.' + preset.key, preset.label)"></button>
                  </template>
                </div>
                <div class="vbox gap-1">
                  <span class="text-xs text-muted-foreground" x-text="T('application-core:shell.list.dateFrom', 'From')"></span>
                  <div x-h-date-picker>
                    <input type="text" :placeholder="HarmoniaFormat.dateHint()" :aria-label="T('application-core:shell.list.dateFrom', 'From')" />
                    <button x-h-date-picker-trigger :aria-label="T('application-core:shell.report.chooseDate', 'Choose date')"></button>
                    <div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="filterDraft.from"></div>
                  </div>
                </div>
                <div class="vbox gap-1">
                  <span class="text-xs text-muted-foreground" x-text="T('application-core:shell.list.dateTo', 'To')"></span>
                  <div x-h-date-picker>
                    <input type="text" :placeholder="HarmoniaFormat.dateHint()" :aria-label="T('application-core:shell.list.dateTo', 'To')" />
                    <button x-h-date-picker-trigger :aria-label="T('application-core:shell.report.chooseDate', 'Choose date')"></button>
                    <div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="filterDraft.to"></div>
                  </div>
                </div>
              </div>
            </template>
            <!-- A number filters by a range, either end left empty for an open one. -->
            <template x-if="editedFilterColumn && editedFilterColumn.kind === 'number'">
              <div class="vbox gap-3">
                <div class="vbox gap-1">
                  <span class="text-xs text-muted-foreground" x-text="T('application-core:shell.report.minimum', 'Minimum')"></span>
                  <div x-h-input-number><input type="number" step="any" :aria-label="T('application-core:shell.report.minimum', 'Minimum')"
                                               x-model.number="filterDraft.min" @keydown.enter="${dismiss}applyFilterDraft()" /></div>
                </div>
                <div class="vbox gap-1">
                  <span class="text-xs text-muted-foreground" x-text="T('application-core:shell.report.maximum', 'Maximum')"></span>
                  <div x-h-input-number><input type="number" step="any" :aria-label="T('application-core:shell.report.maximum', 'Maximum')"
                                               x-model.number="filterDraft.max" @keydown.enter="${dismiss}applyFilterDraft()" /></div>
                </div>
              </div>
            </template>
            <template x-if="editedFilterColumn && editedFilterColumn.kind === 'boolean'">
              <select x-model="filterDraft.equals" class="w-full text-sm rounded-md border border-border px-2 py-1"
                      :aria-label="editedFilterColumn.key">
                <option value="" x-text="T('application-core:shell.report.all', 'All')"></option>
                <option value="true" x-text="T('application-core:shell.report.true', 'Yes')"></option>
                <option value="false" x-text="T('application-core:shell.report.false', 'No')"></option>
              </select>
            </template>
            <template x-if="editedFilterColumn && editedFilterColumn.kind === 'text'">
              <input x-h-input type="text" class="w-full" x-model="filterDraft.contains" @keydown.enter="${dismiss}applyFilterDraft()"
                     :aria-label="editedFilterColumn.key" :placeholder="T('application-core:shell.report.contains', 'contains...')" />
            </template>
#end
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>${name}</title>
    <link href="/webjars/codbex__harmonia/dist/harmonia.css" rel="stylesheet" />
    <style>
      /* Theme `html` too (Harmonia only styles `body`) so the full page surface follows the theme.
         harmonia.min.js (below) applies the saved colour scheme - or the OS scheme in `auto` mode -
         itself and keeps every same-origin frame and tab in sync, so this standalone report matches
         the shell that embeds it. */
      html, body { height: 100%; background-color: var(--background); color: var(--foreground); }
      [x-cloak] { display: none !important; }
    </style>
  </head>
  <body class="vbox size-full" x-data="reportPage" x-cloak>
    <!-- The page gutter belongs to the page, not to the dashboard tile (?preview=1) that embeds it:
         the tile's card already frames the rows. -->
    <div class="vbox size-full gap-4" :class="preview ? '' : 'p-4'">
      <!-- One action row, the manage list's (#7491): what the report is, then its Filters, and on the
           right the Refresh with its Updated stamp, the Chart / Table switch and a More actions menu
           for Export and Print. Unlike a list page this one keeps its title: the page is a document
           of its own, opened at its own URL or in the application shell's Reports, where no
           breadcrumb names it. Hidden in preview mode (the dashboard tile): just the data. -->
      <div x-show="!preview" class="hbox flex-wrap items-center gap-2">
        <!-- A report with a period names the window its rows cover (#8506): "Sales (Last 30 days)". -->
        <h1 class="truncate text-xl font-semibold tracking-tight" x-text="T('$projectName:${tprefix}.t.${tId}', displayName) + (periodText ? ' (' + periodText + ')' : '')"></h1>
        <span x-show="state === 'default'" x-h-badge data-variant="information" x-text="T('application-core:shell.report.rows', '{{count}} rows', { count: count })"></span>
        <!-- The per-column filters live in this menu, the manage list's (#7390): step one lists the
             report's columns, step two edits the one picked, and Apply writes it into `filters` and
             runs the one query that implies. The conditions (a date or number range, a boolean, a
             text contains - see conditions()) are applied server-side, so paging, count, export and
             print all reflect them. overflow-visible lets the date picker's popup overhang the
             panel, which Harmonia's no-scroll body would otherwise clip. -->
        <div class="relative inline-flex">
          <button x-h-button data-variant="outline" x-h-popover-trigger.chevron="filterOpen" :data-toggled="filterOpen">
            <svg role="presentation" x-h-lucide data-lucide="list-filter"></svg>
            <span x-text="T('application-core:shell.report.filter', 'Filter')"></span>
            <svg role="presentation" x-h-lucide data-lucide="chevron-down"></svg>
          </button>
          <div x-h-popover.no-scroll data-align="bottom-start" data-innerclicks="true" class="overflow-visible" style="min-width: 18rem">
            <!-- Step one: which column to filter by. A column already filtered shows its value, so the
                 same entry is how that filter is changed. -->
            <div class="vbox p-1" x-show="!filterEditing">
              <span x-h-text.muted class="px-2 pt-1 pb-2 text-sm" x-text="T('application-core:shell.report.addFilter', 'Add filter')"></span>
              <template x-for="col in reportColumns" :key="col.key">
                <button x-h-button data-variant="transparent" class="h-auto justify-start py-2" @click="openFilterEditor(col.key)">
                  <span class="vbox min-w-0 flex-1 items-start">
                    <span class="truncate" x-text="col.key"></span>
                    <span class="truncate text-xs text-muted-foreground" x-show="filterHasValue(col)" x-text="filterValueText(col)"></span>
                  </span>
                </button>
              </template>
            </div>
            <!-- Step two: the value. -->
            <div class="vbox" x-show="filterEditing" x-cloak>
              <div x-h-toolbar data-variant="transparent" data-size="sm">
                <button x-h-button data-variant="transparent" data-size="icon-sm" @click="backToFilterMenu()"
                        :aria-label="T('application-core:shell.report.back', 'Back')">
                  <svg role="presentation" x-h-lucide data-lucide="chevron-left"></svg>
                </button>
                <span x-h-toolbar-title class="truncate" x-text="editedFilterColumn ? editedFilterColumn.key : ''"></span>
              </div>
              <div class="p-3">
#reportFilterEditor("")
              </div>
              <div x-h-toolbar.footer data-size="sm">
                <div x-h-toolbar-spacer></div>
                <button x-h-button data-variant="outline" data-size="sm" @click="closeFilterMenu()"
                        x-text="T('application-core:shell.report.cancel', 'Cancel')"></button>
                <button x-h-button data-variant="primary" data-size="sm" @click="applyFilterDraft()"
                        x-text="T('application-core:shell.report.apply', 'Apply')"></button>
              </div>
            </div>
          </div>
        </div>
        <!-- A re-read is in flight: the rows on screen stay (see load(quiet)), this only signals it. -->
        <span x-show="reloading" x-h-spinner aria-hidden="true"></span>
        <div class="flex-1"></div>
        <!-- The Inbox's Refresh (#8130): re-reads under the parameters, filters and page in force,
             and the stamp says how old the rows on screen are. -->
        <span x-show="lastUpdated" x-h-text.muted x-text="T('application-core:shell.inbox.updated', 'Updated {{time}}', { time: updatedTime() })"></span>
        <button x-h-button data-variant="outline" @click="refresh()">
          <svg role="presentation" x-h-lucide data-lucide="refresh-cw"></svg><span x-text="T('application-core:shell.report.refresh', 'Refresh')"></span>
        </button>
#if($chart)
        <!-- The view switch (#7837): one icon-only single-choice group, the same shape every browse
             page carries. Both views draw the same fetched rows. -->
        <div x-h-button-group x-model="view" :aria-label="T('application-core:shell.report.view', 'View')">
          <button type="button" x-h-button data-variant="outline" data-size="icon" x-h-button-group-radio="'chart'"
                  :aria-label="T('application-core:shell.report.chart', 'Chart')" :title="T('application-core:shell.report.chart', 'Chart')">
            <svg role="presentation" x-h-lucide data-lucide="chart-column"></svg>
          </button>
          <button type="button" x-h-button data-variant="outline" data-size="icon" x-h-button-group-radio="'table'"
                  :aria-label="T('application-core:shell.report.table', 'Table')" :title="T('application-core:shell.report.table', 'Table')">
            <svg role="presentation" x-h-lucide data-lucide="table"></svg>
          </button>
        </div>
#end
        <button x-h-button data-variant="outline" data-size="icon" x-h-menu-trigger.dropdown
                :aria-label="T('application-core:shell.report.moreActions', 'More actions')">
          <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
        </button>
        <ul x-h-menu data-align="bottom-end">
          <!-- Each takes a scope (#8434): the FULL filtered result (first, the default) or only the
               page of rows on screen. -->
          <li x-h-menu-sub :aria-disabled="state !== 'default'">
            <svg role="presentation" x-h-lucide data-lucide="download"></svg>
            <span x-text="T('application-core:shell.report.export', 'Export')"></span>
            <ul x-h-menu.sub>
              <li x-h-menu-item @click="exportCsv('all')" x-text="T('application-core:shell.report.allRecords', 'All records')"></li>
              <li x-h-menu-item @click="exportCsv('page')" x-text="T('application-core:shell.report.currentPage', 'Current page')"></li>
            </ul>
          </li>
          <li x-h-menu-sub :aria-disabled="state !== 'default'">
            <svg role="presentation" x-h-lucide data-lucide="printer"></svg>
            <span x-text="T('application-core:shell.report.print', 'Print')"></span>
            <ul x-h-menu.sub>
              <li x-h-menu-item @click="printReport('all')" x-text="T('application-core:shell.report.allRecords', 'All records')"></li>
              <li x-h-menu-item @click="printReport('page')" x-text="T('application-core:shell.report.currentPage', 'Current page')"></li>
            </ul>
          </li>
        </ul>
      </div>

      <!-- Declared report parameters (the .report `parameters` block - e.g. the balance report's
           fromDate/toDate window): first-class inputs sent by name with every query. An empty value
           uses the parameter's server-side default. Renders nothing for parameter-less reports. -->
      <div x-show="!preview && reportParams.length" class="hbox items-end gap-2 flex-wrap">
#if($periodJs)
        <!-- The period presets (#8506): choosing one fills the two dates beside it and re-reads the
             report; a date set by hand switches the select to Custom. -->
        <div class="vbox gap-1">
          <label x-h-label id="report-period-label" x-text="T('application-core:shell.report.period', 'Period')"></label>
          <div x-h-select>
            <input x-h-select-input x-model="preset" aria-labelledby="report-period-label" />
            <div x-h-select-content>
              <div x-h-select-list>
                <template x-for="p in period.presets" :key="p.name">
                  <div x-h-select-option="presetLabel(p.name)" :data-value="p.name"></div>
                </template>
                <div x-h-select-option="presetLabel('custom')" data-value="custom"></div>
              </div>
            </div>
          </div>
        </div>
#end
        <template x-for="(p, pi) in reportParams" :key="p.name">
          <div class="vbox gap-1">
            <label x-h-label :for="'report-param-' + pi" x-text="paramLabel(p.name)"></label>
            <template x-if="p.kind === 'date'">
              <div x-h-date-picker>
                <input type="text" :id="'report-param-' + pi" :placeholder="HarmoniaFormat.dateHint()" @keydown.enter="applyFilters()" />
                <button x-h-date-picker-trigger :aria-label="T('application-core:shell.report.chooseDate', 'Choose date')"></button>
                <div x-h-date-picker-popup="HarmoniaFormat.pickerConfig()" x-model="params[p.name]"></div>
              </div>
            </template>
            <template x-if="p.kind === 'number'">
              <div x-h-input-number><input type="number" step="any" :id="'report-param-' + pi" x-model.number="params[p.name]" @keydown.enter="applyFilters()" /></div>
            </template>
            <template x-if="p.kind === 'text'">
              <input x-h-input type="text" :id="'report-param-' + pi" x-model="params[p.name]" @keydown.enter="applyFilters()" />
            </template>
          </div>
        </template>
        <button x-h-button data-variant="primary" @click="applyFilters()"><svg role="presentation" x-h-lucide data-lucide="check"></svg><span x-text="T('application-core:shell.report.apply', 'Apply')"></span></button>
      </div>

      <!-- The filters in force, the manage list's chips (#7390). A chip names its column and prints
           its value; its body opens the same editor the Filter menu's second step shows, and its x
           drops that one filter and re-queries. The shape is the documented one - trigger, close,
           then the popover, all inside the chip, which is what x-h-popover resolves against. The
           trigger carries BOTH a bound state and an @click, which hands Harmonia's popover over to
           full manual control, so this toggles `open` itself and restores the outside-click
           dismissal. relative z-20: x-h-chip carries transform-gpu, a stacking context the popover
           cannot escape, and the table's sticky header would otherwise paint over the open panel. -->
      <div x-show="!preview && activeFilterChips.length" class="hbox items-center gap-2 flex-wrap">
        <span class="text-xs font-medium text-muted-foreground" x-text="T('application-core:shell.report.activeFilters', 'Active filters')"></span>
        <template x-for="chip in activeFilterChips" :key="chip.key">
          <div x-h-chip data-variant="information" class="relative z-20" x-data="{ open: false }" @click.outside="open = false">
            <button x-h-chip-button x-h-popover-trigger="open" @click="open = !open; open && openFilterEditor(chip.key)">
              <span class="text-muted-foreground" x-text="chip.key + ':'"></span>
              <span class="truncate" style="max-width: 14rem" x-text="chip.text"></span>
            </button>
            <button x-h-chip-close :aria-label="T('application-core:shell.report.removeFilter', 'Remove {{name}} filter', { name: chip.key })"
                    @click="removeFilter(chip.key)"></button>
            <div x-h-popover.no-scroll data-align="bottom-start" data-innerclicks="true" class="overflow-visible" style="min-width: 18rem">
              <div class="p-3">
#reportFilterEditor("open = false; ")
              </div>
              <div x-h-toolbar.footer data-size="sm">
                <button x-h-button data-variant="transparent" data-size="sm" @click="open = false; removeFilter(chip.key)"
                        x-text="T('application-core:shell.report.remove', 'Remove')"></button>
                <div x-h-toolbar-spacer></div>
                <button x-h-button data-variant="outline" data-size="sm" @click="open = false; backToFilterMenu()"
                        x-text="T('application-core:shell.report.cancel', 'Cancel')"></button>
                <button x-h-button data-variant="primary" data-size="sm" @click="open = false; applyFilterDraft()"
                        x-text="T('application-core:shell.report.apply', 'Apply')"></button>
              </div>
            </div>
          </div>
        </template>
        <button x-h-button data-variant="transparent" data-size="sm" @click="clearFilters()"
                x-text="T('application-core:shell.report.clearFilters', 'Clear filters')"></button>
      </div>

      <!-- An Export or Print that failed: the rows on screen are still good, so the failure is said
           beside them rather than replacing them. -->
      <div x-show="actionError" x-h-alert data-variant="negative" role="alert">
        <div x-h-alert-description x-text="actionError"></div>
        <div x-h-alert-actions>
          <button x-h-button data-variant="transparent" data-size="icon-sm" @click="actionError = null"
                  :aria-label="T('application-core:shell.report.dismiss', 'Dismiss')">
            <svg role="presentation" x-h-lucide data-lucide="x"></svg>
          </button>
        </div>
      </div>

      <div x-show="state === 'loading'"><div x-h-spinner></div></div>
      <div x-show="state === 'error'" x-h-info-page>
        <div x-h-info-page-header>
          <div x-h-info-page-media.icon><svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg></div>
          <div x-h-info-page-title x-text="T('application-core:shell.report.notRun', 'The report could not be run')"></div>
          <div x-h-info-page-description x-text="error"></div>
        </div>
        <div x-h-info-page-content x-show="!preview">
          <button x-h-button data-variant="primary" @click="load()" x-text="T('application-core:shell.report.retry', 'Retry')"></button>
        </div>
      </div>
      <div x-show="state === 'empty'" x-h-info-page>
        <div x-h-info-page-header>
          <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="inbox"></svg></div>
          <div x-h-info-page-title x-text="T('application-core:shell.report.noData', 'No data')"></div>
          <div x-h-info-page-description x-text="T('application-core:shell.report.noRows', 'The ${name} report returned no rows.', { name: '${name}' })"></div>
        </div>
      </div>
      <!-- The column filters match nothing: an answer, not an empty report, so it says so and offers
           the way back. -->
      <div x-show="state === 'no-results'" x-h-info-page>
        <div x-h-info-page-header>
          <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="search-x"></svg></div>
          <div x-h-info-page-title x-text="T('application-core:shell.report.noMatch', 'No matching rows')"></div>
          <div x-h-info-page-description x-text="T('application-core:shell.report.noMatchHint', 'Try adjusting the filters.')"></div>
        </div>
        <div x-h-info-page-content x-show="!preview">
          <button x-h-button data-variant="outline" @click="clearFilters()" x-text="T('application-core:shell.report.clearFilters', 'Clear filters')"></button>
        </div>
      </div>

      <!-- The dashboard embeds this page in a tile (?preview=1) whose card already frames the rows,
           so preview drops the table's box and grid lines - the reference's dashboard table card is
           flush and borderless, while the report page itself keeps both. The container's
           data-border is read ONCE when the directive initializes (it just adds
           `border rounded-md`), so the preview branch sets those classes directly rather than binding
           the attribute and racing Alpine's directive order; data-borders is a pure CSS hook and does
           bind. -->
      <div x-show="state === 'default'" class="vbox gap-2 flex-1 min-h-0 overflow-auto">
#if($chart)
## Native Harmonia chart directive for this report's chart type (a generation-time constant).
#if($chart == "line")#set($chartDirective = "x-h-chart-line")#elseif($chart == "pie")#set($chartDirective = "x-h-chart-pie")#elseif($chart == "doughnut")#set($chartDirective = "x-h-chart-doughnut")#elseif($chart == "polarArea")#set($chartDirective = "x-h-chart-polar-area")#elseif($chart == "radar")#set($chartDirective = "x-h-chart-radar")#else#set($chartDirective = "x-h-chart-bar")#end
        <!-- Chart surface: the report's aggregated rows rendered as a native ${chart} Harmonia chart,
             named for assistive technology by the report it draws (as the reference's charts are). -->
        <div x-show="view === 'chart'" class="flex-1" style="min-height: 60vh;">
          <div x-ref="chartEl" ${chartDirective}="chartConfig" class="size-full" :aria-label="T('$projectName:${tprefix}.t.${tId}', displayName)"></div>
        </div>
        <div x-show="view === 'table'" class="vbox gap-2">
#end
        <div x-h-table-container.scroll :class="preview ? '' : 'border rounded-md'">
          <table x-h-table :data-borders="preview ? null : 'both'">
            <thead x-h-table-header>
              <tr x-h-table-row>
                <template x-for="(col, i) in columns" :key="i"><th x-h-table-head scope="col" :class="alignClass(col)" x-text="col"></th></template>
              </tr>
            </thead>
            <tbody x-h-table-body>
              <template x-for="(row, ri) in rows" :key="ri">
                <tr x-h-table-row data-hoverable="true">
#if($drill)
                  <!-- Drill-down (#8374): the first cell opens the list of the records this row counts. -->
                  <template x-for="(col, ci) in columns" :key="ci">
                    <td x-h-table-cell :class="alignClass(col)">
                      <template x-if="ci === 0 && drillHref(row)"><a :href="drillHref(row)" target="_parent" class="font-medium underline" x-text="cellText(col, row)"></a></template>
                      <template x-if="!(ci === 0 && drillHref(row))"><span x-text="cellText(col, row)"></span></template>
                    </td>
                  </template>
#else
                  <template x-for="(col, ci) in columns" :key="ci"><td x-h-table-cell :class="alignClass(col)" x-text="cellText(col, row)"></td></template>
#end
                </tr>
              </template>
            </tbody>
#if($kind == 'balance')
            <!-- Balance totals: the summed SUM columns, shown only when the whole result fits on
                 one page (the debit/credit equality check the accountant reads off the footer). -->
            <tfoot x-h-table-footer x-show="showTotals">
              <tr x-h-table-row>
                <template x-for="(col, ci) in columns" :key="ci">
                  <td x-h-table-cell class="font-semibold" :class="alignClass(col)" x-text="ci === 0 ? T('application-core:shell.report.total', 'Total') : totalText(col)"></td>
                </template>
              </tr>
            </tfoot>
#end
          </table>
        </div>

        <!-- Pager: first / last / the current page's neighbours with an ellipsis over each gap
             (pageWindow); every page change re-queries the server. Hidden in the dashboard preview. -->
        <nav x-h-pagination class="w-fit!" x-show="!preview && totalPages > 1">
          <ul x-h-pagination-content>
            <li x-h-pagination-item>
              <a x-h-pagination-link.previous href="#" :aria-label="T('application-core:shell.report.prev', 'Previous')" :aria-disabled="page <= 1" :tabindex="page <= 1 ? -1 : 0" @click.prevent="if (page > 1) goPage(page - 1)">
                <svg x-h-lucide role="presentation" data-lucide="chevron-left"></svg>
                <span x-h-pagination-link-label x-text="T('application-core:shell.report.prev', 'Previous')"></span>
              </a>
            </li>
            <template x-for="(p, i) in pageWindow()" :key="i">
              <li x-h-pagination-item>
                <template x-if="p === '...'"><span x-h-pagination-ellipsis></span></template>
                <template x-if="p !== '...'"><a x-h-pagination-link="page === p" href="#" @click.prevent="goPage(p)" x-text="p"></a></template>
              </li>
            </template>
            <li x-h-pagination-item>
              <a x-h-pagination-link.next href="#" :aria-label="T('application-core:shell.report.next', 'Next')" :aria-disabled="page >= totalPages" :tabindex="page >= totalPages ? -1 : 0" @click.prevent="if (page < totalPages) goPage(page + 1)">
                <span x-h-pagination-link-label x-text="T('application-core:shell.report.next', 'Next')"></span>
                <svg x-h-lucide role="presentation" data-lucide="chevron-right"></svg>
              </a>
            </li>
          </ul>
        </nav>
#if($chart)
        </div>
#end
      </div>
    </div>

    <!-- Value formatter (window.HarmoniaFormat): report.js formats numeric cells through it; must load before Alpine inits. -->
    <script src="/services/web/application-core/shell/js/services/format.js"></script>
    <!-- The shared refusal gate: a report failure reaches the banner only through App.services.apiErrors (#7263). -->
    <script src="/services/web/application-core/shell/js/services/apiError.js"></script>
    <!-- i18n: the shared shell translator (window.T + the Alpine i18n store). This page is standalone
         (no SPA shell / app.js), so the catalog namespace is bootstrapped inline: i18n.js reads
         App.config.projectName at load to fetch the project's catalogs next to 'application-core'. -->
    <script>window.App = window.App || { config: {} }; App.config = App.config || {}; App.config.projectName = '$projectName';</script>
    <script src="/services/web/application-core/shell/js/services/i18n.js"></script>
    <script src="./report.js"></script>
    <script defer src="/webjars/alpinejs/dist/cdn.min.js"></script>
    <script src="/webjars/codbex__harmonia/dist/harmonia.min.js"></script>
    <script src="/webjars/lucide/dist/umd/lucide.min.js"></script>
    <!-- opt-in Harmonia Lucide plugin: registers x-h-lucide (renders Lucide icons + keeps them in sync); needs window.lucide (above). -->
    <script src="/webjars/codbex__harmonia/dist/harmonia-lucide.min.js"></script>
    <!-- Lucide icons render via x-h-lucide (harmonia-lucide bundle above). Cross-frame/tab colour-scheme
         sync is handled by Harmonia itself (its own storage listener), so no extra script is needed. -->
  </body>
</html>
