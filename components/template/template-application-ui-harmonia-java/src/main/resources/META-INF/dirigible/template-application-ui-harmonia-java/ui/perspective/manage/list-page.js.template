/*
 * Manage list page for ${name} — the list state machine plus CRUD navigation
 * (New / Edit) and inline Delete with a confirmation dialog. Create/Edit happen
 * on the routed ${name}FormPage (/${name}/create, /${name}/{id}/edit).
 */
## A relation labelled by a number: { stampOn: issue } field shows the draft marker, never its UUID
## placeholder (#7722): labelOf reads one row's label, labelRows hands a helper rows already marked.
#macro(labelOf $dnProp $dnRow)#if($dnProp.widgetDropDownDocumentNumber)window.HarmoniaFormat.documentNumber(${dnRow}.${dnProp.widgetDropDownValue})#else${dnRow}.${dnProp.widgetDropDownValue}#end#end
#macro(labelRows $dnProp $dnRows)#if($dnProp.widgetDropDownDocumentNumber)this.documentNumberLabels(${dnRows}, '${dnProp.widgetDropDownValue}')#else${dnRows}#end#end
document.addEventListener('alpine:init', () => {
  Alpine.data('${name}ManageListPage', () => ({
    ...basePage(),
    state: 'loading',
    items: [],
    error: null,
    // A per-column filter refresh (POST /search) is in flight. The table keeps showing the previous,
    // settled rows while it runs, so a half-typed filter never flips the page to the "no records"
    // empty state - that belongs only to a query that has actually returned zero rows (issue #7461).
    // filterSeq discards a slow response that a newer keystroke has already superseded.
    filtering: false,
    filterSeq: 0,
    searchTerm: '',
    sortColumn: null,
    sortDirection: null,
    currentPage: 1,
    pageSize: 10,
    selected: null,   // the row shown in the right-hand details pane

    // Per-column filter row (server-side, POST /search). string -> LIKE %v%, number/fk -> EQ, date -> a
    // { from, to } range of whole days, either end open (#8131; `instant` marks a timestamp column),
    // boolean -> EQ with a real true/false picked from Yes/No (a LIKE '%true%' reaches the controller as
    // Boolean.valueOf("%true%") = false and matches nothing, issue #7720).
    // FK columns render a dropdown from the same lookup maps the list loads. Order + `number` mirror
    // the table header (major, non-auto-increment properties). A MULTISELECT column is type 'none':
    // its stored value is a key LIST ("1,3"), so an EQ can only match the exact whole list and a LIKE
    // by id false-positives on multi-digit keys - buildConditions handles only string|number|fk|date|boolean,
    // so 'none' contributes no condition by construction and the filter row renders an empty cell.
    columnFilters: {},
    filterColumns: [
#foreach($property in $listProperties)
#if(!$property.dataAutoIncrement && $property.widgetIsMajor)
      { name: '${property.name}', type: '#if($property.widgetType == "MULTISELECT")none#elseif($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS")fk#elseif($property.dataTypeTypescript == "boolean")boolean#elseif($property.isDateType)date#elseif($property.isNumberType)number#{else}string#end', label: '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end', tkey: '$projectName:${tprefix}.t.${property.dataName}'#if($property.isNumberType), number: true#end#if($property.isDateType && $property.dataTypeJavaClass == "java.time.Instant"), instant: true#end },
#end
#end
    ],

    // The Filter menu is presentation over the filter model above: filterOpen is the popover's open
    // state, filterEditing the column whose editor it shows (null = the "add a filter" list), and
    // filterDraft the value being edited - written into columnFilters only when the user applies it,
    // so one query runs per filter rather than one per keystroke.
    filterOpen: false,
    filterEditing: null,
    filterDraft: '',

    // The record preview is a right-hand sheet; the overlay binds this two-way, so dismissing it by
    // clicking the scrim has to clear the selection the same way closeDetails() does.
    detailsOpen: false,

    // Delete confirmation.
    deleteOpen: false,
    deleteTarget: null,
    deleteBusy: false,
    deleteError: '',

    // Controller path for ${name}, relative to App.config.restBase
    // (the default base api.* prepends): <restBase>/<perspective>/<Entity>Controller.
    apiPath: '/${javaPerspectiveName}/${name}Controller',

    // Entity name used to match developer-contributed custom actions ($store.customActions) targeted
    // at this view. Set here (not inline in the view) so Velocity substitutes it - a $store.*(...)
    // call in the template would emit any nested ${...} verbatim.
    caView: '${name}',

    async init() {
      // The sheet's overlay owns detailsOpen two-way, so a dismissal that never goes through
      // closeDetails() - a click on the scrim - still has to drop the selection and the record id.
      this.$watch('detailsOpen', (open) => { if (!open && this.selected) this.closeDetails(); });
      // The menu always opens on its "add a filter" step, whatever editor it was last left on.
      this.$watch('filterOpen', (open) => { if (open) { this.filterEditing = null; this.filterDraft = ''; } });
#if($hierarchyProperty)
      // The remembered Tree / Table choice is per user, and the user's name arrives asynchronously.
      this.restoreViewMode();
      this.$watch('userName', () => this.restoreViewMode());
#end
#if($hasRestrictedFields)
      // Role-scoped fields: ask the controller which columns it withholds from this caller, so the
      // table, its filter row and the export leave them out instead of carrying permanently empty
      // cells. Not awaited - the table renders at once and drops the columns when the answer lands.
      this.loadRestrictedFields().then(() => {
        this.filterColumns = this.filterColumns.filter(c => this.canSee(c.name));
        this.exportColumns = this.exportColumns.filter(c => this.canSee(c.name));
      });
#end
#if($roleWrite)
      // Whether this caller may write ${name} at all (#8089): New, Edit and Delete stay hidden until
      // the controller answers, and stay hidden for a caller it would refuse. Not awaited - the rows
      // render at once.
      this.loadAccess();
#else
      // No write gate on ${name}: whoever may open this page may write, so there is nothing to ask.
      this.access = { read: true, write: true };
#end
      await this.load();
      this.loadLookups();
      this.selectFromRoute();
      // A custom action changes rows this view lists (a transition flips a status, a create-from adds
      // a record) through its own endpoint, not this page's editing path. Re-read on every action so
      // the table, the selected record's pane and the status-filtered action buttons agree with the
      // server (issue #7073).
      this.onActionDone(async () => { await this.load(); this.loadLookups(); });
      // Back on this list through the sidebar or the hosting shell, which re-renders nothing (#8130).
      this.onReentered(() => this.refresh());
#if($hasProcess)
      // A completed BPM task on the selected record changes it behind this view's back, and the chain
      // behind the task keeps writing after the completion returned, which is why the processTasks
      // store announces that record's process again on a bounded schedule after the task form closed
      // (#7612). Re-read the list quietly - the rows stay on screen - so the table and the open sheet
      // move too.
      this.onTasksChanged(() => this.selected && this.selected.ProcessId, async () => { await this.load(true); this.loadLookups(); });
#end
    },

    // Deep link / reload support: /${name}/:id pre-selects that row once the list is loaded, and
    // opens the sheet it is selected IN - the URL names a record because the record is being looked
    // at, so a reload or a step through history that lands here has to show it, not just highlight
    // the row behind a closed sheet. Every route step re-renders this fragment, so this covers the
    // whole history axis: an id opens the sheet, the bare list route renders with none.
    selectFromRoute() {
      const params = (window.PineconeRouter.context && window.PineconeRouter.context.params) || {};
      const id = params.id;
      if (id === undefined || id === null || id === '') return;
      const match = this.items.find(it => String(it.${primaryKeysString}) === String(id));
      if (match) { this.selected = match; this.detailsOpen = true; this.refreshIcons(); }
    },

    // True while this list is rendered inline on somebody else's route - the Settings master-detail
    // loads this fragment into its detail pane. The page owns no route of its own there, so neither
    // the selected row nor an edit may navigate: both would take the shell off the hosting page.
    inlineHosted() {
      const here = (window.location.hash || '').split('?')[0];
      return here !== '#/${name}' && here.indexOf('#/${name}/') !== 0;
    },

    // Create / edit / preview while inline, through the shared related-record iframe dialog - the
    // same path a master's detail panel opens its child form on, for the same reason: the hosting
    // page keeps its state, and the list reloads when the dialog reports a save.
    // A route may already carry its own query (Add child presets the parent), so the dialog flags
    // join it rather than open a second '?', which the form would read as part of the last value.
    openInDialog(route, title) {
      Alpine.store('related').create(window.location.pathname + '?embedded=1#' + route + (route.indexOf('?') >= 0 ? '&' : '?') + 'embedded=1&dialog=1',
              title, () => this.load());
    },

    // Reflect the selected row in the URL (/${name}/:id) without re-rendering the list. Uses
    // replaceState (no Pinecone re-route) and notifies the embedding shell so the top-level
    // address bar stays in sync; deep-linking/reload is handled by selectFromRoute() above.
    syncSelectionUrl(row) {
      if (typeof window.history === 'undefined' || !window.history.replaceState) return;
      // Inline, the selected row is not a destination of its own: rewriting the hash routes the
      // shell away from the page that embeds us, straight out of Settings.
      if (this.inlineHosted()) return;
      const path = '/${name}' + (row ? '/' + encodeURIComponent(row.${primaryKeysString}) : '');
      const url = '#' + path;
      if (window.location.hash === url) return;
      window.history.replaceState(window.history.state, '', url);
      try { window.dispatchEvent(new HashChangeEvent('hashchange')); } catch (e) { /* older browsers */ }
    },

    // `quiet` keeps the current rows, page and filters on screen until the fresh rows arrive (a
    // background re-read), so it re-runs the filter in force rather than the full list.
    async load(quiet) {
      if (!quiet) {
        this.state = 'loading';
        this.currentPage = 1;
      }
      this.error = null;
      try {
        const conditions = quiet ? this.buildConditions() : [];
        this.items = conditions.length
          ? await App.services.api.post(this.apiPath + '/search', { conditions })
          : await App.services.api.getAll(this.apiPath);
        this.state = this.items.length === 0 ? 'empty' : 'default';
        // A quiet re-read keeps the page, unless the rows it stood on are gone.
        this.currentPage = Math.min(this.currentPage, this.totalPages);
        this.lastUpdated = new Date();
        // Keep the current selection if it still exists, else clear it.
        if (this.selected) {
          this.selected = this.items.find(it => it.${primaryKeysString} === this.selected.${primaryKeysString}) || null;
        }
      } catch (e) {
        this.error = App.services.apiErrors.messageFor(e, 'Could not load ${name}.');
        this.state = 'error';
      }
      this.refreshIcons();
    },

    // The header's Refresh (#8130): the rows again, under the search, filters, sort and page in force.
    async refresh() {
      await this.load(true);
      this.loadLookups();
    },

#if($hierarchyProperty)
    // --- Hierarchy (intent `hierarchy:`, #7613): the list renders as a TREE-TABLE - the very table
    // the flat list shows, same columns, headers and sort, with the first column indented under an
    // expand chevron. A tree with no edges is just a table, so the flat table shows until some record
    // actually has a parent; a search or a column filter matches records anywhere in the tree, so it
    // gets the flat table too. The person can switch to the table themselves (viewMode), and the
    // choice is remembered per user and entity.
    viewMode: 'tree',   // 'tree' | 'table'
    collapsed: {},      // a node's key -> true while its children are hidden
    // Whether the records form a hierarchy at all: some record's parent is among the loaded ones.
    get hasHierarchy() {
      const ids = new Set(this.items.map(it => it.${primaryKeysString}));
      return this.items.some(it => it.${hierarchyProperty} != null && ids.has(it.${hierarchyProperty}));
    },
    get treeVisible() {
      return this.viewMode === 'tree' && this.hasHierarchy && !this.searchTerm && !this.hasActiveColumnFilters;
    },
    // The tree flattened depth-first, each node with its depth: siblings follow the table's current
    // sort, a collapsed node hides its subtree, and there is no depth limit. A record whose parent is
    // not loaded is a root, and a cycle in the data still renders every record once rather than
    // looping or dropping the records caught in it.
    get treeRows() {
      const order = this.sortedItems;
      const ids = new Set(order.map(it => it.${primaryKeysString}));
      const childrenByParent = new Map();
      const roots = [];
      for (const it of order) {
        const parent = it.${hierarchyProperty};
        if (parent == null || !ids.has(parent)) {
          roots.push(it);
        } else {
          if (!childrenByParent.has(parent)) childrenByParent.set(parent, []);
          childrenByParent.get(parent).push(it);
        }
      }
      // A record no root reaches sits in a parent cycle: the first such record becomes a root of its
      // own, marking the rest of its cycle, so every record renders once. Reachability ignores what is
      // collapsed - a collapsed branch is hidden, not orphaned.
      const reachable = new Set();
      const mark = (node) => {
        const key = node.${primaryKeysString};
        if (reachable.has(key)) return;
        reachable.add(key);
        (childrenByParent.get(key) || []).forEach(mark);
      };
      roots.forEach(mark);
      for (const it of order) {
        if (!reachable.has(it.${primaryKeysString})) {
          roots.push(it);
          mark(it);
        }
      }
      const rows = [];
      const seen = new Set();
      const walk = (node, depth) => {
        const key = node.${primaryKeysString};
        if (seen.has(key)) return;
        seen.add(key);
        const children = childrenByParent.get(key) || [];
        rows.push({ row: node, depth, hasChildren: children.length > 0 });
        if (!this.collapsed[key]) children.forEach(child => walk(child, depth + 1));
      };
      roots.forEach(root => walk(root, 0));
      return rows;
    },
    // What the table body iterates: the tree's rows in tree mode, the current page otherwise - one
    // shape for both, so every column renders from the same markup.
    get visibleRows() {
      return this.treeVisible ? this.treeRows : this.paginatedItems.map(row => ({ row, depth: 0, hasChildren: false }));
    },
    toggleNode(row) {
      const key = row.${primaryKeysString};
      this.collapsed = { ...this.collapsed, [key]: !this.collapsed[key] };
    },
    isCollapsed(row) { return !!this.collapsed[row.${primaryKeysString}]; },
    // The remembered Tree / Table choice lives in the browser, keyed by project, entity and user - a
    // convenience, so a browser without storage (a private window, blocked site data) keeps the
    // default rather than failing the page.
    get userName() { return (Alpine.store('currentUser') && Alpine.store('currentUser').name) || ''; },
    viewModeKey() { return 'dirigible.listView.${projectName}.${name}.' + this.userName; },
    restoreViewMode() {
      try {
        const saved = window.localStorage.getItem(this.viewModeKey());
        if (saved === 'tree' || saved === 'table') this.viewMode = saved;
      } catch (e) {
        console.warn('[${name}ManageListPage] the list view choice could not be read', e);
      }
    },
    rememberViewMode(mode) {
      try {
        window.localStorage.setItem(this.viewModeKey(), mode);
      } catch (e) {
        console.warn('[${name}ManageListPage] the list view choice could not be remembered', e);
      }
    },
#end
    // The heading the sheet carries over the record's properties: what KIND of thing it is. The
    // record's own key is in the header beside it, and its values are in the block below.
    sheetTitle() {
      return window.T ? T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') : '${entityLabel}';
    },

    // ----- What the sheet offers for the selected record -------------------------------------------
    // In the order they are offered: the record's own actionable process tasks (your step outranks
    // everything), then whatever the customActions extension point contributes. The FIRST of them is
    // the sheet's one visible button; the rest go into its overflow menu, each group its own.
    get recordTasks() {
#if($hasProcess)
      const tasks = Alpine.store('processTasks');
      return (this.selected && tasks) ? tasks.getTasks(this.selected) : [];
#else
      return [];
#end
    },
    get recordActions() {
      const actions = Alpine.store('customActions');
      return (this.selected && actions) ? actions.getActions(this.caView, 'entity', this.selected) : [];
    },
    // A row's own contributed actions, for its row menu (#8116): the sheet's rule, applied to the row -
    // the same store call, so the same status guards and roles. A method, not a getter: the row menu
    // evaluates it per row, and the row already carries the status the guards read.
    rowActions(row) {
      const actions = Alpine.store('customActions');
      return (row && actions) ? actions.getActions(this.caView, 'entity', row) : [];
    },
    // Runs one of a row's actions on that row. Here rather than in the markup: there, a $store call
    // whose arguments carry the row's key expression is read by Velocity as one reference, and refused.
    runRowAction(action, row) {
      Alpine.store('customActions').trigger(action, row.${primaryKeysString}, row);
    },
    // The contributed action that is the sheet's filled button (#8119): the first of the record's
    // actions that declares primary - recordActions has already applied its status guards and roles.
    get primaryCustomAction() {
      return this.recordActions.find((a) => a.primary) || null;
    },
    // 'task' | 'action' | 'edit' | 'preview' - what the sheet's one filled button does. The record's
    // own process task comes first (the step it is waiting on), then a contributed action declared
    // primary that applies to the record (#8119), then Edit, and Preview when the record's status - or
    // a caller who may only read (#8089) - leaves nothing to edit. Any other contributed action is
    // never it: Duplicate and Print are conveniences, not the reason the record is open.
    get primaryAction() {
      if (this.recordTasks.length) return 'task';
      if (this.primaryCustomAction) return 'action';
      if (!this.canWrite()) return 'preview';
#if($immutableStatusProperty || $immutableAlways)
      if (this.isRowImmutable(this.selected)) return 'preview';
#end
      return 'edit';
    },
    // Whatever the primary button did not take. Contributed actions are all of them, always.
    get menuTasks() { return this.primaryAction === 'task' ? this.recordTasks.slice(1) : this.recordTasks; },
    get menuActions() {
      const primary = this.primaryCustomAction;
      return this.recordActions.filter((a) => a !== primary);
    },
    runPrimaryAction() {
      const action = this.primaryCustomAction;
      if (action) Alpine.store('customActions').trigger(action, this.selectedId, this.selected);
    },
    primaryActionLabel() {
      const a = this.primaryCustomAction;
      if (!a) return '';
      return a.translation && a.translation.key ? T(a.translation.key, a.label, a.translation.options || {}) : a.label;
    },
    // The task the primary button runs. Named here rather than indexed in the markup: a $store
    // method call carrying an index expression is the Velocity-vs-Alpine trap - Velocity parses the
    // $store reference and chokes on the '['.
    get primaryTask() { return this.recordTasks[0] || null; },

    get menuHasEdit() {
      if (!this.canWrite()) return false;
#if($immutableStatusProperty || $immutableAlways)
      if (this.isRowImmutable(this.selected)) return false;
#end
      return this.primaryAction !== 'edit';
    },
    get menuHasPreview() { return this.primaryAction !== 'preview'; },
    // Delete is withheld from a caller who may not write (the controller would 403) and from a
    // record its status makes read-only (it would 409).
    get menuHasDelete() {
      if (!this.canWrite()) return false;
#if($immutableStatusProperty || $immutableAlways)
      return !this.isRowImmutable(this.selected);
#else
      return true;
#end
    },
    // A separator earns its place only between two groups that both have something in them.
#if($hierarchyProperty)
    // Add child is in the record group for a caller who may write, so the group is never empty then.
    get menuHasRecordActions() { return this.canWrite() || this.menuHasPreview; },
#else
    get menuHasRecordActions() { return this.menuHasPreview || this.menuHasEdit; },
#end
    get menuHasAnythingAbove() { return this.menuTasks.length > 0 || this.menuActions.length > 0 || this.menuHasRecordActions; },

    // Right-pane selection (the table shows only the major columns; the pane shows every property).
    get selectedId() { return this.selected ? this.selected.${primaryKeysString} : null; },
    isSelected(row)  { return this.selected && row.${primaryKeysString} === this.selected.${primaryKeysString}; },
    selectRow(row)   { this.selected = row; this.detailsOpen = true; this.refreshIcons(); this.syncSelectionUrl(row); },
    // Dismiss the detail panel: drop the selection so the list returns to full width and the row
    // highlight clears, and take the record id back out of the URL (issue #7463).
    closeDetails()   { this.selected = null; this.detailsOpen = false; this.refreshIcons(); this.syncSelectionUrl(null); },
    // Render a property value for the details pane. Jackson serializes java.time as arrays
    // (LocalDate [y,m,d], LocalDateTime [y,m,d,h,mi,s,ns]); show those as readable date strings.
    // Render a date/datetime value through the instance Date/Timestamp patterns (shell format.js).
    displayValue(v, isDate) {
      return window.HarmoniaFormat.value(v, isDate);
    },

    lookups: {},   // relationship property name -> { fkValue: label }
    // Fetch the referenced rows for each relationship (DROPDOWN) and MULTISELECT property once,
    // mapping key -> label.
    async loadLookups() {
      const all = {};
#foreach($property in $properties)
#if($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS" || $property.widgetType == "MULTISELECT")
      try {
        const opt${property.name} = await App.services.api.getAll('${property.widgetDropdownControllerUrl}', { baseUrl: '' });
        const map${property.name} = {};
        (opt${property.name} || []).forEach(e => { map${property.name}[e.${property.widgetDropDownKey}] = #labelOf($property "e"); });
        all['${property.name}'] = map${property.name};
      } catch (e) {
        console.error('[${name}ManageListPage] failed to load lookup for ${property.name}', e);
      }
#end
#end
      this.lookups = all;
      this.refreshIcons();
    },
    // A relationship FK shows its referenced label; otherwise fall back to the formatted value.
    lookupText(prop, v) {
      const m = this.lookups[prop];
      const t = m ? m[v] : undefined;
      return (t !== undefined && t !== null && t !== '') ? t : this.displayValue(v);
    },
    // A MULTISELECT cell holds a key LIST ("1,3"): resolve each key through the same lookup map and
    // join the labels. Deliberately its own resolver - lookupText must never sniff for commas, or a
    // legitimate comma-carrying string column would be torn apart.
    multiLookupText(prop, v) {
      if (v === undefined || v === null || v === '') return '';
      const m = this.lookups[prop] || {};
      return String(v).split(',').map(k => {
        const key = k.trim();
        const t = m[key];
        return (t !== undefined && t !== null && t !== '') ? t : key;
      }).join(', ');
    },

    // EntityStatus badge colour, keyed by status keyword - same map as the form/document pages.
    statusVariant(text) {
      const t = String(text || '').toLowerCase();
      if (/draft/.test(t)) return 'outline';
      if (/(cancel|reject|declin|void|fail|overdue|insufficient|exhaust)/.test(t)) return 'negative';
      if (/(pending|await|hold|review|partial)/.test(t)) return 'warning';
      if (/(approv|accept|activ|complet|paid|done|available)/.test(t)) return 'positive';
      if (/(issu|sent|ship|process|submit)/.test(t)) return 'information';
      return 'default';
    },

    get displayState() {
      if (this.state === 'loading') return 'loading';
      if (this.state === 'error')   return 'error';
      // While a per-column filter query is in flight, keep the last settled view: the previous rows
      // stay on screen (only a spinner if there are none yet), never the empty/"no records" state,
      // which belongs to a query that has already returned zero rows (issue #7461).
      if (this.filtering) return this.items.length ? 'default' : 'loading';
      // With an active column filter, keep the table (and its filter row) visible even with 0 rows,
      // so the user can adjust/clear it — don't fall back to the "create your first record" empty state.
      if (this.items.length === 0)  return (this.hasActiveColumnFilters || this.searchTerm) ? 'no-results' : 'empty';
      if (this.searchTerm && this.filteredItems.length === 0) return 'no-results';
      return 'default';
    },

    // ----- Per-column server-side filter row ------------------------------------------------------
    // Build POST /search conditions from the non-empty column filters (string -> LIKE, a date range ->
    // GTE / LT, else EQ).
    buildConditions() {
      const conds = [];
      for (const col of this.filterColumns) {
        const raw = this.columnFilters[col.name];
        if (!this.filterHasValue(col, raw)) continue;
        if (col.type === 'string') {
          conds.push({ propertyName: col.name, operator: 'LIKE', value: '%' + String(raw).trim() + '%' });
        } else if (col.type === 'number' || col.type === 'fk') {
          const n = Number(raw);
          conds.push({ propertyName: col.name, operator: 'EQ', value: isNaN(n) ? raw : n });
        } else if (col.type === 'date') {
          // From and To are whole days, so the range is the half-open [From, the day after To) the
          // controller's GTE / LT answer - To includes its whole day on a timestamp column too.
          if (raw.from) conds.push({ propertyName: col.name, operator: 'GTE', value: this.dateBound(raw.from, col.instant) });
          if (raw.to) conds.push({ propertyName: col.name, operator: 'LT', value: this.dateBound(this.addDays(raw.to, 1), col.instant) });
        } else if (col.type === 'boolean') {
          conds.push({ propertyName: col.name, operator: 'EQ', value: raw === true || String(raw) === 'true' });
        }
      }
      return conds;
    },

    // Whether a column's filter value narrows anything: a date range needs at least one of its ends.
    filterHasValue(col, v) {
      if (v === undefined || v === null) return false;
      if (col.type === 'date') return !!(v.from || v.to);
      return String(v).trim() !== '';
    },

    // ----- Date ranges (#8131): the picker's model and every bound are local YYYY-MM-DD days ----------
    toDay(date) {
      return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
    },
    fromDay(day) {
      const [y, m, d] = String(day).split('-').map(Number);
      return new Date(y, m - 1, d);
    },
    addDays(day, n) {
      const date = this.fromDay(day);
      return this.toDay(new Date(date.getFullYear(), date.getMonth(), date.getDate() + n));
    },
    // A day as the controller binds it: a DATE column takes the day itself, a timestamp column the
    // instant the day starts in the user's own time zone.
    dateBound(day, instant) { return instant ? this.fromDay(day).toISOString() : day; },

    // The quick periods; each fills From and To, and Apply runs the query as for a typed range. A week
    // starts on Monday.
    datePresets: [
      { key: 'today',     label: 'Today' },
      { key: 'thisWeek',  label: 'This week' },
      { key: 'thisMonth', label: 'This month' },
      { key: 'lastMonth', label: 'Last month' },
      { key: 'thisYear',  label: 'This year' },
    ],
    applyDatePreset(key) {
      const now = new Date();
      const y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
      const monday = d - ((now.getDay() + 6) % 7);
      const range = {
        today:     [new Date(y, m, d), new Date(y, m, d)],
        thisWeek:  [new Date(y, m, monday), new Date(y, m, monday + 6)],
        thisMonth: [new Date(y, m, 1), new Date(y, m + 1, 0)],
        lastMonth: [new Date(y, m - 1, 1), new Date(y, m, 0)],
        thisYear:  [new Date(y, 0, 1), new Date(y, 11, 31)],
      }[key];
      this.filterDraft = { from: this.toDay(range[0]), to: this.toDay(range[1]) };
    },

    // Reload the list from the backend: POST /search when any filter is set, else the full getAll.
    async applyServerFilter() {
      const conditions = this.buildConditions();
      // Do NOT blank the table to a spinner (state = 'loading') here: that hides the filter row the
      // user is typing into and would report an in-flight query as the empty state. Keep the settled
      // rows visible and only swap them in once this response is the newest one (issue #7461).
      const seq = ++this.filterSeq;
      this.filtering = true;
      this.error = null;
      try {
        const rows = conditions.length
          ? await App.services.api.post(this.apiPath + '/search', { conditions })
          : await App.services.api.getAll(this.apiPath);
        if (seq !== this.filterSeq) return;   // a newer keystroke already superseded this response
        this.items = rows;
        this.currentPage = 1;
        this.state = this.items.length === 0 ? 'empty' : 'default';
        if (this.selected) this.selected = this.items.find(it => it.${primaryKeysString} === this.selected.${primaryKeysString}) || null;
      } catch (e) {
        if (seq !== this.filterSeq) return;
        this.error = App.services.apiErrors.messageFor(e, 'Could not filter ${name}.');
        this.state = 'error';
      } finally {
        if (seq === this.filterSeq) this.filtering = false;
      }
      this.refreshIcons();
    },

    get hasActiveColumnFilters() {
      return this.filterColumns.some(c => this.filterHasValue(c, this.columnFilters[c.name]));
    },

    clearColumnFilters() { this.columnFilters = {}; this.applyServerFilter(); },

    // ----- The Filter menu and its chips (presentation over the model above) ----------------------
    // A column's own label, the one its table header shows.
    filterLabel(col) { return window.T ? T(col.tkey, col.label) : col.label; },

    // The columns a filter can be added on. A MULTISELECT column ('none') is excluded rather than
    // offered and then ignored: its value is a key list, which neither EQ nor LIKE can match.
    get availableFilters() { return this.filterColumns.filter(c => c.type !== 'none'); },

    // The filters in force, as chips - each value printed the way the table prints that column.
    get activeFilterChips() {
      return this.filterColumns.filter(c => this.filterHasValue(c, this.columnFilters[c.name]))
        .map(c => ({ name: c.name, label: this.filterLabel(c), text: this.filterValueText(c) }));
    },

    filterValueText(col) {
      const v = this.columnFilters[col.name];
      if (col.type === 'fk')   return this.lookupText(col.name, v);
      if (col.type === 'date') {
        // "01.10.2026 - 31.10.2026", or the one end an open range has.
        const from = v.from ? this.displayValue(v.from, true) : '';
        const to = v.to ? this.displayValue(v.to, true) : '';
        if (from && to) return from + ' - ' + to;
        if (!window.T) return from ? 'From ' + from : 'To ' + to;
        return from ? T('application-core:shell.list.dateFromValue', 'From {{date}}', { date: from })
                    : T('application-core:shell.list.dateToValue', 'To {{date}}', { date: to });
      }
      if (col.type === 'boolean') {
        const yes = v === true || String(v) === 'true';
        return window.T ? (yes ? T('$projectName:${tprefix}.defaults.yes', 'Yes') : T('$projectName:${tprefix}.defaults.no', 'No')) : (yes ? 'Yes' : 'No');
      }
      return String(v);
    },

    // Open the editor for one column, starting from the value that column already filters by. A date
    // column edits a { from, to } copy, so Cancel leaves the range in force untouched.
    openFilterEditor(name) {
      this.filterEditing = name;
      const v = this.columnFilters[name];
      if (this.editedFilterColumn && this.editedFilterColumn.type === 'date') {
        this.filterDraft = { from: (v && v.from) || '', to: (v && v.to) || '' };
        return;
      }
      this.filterDraft = (v === undefined || v === null) ? '' : v;
    },
    backToFilterMenu() { this.filterEditing = null; this.filterDraft = ''; },
    get editedFilterColumn() { return this.filterColumns.find(c => c.name === this.filterEditing) || null; },

    // Apply writes the draft into the filter model and runs the ONE query it implies.
    applyFilterDraft() {
      if (!this.filterEditing) return;
      let value = this.filterDraft;
      // A range picked back to front is meant the right way round.
      if (value && value.from && value.to && value.from > value.to) value = { from: value.to, to: value.from };
      this.columnFilters = { ...this.columnFilters, [this.filterEditing]: value };
      this.closeFilterMenu();
      this.applyServerFilter();
    },
    closeFilterMenu() { this.filterOpen = false; this.filterEditing = null; this.filterDraft = ''; },

    // Drop one filter (a chip's x). The rest stay in force.
    removeFilter(name) {
      const next = { ...this.columnFilters };
      delete next[name];
      this.columnFilters = next;
      this.applyServerFilter();
    },

    // FK filter dropdown options ({value,text}) from the already-loaded lookup map.
    optionsForFilter(name) {
      const m = this.lookups[name] || {};
      return Object.keys(m).map(k => ({ value: k, text: m[k] }));
    },

    get filteredItems() {
      if (!this.searchTerm) return this.items;
      const q = this.searchTerm.toLowerCase();
      return this.items.filter(it => Object.values(it).some(v =>
        v != null && String(v).toLowerCase().includes(q)));
    },

    get sortedItems() {
      if (!this.sortColumn) return this.filteredItems;
      const col = this.sortColumn, dir = this.sortDirection;
      // A relation column shows the referenced record's label, not its key, so it sorts by that label
      // (issue #7721) - resolved exactly as the cell and the export resolve it.
      const relation = this.exportColumns.find(c => c.name === col && (c.fk || c.multi));
      if (relation) {
        const collator = this.textCollator();
        const sign = dir === 'asc' ? 1 : -1;
        return [...this.filteredItems].sort((a, b) =>
          sign * collator.compare(this.exportCell(a, relation), this.exportCell(b, relation)));
      }
      return [...this.filteredItems].sort((a, b) => {
        let va = a[col] ?? '', vb = b[col] ?? '';
        if (typeof va === 'string') va = va.toLowerCase();
        if (typeof vb === 'string') vb = vb.toLowerCase();
        if (va < vb) return dir === 'asc' ? -1 : 1;
        if (va > vb) return dir === 'asc' ?  1 : -1;
        return 0;
      });
    },

    get totalPages() { return Math.max(1, Math.ceil(this.sortedItems.length / this.pageSize)); },
    get paginatedItems() {
      const start = (this.currentPage - 1) * this.pageSize;
      return this.sortedItems.slice(start, start + this.pageSize);
    },

    onSearchChange() { this.currentPage = 1; this.refreshIcons(); },
    clearSearch()    { this.searchTerm = ''; this.currentPage = 1; this.refreshIcons(); },

    cycleSort(column) {
      if (this.sortColumn !== column) { this.sortColumn = column; this.sortDirection = 'asc'; }
      else if (this.sortDirection === 'asc') { this.sortDirection = 'desc'; }
      else { this.sortColumn = null; this.sortDirection = null; }
      this.currentPage = 1;
      this.refreshIcons();
    },
    // What a screen reader announces for a sortable column header.
    ariaSort(col) {
      if (this.sortColumn !== col) return 'none';
      return this.sortDirection === 'asc' ? 'ascending' : 'descending';
    },
    isSortedAsc(col)  { return this.sortColumn === col && this.sortDirection === 'asc'; },
    isSortedDesc(col) { return this.sortColumn === col && this.sortDirection === 'desc'; },
    isUnsorted(col)   { return this.sortColumn !== col; },

    // "1-10 of 11 Expenses": WHICH rows are in view, of everything the search and the filters leave.
    // A count alone ("10 of 11") says how many but not which, and reads as a contradiction on the
    // last page, where it would be "1 of 11".
    showingRange() {
      const total = this.sortedItems.length;
      if (!total) return '';
      const from = (this.currentPage - 1) * this.pageSize + 1;
      const to = from + this.paginatedItems.length - 1;
      const name = window.T ? T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}') : '${menuLabel}';
      return window.T
        ? T('$projectName:${tprefix}.defaults.showing', '{{from}}-{{to}} of {{total}} {{name}}',
            { from: from, to: to, total: total, name: name })
        : from + '-' + to + ' of ' + total + ' ' + name;
    },

    goPage(n) { this.currentPage = Math.max(1, Math.min(n, this.totalPages)); this.refreshIcons(); },
    // The page numbers the pager shows: first, last and the current page's neighbours, '...' over
    // each gap - at most 7 entries, so a long list never renders a link per page.
    pageWindow() {
      const total = this.totalPages, current = this.currentPage;
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const start = Math.max(2, current - 1), end = Math.min(total - 1, current + 1);
      const pages = [1];
      if (start > 2) pages.push('...');
      for (let p = start; p <= end; p++) pages.push(p);
      if (end < total - 1) pages.push('...');
      pages.push(total);
      return pages;
    },

    // ----- Export / print: the FULL filtered+sorted set (not the current page), cells resolved
    // exactly like the table (FK labels, formatted dates) via the shared basePage helpers.
    exportColumns: [
#foreach($property in $listProperties)
#if(!$property.dataAutoIncrement && $property.widgetIsMajor)
      { name: '${property.name}', label: '#if($property.widgetLabel)${property.widgetLabelJs}#else${property.name}#end', tkey: '$projectName:${tprefix}.t.${property.dataName}'#if($property.widgetType == "MULTISELECT"), multi: true#elseif($property.widgetType == "DROPDOWN" || $property.widgetType == "DOCUMENT_STATUS"), fk: true#elseif($property.isNumberType), number: true#end#if($property.isDateType), date: true#end#if($property.numberStampOnIssue), documentNumber: true#end },
#end
#end
    ],
    exportCell(row, col) {
      const v = row[col.name];
      if (v == null || v === '') return '';
      // A MULTISELECT exports its resolved labels, not the raw key list - fk resolution would treat
      // the whole csv as one key and fall back to the raw ids.
      if (col.multi) return this.multiLookupText(col.name, v);
      if (col.documentNumber) return String(window.HarmoniaFormat.documentNumber(v));
      return col.fk ? this.lookupText(col.name, v) : this.displayValue(v, !!col.date);
    },
    exportCsv() {
      this.exportRowsCsv(this.sortedItems, this.exportColumns, (r, c) => this.exportCell(r, c), '${name}.csv');
    },
    printList() {
      this.printRows(this.sortedItems, this.exportColumns, (r, c) => this.exportCell(r, c),
        window.T ? window.T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}') : '${menuLabel}');
    },

#if($calendarView)
    // Switch to the additional calendar page (intent `view: calendar|range`), which owns /${name}.
    goCalendar() { window.PineconeRouter.navigate('/${name}'); },
#end
#if($slotsView)
    // Switch to the additional slot-picker page (intent `view: slots`), which owns /${name}.
    goSlots() { window.PineconeRouter.navigate('/${name}'); },
#end
#if($hierarchyProperty || $calendarView || $slotsView)
    // The view switch (one x-h-button-group): the pressed option is what the page shows - Tree only
    // while the records form a hierarchy - and picking the calendar or the slot picker leaves for it.
    get viewChoice() {
#if($hierarchyProperty)
      return this.hasHierarchy ? this.viewMode : 'table';
#else
      return 'table';
#end
    },
    set viewChoice(value) {
#if($calendarView)
      if (value === 'calendar') return this.goCalendar();
#end
#if($slotsView)
      if (value === 'slots') return this.goSlots();
#end
#if($hierarchyProperty)
      this.viewMode = value;
      this.rememberViewMode(value);
#end
    },
#end
    newEntity() {
      const route = '/${name}/create';
      if (this.inlineHosted()) return this.openInDialog(route, window.T ? T('application-core:shell.related.addNew', 'Add new') : 'Add new');
      window.PineconeRouter.navigate(route);
    },
#if($hierarchyProperty)
    // Add child (#7724): the create form with the hierarchy relation preset to this record. The
    // query param both prefills ${hierarchyProperty} and context-locks it (isContextLocked), so the new
    // record cannot land at the top level because the parent was never picked. Re-parenting stays
    // where it was - the edit form's picker.
    newChild(row) {
      const route = '/${name}/create?${hierarchyProperty}=' + encodeURIComponent(row.${primaryKeysString});
      if (this.inlineHosted()) return this.openInDialog(route, window.T ? T('$projectName:${tprefix}.defaults.addChild', 'Add child') : 'Add child');
      window.PineconeRouter.navigate(route);
    },
#end
    editEntity(row) {
      const route = '/${name}/' + encodeURIComponent(row.${primaryKeysString}) + '/edit';
      if (this.inlineHosted()) return this.openInDialog(route, this.entityTitle());
      window.PineconeRouter.navigate(route);
    },
    previewEntity(row) {
      const route = '/${name}/' + encodeURIComponent(row.${primaryKeysString}) + '/preview';
      if (this.inlineHosted()) return this.openInDialog(route, this.entityTitle());
      window.PineconeRouter.navigate(route);
    },
    // The singular entity label, for the dialog that holds one record's form.
    entityTitle() {
      return window.T ? T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') : '${entityLabel}';
    },
#if($immutableStatusProperty || $immutableAlways)

    // Immutability mirror for the row affordances (intent `immutable`/`immutableWhen:`): computed
    // from the row's status FK against the generation-time immutable status ids - no per-row API
    // call. The controller's 409 (and its GET /{id}/mutable pre-check, which the form page asks)
    // stay authoritative; this only keeps Edit/Delete honest in the table and the details pane.
    isRowImmutable(row) {
#if($immutableAlways)
      return row != null;
#else
      const v = row == null ? null : row.${immutableStatusProperty};
      return v != null && '${immutableStatusValues}'.split(',').includes(String(v));
#end
    },
#end

    askDelete(row) {
      this.deleteTarget = row;
      this.deleteError = '';
      this.deleteOpen = true;
    },

    async confirmDelete() {
      if (!this.deleteTarget) return;
      this.deleteBusy = true;
      this.deleteError = '';
      try {
        await App.services.api.delete(this.apiPath + '/' + encodeURIComponent(this.deleteTarget.${primaryKeysString}));
        if (this.selected && this.selected.${primaryKeysString} === this.deleteTarget.${primaryKeysString}) this.selected = null;
        this.deleteOpen = false;
        this.deleteTarget = null;
        await this.load();
      } catch (e) {
        this.deleteError = App.services.apiErrors.messageFor(e, 'Could not delete the ${name} record.');
      } finally {
        this.deleteBusy = false;
      }
    },
  }));
}, { once: true });
