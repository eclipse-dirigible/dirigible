<!--
  Generated by Eclipse Dirigible based on model and template.
  Personal (my) list fragment for ${name}. Rendered into #app on /my/${name}.
-->
<div x-data="${name}MyListPage" class="vbox size-full">

  <div x-h-toolbar data-variant="transparent">
    <span x-h-toolbar-title class="shrink-0" x-text="'My ' + T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}')"></span>
    <div x-h-toolbar-spacer></div>
#if($calendarView)
    <!-- The entity also renders on a personal calendar, which owns /my/${name}; this list lives at
         /my/${name}/list. -->
    <button x-h-button data-variant="outline" data-size="sm" @click="goCalendar()">
      <svg role="presentation" x-h-lucide data-lucide="calendar"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.calendar', 'Calendar')"></span>
    </button>
#end
#if(!$personalReadOnly && !$systemWritten)
    <button x-h-button data-variant="primary" @click="newEntity()">
      <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.new', 'New')"></span>
    </button>
#end
    <!-- The Inbox's Refresh (#8130): re-reads the rows, and the stamp says how old the ones on screen are. -->
    <span x-show="lastUpdated" x-h-text.muted x-text="T('application-core:shell.inbox.updated', 'Updated {{time}}', { time: updatedTime() })"></span>
    <button x-h-button data-variant="outline" data-size="sm" @click="refresh()">
      <svg role="presentation" x-h-lucide data-lucide="refresh-cw"></svg><span x-text="T('application-core:shell.inbox.refresh', 'Refresh')"></span>
    </button>
    <!-- Export the own rows as CSV / print them (Save as PDF via the browser dialog). -->
    <button x-h-button data-variant="outline" data-size="sm" :disabled="items.length === 0" @click="exportCsv()">
      <svg role="presentation" x-h-lucide data-lucide="download"></svg><span x-text="T('$projectName:${tprefix}.defaults.export', 'Export')"></span>
    </button>
    <button x-h-button data-variant="outline" data-size="sm" :disabled="items.length === 0" @click="printList()">
      <svg role="presentation" x-h-lucide data-lucide="printer"></svg><span x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></span>
    </button>
  </div>

  <div x-show="state === 'loading'" class="p-4"><div x-h-spinner></div></div>
  <div x-show="state === 'error'" class="p-4" x-h-text.muted x-text="error"></div>
  <div x-show="state === 'empty'" class="p-4" x-h-text.muted
       x-text="T('$projectName:${tprefix}.messages.noData', 'No records yet.')"></div>

  <div x-show="state === 'default'" x-h-table-container.scroll>
    <table x-h-table x-list-columns data-borders="rows">
      <thead x-h-table-header>
        <tr x-h-table-row>
          <template x-for="col in columns" :key="col.name">
            <th x-h-table-head scope="col" :class="col.number ? 'text-right' : ''"
                x-text="T(col.tkey, col.label)"></th>
          </template>
          <th x-h-table-head scope="col" class="w-12" data-col-actions data-sticky="end" x-show="hasRowActions"><span class="sr-only" x-text="T('$projectName:${tprefix}.aria.tableRowMenu', 'Table Row Menu')"></span></th>
        </tr>
      </thead>
      <tbody x-h-table-body>
        <template x-for="row in items" :key="row.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end">
          <tr x-h-table-row data-hoverable="true" class="cursor-pointer" @click="rowClicked($event, row)">
            <template x-for="col in columns" :key="col.name">
              <td x-h-table-cell :class="col.number ? 'text-right' : ''">
                <template x-if="col.status"><span x-h-badge :data-variant="statusVariant(statusText(row), row[col.name])" x-text="statusText(row)"></span></template>
                <template x-if="!col.status"><span x-text="display(row, col)"></span></template>
              </td>
            </template>
            <!-- The row's own actions on the personal surface (#8406) - a transition its owner runs on
                 it - only those its status accepts, and only when it has any. -->
            <td x-h-table-cell data-row-actions data-sticky="end" class="text-right" x-show="hasRowActions">
              <template x-if="rowActions(row).length || rowDestructiveActions(row).length">
                <span class="inline-flex">
                  <button x-h-menu-trigger.dropdown x-h-table-cell-button aria-label="Row actions">
                    <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
                  </button>
                  <ul x-h-menu data-align="bottom-end">
                    <template x-for="action in rowActions(row)" :key="action.id">
                      <li x-h-menu-item @click="runRowAction(action, row)"
                          x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
                    </template>
                    <!-- The destructive ones (#8364) last, after a separator, in red. -->
                    <template x-if="rowActions(row).length &amp;&amp; rowDestructiveActions(row).length">
                      <li x-h-menu-separator></li>
                    </template>
                    <template x-for="action in rowDestructiveActions(row)" :key="action.id">
                      <li x-h-menu-item data-variant="negative" @click="runRowAction(action, row)"
                          x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
                    </template>
                  </ul>
                </span>
              </template>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
