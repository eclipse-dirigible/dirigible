<!--
  Generated by Eclipse Dirigible based on model and template.
  Personal (my) list fragment for ${name}. Rendered into #app on /my/${name}.
-->
<div x-data="${name}MyListPage" class="vbox size-full gap-4 p-4">

  <!-- One action row, the manage list's (#7390): what you came to do (New) stays visible while the
       discretionary actions collapse into the overflow. A plain hbox rather than x-h-toolbar - the
       page's own gutter frames it. Unlike the manage list it leads with the page's title: in the
       Personal shell, where this page mostly runs, no breadcrumb names it. -->
  <div class="hbox flex-wrap items-center gap-2">
    <h1 class="truncate text-xl font-semibold tracking-tight" x-text="T('$projectName:${tprefix}.defaults.myEntity', 'My {{name}}', { name: T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}') })"></h1>
    <div class="flex-1"></div>

    <!-- The Inbox's Refresh (#8130): re-reads the rows, and the stamp says how old the ones on screen are. -->
    <span x-show="lastUpdated" x-h-text.muted x-text="T('application-core:shell.inbox.updated', 'Updated {{time}}', { time: updatedTime() })"></span>
    <button x-h-button data-variant="outline" @click="refresh()">
      <svg role="presentation" x-h-lucide data-lucide="refresh-cw"></svg>
      <span x-text="T('application-core:shell.inbox.refresh', 'Refresh')"></span>
    </button>

#if($calendarView)
    <!-- The view switch (#7837): one icon-only single-choice group, just before New. The entity also
         renders on a personal calendar, which owns /my/${name}; this list lives at /my/${name}/list. -->
    <div x-h-button-group x-model="viewChoice" :aria-label="T('$projectName:${tprefix}.defaults.listView', 'View')">
      <button type="button" x-h-button data-variant="outline" data-size="icon" x-h-button-group-radio="'calendar'"
              :aria-label="T('$projectName:${tprefix}.defaults.calendar', 'Calendar')" :title="T('$projectName:${tprefix}.defaults.calendar', 'Calendar')">
        <svg role="presentation" x-h-lucide data-lucide="calendar-days"></svg>
      </button>
      <button type="button" x-h-button data-variant="outline" data-size="icon" x-h-button-group-radio="'table'"
              :aria-label="T('$projectName:${tprefix}.defaults.list', 'List')" :title="T('$projectName:${tprefix}.defaults.list', 'List')">
        <svg role="presentation" x-h-lucide data-lucide="table"></svg>
      </button>
    </div>

#end
#if(!$personalReadOnly && !$systemWritten)
    <button x-h-button data-variant="primary" @click="newEntity()">
      <svg role="presentation" x-h-lucide data-lucide="plus"></svg>
      <span x-text="T('$projectName:${tprefix}.defaults.new', 'New')"></span>
    </button>

#end
    <!-- Everything discretionary: export the own rows as CSV / print them (Save as PDF via the
         browser dialog). -->
    <button x-h-button data-variant="outline" data-size="icon" x-h-menu-trigger.dropdown
            :aria-label="T('$projectName:${tprefix}.defaults.moreActions', 'More actions')">
      <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
    </button>
    <ul x-h-menu data-align="bottom-end">
      <li x-h-menu-item :aria-disabled="items.length === 0" @click="exportCsv()">
        <svg role="presentation" x-h-lucide data-lucide="download"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.export', 'Export')"></span>
      </li>
      <li x-h-menu-item :aria-disabled="items.length === 0" @click="printList()">
        <svg role="presentation" x-h-lucide data-lucide="printer"></svg>
        <span x-text="T('$projectName:${tprefix}.defaults.print', 'Print')"></span>
      </li>
    </ul>
  </div>

  <!-- Loading (the first load only - a refresh keeps the rows on screen) -->
  <div x-show="state === 'loading'"><div x-h-spinner></div></div>

  <!-- Error -->
  <div x-show="state === 'error'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg x-h-icon data-icon="circle-error" role="img" aria-label="error"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.error.loading', 'Could not load')"></div>
      <div x-h-info-page-description x-text="error"></div>
    </div>
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="load()" x-text="T('$projectName:${tprefix}.defaults.retry', 'Retry')"></button>
    </div>
  </div>

  <!-- Empty: the caller owns no record yet. -->
  <div x-show="state === 'empty'" x-h-info-page>
    <div x-h-info-page-header>
      <div x-h-info-page-media.icon><svg role="presentation" x-h-lucide data-lucide="inbox"></svg></div>
      <div x-h-info-page-title x-text="T('$projectName:${tprefix}.messages.noDataYet', 'No ${menuLabel} yet', { name: T('$projectName:${tprefix}.t.${dataName}_plural', '${menuLabel}') })"></div>
#if(!$personalReadOnly && !$systemWritten)
      <div x-h-info-page-description x-text="T('$projectName:${tprefix}.messages.getStarted', 'Get started by creating the first record.')"></div>
#end
    </div>
#if(!$personalReadOnly && !$systemWritten)
    <div x-h-info-page-content>
      <button x-h-button data-variant="primary" @click="newEntity()" x-text="T('$projectName:${tprefix}.defaults.newEntity', 'New {{name}}', { name: T('$projectName:${tprefix}.t.${dataName}', '${entityLabel}') })"></button>
    </div>
#end
  </div>

  <!-- The table is as tall as its rows and the page scrolls, as on the manage list. -->
  <div x-show="state === 'default'" x-h-table-container data-border="true">
    <table x-h-table x-list-columns data-borders="rows">
      <thead x-h-table-header>
        <tr x-h-table-row>
          <template x-for="(col, ci) in columns" :key="col.name">
            <th x-h-table-head scope="col" :data-sticky="ci === 0 ? 'start' : null" :class="col.number ? 'text-right' : ''"
                x-text="T(col.tkey, col.label)"></th>
          </template>
          <th x-h-table-head scope="col" class="w-12" data-col-actions data-sticky="end" x-show="hasRowActions"><span class="sr-only" x-text="T('$projectName:${tprefix}.aria.tableRowMenu', 'Table Row Menu')"></span></th>
        </tr>
      </thead>
      <tbody x-h-table-body>
        <template x-for="row in items" :key="row.#foreach($property in $properties)#if($property.dataPrimaryKey)${property.name}#end#end">
          <tr x-h-table-row data-hoverable="true" class="cursor-pointer" @click="rowClicked($event, row)">
            <template x-for="(col, ci) in columns" :key="col.name">
              <td x-h-table-cell :data-sticky="ci === 0 ? 'start' : null" :class="col.number ? 'text-right' : ''">
                <template x-if="col.status"><span x-h-badge :data-variant="statusVariant(statusText(row), row[col.name])" x-text="statusText(row)"></span></template>
                <template x-if="!col.status"><span x-text="display(row, col)"></span></template>
              </td>
            </template>
            <!-- The row's own actions on the personal surface (#8406) - a transition its owner runs on
                 it - only those its status accepts, and only when it has any. -->
            <td x-h-table-cell data-row-actions data-sticky="end" class="text-right" x-show="hasRowActions">
              <template x-if="rowActions(row).length || rowDestructiveActions(row).length">
                <span class="inline-flex">
                  <button x-h-menu-trigger.dropdown x-h-table-cell-button :aria-label="T('$projectName:${tprefix}.defaults.rowActions', 'Row actions')">
                    <svg role="presentation" x-h-lucide data-lucide="ellipsis"></svg>
                  </button>
                  <ul x-h-menu data-align="bottom-end">
                    <template x-for="action in rowActions(row)" :key="action.id">
                      <li x-h-menu-item @click="runRowAction(action, row)"
                          x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
                    </template>
                    <!-- The destructive ones (#8364) last, after a separator, in red. -->
                    <template x-if="rowActions(row).length &amp;&amp; rowDestructiveActions(row).length">
                      <li x-h-menu-separator></li>
                    </template>
                    <template x-for="action in rowDestructiveActions(row)" :key="action.id">
                      <li x-h-menu-item data-variant="negative" @click="runRowAction(action, row)"
                          x-text="action.translation &amp;&amp; action.translation.key ? T(action.translation.key, action.label, action.translation.options || {}) : action.label"></li>
                    </template>
                  </ul>
                </span>
              </template>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>
